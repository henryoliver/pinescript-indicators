// Moving Average with Trend Indicator

//@version=6
indicator(title = "MAs & Waves", shorttitle = "🌊 MA&W", overlay = true, max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0 = #2E3440
const color NORD1 = #3B4252
const color NORD2 = #434C5E
const color NORD3 = #4C566A
// Snow Storm
const color NORD4 = #D8DEE9
const color NORD5 = #E5E9F0
const color NORD6 = #ECEFF4
// Frost
const color NORD7 = #8FBCBB
const color NORD8 = #88C0D0
const color NORD9 = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// 🧩 TYPE DEFINITIONS
// Custom Pine types live here when a file needs them.
// ═════════════════════════════════════════════════════════════════════════════
enum TrendDir
    UP
    DOWN
    FLAT

// ═════════════════════════════════════════════════════════════════════════════
// 🎛️ USER INPUT SETTINGS
// All input groups are declared together so the settings dialog keeps the
// built-in ordering — Trend, Cycle, Waves, then Calculation last. Pine's
// top-to-bottom declaration rule would otherwise force the Calculation inputs
// above the sections that consume them, moving the group to the top.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_TREND = "📈 Trend"
const string GROUP_CYCLE = "🔄 Cycle"
const string GROUP_WAVES = "🌊 Waves"
const string GROUP_CALC = "🧮 Calculation"

// Trend Settings
trendSource = input.source(defval = close, title = "Source", tooltip = "Price series the trend SMA is calculated on.", group = GROUP_TREND)
trendSmaLength = input.int(defval = 50, title = "SMA Length", minval = 1, tooltip = "Length of the trend SMA — Barry's 50 MA. The wave count reads this line's direction; the cycle layer is independent of it.", group = GROUP_TREND)
trendSmaOffset = input.int(defval = 0, title = "SMA Offset", minval = -500, maxval = 500, display = display.none, tooltip = "Shifts the plotted SMA line left or right in bars. Visual only — the trend engine and wave count always read the unshifted series.", group = GROUP_TREND)
trendFlatWindow = input.int(defval = 10, title = "Flat Window", minval = 1, maxval = 200,
     tooltip = "Bars over which the SMA's net movement is measured for the flat-regime test (only used when Flat ATR Fraction > 0). On a sideways MA the one-bar slope keeps alternating sign with real magnitude, so single bars never read flat — this window is what catches the neutral stretch the eye sees. A flat regime colors the line gray and ends the wave count.", group = GROUP_TREND)
trendFlatAtrFraction = input.float(defval = 0.0, title = "Flat ATR Fraction", minval = 0.0, maxval = 5.0, step = 0.05,
     tooltip = "Flat-regime sensitivity: the MA is flat when its net movement over the Flat Window is at most this fraction of ATR(14). A flat stretch ends the count like a direction change, so up > flat > up resets and re-anchors wave 1 after the resume. 0 (default) disables the regime — strictly UP/DOWN, the count then resets only on a direction change. Try 0.25 to enable flat detection.", group = GROUP_TREND)
trendBreakAtrFraction = input.float(defval = 0.0, title = "Break ATR Fraction", minval = 0.0, maxval = 5.0, step = 0.05,
     tooltip = "Direction-break sensitivity for the WAVE layer: the count's trend reading only flips once the SMA moves against it by at least this fraction of ATR(14) from its running extreme. Barry reads the MA's angle — a sign flip with negligible net movement is noise, so a micro-dip mid-retrace no longer resets the count while a real rollover still does. 0 (default) = any move against the trend flips the reading (pure sign-of-slope); raise per chart (e.g. 0.1) to ignore micro-wiggles. The MA line's color stays pure sign-of-slope regardless.", group = GROUP_TREND)

// Cycle Settings (Barry's cycle defaults: %K Length 5, %K Smoothing 2, %D Smoothing 3)
cycleKLength = input.int(defval = 5, title = "%K Length", minval = 1, tooltip = "Stochastic %K lookback. 5/2/3 are Barry's cycle settings — the %D against the 45/55 band defines the half-cycles the waves count.", group = GROUP_CYCLE)
cycleKSmoothing = input.int(defval = 2, title = "%K Smoothing", minval = 1, tooltip = "SMA applied to raw %K (the 2 in Barry's 5/2/3).", group = GROUP_CYCLE)
cycleDSmoothing = input.int(defval = 3, title = "%D Smoothing", minval = 1, tooltip = "SMA applied to %K to produce %D (the 3 in Barry's 5/2/3). %D crossing the 45/55 band starts and ends the half-cycles.", group = GROUP_CYCLE)

// Wave Settings
// Wave label colors match macd-waves' wave count colors.
waveUpColor = input.color(defval = color.new(color = NORD8, transp = 20), title = "Up Trend Wave Color", tooltip = "Label color for waves counted under an UP trend (matches macd-waves' up count color).", group = GROUP_WAVES)
waveDownColor = input.color(defval = color.new(color = NORD11, transp = 10), title = "Down Trend Wave Color", tooltip = "Label color for waves counted under a DOWN trend (matches macd-waves' down count color).", group = GROUP_WAVES)
waveLabelSize = input.int(defval = 14, title = "Wave Label Size", minval = 8, maxval = 40, tooltip = "Font size of every wave label — numbers, letters, and F pins alike.", group = GROUP_WAVES)

// Calculation Settings (manual equivalent of the built-in section — the
// indicator() `timeframe` parameter can't be used in scripts that create drawings)
calcTimeframe = input.timeframe(defval = "", title = "Timeframe",
     tooltip = "Timeframe the SMA is calculated on. Leave on Chart to follow the chart's timeframe. Note: an HTF SMA with chart-timeframe cycles is a hybrid — Barry's multi-timeframe handling uses separate charts at 3:1, so the wave count is no longer his pure system.", group = GROUP_CALC)
calcWaitForClose = input.bool(defval = true, title = "Wait for timeframe closes",
     tooltip = "On a higher timeframe, only show values once that timeframe's bar closes (gaps between closes). Off updates the line with the forming bar.", group = GROUP_CALC)

// ═════════════════════════════════════════════════════════════════════════════
// 📈 TREND
// SMA engine and trend state. The SMA and its one-bar slope are computed inside
// the requested timeframe, so on an HTF setting the slope reads HTF bars, not
// chart bars. Exports `trendSma`, `trendDir`, and `trendColor`.
// ═════════════════════════════════════════════════════════════════════════════
const color TREND_UP_COLOR = color.new(color = NORD8, transp = 20)
const color TREND_DOWN_COLOR = color.new(color = NORD9, transp = 60)
const color TREND_FLAT_COLOR = NORD2

// Inputs to signal — "Wait for timeframe closes" maps to gaps: na between HTF
// closes when on. lookahead stays off so historical HTF values never leak early.
// The flat regime is computed inside the engine so an HTF setting measures it
// in HTF bars against HTF ATR; it crosses request.security as a 1/0 float.
f_trendEngine() =>
    float smaValue = ta.sma(source = trendSource, length = trendSmaLength)
    float atrValue = ta.atr(length = 14)
    float netChange = ta.change(source = smaValue, length = trendFlatWindow)
    bool isFlatRegime = trendFlatAtrFraction > 0 and not na(netChange) and not na(atrValue) and
         math.abs(number = netChange) <= trendFlatAtrFraction * atrValue
    [smaValue, smaValue - smaValue[1], isFlatRegime ? 1.0 : 0.0, atrValue]

// gaps_on only applies when an actual HIGHER timeframe is selected — that is
// the only case "Wait for timeframe closes" is about (its tooltip says so).
// On the default chart timeframe the request maps 1:1 and gaps_off removes
// any chance of the same-TF-with-gaps realtime edge starving the trend
// engine (na trendSma on live ticks would freeze waveReadDir, trendDir, and
// the wave-1 SMA gate for the whole session).
[trendSma, trendSlopePerBar, trendFlatRegimeRaw, trendAtr] = request.security(symbol = syminfo.tickerid, timeframe = calcTimeframe,
     expression = f_trendEngine(), gaps = calcWaitForClose and calcTimeframe != "" ? barmerge.gaps_on : barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

// Fill-forward SMA for the extreme-bar capture below — on an HTF setting with
// gaps on, the bars between HTF closes read na; the wave-1 close-vs-MA gate
// tests those bars against the last known MA value instead of failing on na.
float trendSmaFilled = fixnan(source = trendSma)

// Signal to state — the slope's sign classifies the bar; FLAT exists only
// through the regime test, because a per-bar reading can't catch neutral: on
// a sideways MA the one-bar slope keeps real magnitude with alternating sign,
// while the MA's NET movement over the window collapses toward zero. With
// the regime enabled a plateau breaks the count like a direction change —
// up > flat > up resets and re-anchors wave 1. With the regime disabled
// (fraction 0, the default) the state is strictly UP or DOWN — the count
// resets only on a direction change. An na slope (SMA warm-up, HTF gap bar)
// or an exactly-zero slope holds the last state. The gray line, the
// extreme-bar classification, and the wave count's flat break all read this
// same state.
bool trendFlatRegime = nz(source = trendFlatRegimeRaw, replacement = 0) > 0.5
var TrendDir trendDir = TrendDir.FLAT
trendDir := trendFlatRegime ? TrendDir.FLAT :
     trendSlopePerBar > 0 ? TrendDir.UP :
     trendSlopePerBar < 0 ? TrendDir.DOWN : trendDir
color trendColor = switch trendDir
    TrendDir.UP => TREND_UP_COLOR
    TrendDir.DOWN => TREND_DOWN_COLOR
    TrendDir.FLAT => TREND_FLAT_COLOR

// Wave-layer trend reading — the count judges direction through an
// ATR-fraction hysteresis on the SMA itself: the reading flips only once the
// SMA retreats at least Break ATR Fraction × ATR from its running extreme.
// Barry reads the MA's ANGLE — a sign flip with negligible net movement is
// noise, not a direction change (QQQ 9m 2026-07-10: a micro-dip mid-retrace
// reset the count and orphaned the 2 as a bare "a" while the reference ran
// straight through 2,3,4,5,6). A real rollover still bends the line past the
// threshold and breaks the count. The MA plot keeps the pure sign-of-slope
// color above — the two can disagree for a few bars, exactly like the
// reference's red-tinted wiggles that never touch its count. FLAT regime
// bars stay owned by the flat latch; this reading is strictly UP/DOWN once
// seeded. Updates are skipped on na bars (SMA warm-up, HTF gap bars).
var int waveReadDirState = 0       // 1 = up, -1 = down, 0 = unseeded — the count's effective reading
var float waveReadSmaExtreme = na  // the SMA's running extreme in the read direction
if not na(trendSma)
    float breakThreshold = trendBreakAtrFraction * nz(source = trendAtr, replacement = 0)
    if waveReadDirState == 0
        waveReadSmaExtreme := trendSma
        waveReadDirState := trendSlopePerBar > 0 ? 1 : trendSlopePerBar < 0 ? -1 : 0
    else if waveReadDirState == 1
        waveReadSmaExtreme := math.max(waveReadSmaExtreme, trendSma)
        if trendSma < waveReadSmaExtreme and waveReadSmaExtreme - trendSma >= breakThreshold
            waveReadDirState := -1
            waveReadSmaExtreme := trendSma
    else
        waveReadSmaExtreme := math.min(waveReadSmaExtreme, trendSma)
        if trendSma > waveReadSmaExtreme and trendSma - waveReadSmaExtreme >= breakThreshold
            waveReadDirState := 1
            waveReadSmaExtreme := trendSma
TrendDir waveReadDir = waveReadDirState == 1 ? TrendDir.UP : waveReadDirState == -1 ? TrendDir.DOWN : TrendDir.FLAT

// ═════════════════════════════════════════════════════════════════════════════
// 🔄 CYCLES
// Cycle engine (same as stochastic/macd-waves): %D 5/2/3 against the 45/55 band.
// Crossing above 45 starts a high half-cycle, crossing below 55 starts a low
// half-cycle (plus the band-skip variants). Each half-cycle tracks its extreme
// price live (highest high / lowest low) plus the extreme bar's open/close,
// SMA value, and trend state (wave qualification and classification are
// judged on that bar),
// and exports them with the just-ended half-cycle's final values, for the
// WAVES and PLOT layers. Each bar belongs to the half-cycle
// matching its own %D state (Barry's window rule), so the boundary bar is the
// NEW half-cycle's first bar: the ended cycle's extreme freezes on the bar
// before the cross, and a wave can never pin on a bar of the next half-cycle.
// ONE exception (Henry 2026-07-27, a scoped return of the removed hammer
// rule): when the crossing bar's own close ends the cycle AND that bar
// prints the ended cycle's extreme (its high tops a high half-cycle, its
// low undercuts a low one), the ended cycle claims it — the wave/F/letter
// verdict is judged and pinned on that bar. A stop-run wick on the crossing
// bar therefore CAN hand the ended cycle its extreme again (an F where the
// wick beat the baseline without a body commit is now the intended read).
// The claimed bar is consumed (one wave point per bar): the new half-cycle
// then starts unseeded and takes its extreme from its first regular bar.
// Otherwise the new half-cycle still seeds
// from every bar since the ended extreme — the %D cross lags the price turn
// by a varying number of bars, and any of them may hold the new extreme —
// plus the crossing bar itself.
// One wave point per bar: a bar that anchored a half-cycle's extreme is
// consumed, so consecutive wave points (1 then 2, 2 then 3, a then b) never
// share a bar — the seed scan stops one bar short of the ended extreme.
// ═════════════════════════════════════════════════════════════════════════════
// %D above 55 = high zone, below 45 = low zone.
const float CYCLE_LOW_BOUNDARY = 45.0
const float CYCLE_HIGH_BOUNDARY = 55.0
// Longest boundary-seed scan back to the ended cycle's extreme bar.
const int CYCLE_SEED_MAX_LOOKBACK = 200

// Boundary seeding indexes history with a runtime offset — declare the
// buffers so the auto-sized ones (measured on the short early cycles) never
// overflow on a later, longer half-cycle.
max_bars_back(high, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(low, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(open, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(close, CYCLE_SEED_MAX_LOOKBACK)
// The wave-layer reading's int state is indexed by the seed scan directly
// (max_bars_back needs a simple-type series, which an enum is not).
max_bars_back(waveReadDirState, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(trendSmaFilled, CYCLE_SEED_MAX_LOOKBACK)

float cycleK = ta.sma(source = ta.stoch(source = close, high = high, low = low, length = cycleKLength), length = cycleKSmoothing)
float cycleD = ta.sma(source = cycleK, length = cycleDSmoothing)
bool cycleCrossedAbove45 = ta.crossover(source1 = cycleD, source2 = CYCLE_LOW_BOUNDARY)
bool cycleCrossedAbove55 = ta.crossover(source1 = cycleD, source2 = CYCLE_HIGH_BOUNDARY)
bool cycleCrossedBelow55 = ta.crossunder(source1 = cycleD, source2 = CYCLE_HIGH_BOUNDARY)
bool cycleCrossedBelow45 = ta.crossunder(source1 = cycleD, source2 = CYCLE_LOW_BOUNDARY)

var int cycleZone = 0  // 1 = high half-cycle, -1 = low half-cycle, 0 = unseeded
bool cycleStartedHigh = cycleCrossedAbove45 or (cycleCrossedAbove55 and cycleZone == -1)
bool cycleStartedLow = cycleCrossedBelow55 or (cycleCrossedBelow45 and cycleZone == 1)
bool cycleStartedThisBar = cycleStartedHigh or cycleStartedLow

// The open half-cycle's extreme price and its bar, plus the just-ended
// half-cycle's final extreme (na unless a new half-cycle started this bar).
var float cycleExtreme = na
var int cycleExtremeBar = na
var float cycleExtremeOpen = na
var float cycleExtremeClose = na
var float cycleExtremeSma = na
var TrendDir cycleExtremeTrendDir = TrendDir.FLAT
float endedCycleExtreme = na
int endedCycleExtremeBar = na
float endedCycleExtremeOpen = na
float endedCycleExtremeClose = na
float endedCycleExtremeSma = na
TrendDir endedCycleExtremeTrendDir = TrendDir.FLAT

// Track the open half-cycle's extreme. Skipped on boundary bars: the crossing
// bar's %D already reads the other zone, so the bar belongs to the NEW
// half-cycle and must never move the ended cycle's extreme — it enters
// through the new cycle's seed scan below instead (or, when the ended cycle
// claimed the crossing bar as its extreme, the cycle starts unseeded — na —
// and the first regular bar seeds it here). Ties go to the most
// recent bar (>=/<=), so an equal high/low moves the dot forward.
if cycleZone != 0 and not cycleStartedThisBar and
     (na(cycleExtreme) or (cycleZone == 1 and high >= cycleExtreme) or (cycleZone == -1 and low <= cycleExtreme))
    cycleExtreme := cycleZone == 1 ? high : low
    cycleExtremeBar := bar_index
    cycleExtremeOpen := open
    cycleExtremeClose := close
    cycleExtremeSma := trendSmaFilled
    cycleExtremeTrendDir := waveReadDir

if cycleStartedThisBar and barstate.isconfirmed
    // BOUNDARY-BAR REWARD (Henry 2026-07-27): the crossing bar belongs to
    // the NEW half-cycle — except when it prints the ended cycle's extreme
    // at the very close that ends it. Then the ended cycle claims the bar:
    // its extreme, open/close, SMA, and trend reading all come from HERE,
    // so the wave/F/letter verdict is judged and pinned on this bar (the
    // extreme-bar and boundary readings are the same bar and always agree).
    // Ties move forward (>=/<=) like the tracker. cycleZone still holds the
    // ENDED cycle's side at this point.
    bool boundaryBarTakesEndedExtreme = cycleZone != 0 and
         (na(cycleExtreme) or (cycleZone == 1 ? high >= cycleExtreme : low <= cycleExtreme))
    if boundaryBarTakesEndedExtreme
        cycleExtreme := cycleZone == 1 ? high : low
        cycleExtremeBar := bar_index
        cycleExtremeOpen := open
        cycleExtremeClose := close
        cycleExtremeSma := trendSmaFilled
        cycleExtremeTrendDir := waveReadDir
    endedCycleExtreme := cycleExtreme
    endedCycleExtremeBar := cycleExtremeBar
    endedCycleExtremeOpen := cycleExtremeOpen
    endedCycleExtremeClose := cycleExtremeClose
    endedCycleExtremeSma := cycleExtremeSma
    endedCycleExtremeTrendDir := cycleExtremeTrendDir
    cycleZone := cycleStartedHigh ? 1 : -1
    if boundaryBarTakesEndedExtreme
        // The claimed boundary bar is consumed — one wave point per bar —
        // so the new half-cycle starts unseeded: the extreme tracker above
        // seeds it from the first regular bar (na comparisons keep every
        // consumer dark until then, and the boundary tick's own render is
        // frozen anyway).
        cycleExtreme := na
        cycleExtremeBar := na
        cycleExtremeOpen := na
        cycleExtremeClose := na
        cycleExtremeSma := na
        cycleExtremeTrendDir := TrendDir.FLAT
    else
        // Seed the new half-cycle: scan every eligible bar since the ended
        // extreme — the %D cross lags the price turn by a varying number of bars,
        // and any of them may already hold the new cycle's extreme — plus this
        // boundary bar itself (offset 0), the new cycle's first bar. The ended
        // extreme bar is consumed — one wave point per bar, so consecutive points
        // (1 then 2, 2 then 3, a then b) never share a bar — and the scan stops
        // one bar short of it. Ties keep the most recent bar, like the tracker.
        int cycleSeedLookback = na(endedCycleExtremeBar) ? 1 : math.min(bar_index - endedCycleExtremeBar - 1, CYCLE_SEED_MAX_LOOKBACK)
        float cycleSeedExtreme = cycleStartedHigh ? high : low
        int cycleSeedOffset = 0
        if cycleSeedLookback > 0
            for barOffset = 1 to cycleSeedLookback
                float seedCandidate = cycleStartedHigh ? high[barOffset] : low[barOffset]
                if cycleStartedHigh ? seedCandidate > cycleSeedExtreme : seedCandidate < cycleSeedExtreme
                    cycleSeedExtreme := seedCandidate
                    cycleSeedOffset := barOffset
        cycleExtreme := cycleSeedExtreme
        cycleExtremeBar := bar_index - cycleSeedOffset
        cycleExtremeOpen := open[cycleSeedOffset]
        cycleExtremeClose := close[cycleSeedOffset]
        cycleExtremeSma := trendSmaFilled[cycleSeedOffset]
        cycleExtremeTrendDir := waveReadDirState[cycleSeedOffset] == 1 ? TrendDir.UP :
             waveReadDirState[cycleSeedOffset] == -1 ? TrendDir.DOWN : TrendDir.FLAT

// ═════════════════════════════════════════════════════════════════════════════
// 🌊 WAVES
// Wave structure on top of the cycle extremes (Barry Burns rules).
//
// Trend: read at each half-cycle's extreme bar — Barry judges the MA angle at
// the cycle high/low itself — so same-direction wiggles never reset the count
// (Part 3), and at a trend birth the first cycle low after the MA rolls over
// is already wave 1. A changed reading ends the old count on the spot. The
// live layer samples the same bar, so a mid-cycle change previews the reset
// ahead of the pin: the old count's SHOWN label freezes at its extreme bar
// (shared half-cycle rule, 2026-07-16), an unshown preview simply drops,
// and wave 1 previews on the new impulse side. Pinned labels from completed
// half-cycles are never touched; pinned owners keep their number/stack.
// Exception — direction break: an OPPOSITE reading on ANY bar of a half-cycle
// also ends the count (Part 5: the count ends as soon as the 50 MA changes
// direction), because the rollover bars usually sit mid-cycle (the MA lags
// price) and the slope can recover by the extreme bar — extreme-bar sampling
// alone then reads the count's trend on both sides of a real top (QQQ 1m
// 2026-07-08 09:00: a two-bar down dip bottomed one bar before the cycle low
// and the up count ran straight from 5 into a 6-owner across the rollover).
// Every reading here is the hysteresis waveReadDir (Break ATR Fraction), so
// "opposite" means the SMA genuinely bent against the count — a sign-flip
// micro-wiggle never reaches this layer (QQQ 9m 2026-07-10: it used to reset
// mid-trend, orphan the 2 as a bare "a", and re-anchor 1 two waves late).
// One agreement rule resolves the break: a wave pins only where the extreme
// bar's reading and the boundary bar's reading AGREE. Disagreement (rollover,
// or a lone opposite-slope extreme bar) pins nothing — the count resets and
// takes the boundary's reading, and wave 1 anchors at the next extreme whose
// bar agrees. Full agreement with the old trend after a mid-cycle break
// (dip-and-resume) re-anchors wave 1 of a reborn same-direction count. The
// live layer applies the same rule with the current reading standing in for
// the boundary bar, so no wave ever previews into the other side's trend.
// Exception — flat break: a FLAT reading on ANY bar of a half-cycle ends the
// count at the boundary (Part 5: "as soon as you get the 50 MA going flat,
// the wave count would end"), because the flat stretch usually falls between
// two extreme bars and extreme-bar sampling alone never sees it. After a
// flat break the ended extreme re-anchors wave 1 only if it printed after
// the MA resumed; an extreme from before the flat belongs to the dead count
// and is discarded via a FLAT classification.
//
// Impulse side: qualifies when the cycle's EXTREME bar commits a real body
// past the last CONFIRMED wave extreme — never a failed wave's or a letter
// cycle's — with the open allowed to touch it and the close required to clear
// it. An extreme beyond the baseline without that body commit is a failed
// wave ("F" + number, always bare — a cycle is a failed wave OR a lettered
// retrace cycle, never both; corpus F3s pin inside open zones): it pins,
// advances nothing, and restarts the letters AND the zone's complexity
// count. Wave 1 has its own gate instead of a baseline: its extreme bar
// must CLOSE on the trend side of the MA (above it in an up trend, below
// in a down trend; equal fails). A miss skips the half-cycle — nothing
// pins and the count keeps hunting wave 1 at the next impulse-side
// extreme. Confirmed impulses move the baseline, advance the count by 2,
// and close the retrace zone.
//
// Retrace zone (between confirmed impulses): every cycle consumes a letter in
// order, and every non-owner cycle shows its letter (Barry: letters mark
// cycles). Letters restart after every wave point — confirmed AND failed. A
// lone "a" is meaningless, so it only plots once the very next cycle shows its
// "b" — live: the "a" previews as soon as the live bare-letter "b" draws, and
// pins with the "b"; a failed wave, confirmed impulse, or trend reset drops it
// (and its preview) instead.
// The most extreme completed retrace owns the even number, stacked with its
// letter once the zone is complex (2+ retraces, live included) and the letter
// is confirmed — the letter on the candle side, the number at the outer edge. Ownership is provisional — a deeper retrace takes the number
// and downgrades the old owner to its letter (an owner "a" that never got its
// "b" is deleted instead) — deeper-retrace takeover only: a trend reset
// leaves the owner label exactly as pinned (shared half-cycle rule: pinned
// labels on completed half-cycles persist; only the shift cycle re-owns).
// Impulse numbers are final once their half-cycle ends.
// ═════════════════════════════════════════════════════════════════════════════
const string WAVE_ALPHABET = "abcdefghijklmnopqrstuvwxyz"

// Trend + count state (reset when the boundary-sampled trend changes)
var TrendDir waveTrendDir = TrendDir.FLAT  // the count's trend — the reading at the last classified cycle extreme
var float waveLastImpulseExtreme = na      // last CONFIRMED impulse extreme — the only qualification baseline
var int waveNextImpulseNumber = 1          // number the next impulse attempt is targeting (1, 3, 5, ...)

// Retrace-zone state (between two confirmed impulses)
var int waveZoneNextLetterIndex = 0        // next letter consumed by a cycle inside the zone
var int waveZoneRetraceCount = 0           // completed retrace-side cycles in the zone
var float waveZoneBestExtreme = na         // most extreme completed retrace price — owns the even number
var int waveZoneBestLetterIndex = -1       // the owner's letter (stacked under its number when complex)
var bool waveZoneOwnerAConfirmed = true    // an owner "a" displays only after its "b" confirms
var bool waveZoneOwnerAPending = false     // owner "a" awaiting the very next cycle's verdict

// A lone letter-"a" pin is held here until the very next cycle shows its "b"
// (previewed live, made permanent on the pin); a failed wave, confirmed
// impulse, or trend reset drops it instead.
var float wavePendingAPrice = na
var int wavePendingABar = na
var bool wavePendingAIsHighSide = false

// Per-open-cycle state
var int waveCycleLetterIndex = -1          // letter consumed by the open cycle (-1 = outside a zone)

// Flat-break latch — a FLAT trend reading anywhere in the open half-cycle
// (boundary bar included) breaks the count at the next boundary. Consumed and
// cleared there.
var bool waveCycleSawFlat = false
var int waveLastFlatBar = na
if trendDir == TrendDir.FLAT
    waveCycleSawFlat := true
    waveLastFlatBar := bar_index

// Direction-break latch — a reading OPPOSITE to the count's trend anywhere in
// the open half-cycle (boundary bar included) breaks the count at the next
// boundary even when the extreme bar reads the count's trend again. Consumed
// and cleared there, like the flat latch. The reading is the hysteresis
// waveReadDir, so sign-flip wiggles below the Break ATR Fraction never latch.
var bool waveCycleSawOpposite = false
if waveTrendDir != TrendDir.FLAT and waveReadDir != TrendDir.FLAT and waveReadDir != waveTrendDir
    waveCycleSawOpposite := true

// Helper function to look up a zone letter (wraps past 'z').
f_waveLetterAt(int letterIndex) =>
    int wrappedIndex = letterIndex % 26
    str.substring(source = WAVE_ALPHABET, begin_pos = wrappedIndex, end_pos = wrappedIndex + 1)

// Helper function building a retrace label: plain number while the zone is
// simple, number stacked with the letter once it is complex. The letter always
// sits on the candle side and the number at the outer edge — above the candle
// the number is the top line, below the candle it is the bottom line.
f_waveRetraceText(int retraceNumber, int letterIndex, bool zoneIsComplex, bool isHighSide) =>
    string numberText = str.tostring(value = retraceNumber)
    if zoneIsComplex and letterIndex >= 0
        string letterText = f_waveLetterAt(letterIndex = letterIndex)
        isHighSide ? numberText + "\n" + letterText : letterText + "\n" + numberText
    else
        numberText

// Impulse qualification — ONE implementation for the boundary and live
// passes (the same three tests over different extreme snapshots): wick
// beyond the last CONFIRMED wave extreme, real-body commit past it (open
// may touch, close must clear), and the wave-1 MA-close gate. Pure
// comparisons — no state, safe to call from any scope.
f_qualifyImpulse(TrendDir qualifyDir, float extremePrice, float extremeOpen, float extremeClose, float extremeSma, float baselineExtreme) =>
    bool wickBeyond = not na(baselineExtreme) and
         (qualifyDir == TrendDir.UP ? extremePrice > baselineExtreme : extremePrice < baselineExtreme)
    bool bodyCommits = not na(baselineExtreme) and
         (qualifyDir == TrendDir.UP ?
             extremeOpen >= baselineExtreme and extremeClose > baselineExtreme :
             extremeOpen <= baselineExtreme and extremeClose < baselineExtreme)
    bool wave1Qualifies = not na(extremeSma) and
         (qualifyDir == TrendDir.UP ? extremeClose > extremeSma : extremeClose < extremeSma)
    [wickBeyond, bodyCommits, wave1Qualifies]

// Freeze handoff — restamps the live object into the permanent frozen
// old-trend label from the hold snapshot. Pure set_* calls; both call
// sites are confirmed-tick only (lifecycle invariant).
f_freezeHeldLabel(label liveLabel, int frozenBar, float frozenPrice, string frozenText, color frozenColor) =>
    label.set_xy(id = liveLabel, x = frozenBar, y = frozenPrice)
    label.set_text(id = liveLabel, text = frozenText)
    label.set_textcolor(id = liveLabel, textcolor = frozenColor)
    liveLabel

// ── Cycle boundary processing — classify the ended half-cycle, then seed the
// new one. Exports for PLOT: the ended cycle's pin text ("" = drop its live
// label), whether the pinned label takes retrace-number ownership, a one-shot
// downgrade text or delete flag for the old owner (deeper takeover or trend
// reset), an owner-ref clear flag, and a released held-"a" to draw.
string waveEndedLabelText = ""
bool waveEndedBecomesOwner = false
bool waveEndedCountReset = false
string waveEndedOwnerDowngradeText = ""
bool waveEndedOwnerDelete = false
bool waveOwnerClear = false
float wavePendingAReleasePrice = na
int wavePendingAReleaseBar = na
bool wavePendingAReleaseIsHighSide = false

if cycleStartedThisBar and barstate.isconfirmed
    bool hadPendingA = not na(wavePendingAPrice)
    bool hadOwnerAPending = waveZoneOwnerAPending
    bool endedPinnedBareLetter = false
    // The ended cycle is classified by the trend on its own extreme bar; an
    // unseeded first cycle (na extreme) falls back to the boundary reading.
    TrendDir endedCycleTrendDir = na(endedCycleExtreme) ? waveReadDir : endedCycleExtremeTrendDir
    // Flat break: a FLAT stretch inside the ended half-cycle ends the count
    // even when the extreme bar itself reads the count's trend. An extreme
    // from before the flat belongs to the dead count — classify it FLAT so it
    // pins nothing; one printed after the MA resumed re-anchors wave 1 below.
    bool endedCycleFlatBroke = waveCycleSawFlat and waveTrendDir != TrendDir.FLAT
    // One agreement rule resolves every direction case: a wave pins only
    // where the extreme bar's reading and the boundary bar's reading AGREE —
    // a bar can never receive a wave from a trend that wasn't standing at
    // both ends of the verdict. Disagreement (a rollover whose extreme
    // closed in the old trend — QQQ 2m 2026-07-10 08:44 — or a lone
    // opposite-slope extreme bar inside a standing trend) pins NOTHING: the
    // count resets, takes the boundary's reading, and wave 1 anchors at the
    // next extreme whose bar agrees. Full agreement with the OLD trend after
    // a mid-cycle break (dip-and-resume, QQQ 2m 2026-07-09 09:58) re-anchors
    // wave 1 of a reborn same-direction count. A flat break supersedes both:
    // the MA stalled rather than turned, and the flat rules below own it.
    bool endedCycleRebirth = waveCycleSawOpposite and not endedCycleFlatBroke and waveTrendDir != TrendDir.FLAT and
         endedCycleTrendDir == waveTrendDir and waveReadDir == waveTrendDir
    bool endedCycleBarMismatch = not endedCycleFlatBroke and endedCycleTrendDir != TrendDir.FLAT and
         waveReadDir != TrendDir.FLAT and endedCycleTrendDir != waveReadDir
    if endedCycleBarMismatch
        endedCycleTrendDir := waveReadDir
    if endedCycleFlatBroke and not na(endedCycleExtremeBar) and endedCycleExtremeBar <= waveLastFlatBar
        endedCycleTrendDir := TrendDir.FLAT
    if endedCycleTrendDir != waveTrendDir or endedCycleFlatBroke or endedCycleRebirth or endedCycleBarMismatch
        // The old count ended. PERSISTENCE RULE (Henry 2026-07-16): a trend
        // shift removes nothing that is already on the chart — the owner
        // label keeps its pinned number/stack exactly as drawn (the old
        // downgrade-to-letter and unconfirmed-"a" delete are gone), and the
        // ended cycle's displayed label pins as-shown in the plot layer.
        // Only the COUNT resets: baseline, numbering, letters, ownership.
        waveEndedCountReset := true
        waveLastImpulseExtreme := na
        waveNextImpulseNumber := 1
        waveZoneNextLetterIndex := 0
        waveZoneRetraceCount := 0
        waveZoneBestExtreme := na
        waveZoneBestLetterIndex := -1
        waveOwnerClear := true
    waveTrendDir := endedCycleTrendDir
    // Falls through after a reset too, so a low whose extreme printed under
    // the newborn trend anchors wave 1 immediately — no discarded cycle.
    // A rollover-flipped extreme (bar mismatch) is no longer discarded for
    // the WAVE-1 attempt (Henry 2026-07-16, QQQ 2m 10:25: the reference
    // anchors the newborn count's 1 at the shift half-cycle's own extreme):
    // after any reset the next number is 1, and the wave-1 gate — the
    // extreme bar must CLOSE on the new trend's side of the MA — is a
    // stronger test of that bar's allegiance than the hysteresis reading
    // that flagged the mismatch. Higher numbers keep the discard.
    if waveTrendDir != TrendDir.FLAT and not na(endedCycleExtreme) and (not endedCycleBarMismatch or waveNextImpulseNumber == 1)
        bool endedIsImpulseSide = (waveTrendDir == TrendDir.UP) == cycleStartedLow
        if endedIsImpulseSide
            // Qualification is judged on the ended cycle's extreme bar
            // against the last CONFIRMED wave extreme only. Wave-1 gate: the
            // first impulse wave of a trend only counts when its extreme bar
            // CLOSES on the trend side of the MA — a cycle high closing
            // above the line in an up trend, a cycle low closing below it
            // in a down trend. An equal close fails, like the body-commit
            // rule. A miss skips the half-cycle — nothing pins, no baseline,
            // and the count keeps hunting wave 1 at the next impulse-side
            // extreme. Applies to EVERY wave-1 attempt: fresh trend,
            // flat-break re-anchor, and same-direction rebirth alike.
            [endedWickBeyond, endedBodyCommits, endedWave1Qualifies] = f_qualifyImpulse(qualifyDir = waveTrendDir,
                 extremePrice = endedCycleExtreme, extremeOpen = endedCycleExtremeOpen, extremeClose = endedCycleExtremeClose,
                 extremeSma = endedCycleExtremeSma, baselineExtreme = waveLastImpulseExtreme)
            if waveNextImpulseNumber == 1 ? endedWave1Qualifies : endedBodyCommits
                // Confirmed impulse — advance the count, move the baseline, close the zone.
                waveEndedLabelText := str.tostring(value = waveNextImpulseNumber)
                waveLastImpulseExtreme := endedCycleExtreme
                waveNextImpulseNumber := waveNextImpulseNumber + 2
                waveZoneNextLetterIndex := 0
                waveZoneRetraceCount := 0
                waveZoneBestExtreme := na
                waveZoneBestLetterIndex := -1
                waveOwnerClear := true
            else if endedWickBeyond
                // Failed wave — wick passed the baseline, no real body did. It
                // pins bare and advances nothing: a cycle is a failed wave OR
                // a lettered retrace cycle, never both (corpus F3s pin inside
                // open zones; F labels always print bare). The letters and the
                // zone's complexity count restart after it just like after a
                // real wave. Ownership survives: the even number is still the
                // extreme between the confirmed impulses ("the 8 goes over
                // here because it's still looking for a full 9").
                waveEndedLabelText := "F" + str.tostring(value = waveNextImpulseNumber)
                waveZoneNextLetterIndex := 0
                waveZoneRetraceCount := 0
            else if waveNextImpulseNumber > 1 and waveCycleLetterIndex >= 0
                // No break at all — just a lettered cycle inside the open
                // zone. The number guard keeps a reset boundary's stale letter
                // (consumed under the dead count) off a skipped wave-1 attempt.
                waveEndedLabelText := f_waveLetterAt(letterIndex = waveCycleLetterIndex)
                endedPinnedBareLetter := true
        else if waveNextImpulseNumber > 1
            // Retrace-side cycle completed inside the open zone.
            waveZoneRetraceCount := waveZoneRetraceCount + 1
            bool zoneIsComplex = waveZoneRetraceCount >= 2
            bool takesOwnership = na(waveZoneBestExtreme) or
                 (waveTrendDir == TrendDir.UP ? endedCycleExtreme < waveZoneBestExtreme : endedCycleExtreme > waveZoneBestExtreme)
            int waveRetraceNumber = waveNextImpulseNumber - 1
            if takesOwnership
                if not na(waveZoneBestExtreme) and waveZoneBestLetterIndex >= 0
                    if waveZoneBestLetterIndex == 0 and not waveZoneOwnerAConfirmed
                        waveEndedOwnerDelete := true
                    else
                        waveEndedOwnerDowngradeText := f_waveLetterAt(letterIndex = waveZoneBestLetterIndex)
                waveZoneBestExtreme := endedCycleExtreme
                waveZoneBestLetterIndex := waveCycleLetterIndex
                // A new owner's "a" stays hidden (plain number, no stack)
                // until the very next cycle confirms its "b".
                waveZoneOwnerAConfirmed := waveCycleLetterIndex != 0
                waveZoneOwnerAPending := waveCycleLetterIndex == 0
                waveEndedLabelText := f_waveRetraceText(retraceNumber = waveRetraceNumber, letterIndex = waveCycleLetterIndex == 0 ? -1 : waveCycleLetterIndex, zoneIsComplex = zoneIsComplex, isHighSide = waveTrendDir == TrendDir.DOWN)
                waveEndedBecomesOwner := true
            else if zoneIsComplex and waveCycleLetterIndex >= 1
                waveEndedLabelText := f_waveLetterAt(letterIndex = waveCycleLetterIndex)
                endedPinnedBareLetter := true
            else if waveCycleLetterIndex == 0
                // A lone "a" — hold it until the next cycle confirms its "b".
                wavePendingAPrice := endedCycleExtreme
                wavePendingABar := endedCycleExtremeBar
                wavePendingAIsHighSide := cycleStartedLow
    // Seed the new cycle — consume a letter while a zone is open.
    waveCycleLetterIndex := -1
    if waveTrendDir != TrendDir.FLAT and waveNextImpulseNumber > 1
        waveCycleLetterIndex := waveZoneNextLetterIndex
        waveZoneNextLetterIndex := waveZoneNextLetterIndex + 1
    // Resolve held "a"s from the previous boundary: only a plain-letter pin by
    // the very next cycle (its "b") confirms them — a failed wave, confirmed
    // impulse, or trend reset drops them for good.
    if hadPendingA
        if endedPinnedBareLetter
            wavePendingAReleasePrice := wavePendingAPrice
            wavePendingAReleaseBar := wavePendingABar
            wavePendingAReleaseIsHighSide := wavePendingAIsHighSide
        wavePendingAPrice := na
        wavePendingABar := na
    if hadOwnerAPending
        waveZoneOwnerAConfirmed := endedPinnedBareLetter
        waveZoneOwnerAPending := false
    waveCycleSawFlat := false  // the flat break was consumed with the ended cycle
    waveCycleSawOpposite := false  // and so was the direction break

// ── Live trend, sampled where the boundary will sample it: the open cycle's
// own extreme bar. When that reading differs from the count's trend, the
// boundary is going to reset — so the live layer previews the reset (count
// restarts at 1; the old count's SHOWN label freezes at its extreme via the
// confirmed-tick handoff, an unshown preview drops; pinned owners never
// change). Preview only; the boundary owns all state, and the preview
// reverts if a new extreme bar reads the old trend again.
TrendDir waveLiveTrendDir = na(cycleExtreme) ? waveTrendDir : cycleExtremeTrendDir
bool waveLiveFlatBroke = waveCycleSawFlat and waveTrendDir != TrendDir.FLAT
// Direction-break preview — mirrors the boundary's agreement rule with the
// CURRENT trend reading standing in for the boundary bar: the label only
// previews while the extreme bar's reading matches it, so a wave can never
// preview into the other side's standing trend — a lone opposite-slope
// extreme bar, or a new-trend extreme while the MA has already flipped back,
// previews nothing (FLAT = empty live text; anything already SHOWN freezes
// via the handoff instead). A mid-cycle break with full agreement on the
// old trend previews the same-direction rebirth (wave 1).
bool waveLivePreviewsRebirth = waveCycleSawOpposite and not waveLiveFlatBroke and waveTrendDir != TrendDir.FLAT and
     waveLiveTrendDir == waveTrendDir and waveReadDir == waveTrendDir and not na(cycleExtreme)
if waveLiveTrendDir != TrendDir.FLAT and waveReadDir != TrendDir.FLAT and waveLiveTrendDir != waveReadDir
    waveLiveTrendDir := TrendDir.FLAT
// Flat-break preview — mirrors the boundary: an extreme from before the
// flat reads FLAT (empty live text — its label drops), one after it
// previews the re-anchor.
if waveLiveFlatBroke and not na(cycleExtremeBar) and cycleExtremeBar <= waveLastFlatBar
    waveLiveTrendDir := TrendDir.FLAT
bool waveLivePreviewsReset = cycleZone != 0 and (waveLiveTrendDir != waveTrendDir or waveLiveFlatBroke or waveLivePreviewsRebirth)

// ── %K-turn display gate (TICK-TIME since 2026-07-28, replacing the
// 2026-07-25 close gate at Henry's ask — the close gate read as a one-bar
// delay: the show only landed on a bar's confirming tick, so visually the
// label appeared as the NEXT bar formed. Same rework macd-waves got
// 2026-07-27.) ONE gate feeds display, hold, freeze, and the classification
// block alike, so every live label type — number, F, and letter — first
// shows through the identical check:
//   SHOW   — as soon as ANY tick has %K angling AGAINST the open cycle's
//            side (forming %K vs the last committed close; falling in a
//            high half-cycle, rising in a low one). No bar-close
//            confirmation — the show lands mid-bar and STICKS (varip
//            survives Pine's rollback). Accepted trade-off, back with the
//            tick-time show: an intrabar-only turn that fades before the
//            close keeps its label but may not reproduce on a reload
//            (history has closes only). Provisional %D-crossing ticks
//            never latch (cycleStartedThisBar guard) — the turn must
//            belong to the standing window.
//   HOLD   — once shown, shown for the rest of the half-cycle: post-show
//            per-tick tracking is unchanged, the label keeps morphing live
//            into the pin, and a later un-turn can't hide it. Reset on the
//            boundary's confirmed tick, where cycleZone has already
//            flipped — a boundary close whose %K already angles against
//            the NEW cycle re-opens the gate on the spot — and by the
//            RE-ARM below, the one non-boundary close.
//   RE-ARM — (Henry 2026-07-27) a count reset confirming MID-half-cycle
//            (trend shift, rebirth, flat re-anchor) spends the shown turn:
//            on the reset preview's first confirmed close, if the old
//            count's gate was already open and %K has rotated back WITH
//            the cycle, the gate closes again — the newborn count's wave 1
//            must earn its own %K turn (any later tick now qualifies)
//            instead of inheriting the turn the ended count consumed. The
//            old count's shown label is untouched: the shared-half-cycle
//            handoff freezes it from the hold snapshot on this same tick.
//            A shift close where %K still angles against the cycle keeps
//            the gate open — that turn is standing, so wave 1 may show on
//            that very close. Edge-only: a later un-turn inside the
//            standing preview never re-closes the gate (HOLD wins). If the
//            reset preview reverts (a new extreme bar reads the old trend
//            again), the re-arm is undone — the resumed old count already
//            earned its show, and leaving the gate shut would hide a
//            plotted label.
// The re-arm bookkeeping stays on confirmed ticks (var); the SHOW is the
// one varip write. Historical bars only ever execute their close, so a
// replay reproduces the old close-gate timing exactly — the earliness
// exists only in realtime.
varip bool cycleKTurnShown = false
var bool cycleKTurnRearmedByShift = false     // the reset preview re-closed an already-earned gate (undone on revert)
var bool waveResetPreviewAtLastClose = false  // waveLivePreviewsReset at the previous confirmed close — the shift edge detector
bool cycleKTickAgainstCycle = cycleZone == 1 ? cycleK < cycleK[1] : cycleZone == -1 ? cycleK > cycleK[1] : false
if barstate.isconfirmed
    if cycleStartedThisBar
        cycleKTurnShown := false
        cycleKTurnRearmedByShift := false
    if waveLivePreviewsReset and not waveResetPreviewAtLastClose and cycleKTurnShown and not cycleKTickAgainstCycle
        cycleKTurnShown := false
        cycleKTurnRearmedByShift := true
    if not waveLivePreviewsReset and cycleKTurnRearmedByShift
        cycleKTurnShown := true
        cycleKTurnRearmedByShift := false
    if cycleKTickAgainstCycle
        cycleKTurnShown := true
        cycleKTurnRearmedByShift := false
    waveResetPreviewAtLastClose := waveLivePreviewsReset
else if not cycleStartedThisBar and cycleKTickAgainstCycle
    cycleKTurnShown := true

// ── Live qualification + classification of the open half-cycle, judged on
// the current extreme bar and re-evaluated as the extreme moves. The open
// may equal the last confirmed wave extreme; the close must clear it,
// whatever the bar's color ("a green bar closing equal to the low of wave
// one is not a wave three"). An extreme beyond the baseline without the
// body = failed. A failed wave upgrades to its full number in place if a
// deeper extreme bar commits the body — and downgrades back if a wick-only
// bar takes the extreme. The whole block is gated on the %K turn gate:
// before a shown turn no consumer can display the result, so the string
// building and comparisons skip (the hold, the draw gate, and the pendingA
// preview all require the gate too).
bool waveCycleIsImpulseSide = cycleZone != 0 and waveLiveTrendDir != TrendDir.FLAT and (waveLiveTrendDir == TrendDir.UP) == (cycleZone == 1)
string waveLiveLabelText = ""
bool waveLiveShowsLetter = false  // the live label is the cycle's bare letter
bool waveLiveTakesOwnerNumber = false  // the live retrace is provisionally taking an EXISTING owner's number
if cycleZone != 0 and waveLiveTrendDir != TrendDir.FLAT and cycleKTurnShown
    int waveLiveImpulseNumber = waveLivePreviewsReset ? 1 : waveNextImpulseNumber
    if waveCycleIsImpulseSide
        // Wave-1 gate, mirrored from the boundary: a "1" only previews while
        // the current extreme bar's close sits on the trend side of the MA on
        // its own bar (equal fails). Wick/body qualification only stands
        // while the count's own trend does (a reset preview forces number 1,
        // whose gate ignores them). The letter branch carries the same
        // number guard as the boundary so a previewed reset never shows the
        // dead zone's letter on a failing wave-1 attempt.
        [waveLiveWickBeyondRaw, waveLiveBodyCommitsRaw, waveLiveWave1Qualifies] = f_qualifyImpulse(qualifyDir = waveLiveTrendDir,
             extremePrice = cycleExtreme, extremeOpen = cycleExtremeOpen, extremeClose = cycleExtremeClose,
             extremeSma = cycleExtremeSma, baselineExtreme = waveLastImpulseExtreme)
        bool waveLiveQualifyStands = not waveLivePreviewsReset and not na(cycleExtreme)
        bool waveLiveWickBeyond = waveLiveQualifyStands and waveLiveWickBeyondRaw
        bool waveLiveBodyCommits = waveLiveQualifyStands and waveLiveBodyCommitsRaw
        if waveLiveImpulseNumber == 1 ? waveLiveWave1Qualifies : waveLiveBodyCommits
            waveLiveLabelText := str.tostring(value = waveLiveImpulseNumber)
        else if waveLiveWickBeyond
            waveLiveLabelText := "F" + str.tostring(value = waveLiveImpulseNumber)
        else if waveLiveImpulseNumber > 1 and waveCycleLetterIndex >= 0
            waveLiveLabelText := f_waveLetterAt(letterIndex = waveCycleLetterIndex)
            waveLiveShowsLetter := true
    else if not waveLivePreviewsReset and waveNextImpulseNumber > 1
        bool liveTakesOwnership = na(waveZoneBestExtreme) or
             (waveTrendDir == TrendDir.UP ? cycleExtreme < waveZoneBestExtreme : cycleExtreme > waveZoneBestExtreme)
        // Exported for the hold/freeze below: this preview is claiming a
        // number a pinned owner label currently displays — if a trend shift
        // freezes the preview, that owner's duplicate number must go.
        waveLiveTakesOwnerNumber := liveTakesOwnership and not na(waveZoneBestExtreme)
        bool zoneIsComplexLive = waveZoneRetraceCount + 1 >= 2  // the live retrace counts toward complexity
        if liveTakesOwnership
            // A live "a" can never be confirmed yet — preview the plain number.
            waveLiveLabelText := f_waveRetraceText(retraceNumber = waveNextImpulseNumber - 1, letterIndex = waveCycleLetterIndex == 0 ? -1 : waveCycleLetterIndex, zoneIsComplex = zoneIsComplexLive, isHighSide = waveTrendDir == TrendDir.DOWN)
        else if zoneIsComplexLive and waveCycleLetterIndex >= 1
            waveLiveLabelText := f_waveLetterAt(letterIndex = waveCycleLetterIndex)
            waveLiveShowsLetter := true

// ── Authoritative owner text, recomputed every TICK (2026-07-28, was
// confirm-gated): while a live retrace is provisionally deeper than the
// owner, the owner previews its letter; it reverts to its number (stacked
// when complex) otherwise. Per-tick because the deeper retrace's number
// preview is tick-time now — the owner's downgrade must travel on the SAME
// tick, or both labels read the even number for the rest of the bar
// (duplicated-2 bug, Henry 2026-07-28). Unconfirmed boundary ticks still
// change nothing (application-side guard, like every render path).
string waveOwnerText = ""
bool waveOwnerHasZone = not na(waveZoneBestExtreme)
if waveOwnerHasZone and (barstate.isconfirmed or not cycleStartedThisBar)
    // The owner's letter only displays once confirmed — an "a" without its
    // "b" keeps the plain number (or an empty preview while a live retrace
    // is provisionally deeper). A trend-reset preview changes NOTHING here
    // (shared half-cycle rule): the pinned owner keeps its number/stack.
    bool ownerLetterShowable = waveZoneBestLetterIndex >= 1 or (waveZoneBestLetterIndex == 0 and waveZoneOwnerAConfirmed)
    // Gate-qualified: the owner only reacts to a live retrace that is
    // actually SHOWING (the %K turn gate opened). Before the gate opens the
    // deeper retrace's own number preview is suppressed, so blanking or
    // downgrading the owner then would leave its number vanished with
    // nothing previewing in its place — every live-driven label mutation
    // goes through the one display gate (Henry 2026-07-25).
    bool liveIsRetraceSide = cycleZone != 0 and cycleKTurnShown and waveTrendDir != TrendDir.FLAT and not waveCycleIsImpulseSide and waveNextImpulseNumber > 1
    bool liveIsDeeper = liveIsRetraceSide and not waveLivePreviewsReset and (waveTrendDir == TrendDir.UP ? cycleExtreme < waveZoneBestExtreme : cycleExtreme > waveZoneBestExtreme)
    // The live retrace only counts toward complexity while the count's own
    // trend stands — a reset preview must not freeze the owner with a stack
    // earned from a cycle the shift invalidated (review fix 2026-07-16).
    bool zoneIsComplexNow = waveZoneRetraceCount + (liveIsRetraceSide and not waveLivePreviewsReset ? 1 : 0) >= 2
    if liveIsDeeper
        waveOwnerText := zoneIsComplexNow and ownerLetterShowable ? f_waveLetterAt(letterIndex = waveZoneBestLetterIndex) : ""
    else
        waveOwnerText := f_waveRetraceText(retraceNumber = waveNextImpulseNumber - 1, letterIndex = ownerLetterShowable ? waveZoneBestLetterIndex : -1, zoneIsComplex = zoneIsComplexNow, isHighSide = waveTrendDir == TrendDir.DOWN)

color waveLabelColor = waveTrendDir == TrendDir.DOWN ? waveDownColor : waveUpColor
color waveLiveLabelColor = waveLiveTrendDir == TrendDir.DOWN ? waveDownColor : waveUpColor

// ═════════════════════════════════════════════════════════════════════════════
// 📊 PLOT
// Render layer — the SMA plot plus all label drawing. Series, state, texts,
// and ownership flags are computed in their owning sections above.
// ═════════════════════════════════════════════════════════════════════════════
plot(series = trendSma, title = "SMA", color = trendColor, linewidth = 3, offset = trendSmaOffset)

// Helper function to create a wave text label on first use or update it afterwards.
// High-side labels sit above the extreme, low-side labels below it.
f_upsertWaveLabel(label existingLabel, int labelBarIndex, float labelPrice, string labelText, color labelTextColor, bool isHighSide) =>
    label updatedLabel = existingLabel
    if na(updatedLabel)
        updatedLabel := label.new(x = labelBarIndex, y = labelPrice, text = labelText, xloc = xloc.bar_index, yloc = yloc.price,
             style = isHighSide ? label.style_label_down : label.style_label_up,
             color = color.new(color = color.gray, transp = 100), textcolor = labelTextColor, size = waveLabelSize)
    else
        label.set_xy(id = updatedLabel, x = labelBarIndex, y = labelPrice)
        label.set_text(id = updatedLabel, text = labelText)
        label.set_textcolor(id = updatedLabel, textcolor = labelTextColor)
    updatedLabel

// Wave label — live once the tick-time %K-turn gate opens, pinned on the %D cross
// (frozen in place instead when a trend shift cut its count — shared
// half-cycle rule). The retrace-number owner's label ref is kept so a
// DEEPER RETRACE can downgrade it to its letter mid-zone; a trend reset
// leaves it exactly as pinned. The authoritative owner text is re-applied
// every confirmed bar (provisional-retrace repaint semantics; impulse pins
// are final).
var label waveNumberLabel = na
var label waveZoneOwnerLabel = na
var label wavePendingALabel = na  // the held "a", drawn provisionally while the live "b" shows
// Spare label — one blank label kept in reserve (minted only on confirmed
// ticks, honoring the lifecycle invariant) so a trend shift can preview the
// NEWBORN count intrabar while the old count's label stays put: the shift
// tick can't label.new, and morphing the one live object into the newborn
// "1" is exactly the old-wave-2-vanishes flick Henry killed 2026-07-28. Its
// intrabar set_*s roll back every tick and it is never written on confirmed
// ticks, so its committed state is always blank — invisible until a shift
// preview borrows it, adopted as the newborn count's live object at the
// handoff (zero-pixel morph), then re-minted fresh.
var label waveSpareLabel = na
// Display gate — the tick-time %K-turn gate (computed in the WAVES section,
// where the classification consumes it too): show as soon as any tick has
// %K turned against the open cycle, keep showing until the pin, the
// identity's own confirmed reject, or the mid-cycle count reset's RE-ARM
// (gate block); identity stays LIVE while shown (text/price/
// anchor morph with the cycle state into the pin). Unconfirmed BOUNDARY
// ticks freeze everything.

// SHARED HALF-CYCLE RULE (Henry 2026-07-16, final form): labels never cross
// trends, but the SHIFT half-cycle may host BOTH counts. When a trend shift
// starts mid-half-cycle, the old trend's shown label FREEZES exactly where
// it stood — its extreme bar, its identity, its color — as a permanent
// label, and the new count starts in the same half-cycle (wave-1 preview
// live, boundary pin via the wave-1 exemption). The hold below snapshots
// the shown identity while the count's own trend still stands; the freeze
// itself happens in the confirmed-tick block (label handoff — no intrabar
// creation, per the lifecycle invariant). Labels pinned on earlier,
// completed half-cycles are never touched by any of this.
// COUNT-OVER-LETTER precedence (Henry 2026-07-27): both counts share the
// ONE cycle extreme, so until price prints a new extreme the newborn
// count's wave 1 anchors on the very bar where the old count's bare
// letter froze. A number and a letter never share a bar — the count wins:
// the frozen letter hides while a count label (number or F) occupies its
// bar, and returns the moment a new extreme migrates the count's anchor
// off it (yield blocks below and in the boundary branch). Frozen numbers,
// F pins, and owner stacks are count labels themselves and never yield.
// varip since 2026-07-28: the gate shows tick-time now, so the hold must
// travel WITH the show — a var hold rolls back each tick, and a trend shift
// right after an intrabar-only first show would freeze an empty snapshot
// and drop the visible label (the exact disappearing-label bug the
// 2026-07-16 hardening fixed on the old latch). Trade-off, accepted with
// the tick-time gate: a shift confirming while the extreme's tick rolled
// back freezes the label where it was last SHOWN, which may not be the
// committed extreme — what is shown must persist. Intrabar, an EMPTY live
// text never overwrites the hold (a momentary disqualification tick keeps
// the last shown state — anti-flick); a confirmed empty text still lands
// (the identity's own reject, unchanged canon).
varip string waveLiveHeldText = ""
varip float waveLiveHeldPrice = na
varip int waveLiveHeldBar = na
varip color waveLiveHeldColor = na
varip bool waveLiveHeldIsLetter = false
varip bool waveLiveHeldTakesOwner = false       // the held preview was claiming a pinned owner's number
varip string waveOwnerDowngradeSnapshot = ""    // the owner text standing while it was claimed (letter or blank)
var label waveHeldFrozenLabel = na
// A frozen deeper-retrace preview KEEPS the owner's number spent (Henry
// 2026-07-28, duplicated-2 fix): while this flag stands, the owner label
// renders the downgrade snapshot instead of the live owner text — without
// it, the reset preview turns liveIsDeeper off on the very tick the "2"
// preview freezes, and the owner's "2" comes back next to the frozen one.
// Cleared when the frozen label reverts (owner recomputes live) and at the
// boundary (the ref drops with the downgrade standing).
var bool waveFrozenTookOwnerNumber = false
// The na(waveHeldFrozenLabel) guard: while a frozen label exists, the hold
// IS its snapshot — an intrabar revert tick (preview momentarily off, the
// confirmed delete still pending) must not overwrite it, or a re-engaged
// preview would re-stamp the frozen label from corrupted values.
if cycleZone != 0 and cycleKTurnShown and not waveLivePreviewsReset and not cycleStartedThisBar and
     na(waveHeldFrozenLabel) and (waveLiveLabelText != "" or barstate.isconfirmed)
    waveLiveHeldText := waveLiveLabelText
    waveLiveHeldPrice := cycleExtreme
    waveLiveHeldBar := cycleExtremeBar
    waveLiveHeldColor := waveLiveLabelColor
    waveLiveHeldIsLetter := waveLiveShowsLetter
    waveLiveHeldTakesOwner := waveLiveTakesOwnerNumber
    if waveLiveTakesOwnerNumber
        waveOwnerDowngradeSnapshot := waveOwnerText
// Render state — the live label never blanks INTRABAR: a momentary
// disqualification tick (the provisional extreme breathing across a
// baseline flips the classification empty for a tick) keeps rendering the
// last shown state instead of flashing blank↔shown. A REAL reject still
// hides at the close, where the hold snapshots the empty text. Reset
// previews are exempt — the split path below owns the old label then.
string waveLiveRenderText = waveLiveLabelText
bool waveLiveRenderIsLetter = waveLiveShowsLetter
if waveLiveRenderText == "" and not barstate.isconfirmed and not waveLivePreviewsReset and waveLiveHeldText != ""
    waveLiveRenderText := waveLiveHeldText
    waveLiveRenderIsLetter := waveLiveHeldIsLetter
bool waveLiveLabelDrawn = not na(cycleExtreme) and cycleKTurnShown and waveLiveRenderText != "" and
     (barstate.isconfirmed or not cycleStartedThisBar)
// Close-only gate for the STRUCTURAL label work — pins, boundary owner
// downgrades, freezes, and every create/delete: an intrabar %D cross can
// recede before the close, so these mutations wait for the bar's confirming
// tick, where the extreme tracking and boundary state above have already
// seen the bar's final values. (The pendingA preview and the owner
// application are per-tick set_text blocks below since 2026-07-28.) Wave
// STATE is untouched — it still updates every tick and rolls back.
if barstate.isconfirmed
    if cycleStartedThisBar
        if waveEndedOwnerDelete and not na(waveZoneOwnerLabel)
            label.delete(id = waveZoneOwnerLabel)  // an owner "a" that never earned its "b"
            waveZoneOwnerLabel := na
        if waveEndedOwnerDowngradeText != "" and not na(waveZoneOwnerLabel)
            label.set_text(id = waveZoneOwnerLabel, text = waveEndedOwnerDowngradeText)
        // Same-bar shift + boundary: the trend flipped on the boundary bar
        // itself, so the mid-cycle freeze (confirmed non-boundary ticks
        // below) never ran — freeze the old trend's label from the hold
        // snapshot NOW, before the pin path reuses or deletes the object.
        if waveEndedCountReset and waveLiveHeldText != "" and not na(waveLiveHeldBar) and na(waveHeldFrozenLabel) and not na(waveNumberLabel)
            waveHeldFrozenLabel := f_freezeHeldLabel(liveLabel = waveNumberLabel, frozenBar = waveLiveHeldBar,
                 frozenPrice = waveLiveHeldPrice, frozenText = waveLiveHeldText, frozenColor = waveLiveHeldColor)
            waveNumberLabel := na  // the pin path builds fresh if it pins
            // The frozen preview was claiming the owner's number — commit the
            // owner's downgrade NOW (per-tick applications rolled back, the
            // apply block skips once the zone state resets below): the frozen
            // label IS the valid even wave, the old owner must not keep a
            // duplicate (Henry 2026-07-28).
            if waveLiveHeldTakesOwner and not na(waveZoneOwnerLabel)
                label.set_text(id = waveZoneOwnerLabel, text = waveOwnerDowngradeSnapshot)
            if not na(wavePendingALabel) and waveLiveHeldIsLetter
                // Frozen "b" keeps its previewed "a" (pair persists) — commit
                // the per-tick preview text before orphaning the ref. A held
                // pendingA whose "b" did NOT freeze falls through to the drop
                // path below instead.
                label.set_text(id = wavePendingALabel, text = "a")
                wavePendingALabel := na
        if waveEndedLabelText != ""
            waveNumberLabel := f_upsertWaveLabel(existingLabel = waveNumberLabel, labelBarIndex = endedCycleExtremeBar,
                 labelPrice = endedCycleExtreme, labelText = waveEndedLabelText, labelTextColor = waveLabelColor, isHighSide = cycleStartedLow)
            if waveEndedBecomesOwner
                waveZoneOwnerLabel := waveNumberLabel
        else if not na(waveNumberLabel)
            // The ended cycle earned no pin: its own qualification failed,
            // or the count reset and the new count's wave 1 did not
            // qualify — the live object's remaining preview drops (the old
            // trend's label, if any, is already frozen above).
            label.delete(id = waveNumberLabel)
        // Fresh, hidden label for the new half-cycle, created HERE on the
        // boundary's CONFIRMED tick — see the live-upsert comment below for
        // why intrabar label.new is forbidden (GC at the label cap eats
        // committed pins; 2026-07-15 fix).
        waveNumberLabel := label.new(x = bar_index, y = cycleStartedHigh ? high : low, text = "", xloc = xloc.bar_index, yloc = yloc.price,
             style = cycleStartedHigh ? label.style_label_down : label.style_label_up,
             color = color.new(color = color.gray, transp = 100), textcolor = waveLiveLabelColor, size = waveLabelSize)
        if na(waveSpareLabel)
            // Keep the shift-preview spare stocked (confirmed tick — the
            // only place a label may be born).
            waveSpareLabel := label.new(x = bar_index, y = cycleStartedHigh ? high : low, text = "", xloc = xloc.bar_index, yloc = yloc.price,
                 style = cycleStartedHigh ? label.style_label_down : label.style_label_up,
                 color = color.new(color = color.gray, transp = 100), textcolor = waveLiveLabelColor, size = waveLabelSize)
        if waveOwnerClear
            waveZoneOwnerLabel := na  // zone closed or structure reset — the label stays, the ref is dropped
        // A frozen old-trend label becomes permanent at the boundary; the
        // hold belonged to the ended cycle either way. Count-over-letter
        // precedence settles for good here: if the newborn count's pin just
        // landed on the frozen bare letter's bar, the letter yields
        // permanently; otherwise it is restored — a failed wave-1 attempt
        // (no pin) must not leave the contested bar with nothing at all.
        if not na(waveHeldFrozenLabel) and waveLiveHeldIsLetter
            bool frozenBarPinned = waveEndedLabelText != "" and not na(endedCycleExtremeBar) and
                 endedCycleExtremeBar == waveLiveHeldBar
            label.set_text(id = waveHeldFrozenLabel, text = frozenBarPinned ? "" : waveLiveHeldText)
        waveHeldFrozenLabel := na
        waveLiveHeldText := ""
        waveLiveHeldIsLetter := false
        waveLiveHeldTakesOwner := false
        waveFrozenTookOwnerNumber := false
        if not na(wavePendingAReleasePrice)
            // The held "a" earned its "b" — make its preview permanent (or draw it
            // retroactively if the live "b" never showed). Dropping the ref keeps
            // every later write off it.
            label releasedALabel = f_upsertWaveLabel(existingLabel = wavePendingALabel, labelBarIndex = wavePendingAReleaseBar,
                 labelPrice = wavePendingAReleasePrice, labelText = "a", labelTextColor = waveLabelColor, isHighSide = wavePendingAReleaseIsHighSide)
            wavePendingALabel := na
        else if not na(wavePendingALabel)
            // Dropped — a failed wave, confirmed impulse, or reset killed the
            // held "a" (its per-tick previews rolled back; the object's
            // committed state is at most a blank). Confirmed tick: delete is
            // safe, ref and deletion commit together.
            label.delete(id = wavePendingALabel)
            wavePendingALabel := na
        if not na(wavePendingAPrice)
            // A lone "a" was held at THIS boundary — mint its preview object
            // now, blank (lifecycle invariant: labels are only born on
            // confirmed ticks). The per-tick block below shows it the moment
            // the next cycle's live "b" draws — same tick-time engine as
            // every other live label.
            wavePendingALabel := label.new(x = wavePendingABar, y = wavePendingAPrice, text = "", xloc = xloc.bar_index, yloc = yloc.price,
                 style = wavePendingAIsHighSide ? label.style_label_down : label.style_label_up,
                 color = color.new(color = color.gray, transp = 100), textcolor = waveLabelColor, size = waveLabelSize)
    else
        if waveLivePreviewsReset and waveLiveHeldText != "" and not na(waveLiveHeldBar) and na(waveHeldFrozenLabel) and not na(waveNumberLabel)
            // Trend shift confirmed mid-half-cycle: leave the old trend's
            // label exactly where it stood (Henry 2026-07-16) — the live
            // object becomes the permanent frozen label, restamped from the
            // hold snapshot, and the NEW count's preview in this same
            // half-cycle adopts the SPARE label: the intrabar split below
            // was already previewing the newborn on it, so the handoff is a
            // zero-pixel morph — nothing hides, nothing jumps (Henry
            // 2026-07-28). Confirmed tick only: the handoff, the adoption,
            // and the replacement mint commit together (lifecycle-safe).
            waveHeldFrozenLabel := f_freezeHeldLabel(liveLabel = waveNumberLabel, frozenBar = waveLiveHeldBar,
                 frozenPrice = waveLiveHeldPrice, frozenText = waveLiveHeldText, frozenColor = waveLiveHeldColor)
            if na(waveSpareLabel)
                waveNumberLabel := label.new(x = bar_index, y = waveLiveHeldPrice, text = "", xloc = xloc.bar_index, yloc = yloc.price,
                     style = cycleZone == 1 ? label.style_label_down : label.style_label_up,
                     color = color.new(color = color.gray, transp = 100), textcolor = waveLiveLabelColor, size = waveLabelSize)
            else
                waveNumberLabel := waveSpareLabel
                label.set_style(id = waveNumberLabel, style = cycleZone == 1 ? label.style_label_down : label.style_label_up)
            waveSpareLabel := label.new(x = bar_index, y = waveLiveHeldPrice, text = "", xloc = xloc.bar_index, yloc = yloc.price,
                 style = cycleZone == 1 ? label.style_label_down : label.style_label_up,
                 color = color.new(color = color.gray, transp = 100), textcolor = waveLiveLabelColor, size = waveLabelSize)
            // The frozen preview was claiming the owner's number — spend it:
            // the flag routes the owner's per-tick application onto the
            // downgrade snapshot from this tick on (duplicated-2 fix, Henry
            // 2026-07-28), and the revert path below hands the number back.
            waveFrozenTookOwnerNumber := waveLiveHeldTakesOwner
            if not na(wavePendingALabel)
                if waveLiveHeldIsLetter
                    // The previewed lone-"a" freezes WITH its "b" — the pair
                    // persists together (a frozen bare "b" with its "a"
                    // erased would be exactly the meaningless-lone-letter
                    // state the pendingA machinery exists to prevent).
                    // Commit the per-tick preview text, then orphan the ref
                    // so no later write reaches it; clearing the pending
                    // state keeps the boundary from re-dropping it.
                    label.set_text(id = wavePendingALabel, text = "a")
                else
                    // The held "a" never got its live "b" before the shift —
                    // it dies with the old count. Confirmed tick: safe.
                    label.delete(id = wavePendingALabel)
                wavePendingALabel := na
                wavePendingAPrice := na
                wavePendingABar := na
        else if not waveLivePreviewsReset and not na(waveHeldFrozenLabel)
            // The reset preview reverted (a new extreme bar reads the old
            // trend again) — the old count resumes in the live object, so
            // the frozen copy is reabsorbed and the owner (if its number was
            // spent by the freeze) recomputes live again. Confirmed-tick
            // delete: safe.
            label.delete(id = waveHeldFrozenLabel)
            waveHeldFrozenLabel := na
            waveFrozenTookOwnerNumber := false
// Held-"a" preview — PER TICK since 2026-07-28 (was confirm-gated, which
// made the "a" trail its tick-time "b" by a close — the lag that broke the
// one-engine rule): a lone "a" is meaningless, but the moment the very next
// cycle's live bare-letter "b" is drawing, the "a" has meaning — show it on
// that same tick. Its object was minted blank at the boundary (lifecycle
// invariant), so this is set_text only — shown while the "b" shows, hidden
// via "" otherwise; the real delete stays at the boundary (or the shift
// handoff), where drops commit. Unconfirmed boundary ticks change nothing.
// During a reset preview the live text belongs to the NEWBORN count while
// the "b" keeps displaying through the hold (split/freeze) — the "a" reads
// the HELD letter state then, so the pair never blinks apart mid-shift.
if not na(wavePendingALabel) and not na(wavePendingAPrice) and (barstate.isconfirmed or not cycleStartedThisBar)
    bool wavePendingAPreviewed = waveLivePreviewsReset ? waveLiveHeldIsLetter : waveLiveLabelDrawn and waveLiveRenderIsLetter
    label.set_text(id = wavePendingALabel, text = wavePendingAPreviewed ? "a" : "")
// Owner application — PER TICK since 2026-07-28 (was confirm-gated): the
// deeper retrace's number previews tick-time, so the owner's downgrade (or
// its blank, for an unconfirmed-"a" owner) lands on the same tick — never a
// bar with two even numbers standing. While a trend shift has FROZEN a
// deeper preview, the flag overrides the live text with the downgrade
// snapshot: liveIsDeeper reads false during the reset preview, and the
// owner's number must stay spent as long as the frozen label displays it
// (duplicated-2 fix). set_text only, idempotent, rolls back like every
// intrabar write; confirmed ticks commit it.
if not na(waveZoneOwnerLabel) and waveOwnerHasZone and (barstate.isconfirmed or not cycleStartedThisBar)
    label.set_text(id = waveZoneOwnerLabel, text = waveFrozenTookOwnerNumber ? waveOwnerDowngradeSnapshot : waveOwnerText)

// Live wave label — tick-time, per the display gate above. On the boundary
// bar's confirming tick this runs AFTER the pin block dropped the old ref, so
// the upsert starts a fresh label for the new half-cycle.
// The label object is only ever created or modified on unconfirmed ticks —
// never deleted. An intrabar delete pairs a committed deletion with a
// rolled-back var ref: the ref dangles, and every later write through it —
// including the boundary pin, which reuses this object — lands on a dead
// label and renders nothing (the live label "vanishes" instead of becoming
// permanent). Hiding intrabar is set_text("") instead: the background is
// already fully transparent, so an empty label draws nothing, and the write
// is idempotent — re-applied every tick from committed state. The real
// delete waits for the confirming tick, where drawing and ref commit
// together. Unconfirmed BOUNDARY ticks change nothing at all: the boundary
// state (reseed, classification) is confirm-gated, so those ticks carry a
// half-transitioned view, and rendering (or hiding) from it would flash — the ended cycle's label stays frozen on its
// extreme bar and hands off to the pin at the close, which reuses the same
// object. The live label therefore never leaves the extreme bar across the
// half-cycle's end.
// SHIFT-PREVIEW SPLIT (Henry 2026-07-28): while a reset preview stands
// INTRABAR with a shown old label and the freeze hasn't committed yet, the
// one live object must not morph into the newborn count — that is the
// old-wave-2-vanishes-then-reappears flick. Instead the old label re-pins
// to its hold snapshot every tick (a pre-freeze: the confirmed handoff
// commits these exact values) and the NEWBORN count previews tick-time on
// the spare label at the shared extreme. At the handoff the newborn adopts
// the spare — both labels keep their pixels, realtime morphs straight into
// the permanent state. If the preview reverts mid-bar, the spare's writes
// roll back to its committed blank and the old label resumes below —
// nothing was created or deleted.
bool waveShiftSplitActive = not barstate.isconfirmed and not cycleStartedThisBar and waveLivePreviewsReset and
     na(waveHeldFrozenLabel) and waveLiveHeldText != "" and not na(waveLiveHeldBar) and not na(waveNumberLabel)
if waveShiftSplitActive
    // Count-over-letter, pre-handoff mirror: a held bare letter yields its
    // bar to the newborn count's number while they share the extreme bar.
    bool heldBarContestedLive = waveLiveHeldIsLetter and waveLiveLabelDrawn and not waveLiveRenderIsLetter and
         cycleExtremeBar == waveLiveHeldBar
    label.set_xy(id = waveNumberLabel, x = waveLiveHeldBar, y = waveLiveHeldPrice)
    label.set_text(id = waveNumberLabel, text = heldBarContestedLive ? "" : waveLiveHeldText)
    label.set_textcolor(id = waveNumberLabel, textcolor = waveLiveHeldColor)
    if not na(waveSpareLabel)
        label.set_xy(id = waveSpareLabel, x = cycleExtremeBar, y = cycleExtreme)
        label.set_text(id = waveSpareLabel, text = waveLiveLabelDrawn ? waveLiveRenderText : "")
        label.set_textcolor(id = waveSpareLabel, textcolor = waveLiveLabelColor)
        label.set_style(id = waveSpareLabel, style = cycleZone == 1 ? label.style_label_down : label.style_label_up)
else if waveLiveLabelDrawn
    waveNumberLabel := f_upsertWaveLabel(existingLabel = waveNumberLabel, labelBarIndex = cycleExtremeBar,
         labelPrice = cycleExtreme, labelText = waveLiveRenderText, labelTextColor = waveLiveLabelColor, isHighSide = cycleZone == 1)
else if not na(waveNumberLabel) and not cycleStartedThisBar
    // Gate closed (no %K turn shown yet, or a confirmed empty display text —
    // intrabar empties render the hold instead) — HIDE, never delete: the
    // half-cycle's one label object must live to the boundary so the
    // intrabar ticks above only ever set_* it (a delete-and-recreate cycle
    // is exactly the label.new churn the 2026-07-15 fix removed). The
    // boundary's confirmed tick reuses it for the pin or deletes it, then
    // mints the successor.
    label.set_text(id = waveNumberLabel, text = "")

// COUNT-OVER-LETTER precedence (Henry 2026-07-27): a wave number never
// shares a bar with a letter. While the newborn count's live label (a
// number or F — a reset preview can only show those) anchors on the bar
// where the old count's bare letter froze, the frozen letter hides; the
// moment a new extreme migrates the count's anchor off that bar, the
// letter returns. set_text only, re-applied every tick from committed
// state (idempotent, lifecycle-safe); unconfirmed boundary ticks change
// nothing, like every other render path. On the boundary's confirmed tick
// the ref is already dropped above, where the pin settled the bar for good.
if not na(waveHeldFrozenLabel) and waveLiveHeldIsLetter and (barstate.isconfirmed or not cycleStartedThisBar)
    bool frozenBarContested = waveLiveLabelDrawn and not waveLiveRenderIsLetter and cycleExtremeBar == waveLiveHeldBar
    label.set_text(id = waveHeldFrozenLabel, text = frozenBarContested ? "" : waveLiveHeldText)
