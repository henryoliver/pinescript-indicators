//@version=6
indicator(title = "Cumulative Volume Delta", shorttitle = "⚖️ CVD", format = format.volume, max_lines_count = 500, max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0 = #2E3440
const color NORD1 = #3B4252
const color NORD2 = #434C5E
const color NORD3 = #4C566A
// Snow Storm
const color NORD4 = #D8DEE9
const color NORD5 = #E5E9F0
const color NORD6 = #ECEFF4
// Frost
const color NORD7 = #8FBCBB
const color NORD8 = #88C0D0
const color NORD9 = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// 🧩 TYPE DEFINITIONS
// Custom Pine types used by the indicator.
// ═════════════════════════════════════════════════════════════════════════════
// Line style options and their resolver share one declaration, so they cannot
// drift apart.
enum LineStyleMode
    SOLID  = "Solid"
    DASHED = "Dashed"
    DOTTED = "Dotted"

// One confirmed PRICE swing: the bar it sits on, the price extreme there, and
// the CVD level on that same bar. The divergence engine keeps the last one of
// each kind so the next swing has something to be measured against.
type DivergencePivot
    int bar
    float cvd
    float price

// ═════════════════════════════════════════════════════════════════════════════
// 📊 CUMULATIVE VOLUME DELTA
// Buy-minus-sell volume per bar (the volume footprint delta), accumulated
// inside the anchor period. The absolute value is meaningless; the read is the
// line's SHAPE next to price — agreement (price and flow both make the new
// extreme) or disagreement (price makes it alone).
//
// The forming bar updates tick by tick and settles at its close; closed bars
// are never re-priced.
//
// `cvdValue` is the raw accumulator and runs through every bar; `cvdSeries` is
// the rendered line, na wherever the pane has nothing measured to draw.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_CVD = "⚖️ Cumulative Volume Delta"

// Thin and neutral so the signal MA reads as the primary line.
const color CVD_LINE_COLOR = NORD3

const string TT_CVD_ANCHOR = "⚓ Where the running total restarts.\n• Session (default) — resets at the session's first bar; distance from 0 = the day's net buying/selling\n• Decay — old delta fades; tracks recent flow, oscillates around 0\n• Week / Month — reset at those boundaries\n• Continuous — never resets"
const string TT_CVD_SESSION = "🕐 Which bars feed the total on an extended-hours chart.\n• Include Extended Hours (default) — starts at the first pre-market bar; by 09:30 the line shows pre-market flow\n• Regular Hours Only — starts at 09:30; no line outside regular hours\n• No effect on a regular-hours chart"
const string TT_CVD_ZERO = "➖ Zero line.\n• Session anchor — where the day started; above = net buying since, below = net selling\n• Decay anchor — balance of recent flow\n• Context, not a trigger: new price extremes without a new CVD extreme are the signal\n• Hidden on Continuous"
const string TT_CVD_DECAY = "⏳ Decay anchor only: how fast old delta fades, in bars.\n• Each bar keeps 1 − 2/(N+1) of the total (EMA-style)\n• Default 30 (useful range 21-50)"

cvdAnchorMode = input.string(defval = "Session", title = "Anchor", options = ["Session", "Decay", "Week", "Month", "Continuous"],
     tooltip = TT_CVD_ANCHOR, group = GROUP_CVD)
cvdDecayBars = input.int(defval = 30, title = "Decay Length", minval = 2, maxval = 500,
     tooltip = TT_CVD_DECAY, group = GROUP_CVD, active = cvdAnchorMode == "Decay")
cvdSessionMode = input.string(defval = "Include Extended Hours", title = "Session Data", options = ["Regular Hours Only", "Include Extended Hours"],
     tooltip = TT_CVD_SESSION, group = GROUP_CVD)
cvdShowZeroLine = input.bool(defval = true, title = "Show Zero Line",
     tooltip = TT_CVD_ZERO, group = GROUP_CVD, display = display.none)

bool cvdSessionRegularOnly = cvdSessionMode == "Regular Hours Only"

// Footprint delta — buy minus sell volume on the bar. One footprint call per
// script; only the bar total is read, so a coarse row size keeps the object
// cheap. na where there is no footprint; under Regular Hours Only the whole
// bar is dropped outside the session.
const int CVD_FOOTPRINT_TICKS_PER_ROW = 100
footprint cvdFootprint = request.footprint(ticks_per_row = CVD_FOOTPRINT_TICKS_PER_ROW, va_percent = 70)
float cvdBarDelta = na
if not na(cvdFootprint) and not (cvdSessionRegularOnly and not session.ismarket)
    cvdBarDelta := cvdFootprint.delta()

// The day boundary comes from the session itself, not a requested 1D series:
// on an extended-hours chart the two disagree, and Session Data decides which
// one is meant.
bool cvdAnchorReset = switch cvdAnchorMode
    "Decay"   => cvdSessionRegularOnly ? session.isfirstbar_regular : session.isfirstbar
    "Session" => cvdSessionRegularOnly ? session.isfirstbar_regular : session.isfirstbar
    "Week"    => timeframe.change(timeframe = "1W")
    "Month"   => timeframe.change(timeframe = "1M")
    => false

var int cvdAnchorStartBar = 0
if cvdAnchorReset
    cvdAnchorStartBar := bar_index

// Running total. A realtime tick re-adds only the forming bar's delta, and a
// bar with no delta carries the level forward. The reset is unconditional —
// the first bar of a period is the likeliest to have no footprint, and a
// skipped reset would carry the prior period's level through the new one.
// DECAY keeps 1 − 2/(N+1) of the total each bar before adding the new delta.
float cvdDecayKeep = cvdAnchorMode == "Decay" ? 1.0 - 2.0 / (cvdDecayBars + 1.0) : 1.0
var float cvdValue = na
if cvdAnchorReset
    cvdValue := 0.0
if not na(cvdBarDelta)
    cvdValue := nz(source = cvdValue) * cvdDecayKeep + cvdBarDelta

// A bar is drawn only when it is MEASURED; the accumulator is never gated:
//   · Outside the measured session (Regular Hours Only) the line is blank — a
//     flat overnight stub would claim flow that never happened, and its last
//     bar would confirm as a fake swing against the post-reset values.
//   · Before the period's first measured bar the level would sit at exactly 0
//     and read as a session that opened in balance.
// A mid-session feed gap is neither: the level carries forward unbroken.
var bool cvdAnchorHasData = false
if cvdAnchorReset
    cvdAnchorHasData := false
if not na(cvdBarDelta)
    cvdAnchorHasData := true

bool cvdBarMeasured = cvdAnchorHasData and (not cvdSessionRegularOnly or session.ismarket or not na(cvdBarDelta))

// The series the pane draws and the divergence engine reads.
float cvdSeries = cvdBarMeasured ? cvdValue : na

// Vendor volume guard — delta is meaningless without a volume feed.
var float cvdCumulativeVolume = 0.0
cvdCumulativeVolume += nz(source = volume)
if barstate.islast and cvdCumulativeVolume == 0
    runtime.error(message = "No volume is provided by the data vendor.")

// No runtime.error for a missing footprint: "this symbol has none" and "this
// context (Bar Replay) has none" look identical from inside the script, and an
// error would kill the pane where blank is the right answer.

// ═════════════════════════════════════════════════════════════════════════════
// 🔀 DIVERGENCE
// Swing-to-swing comparison at PRICE's pivots: each confirmed price swing is
// measured against the previous one of its kind, and the CVD is read on those
// same two bars.
//   · Regular bearish — price higher high, CVD lower high: the new high was
//     made on less net buying. Reversal-down read.
//   · Regular bullish — price lower low, CVD higher low: the new low was made
//     on less net selling. Reversal-up read.
//   · Hidden bearish — price lower high, CVD higher high: buyers pushed harder
//     and could not lift price. Down-leg continuation.
//   · Hidden bullish — price higher low, CVD lower low: sellers pushed harder
//     and could not drop price. Up-leg continuation.
// Hidden pairs add nothing over the price swing alone (the same higher low or
// lower high without the CVD condition reads the same), so they are off by
// default and kept as information.
//
// Price must travel at least Min Price Extension × ATR(14) past the prior
// swing — a tick-past "higher high" is noise. Pairs across an anchor reset are
// rejected: the levels either side are on different scales.
//
// A pivot's right-hand window includes the forming bar, so lines and pivot
// state commit on confirmed closes only. A divergence therefore shows
// `Pivot Right Bars` + 1 bars after the swing.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_DIVERGENCE = "🔀 Divergence"

const string TT_DIV_MODE = "🔀 Which divergences to draw.\n• Regular (default) — reversal: price extends past its last swing, flow does not (dotted)\n• Hidden — continuation: price holds its swing while flow overshoots (dashed). No edge over the price swing alone — information only\n• Each one drops an R / H marker — hover it for the readings"
const string TT_DIV_EXT = "📏 How far price must push past the prior swing, in ATR(14).\n• Default 0.75 (useful range 0.5-1.0)\n• 0 = draw every divergence"
const string TT_DIV_PIVOT = "📍 Bars either side of a price swing for it to count.\n• Left = how much structure the swing must clear\n• Right = how long it must hold, and the confirmation lag\n• Default 5 / 5: a 10-min swing on 2-min, 30-min on 6-min"
const string TT_DIV_RANGE = "↔️ Bar distance allowed between the two swings.\n• Below Min — same move\n• Above Max — unrelated structure\n• Default 5-30: 10 min-1 h on 2-min, 30 min-3 h on 6-min"
const string TT_DIV_ANCHOR = "⚓ Ignore swing pairs that straddle an anchor reset.\n• The total restarts at the reset, so levels either side are not comparable\n• No effect on Continuous"
const string TT_DIV_REGULAR_LINE = "〰️ Style and width of REGULAR (reversal) lines.\n• Keep it different from Hidden — style tells the families apart, color tells direction"
const string TT_DIV_HIDDEN_LINE = "〰️ Style and width of HIDDEN (continuation) lines.\n• Keep it different from Regular — style tells the families apart, color tells direction"
const string TT_DIV_BULL = "🟦 Bullish divergence lines and markers — drawn at price swing LOWS."
const string TT_DIV_BEAR = "🟥 Bearish divergence lines and markers — drawn at price swing HIGHS."

divergenceMode = input.string(defval = "Regular", title = "Show", options = ["Off", "Regular", "Hidden", "Both"],
     tooltip = TT_DIV_MODE, group = GROUP_DIVERGENCE)
divergencePivotLeft = input.int(defval = 5, title = "Pivot Bars (Left / Right)", minval = 1, maxval = 50,
     inline = "divergence_pivot", tooltip = TT_DIV_PIVOT, group = GROUP_DIVERGENCE)
divergencePivotRight = input.int(defval = 5, title = "", minval = 1, maxval = 50,
     inline = "divergence_pivot", group = GROUP_DIVERGENCE)
divergenceRangeMin = input.int(defval = 5, title = "Bars Between Pivots (Min / Max)", minval = 1, maxval = 100,
     inline = "divergence_range", tooltip = TT_DIV_RANGE, group = GROUP_DIVERGENCE)
divergenceRangeMax = input.int(defval = 30, title = "", minval = 2, maxval = 500,
     inline = "divergence_range", group = GROUP_DIVERGENCE)
divergenceMinExtensionAtr = input.float(defval = 0.75, title = "Min Price Extension (ATR)", minval = 0.0, maxval = 5.0, step = 0.25,
     tooltip = TT_DIV_EXT, group = GROUP_DIVERGENCE)
divergenceSameAnchorOnly = input.bool(defval = true, title = "Same Anchor Period Only",
     tooltip = TT_DIV_ANCHOR, group = GROUP_DIVERGENCE, display = display.none)
divergenceBullColor = input.color(defval = color.new(color = NORD8, transp = 20), title = "Bullish Color",
     tooltip = TT_DIV_BULL, group = GROUP_DIVERGENCE)
divergenceBearColor = input.color(defval = color.new(color = NORD11, transp = 10), title = "Bearish Color",
     tooltip = TT_DIV_BEAR, group = GROUP_DIVERGENCE)
LineStyleMode divergenceRegularStyle = input.enum(defval = LineStyleMode.DOTTED, title = "Regular Line",
     inline = "divergence_regular", group = GROUP_DIVERGENCE)
int divergenceRegularWidth = input.int(defval = 1, title = "", minval = 1, maxval = 10,
     inline = "divergence_regular", tooltip = TT_DIV_REGULAR_LINE, group = GROUP_DIVERGENCE)
LineStyleMode divergenceHiddenStyle = input.enum(defval = LineStyleMode.DASHED, title = "Hidden Line",
     inline = "divergence_hidden", group = GROUP_DIVERGENCE)
int divergenceHiddenWidth = input.int(defval = 1, title = "", minval = 1, maxval = 10,
     inline = "divergence_hidden", tooltip = TT_DIV_HIDDEN_LINE, group = GROUP_DIVERGENCE)

bool divergenceRegularOn = divergenceMode == "Regular" or divergenceMode == "Both"
bool divergenceHiddenOn = divergenceMode == "Hidden" or divergenceMode == "Both"

// Pivots are taken on PRICE (high for the bearish side, low for the bullish
// side) and evaluated every bar so the built-ins keep a regular history. A
// swing only counts where the pane drew a CVD level.
bool divergenceHighFound = not na(ta.pivothigh(source = high, leftbars = divergencePivotLeft, rightbars = divergencePivotRight)) and not na(cvdSeries[divergencePivotRight])
bool divergenceLowFound = not na(ta.pivotlow(source = low, leftbars = divergencePivotLeft, rightbars = divergencePivotRight)) and not na(cvdSeries[divergencePivotRight])
// ATR as of the pivot bar, for the extension filter. Read unconditionally so
// ta.atr keeps a regular history.
float divergenceAtr = ta.atr(length = 14)
float divergenceAtrAtPivot = divergenceAtr[divergencePivotRight]

// Readings on the pivot bar, `divergencePivotRight` bars back.
int divergencePivotBar = bar_index - divergencePivotRight
float divergenceCvdAtPivot = cvdSeries[divergencePivotRight]
float divergencePriceAtHigh = high[divergencePivotRight]
float divergencePriceAtLow = low[divergencePivotRight]

// The anchor start AS OF THE PIVOT BAR, read here rather than inside
// f_divergencePairValid: the `and` below short-circuits the helper, and a
// history reference inside a sometimes-called function builds an inconsistent
// history buffer.
int divergenceAnchorStartAtPivot = cvdAnchorStartBar[divergencePivotRight]

// The previous swing of each kind, held in state — one object per side, so
// its three fields can never drift apart.
var DivergencePivot divergencePrevHigh = DivergencePivot.new(bar = na, cvd = na, price = na)
var DivergencePivot divergencePrevLow = DivergencePivot.new(bar = na, cvd = na, price = na)

// Helper function reporting whether a swing pair is comparable: a previous
// swing exists, sits within the allowed distance, and belongs to the same
// anchor period as of the pivot bar (not now — the pivot is
// `divergencePivotRight` bars back, so the current anchor start would reject
// valid pairs for that many bars after every reset).
f_divergencePairValid(DivergencePivot prevPivot) =>
    bool hasPrevPivot = not na(prevPivot.bar)
    int pivotGap = hasPrevPivot ? divergencePivotBar - prevPivot.bar : 0
    bool gapInRange = hasPrevPivot and pivotGap >= divergenceRangeMin and pivotGap <= divergenceRangeMax
    gapInRange and (not divergenceSameAnchorOnly or prevPivot.bar >= divergenceAnchorStartAtPivot)

bool divergenceHighValid = divergenceHighFound and f_divergencePairValid(prevPivot = divergencePrevHigh)
bool divergenceLowValid = divergenceLowFound and f_divergencePairValid(prevPivot = divergencePrevLow)

// Extension filter — price must have MOVED past the prior swing, not ticked it.
float divergenceMinMove = divergenceMinExtensionAtr * nz(source = divergenceAtrAtPivot)
bool divergenceRegularBear = divergenceRegularOn and divergenceHighValid and divergencePriceAtHigh - divergencePrevHigh.price >= math.max(divergenceMinMove, syminfo.mintick) and divergenceCvdAtPivot < divergencePrevHigh.cvd
bool divergenceRegularBull = divergenceRegularOn and divergenceLowValid and divergencePrevLow.price - divergencePriceAtLow >= math.max(divergenceMinMove, syminfo.mintick) and divergenceCvdAtPivot > divergencePrevLow.cvd
bool divergenceHiddenBear = divergenceHiddenOn and divergenceHighValid and divergencePrevHigh.price - divergencePriceAtHigh >= math.max(divergenceMinMove, syminfo.mintick) and divergenceCvdAtPivot > divergencePrevHigh.cvd
bool divergenceHiddenBull = divergenceHiddenOn and divergenceLowValid and divergencePriceAtLow - divergencePrevLow.price >= math.max(divergenceMinMove, syminfo.mintick) and divergenceCvdAtPivot < divergencePrevLow.cvd

// Resolves the style enum. f_divergenceDrawLine is its only caller.
f_divergenceLineStyle(LineStyleMode styleMode) =>
    styleMode == LineStyleMode.DASHED ? line.style_dashed : styleMode == LineStyleMode.DOTTED ? line.style_dotted : line.style_solid

// Helper function drawing one divergence line between the two swings' CVD
// levels. Lines are never touched again — `max_lines_count` retires the oldest.
f_divergenceDrawLine(DivergencePivot fromPivot, float toValue, color lineColor, bool isRegular) =>
    line.new(x1 = fromPivot.bar, y1 = fromPivot.cvd, x2 = divergencePivotBar, y2 = toValue, xloc = xloc.bar_index,
         color = lineColor,
         style = f_divergenceLineStyle(styleMode = isRegular ? divergenceRegularStyle : divergenceHiddenStyle),
         width = isRegular ? divergenceRegularWidth : divergenceHiddenWidth)

// Edge per type: price 20 minutes after the divergence confirms (Session
// anchor, swings 5/5, extension 0.75 ATR).
const string DIV_RECORD_REG_BEAR = "📊 Strongest read: +7.9 bps at 20 min · right 73%"
const string DIV_RECORD_REG_BULL = "📊 Slight lean: +2.0 bps at 20 min · right 52%"
const string DIV_RECORD_HID_BULL = "📊 No edge: +3.0 bps at 20 min, −0.1 at 30 min · right 54% — a plain higher low does as well"
const string DIV_RECORD_HID_BEAR = "📊 No edge: +0.6 bps at 20 min · right 46% — information, not a signal"

// Helper function dropping the R / H marker at the newer swing, with its
// meaning, readings and edge in the tooltip.
f_divergenceMarker(float cvdLevel, float priceNow, float pricePrev, float cvdPrev, color markerColor, bool isBullish, bool isRegular) =>
    string kindText = (isBullish ? "🟦 " : "🟥 ") + (isRegular ? "REGULAR " : "HIDDEN ") + (isBullish ? "BULLISH" : "BEARISH")
    string meaning = isRegular ?
         (isBullish ? "Lower low in price, higher low in CVD — less selling behind the new low. Reversal-up read." :
                      "Higher high in price, lower high in CVD — less buying behind the new high. Reversal-down read.") :
         (isBullish ? "Higher low in price, lower low in CVD — sellers pushed harder and could not drop price. Up-leg continuation." :
                      "Lower high in price, higher high in CVD — buyers pushed harder and could not lift price. Down-leg continuation.")
    string record = isRegular ? (isBullish ? DIV_RECORD_REG_BULL : DIV_RECORD_REG_BEAR) : (isBullish ? DIV_RECORD_HID_BULL : DIV_RECORD_HID_BEAR)
    string readings = "• Price " + str.tostring(value = pricePrev, format = format.mintick) + " → " + str.tostring(value = priceNow, format = format.mintick) +
         "\n• CVD " + str.tostring(value = cvdPrev, format = format.volume) + " → " + str.tostring(value = cvdLevel, format = format.volume)
    label.new(x = divergencePivotBar, y = cvdLevel, text = isRegular ? "R" : "H", xloc = xloc.bar_index, yloc = yloc.price,
         style = isBullish ? label.style_label_up : label.style_label_down, color = color.new(color = markerColor, transp = 70),
         textcolor = markerColor, size = size.tiny,
         tooltip = kindText + "\n" + meaning + "\n\n" + readings + "\n\n" + record +
         "\n⏱ Confirmed " + str.tostring(value = divergencePivotRight) + " bars after the swing — confirmation, not an entry.")

// Confirmed closes only — an intrabar pivot can un-happen while its line
// cannot. This bar reads the previous swing, then becomes it.
if barstate.isconfirmed
    if divergenceRegularBear or divergenceHiddenBear
        f_divergenceDrawLine(fromPivot = divergencePrevHigh, toValue = divergenceCvdAtPivot,
             lineColor = divergenceBearColor, isRegular = divergenceRegularBear)
        f_divergenceMarker(cvdLevel = divergenceCvdAtPivot, priceNow = divergencePriceAtHigh, pricePrev = divergencePrevHigh.price,
             cvdPrev = divergencePrevHigh.cvd, markerColor = divergenceBearColor, isBullish = false, isRegular = divergenceRegularBear)
    if divergenceRegularBull or divergenceHiddenBull
        f_divergenceDrawLine(fromPivot = divergencePrevLow, toValue = divergenceCvdAtPivot,
             lineColor = divergenceBullColor, isRegular = divergenceRegularBull)
        f_divergenceMarker(cvdLevel = divergenceCvdAtPivot, priceNow = divergencePriceAtLow, pricePrev = divergencePrevLow.price,
             cvdPrev = divergencePrevLow.cvd, markerColor = divergenceBullColor, isBullish = true, isRegular = divergenceRegularBull)
    if divergenceHighFound
        divergencePrevHigh.bar := divergencePivotBar
        divergencePrevHigh.cvd := divergenceCvdAtPivot
        divergencePrevHigh.price := divergencePriceAtHigh
    if divergenceLowFound
        divergencePrevLow.bar := divergencePivotBar
        divergencePrevLow.cvd := divergenceCvdAtPivot
        divergencePrevLow.price := divergencePriceAtLow

// ═════════════════════════════════════════════════════════════════════════════
// 〰️ SIGNAL MA
// A moving average OF the CVD line. Above it = buying pressure building,
// below = selling. Context, not a trigger — the reversal read is the
// divergences. Auto length spans 30 minutes; past about an hour the average
// lags into the previous swing and the read turns backwards.
//
// Calculation timeframe: indicator(timeframe=) is unavailable to a script that
// draws, so a higher timeframe is built by hand. A running total's value at a
// higher-timeframe close IS that bar's value, so the CVD is SAMPLED at each
// HTF close and the MA runs over a rolling window of those samples — its
// length counts HTF bars.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_SIGNAL = "〰️ Signal MA"
const string GROUP_CALC = "🧮 Calculation"
const float  SIGNAL_AUTO_MINUTES = 30.0
const int    SIGNAL_AUTO_FLOOR_BARS = 3
const int    SIGNAL_AUTO_FALLBACK_BARS = 20
const int    SIGNAL_AUTO_MAX_BARS = 1000

// Signal-line slope colors — one blue family, so up/down read as one line
// while the shade still shows its lean.
const color SIGNAL_UP_COLOR = color.new(color = NORD8, transp = 20)
const color SIGNAL_DOWN_COLOR = color.new(color = NORD9, transp = 60)

// Fill colors between the CVD and its signal MA — the signal pair at 10% /
// 5% opacity, so both lines stay readable on top.
const color FILL_UP_COLOR = color.new(color = NORD8, transp = 90)
const color FILL_DOWN_COLOR = color.new(color = NORD9, transp = 95)

signalMaType = input.string(defval = "SMA", title = "Type", options = ["SMA", "EMA"],
     tooltip = "〰️ Moving average of the CVD line.\n• Bright = rising, dim = falling\n• CVD above it = buying building, below = selling\n• Default SMA", group = GROUP_SIGNAL, display = display.none)
signalAutoLength = input.bool(defval = true, title = "Auto", inline = "signal_length", group = GROUP_SIGNAL, display = display.none)
signalMaLength = input.int(defval = 15, title = "Length", minval = 1, maxval = 1000, inline = "signal_length",
     tooltip = "🔢 MA lookback, in bars of the Calculation timeframe.\n• Auto (default): 30 minutes — 15 bars on 2-min, 5 on 6-min, 20 on daily\n• Untick Auto to use Length in bars\n• Past ~1 hour the read turns backwards\n• Restarts at every anchor reset", group = GROUP_SIGNAL, display = display.none, active = not signalAutoLength)

calcTimeframe = input.timeframe(defval = "", title = "Timeframe",
     tooltip = "🧮 Timeframe the CVD and its MA are shown on.\n• Chart (default) — follows the chart\n• Higher — line steps at each higher-timeframe close; MA counts those bars\n• Divergences stay on the chart's own swings", group = GROUP_CALC)
calcWaitForClose = input.bool(defval = false, title = "Wait for timeframe closes",
     tooltip = "⏱ Higher timeframe only.\n• On — values only at each close, gaps between\n• Off (default) — CVD stays live, MA holds its last close", group = GROUP_CALC)

// A higher timeframe only when it really is higher. The last chart bar inside
// each HTF bar is its close.
bool calcUsesHtf = calcTimeframe != "" and timeframe.in_seconds(timeframe = calcTimeframe) > timeframe.in_seconds()
bool calcHtfClosing = not calcUsesHtf or time_close == time_close(timeframe = calcTimeframe)

// Helper function — the Auto length: `minutes` in bars of `barSeconds`,
// clamped to SIGNAL_AUTO_FLOOR_BARS..SIGNAL_AUTO_MAX_BARS. A bar of a day or
// longer falls back to SIGNAL_AUTO_FALLBACK_BARS, where minutes mean nothing.
// `barSeconds` is the Calculation timeframe's bar.
f_signalAutoBars(float minutes, int barSeconds) =>
    barSeconds >= 86400 ? SIGNAL_AUTO_FALLBACK_BARS :
         math.min(SIGNAL_AUTO_MAX_BARS, math.max(SIGNAL_AUTO_FLOOR_BARS, math.round(number = minutes * 60.0 / barSeconds)))

int signalLength = signalAutoLength ? f_signalAutoBars(minutes = SIGNAL_AUTO_MINUTES,
     barSeconds = calcUsesHtf ? timeframe.in_seconds(timeframe = calcTimeframe) : timeframe.in_seconds()) : signalMaLength

// Rolling window of samples, one per Calculation-timeframe bar, instead of
// ta.* built-ins (those must run every bar and would count chart bars). The
// SMA needs a full window; the EMA seeds from that SMA and then recurses. On
// the chart timeframe every bar is a sample, so both match the built-ins.
var array<float> signalSamples = array.new<float>()
var float signalEma = na
var float signalLineSample = na
var float signalMa = na
// The window restarts with the anchor: the CVD jumps back to zero at a reset,
// so an average still holding the prior period would sit far from the line
// and paint every open as a cross. Blank for the first Length samples.
if cvdAnchorReset
    array.clear(id = signalSamples)
    signalEma := na
    signalLineSample := na
    signalMa := na
if calcHtfClosing and not na(cvdSeries)
    signalLineSample := cvdSeries
    array.push(id = signalSamples, value = cvdSeries)
    if array.size(id = signalSamples) > signalLength
        array.shift(id = signalSamples)
    float signalSma = array.size(id = signalSamples) == signalLength ? array.avg(id = signalSamples) : na
    signalEma := na(signalEma) ? signalSma : signalEma + 2.0 / (signalLength + 1.0) * (cvdSeries - signalEma)
    signalMa := signalMaType == "EMA" ? signalEma : signalSma

// MA slope drives the color; hold the last direction on flat bars so it doesn't
// flicker.
var bool signalRising = true
signalRising := signalMa > signalMa[1] ? true : signalMa < signalMa[1] ? false : signalRising
color signalColor = signalRising ? SIGNAL_UP_COLOR : SIGNAL_DOWN_COLOR

// Plot series. Chart timeframe: the line and its MA wherever the line draws.
// Higher timeframe: wait-for-close shows both only on HTF closes; otherwise
// the line stays live and the MA holds its last close.
bool calcGapNow = calcUsesHtf and calcWaitForClose and not calcHtfClosing
float cvdPlotValue = calcGapNow ? na : calcUsesHtf and calcWaitForClose ? signalLineSample : cvdSeries
float signalPlotValue = calcGapNow or na(cvdSeries) and not calcUsesHtf ? na : signalMa

// Fill between the CVD and its signal MA: up color while the CVD is at or
// above the MA, down color below it.
color signalFillColor = cvdPlotValue >= signalPlotValue ? FILL_UP_COLOR : FILL_DOWN_COLOR

// ═════════════════════════════════════════════════════════════════════════════
// 🎨 PLOTS
// Final plot, hline and fill statements only — every series and color is
// computed in its owning section above.
// ═════════════════════════════════════════════════════════════════════════════
hline(price = 0, title = "Zero Line", color = NORD3, linewidth = 1, linestyle = hline.style_dashed,
     display = cvdShowZeroLine and cvdAnchorMode != "Continuous" ? display.all : display.none)
cvdPlot = plot(series = cvdPlotValue, title = "CVD", color = CVD_LINE_COLOR, linewidth = 1)
// A fill must follow the plots it joins, and the Style tab lists entries in
// declaration order. The MA is therefore plotted twice: a hidden, non-editable
// edge for the fill, then the visible line — which lists the fill above it.
signalFillEdge = plot(series = signalPlotValue, title = "Signal MA Fill Edge", color = na, editable = false, display = display.none)
fill(plot1 = cvdPlot, plot2 = signalFillEdge, color = signalFillColor, title = "CVD / Signal Fill")
plot(series = signalPlotValue, title = "Signal MA", color = signalColor, linewidth = 3)
