color qwRegimeLowConvColor = input.color(
     defval = NORD4,
     title = "Low Conviction",
     tooltip = "Background for LOW CONV. Used verbatim.",
     group = GROUP_QW_REGIME
 )

color qwRegimeBifurcatedColor = input.color(
     defval = NORD13,
     title = "Bifurcated",
     tooltip = "Background for BIFURCATED. Used verbatim.",
     group = GROUP_QW_REGIME
 )

// ─── Opening-Range Expansion ─────────────────────────────────────────────────
// A SECOND, INDEPENDENT day-type row, derived from measuring the verdict above
// (2026-09-27 study, SPY + QQQ, 1,041 sessions each). Findings that produced it:
//   • The Regime Verdict has ZERO directional content — post-10:00 excursion
//     with-verdict vs against-verdict came in at a ratio of 1.02 / 1.01
//     (t = +0.10 / +0.03). It forecasts SIZE, not side.
//   • As a size forecast the eleven sectors are beaten by the chart's own
//     opening range: opening-range-width ÷ daily ATR alone explains R² 0.074
//     (SPY) / 0.048 (QQQ) of next-excursion variance, while sector magnitude
//     plus agreement together manage 0.015, and ADDING the sectors on top of
//     the opening range is worth +0.001. Sector AGREEMENT alone — the whole
//     bifurcation apparatus — scores R² 0.0003.
//   • The resulting ladder is MONOTONIC on both symbols, which the verdict's
//     is not: quintile-1 (narrowest opening range) through quintile-5 gave
//     0.485 → 0.552 → 0.596 → 0.649 → 0.821 of post-10:00 excursion on SPY,
//     0.504 → 0.572 → 0.590 → 0.623 → 0.748 on QQQ.
// It reads the CHART'S OWN symbol and costs one request (the daily ATR), so it
// works on any instrument rather than through a proxy basket.
//
// SELF-CALIBRATING, deliberately. Fixed cutoffs mis-bucket across symbols —
// QQQ's opening range runs structurally wider than SPY's, so one pair of
// numbers cannot serve both. Today's opening range is compared to its OWN
// trailing baseline instead; 1.25/0.80 matches the opening-volume regime ratios
// used by composite-breadth.
//
// WHAT IT IS NOT: directional, and not a stand-down filter. R² ≈ 0.05-0.07 is
// a mild tilt on top of ordinary intraday volatility autocorrelation, not an
// edge. It scales TARGETS, never position size — a wider expected range means a
// wider ATR/structure stop, so for fixed risk per trade the position gets
// SMALLER on exactly these days.
const string GROUP_QW_RANGE = "📐 Opening Range"

color qwRegimeDataGapColor = input.color(
     defval = NORD15,
     title = "Data Gap",
     tooltip = "Background for DATA GAP. Used verbatim.",
     group = GROUP_QW_REGIME
 )

bool qwShowRangeRow = input.bool(
     defval = true,
     title = "Show Opening-Range Row",
     tooltip = "Adds a second day-type row beneath the Regime Verdict: the chart symbol's own opening range measured against its trailing baseline, classified WIDE / NORMAL / NARROW. Independent of the quote window and of the % Change Baseline — it reads the instrument you are trading, not the sector basket. Nothing computes when off except its daily-ATR request.",
     group = GROUP_QW_RANGE
 )

int qwRangeMinutes = input.int(
     defval = 30,
     title = "Opening Range (minutes)",
     minval = 5,
     maxval = 120,
     step = 5,
     tooltip = "Minutes from the 09:30 open used to measure the opening range. 30 is what the study measured, and it is where the opening auction has settled.",
     group = GROUP_QW_RANGE
 )

int qwRangeBaselineDays = input.int(
     defval = 60,
     title = "Baseline (sessions)",
     minval = 10,
     maxval = 120,
     tooltip = "Length of the trailing EMA of opening-range-÷-daily-ATR that today is compared against. Self-calibrating by design — a fixed cutoff cannot serve two symbols whose opening ranges differ structurally.\n\n📐 60 since 2026-10-02 (was 20). Measured on 426 sessions of QQQ and SPY 30-min bars: a 20-session baseline erased most of the information — dividing by a SHORT mean forgets whether the last few weeks have been wide or narrow — while 60 lifted the forecast of the rest-of-day range from R² 0.072 → 0.095 (QQQ) and 0.114 → 0.150 (SPY), out of sample too, and widened the WIDE-vs-NARROW spread to 1.49× / 1.70×. 40-90 all score alike; 60 is the middle. Opening volume and the prior day's range were also tested and overfit out of sample, so they are not in.",
     group = GROUP_QW_RANGE
 )

float qwRangeWideRatio = input.float(
     defval = 1.25,
     title = "Wide Ratio",
     minval = 1.0,
     maxval = 3.0,
     step = 0.05,
     inline = "qw_range_ratios",
     group = GROUP_QW_RANGE
 )

float qwRangeNarrowRatio = input.float(
     defval = 0.80,
     title = "Narrow",
     minval = 0.2,
     maxval = 1.0,
     step = 0.05,
     inline = "qw_range_ratios",
     tooltip = "Today's opening range ÷ its trailing baseline. At or above the wide ratio = WIDE, at or below the narrow ratio = NARROW, between = NORMAL. With the 60-session baseline, 1.25/0.80 gives WIDE ~19-23% / NARROW ~38-40% of sessions on QQQ and SPY, with WIDE days running 1.49× / 1.70× the rest-of-day range of NARROW ones (2026-10-02, 426 sessions).",
     group = GROUP_QW_RANGE
 )

color qwRangeWideColor = input.color(defval = NORD8, title = "Wide", inline = "qw_range_c1", group = GROUP_QW_RANGE)
color qwRangeNormalColor = input.color(defval = NORD4, title = "Normal", inline = "qw_range_c1", group = GROUP_QW_RANGE)
color qwRangeNarrowColor = input.color(defval = NORD3, title = "Narrow", inline = "qw_range_c1", tooltip = "Row background per state. Used verbatim.", group = GROUP_QW_RANGE)

bool qwUseTodayOpenBaseline = qwBaselineMode == "Today's Open"
bool qwBothBaselines        = qwBaselineMode == "Both"
bool qwRelativeToSpy        = qwBaselineMode == "vs SPY (relative)"
// Commitment tiers IN FORCE — scaled only when the verdict runs vs today's open.
float qwTierScale        = qwUseTodayOpenBaseline ? QW_OPEN_TIER_SCALE : 1.0
float qwNoiseTier        = QW_NOISE_THRESHOLD     * qwTierScale
float qwSeriousTier      = QW_SERIOUS_THRESHOLD   * qwTierScale
float qwCommittedTier    = QW_COMMITTED_THRESHOLD * qwTierScale
string qwVerdictBaseline = qwUseTodayOpenBaseline ? "vs open" : "vs close"

// Session edges, declared ABOVE the reading helper because it snapshots the
// futures' 09:30 price. The OPEN window is deliberately narrow (see the
// QW_SESSION_RTH_OPEN note); the NY day key resets per-day state at midnight ET.
bool qwInRthOpenWindow   = not na(time(timeframe = timeframe.period, session = QW_SESSION_RTH_OPEN, timezone = "America/New_York"))
bool qwSessionJustOpened = qwInRthOpenWindow and not qwInRthOpenWindow[1]
bool qwInRthSession      = not na(time(timeframe = timeframe.period, session = QW_SESSION_RTH_FULL, timezone = "America/New_York"))
int  qwNyDayKey = year(time = time, timezone = "America/New_York") * 10000 + month(time = time, timezone = "America/New_York") * 100 + dayofmonth(time = time, timezone = "America/New_York")
bool qwNewNyDay = qwNyDayKey != qwNyDayKey[1]

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
// TWO requests per symbol, and the split is the whole reason replay works
// (2026-09-26 rework). The old single daily request pulled `close` under
// lookahead_on, which on ANY historical bar returns that day's FINAL close —
// so in Bar Replay every bar of a day showed the end-of-day percentages. The
// quote window was reading the future, and the rotation snapshot had to be
// gated off history to keep the leak out of var state.
//
// The fix is to source each field where it is honestly available:
//   DAILY, lookahead_on — {yesterday's close, today's open}. Neither leaks:
//     yesterday's close is final before today begins, and the daily open is
//     set at the symbol's session open, before any intraday bar of that day
//     exists. lookahead_on is REQUIRED here rather than optional — without it
//     a daily request returns the last COMPLETED daily bar, which would make
//     close[1] two days stale and `open` yesterday's.
//   CHART TIMEFRAME, lookahead_off — the current price. There is no higher
//     timeframe to look ahead into, so there is nothing to leak; it is simply
//     the symbol's price at the bar being drawn, correct on history, in
//     replay, and live alike.
//
// Cost is 19 → 38 request.*() calls against a 64-slot Professional/Ultimate
// budget. Correctness picked this shape, not the budget: a one-request variant
// exists (track the day boundary inside the foreign context with
// timeframe.change("D")) and would halve the count, but it reads the prior
// close and open off the CHART's session rather than the symbol's official
// daily bar — silently moving the futures baseline off globex and making every
// number depend on the chart's extended-hours setting. Rejected on the data,
// and it would still be rejected with 64 free slots.
//
// Computes BOTH baselines every time (vs-open and vs-close) and selects the
// primary per the baseline mode — see the QwReading type comment.
f_qwMakeReading(string label, string symbolTicker, bool isCommodity, bool useTodayOpenBaseline, bool isFutures = false) =>
    // SESSION-PINNED TICKER (2026-09-27 correctness fix). `syminfo.tickerid`-style
    // plain symbols inherit the CHART's session setting, so with Extended Trading
    // Hours enabled a daily bar's `open` becomes the 04:00 pre-market print and
    // `close[1]` the 20:00 post-market print — i.e. the two baselines the whole
    // indicator is built on silently changed meaning with a chart checkbox, and
    // differently for each user. ticker.modify(session = session.regular) pins
    // every symbol's daily bar to its exchange's regular session, which is what
    // "yesterday's close" and "today's open" are supposed to mean.
    // AI.md's documented pattern, and its consistency rule is why BOTH requests
    // below use the same resolved ticker.
    // CAVEAT for the futures rows: "regular session" for CME equity-index
    // contracts is exchange-defined, not 09:30-16:00 — verify on chart before
    // leaning on a futures number. Cash and sector ETFs are unambiguous.
    string qwReadingTicker = ticker.modify(tickerid = symbolTicker, session = session.regular)
    [prevClose, todayOpen] = request.security(
         symbol = qwReadingTicker,
         timeframe = "D",
         expression = [close[1], open],
         lookahead = barmerge.lookahead_on,
         ignore_invalid_symbol = true
     )
    [qwReadingBarOpen, qwReadingNowPrice] = request.security(
         symbol = qwReadingTicker,
         timeframe = timeframe.period,
         expression = [open, close],
         lookahead = barmerge.lookahead_off,
         ignore_invalid_symbol = true
     )
    // FUTURES "today's open" = the price at the 09:30 CASH open, snapshotted per
    // symbol (var inside the helper is per call site). Their daily bar opens at
    // globex, so the daily `open` would leave the whole overnight in the row and
    // make cash↔futures comparisons meaningless under this baseline. Before
    // 09:30 the snapshot is na and so is the row — there is no cash open yet.
    var float qwReadingCashOpenPrice = na
    if qwNewNyDay
        qwReadingCashOpenPrice := na
    if qwSessionJustOpened and not na(qwReadingBarOpen)
        qwReadingCashOpenPrice := qwReadingBarOpen
    float qwReadingOpenBase = isFutures ? qwReadingCashOpenPrice : todayOpen
    float qwReadingVsOpenPct  = not na(qwReadingNowPrice) and not na(qwReadingOpenBase) and qwReadingOpenBase != 0.0 ?
         (qwReadingNowPrice - qwReadingOpenBase) / qwReadingOpenBase * 100.0 : na
    float qwReadingVsClosePct = not na(qwReadingNowPrice) and not na(prevClose) and prevClose != 0.0 ?
         (qwReadingNowPrice - prevClose) / prevClose * 100.0 : na
    float qwReadingPrimaryPct = useTodayOpenBaseline ? qwReadingVsOpenPct : qwReadingVsClosePct
    QwReading.new(label = label, pctChange = qwReadingPrimaryPct, pctChangeVsOpen = qwReadingVsOpenPct, pctChangeVsClose = qwReadingVsClosePct, isCommodity = isCommodity)

f_qwCellTextColor(float pctChange) =>
    na(pctChange) ? color.new(color = NORD4, transp = 40) : color.new(color = NORD4, transp = 0)

// tierScale: 1.0 for vs-close numbers, QW_OPEN_TIER_SCALE for vs-open ones, so
// a row's colour always matches the tiers the verdict applies to it.
f_qwPctTextColor(float pctChange, float tierScale = 1.0) =>
    color qwPctColor = color.new(color = NORD4, transp = 40)
    if not na(pctChange)
        if math.abs(number = pctChange) >= QW_COMMITTED_THRESHOLD * tierScale
            qwPctColor := color.new(color = pctChange >= 0.0 ? NORD8 : NORD11, transp = 0)
        else if math.abs(number = pctChange) >= QW_SERIOUS_THRESHOLD * tierScale
            qwPctColor := color.new(color = pctChange >= 0.0 ? NORD7 : NORD12, transp = 0)
        else if math.abs(number = pctChange) > QW_NOISE_THRESHOLD * tierScale
            qwPctColor := color.new(color = pctChange >= 0.0 ? NORD7 : NORD12, transp = 45)
        else
            qwPctColor := color.new(color = NORD3, transp = 0)
    qwPctColor

f_qwFormatPct(float pctChange) =>
    na(pctChange) ? "—" : str.format("{0,number,+0.00;-0.00}%", pctChange)

f_qwGroupSize(array<QwReading> readings) =>
    int qwSizeTotal = 0
    for reading in readings
        if not na(reading.pctChange)
            qwSizeTotal += 1
    qwSizeTotal

// Bifurcation always runs on COLORS, i.e. the noise tier — comparisons are
// therefore strict (a reading at exactly ±0.2% is noise, not a color).
f_qwIsBifurcated(array<QwReading> readings, float threshold, float minorityFraction) =>
    int qwBifGreens = 0
    int qwBifReds   = 0
    int qwBifTotal  = 0
    for reading in readings
        if not na(reading.pctChange)
            qwBifTotal += 1
            if reading.pctChange > threshold
                qwBifGreens += 1
            else if reading.pctChange < -threshold
                qwBifReds += 1
    qwBifGreens > 0 and qwBifReds > 0 and qwBifTotal > 0 and
         math.min(qwBifGreens, qwBifReds) / float(qwBifTotal) > minorityFraction

// Group net means for the header rows. Pine has no field selectors, hence the
// twin helpers; the primary (displayed) net is picked from these two per the
// baseline mode.
f_qwNetMeanVsOpen(array<QwReading> readings) =>
    float qwNetOpenSum   = 0.0
    int   qwNetOpenCount = 0
    for reading in readings
        if not na(reading.pctChangeVsOpen)
            qwNetOpenSum   += reading.pctChangeVsOpen
            qwNetOpenCount += 1
    qwNetOpenCount > 0 ? qwNetOpenSum / qwNetOpenCount : na

f_qwNetMeanVsClose(array<QwReading> readings) =>
    float qwNetCloseSum   = 0.0
    int   qwNetCloseCount = 0
    for reading in readings
        if not na(reading.pctChangeVsClose)
            qwNetCloseSum   += reading.pctChangeVsClose
            qwNetCloseCount += 1
    qwNetCloseCount > 0 ? qwNetCloseSum / qwNetCloseCount : na

// Relative-to-SPY display copies. The source's sector routine is a PERCENT-
// CHANGE chart with SPY overlaid as a thick black line — the read is each row
// against the benchmark, not against zero, and sorted that way it ranks true
// out- and under-performers. Returns COPIES with pctChange rebased, so the
// verdict engine keeps reading the untouched originals: the 0.2/0.5/1.0
// commitment tiers are calibrated on absolute change and must not see a
// relative number. Always rebased on the vs-CLOSE field — relative strength
// measured against two different session baselines would be meaningless.
f_qwRelativeCopy(array<QwReading> readings, float benchmarkPct) =>
    array<QwReading> qwRelOut = array.new<QwReading>()
    for reading in readings
        QwReading qwRelItem = reading.copy()
        // Field assignment is `:=`, never `=` — a plain `=` reads as declaring
        // a new variable named "qwRelItem.pctChange" and Pine rejects the dot
        // (CE10089 / CE10090 / CE10095, hit on the 2026-09-26 build).
        qwRelItem.pctChange := na(reading.pctChangeVsClose) or na(benchmarkPct) ? na :
             reading.pctChangeVsClose - benchmarkPct
        array.push(id = qwRelOut, value = qwRelItem)
    qwRelOut

// Mean of whatever the PRIMARY field currently holds — the group header's net
// in relative mode, where the vs-open/vs-close means don't apply.
f_qwNetMeanPrimary(array<QwReading> readings) =>
    float qwNetPrimSum   = 0.0
    int   qwNetPrimCount = 0
    for reading in readings
        if not na(reading.pctChange)
            qwNetPrimSum   += reading.pctChange
            qwNetPrimCount += 1
    qwNetPrimCount > 0 ? qwNetPrimSum / qwNetPrimCount : na

// Display sort — net percent change descending (green at the top, red at the
// bottom), which is the ordering the market-selection read falls out of.
// Returns a sorted COPY: verdict math and the index-paired cash↔futures
// misalignment loop keep reading the fixed-order arrays. Insertion sort
// because array.sort() has no UDT comparator; groups are 4–11 elements.
// na readings sink to the bottom so dead feeds don't float between colors.
f_qwSortedForDisplay(array<QwReading> readings) =>
    array<QwReading> qwSortBuffer = array.copy(id = readings)
    int qwSortSize = array.size(id = qwSortBuffer)
    if qwSortSize > 1
        for qwSortIndex = 1 to qwSortSize - 1
            QwReading qwSortCurrent = array.get(id = qwSortBuffer, index = qwSortIndex)
            int qwSortInsertIndex = qwSortIndex - 1
            while qwSortInsertIndex >= 0
                QwReading qwSortCompared = array.get(id = qwSortBuffer, index = qwSortInsertIndex)
                bool qwSortShouldShift = not na(qwSortCurrent.pctChange) and
                     (na(qwSortCompared.pctChange) or qwSortCurrent.pctChange > qwSortCompared.pctChange)
                if not qwSortShouldShift
                    break
                array.set(id = qwSortBuffer, index = qwSortInsertIndex + 1, value = qwSortCompared)
                qwSortInsertIndex -= 1
            array.set(id = qwSortBuffer, index = qwSortInsertIndex + 1, value = qwSortCurrent)
    qwSortBuffer

// ─────────────────────────────────────────────────────────────────────────────
// Build readings for each group using fixed-symbol requests so Pine doesn't
// need dynamic request bookkeeping for the symbol loop on every bar.
// ─────────────────────────────────────────────────────────────────────────────
QwReading qwSpyReading  = f_qwMakeReading(label = "SPY",  symbolTicker = "AMEX:SPY",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwQqqReading  = f_qwMakeReading(label = "QQQ",  symbolTicker = "NASDAQ:QQQ",     isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwDiaReading  = f_qwMakeReading(label = "DIA",  symbolTicker = "AMEX:DIA",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwIwmReading  = f_qwMakeReading(label = "IWM",  symbolTicker = "AMEX:IWM",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)

QwReading qwEsReading   = f_qwMakeReading(label = "ES",   symbolTicker = "CME_MINI:ES1!",  isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline, isFutures = true)
QwReading qwNqReading   = f_qwMakeReading(label = "NQ",   symbolTicker = "CME_MINI:NQ1!",  isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline, isFutures = true)
QwReading qwYmReading   = f_qwMakeReading(label = "YM",   symbolTicker = "CBOT_MINI:YM1!", isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline, isFutures = true)
QwReading qwRtyReading  = f_qwMakeReading(label = "RTY",  symbolTicker = "CME_MINI:RTY1!", isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline, isFutures = true)

QwReading qwXlcReading  = f_qwMakeReading(label = "XLC",  symbolTicker = "AMEX:XLC",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlyReading  = f_qwMakeReading(label = "XLY",  symbolTicker = "AMEX:XLY",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlpReading  = f_qwMakeReading(label = "XLP",  symbolTicker = "AMEX:XLP",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXleReading  = f_qwMakeReading(label = "XLE",  symbolTicker = "AMEX:XLE",       isCommodity = true,  useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlfReading  = f_qwMakeReading(label = "XLF",  symbolTicker = "AMEX:XLF",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlvReading  = f_qwMakeReading(label = "XLV",  symbolTicker = "AMEX:XLV",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXliReading  = f_qwMakeReading(label = "XLI",  symbolTicker = "AMEX:XLI",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlbReading  = f_qwMakeReading(label = "XLB",  symbolTicker = "AMEX:XLB",       isCommodity = true,  useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlreReading = f_qwMakeReading(label = "XLRE", symbolTicker = "AMEX:XLRE",      isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXlkReading  = f_qwMakeReading(label = "XLK",  symbolTicker = "AMEX:XLK",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)
QwReading qwXluReading  = f_qwMakeReading(label = "XLU",  symbolTicker = "AMEX:XLU",       isCommodity = false, useTodayOpenBaseline = qwUseTodayOpenBaseline)

// SPY is the benchmark for the relative read. Taken from the vs-close field so
// it is session-consistent for every row, including futures.
float qwSpyBenchmarkPct = qwSpyReading.pctChangeVsClose

array<QwReading> qwCashReadings = array.from(qwSpyReading, qwQqqReading, qwDiaReading, qwIwmReading)
array<QwReading> qwFuturesReadings = array.from(qwEsReading, qwNqReading, qwYmReading, qwRtyReading)
array<QwReading> qwSectorReadings = array.from(
     qwXlcReading, qwXlyReading, qwXlpReading, qwXleReading, qwXlfReading, qwXlvReading,
     qwXliReading, qwXlbReading, qwXlreReading, qwXlkReading, qwXluReading
 )

// ─────────────────────────────────────────────────────────────────────────────
// Aggregate diagnostics — bifurcation, sector commitment, color rotation.
// Every regime check (bifurcation, misalignment, dominant fraction, data gap)
// runs against the full universe of cash + futures + sectors, regardless of
// which groups the user has elected to display. Show* toggles affect table
// rendering only. Sensitivity is intentionally ASYMMETRIC:
//   • Indexes (cash, futures): ANY mix of red and green beyond the noise
//     floor = bifurcated. Zero tolerance — "It's that simple."
//   • Sectors: mixture is tolerated up to a 25% minority of colors beyond
//     the noise floor.
// ─────────────────────────────────────────────────────────────────────────────
bool qwCashBifurcated    = f_qwIsBifurcated(readings = qwCashReadings,    threshold = qwNoiseTier, minorityFraction = 0.0)
bool qwFuturesBifurcated = f_qwIsBifurcated(readings = qwFuturesReadings, threshold = qwNoiseTier, minorityFraction = 0.0)

// Group nets for the header rows. The primary follows the baseline mode; the
// "Both" view renders the vs-open and vs-close nets side by side.
float qwCashNetVsOpen     = f_qwNetMeanVsOpen(readings  = qwCashReadings)
float qwCashNetVsClose    = f_qwNetMeanVsClose(readings = qwCashReadings)
float qwFuturesNetVsOpen  = f_qwNetMeanVsOpen(readings  = qwFuturesReadings)
float qwFuturesNetVsClose = f_qwNetMeanVsClose(readings = qwFuturesReadings)
float qwCashNet    = qwUseTodayOpenBaseline ? qwCashNetVsOpen    : qwCashNetVsClose
float qwFuturesNet = qwUseTodayOpenBaseline ? qwFuturesNetVsOpen : qwFuturesNetVsClose

// Cash↔futures misalignment is PER-PAIR, not group-mean — "the S&P is a
// little green, but the ES is a little red … probably a good time to not
// trade that market." Group means can wash out a single split pair (SPY +0.5%
// vs ES −0.3% while the other three pairs align). Pairing relies on the two
// arrays sharing index order: SPY↔ES, QQQ↔NQ, DIA↔YM, IWM↔RTY. Compared on
// the PRIMARY baseline like the rest of the verdict: under "Today's Open" both
// legs are measured from the 09:30 cash open (futures included — see
// f_qwMakeReading), so the pair stays like-for-like.
//
// The split pairs are NAMED. A pair split is a per-INSTRUMENT veto, not a
// global one: if SPY and ES disagree, that says nothing about QQQ. It still
// counts as the third index-bifurcation check, so it keeps its place in the
// verdict — but the verdict can now say WHICH market is split, which is the
// part you act on.
//
// MEASURED 2026-09-27: this check fires ZERO times in 434 RTH sessions. SPY/ES
// correlate at r=0.9845 and QQQ/NQ at r=0.9911 — an ETF and its own future are
// arbitraged to basis points, so a sign split is a riskless arbitrage and
// cannot persist. Outside RTH it inverts: cash indexes do not tick after 16:00,
// so the cash leg shows a stale close while the future carries the whole
// overnight move, and the check fires constantly for a purely mechanical
// reason. It is kept for fidelity, not because it contributes.
// Roll window, computed — no hard-coded dates and no yearly maintenance. Derive
// the weekday of the 1st from THIS bar's own day-of-week and day-of-month, walk
// forward to the first Thursday, add seven for the second. All in New York
// time, like every other session test in this file.
int qwNyDow = dayofweek(time = time, timezone = "America/New_York")
int qwNyDom = dayofmonth(time = time, timezone = "America/New_York")
int qwNyMonth = month(time = time, timezone = "America/New_York")
int qwMonthFirstDow = ((qwNyDow - 1 - (qwNyDom - 1)) % 7 + 7) % 7 + 1
int qwSecondThursdayDom = 1 + ((dayofweek.thursday - qwMonthFirstDow + 7) % 7) + 7
bool qwInQuarterlyMonth = qwNyMonth == 3 or qwNyMonth == 6 or qwNyMonth == 9 or qwNyMonth == 12
bool qwInRollWindow = qwInQuarterlyMonth and
     math.abs(number = qwNyDom - qwSecondThursdayDom) <= QW_ROLL_WINDOW_DAYS

bool qwCashFuturesMisaligned = false
array<string> qwMisalignedPairNames = array.new<string>()
int qwPairsComparable = 0
int qwPairsOpposed    = 0
for qwPairIndex = 0 to math.min(array.size(id = qwCashReadings), array.size(id = qwFuturesReadings)) - 1
    QwReading qwPairCash    = array.get(id = qwCashReadings, index = qwPairIndex)
    QwReading qwPairFutures = array.get(id = qwFuturesReadings, index = qwPairIndex)
    if not na(qwPairCash.pctChange) and not na(qwPairFutures.pctChange) and
         math.abs(number = qwPairCash.pctChange)    > qwNoiseTier and
         math.abs(number = qwPairFutures.pctChange) > qwNoiseTier
        qwPairsComparable += 1
        if (qwPairCash.pctChange > 0.0) != (qwPairFutures.pctChange > 0.0)
            qwPairsOpposed += 1
            array.push(id = qwMisalignedPairNames, value = qwPairCash.label + "/" + qwPairFutures.label)

// The roll's signature is a CLEAN SWEEP — the splice hits every contract at
// once and contango pushes them all the same way, so every comparable pair
// flips together. Genuine intermarket disagreement is one or two pairs, not
// all of them. Requiring the sweep INSIDE the computed window keeps the check
// live for the other ~20 days a quarter it would otherwise be blind on, and
// keeps a real one-pair split flagged even on roll day itself.
bool qwRollSuspected = not qwUseTodayOpenBaseline and qwInRollWindow and qwPairsComparable >= 3 and qwPairsOpposed == qwPairsComparable
qwCashFuturesMisaligned := qwPairsOpposed > 0 and not qwRollSuspected

// ─── Sector read ─────────────────────────────────────────────────────────────
// Pass 1: colour every sector, ALL ELEVEN, no discount. The minority side has
// to be known before the commodity discount can be applied: the discount is
// CONDITIONAL and only ever drops an OFF-COLOUR commodity sector. These undiscounted counts are also the right basis for the
// colour-rotation snapshot: rotation is about sectors flipping colour, and a
// baseline whose denominator moves with the discount isn't comparable.
int qwSectorGreensAll = 0
int qwSectorRedsAll   = 0
for reading in qwSectorReadings
    if not na(reading.pctChange)
        if reading.pctChange > qwNoiseTier
            qwSectorGreensAll += 1
        else if reading.pctChange < -qwNoiseTier
            qwSectorRedsAll += 1
// Minority colour: +1 = greens are the minority, −1 = reds are, 0 = one-sided
// or an exact tie (a tie is a 50/50 tape, where nothing is "the exception").
int qwSectorMinoritySign = qwSectorGreensAll == 0 or qwSectorRedsAll == 0 or qwSectorGreensAll == qwSectorRedsAll ? 0 :
     qwSectorGreensAll < qwSectorRedsAll ? 1 : -1

// Pass 2: the verdict counts. A commodity sector is dropped — from the counts
// AND from the total — only when it sits on the minority side; those are
// ignored outright rather than down-weighted. Minority labels are collected
// here so the row can name WHICH industries are the odd ones out.
int qwSectorTotal         = 0
int qwSectorGreens        = 0
int qwSectorReds          = 0
int qwSectorGreensSerious = 0
int qwSectorRedsSerious   = 0
array<string> qwSectorMinorityNames = array.new<string>()
for reading in qwSectorReadings
    if not na(reading.pctChange)
        int qwReadingSign = reading.pctChange > qwNoiseTier ? 1 :
             reading.pctChange < -qwNoiseTier ? -1 : 0
        bool qwOnMinoritySide = qwSectorMinoritySign != 0 and qwReadingSign == qwSectorMinoritySign
        bool qwDiscounted = qwIgnoreCommoditySectors and reading.isCommodity and qwOnMinoritySide
        if not qwDiscounted
            qwSectorTotal += 1
            if qwReadingSign == 1
                qwSectorGreens += 1
            else if qwReadingSign == -1
                qwSectorReds += 1
            if reading.pctChange >= qwSeriousTier
                qwSectorGreensSerious += 1
            else if reading.pctChange <= -qwSeriousTier
                qwSectorRedsSerious += 1
            if qwOnMinoritySide
                array.push(id = qwSectorMinorityNames, value = reading.label)

// Two graded levels, per the constants block: past 25% minority the verdict is
// capped (the "cautious about letting my profits run" state); near 50/50 the
// sectors themselves read bifurcated.
int qwSectorMinorityCount = math.min(qwSectorGreens, qwSectorReds)
float qwSectorMinorityFraction = qwSectorTotal > 0 ? qwSectorMinorityCount / float(qwSectorTotal) : 0.0
bool qwSectorsMixed = qwSectorGreens > 0 and qwSectorReds > 0

float qwDominantSeriousFraction = qwSectorTotal > 0 ?
     math.max(qwSectorGreensSerious, qwSectorRedsSerious) / float(qwSectorTotal) : 0.0
// Lean uses serious counts; strict > means an exact tie resolves false rather
// than silently biasing green. A tie large enough to reach the MILD fraction
// necessarily trips the sector bifurcation gate first (raw color counts are a
// superset of serious counts, so minority/total ≥ 0.5 > QW_MINORITY_FRACTION),
// meaning the arrow direction here is only consulted when one side is
// genuinely dominant.
bool qwSectorsLeanGreen = qwSectorGreensSerious > qwSectorRedsSerious

// CAUTION (>25% minority) caps the verdict below COMMITTED; it does not veto
// the day. SPLIT (near 50/50) does veto.
bool qwSectorsCaution = qwSectorsMixed and qwSectorMinorityFraction > QW_MINORITY_FRACTION
bool qwSectorsSplit   = qwSectorsMixed and qwSectorMinorityFraction >= QW_SECTOR_SPLIT_FRACTION

// Data availability — an enabled group must return at least
// QW_PARTIAL_GAP_FRACTION of its expected symbols; otherwise the feed is
// degraded and the verdict can't be trusted. Covers both empty feeds (missing
// permissions, off-hours) AND partial fetches that would otherwise let 1–2
// symbols out of 9+ drive the regime call.
int qwCashExpected       = 4
int qwFuturesExpected    = 4
// Expected sector count is ALWAYS 11 — the commodity discount is a verdict
// concern, not a data-availability one, and after 2026-09-25 it is conditional,
// so qwSectorTotal now varies with the tape. The gap check needs its own
// undiscounted received count or a discounted minority would read as a feed
// outage.
int qwSectorExpected     = 11
int qwSectorReceived     = f_qwGroupSize(readings = qwSectorReadings)
int qwCashReceived       = f_qwGroupSize(readings = qwCashReadings)
int qwFuturesReceived    = f_qwGroupSize(readings = qwFuturesReadings)
int qwCashMinReceived    = math.ceil(number = qwCashExpected * QW_PARTIAL_GAP_FRACTION)
int qwFuturesMinReceived = math.ceil(number = qwFuturesExpected * QW_PARTIAL_GAP_FRACTION)
int qwSectorMinReceived  = math.ceil(number = qwSectorExpected * QW_PARTIAL_GAP_FRACTION)
bool qwCashDataGap       = qwCashReceived    < qwCashMinReceived
bool qwFuturesDataGap    = qwFuturesReceived < qwFuturesMinReceived
bool qwSectorsDataGap    = qwSectorReceived  < qwSectorMinReceived
bool qwDataGap           = qwCashDataGap or qwFuturesDataGap or qwSectorsDataGap

// Color-rotation tracking: snapshot the sector green/red counts at the US
// cash open and surface the delta so the user can spot sectors flipping
// mid-day, which is the earliest tell that the day is changing character.
// US-RTH detection is anchored to America/New_York, NOT to the chart symbol's
// session, so the trigger fires correctly on a futures, FX, or crypto chart.
//
// Snapshot only fires on the actual 09:30 ET transition (qwSessionJustOpened).
// On a chart loaded mid-session, no snapshot exists yet and the delta is na —
// the UI then renders "·" instead of an arrow, signalling "no open baseline
// yet" rather than passing off load-time counts as the open.
//
// It now runs on EVERY bar, history included (2026-09-26). It used to be gated
// behind barstate.isrealtime / islastconfirmedhistory purely to keep the old
// lookahead leak from poisoning this var state with future daily closes. With
// the leak gone the counts are honest on every bar, so the rotation read works
// in Bar Replay and on history exactly as it does live.
//
// Timeframe caveat: the 09:30 edge fires cleanly on 1m–30m charts (a bar
// boundary lands at the open). On wider timeframes where one bar straddles
// the open (e.g. 1h/4h), the snapshot is taken at the bar's start tick — which
// may be a few minutes before 09:30. Accepted: this script is intended for
// intraday work where the chart is typically ≤15m.
var int qwGreensAtOpen = na
var int qwRedsAtOpen   = na

// NY trading-day rollover reset — without this, the snapshot from yesterday's
// 09:30 ET persists overnight, so this morning's premarket bars compute their
// delta against yesterday's open. Clearing on the date change forces the UI
// back to "no baseline yet" until today's 09:30 snapshot fires. Detect the
// rollover via the NY-tz date so charts that have midnight ET bars (futures,
// FX, crypto) trip the reset at ~midnight, and stock-only charts trip it on
// the first bar of the new RTH session (which is the 09:30 bar itself — the
// reset runs before the snapshot assignment below).
if qwNewNyDay
    qwGreensAtOpen := na
    qwRedsAtOpen   := na


if qwSessionJustOpened
    qwGreensAtOpen := qwSectorGreensAll
    qwRedsAtOpen   := qwSectorRedsAll

// Delta is na (not 0) when no snapshot exists or the sector feed is currently
// dead — guards against rendering a phantom "▼9" the moment sectors drop out.
int qwGreensDelta = na(qwGreensAtOpen) or qwSectorReceived == 0 ? na : qwSectorGreensAll - qwGreensAtOpen
int qwRedsDelta   = na(qwRedsAtOpen)   or qwSectorReceived == 0 ? na : qwSectorRedsAll   - qwRedsAtOpen

// ─────────────────────────────────────────────────────────────────────────────
// Regime verdict synthesis. State colors are the regime INPUT colors verbatim
// (the old conviction-transparency ramp is gone — it washed the banner out at
// low fractions and fought the color picker's own opacity slider; conviction
// strength reads from the detail number instead).
// ─────────────────────────────────────────────────────────────────────────────
string qwRegimeText = "· LOW CONV"
color qwRegimeColor = qwRegimeLowConvColor
// DATA GAP overrides everything else — never promote partial data to a verdict.
if qwDataGap
    qwRegimeText  := "× DATA GAP"
    qwRegimeColor := qwRegimeDataGapColor
// INDEX bifurcation is the hard veto — any mix of red and green across cash or
// futures. A near-50/50 SECTOR split joins it; a merely >25% sector minority
// does NOT, it caps the verdict below COMMITTED instead.
else if qwCashBifurcated or qwFuturesBifurcated or qwCashFuturesMisaligned or qwSectorsSplit
    qwRegimeText  := "÷ BIFURCATED"
    qwRegimeColor := qwRegimeBifurcatedColor
else if qwDominantSeriousFraction >= QW_COMMITTED_FRACTION and not qwSectorsCaution
    qwRegimeText  := qwSectorsLeanGreen ? "+ COMMITTED ↑" : "+ COMMITTED ↓"
    qwRegimeColor := qwSectorsLeanGreen ? qwRegimeCommittedUpColor : qwRegimeCommittedDownColor
else if qwDominantSeriousFraction >= QW_MILD_FRACTION
    qwRegimeText  := qwSectorsLeanGreen ? "~ MILD ↑" : "~ MILD ↓"
    qwRegimeColor := qwSectorsLeanGreen ? qwRegimeMildUpColor : qwRegimeMildDownColor

// ─────────────────────────────────────────────────────────────────────────────
// Opening-range expansion engine. Chart OHLC plus one daily-ATR request; the
// sector basket is not consulted. Accumulate the session's high/low over the
// first N minutes, capture the ratio once at the mark, classify against a
// trailing EMA baseline, then fold today into that baseline — classify-then-
// fold, so a session is never compared against itself.
// ─────────────────────────────────────────────────────────────────────────────
// YESTERDAY'S completed ATR on every bar (2026-10-02 fix): `[1]` under
// lookahead_on is the settled-snapshot pattern. The old `ta.atr(14)` under
// lookahead_off returned the prior day's ATR on history but TODAY'S developing
// one live — already inflated by the opening range being measured — so the
// live call could read NORMAL where history would have printed WIDE.
float qwRangeDailyAtr = request.security(
     symbol = ticker.modify(tickerid = syminfo.tickerid, session = session.regular),
     timeframe = "D",
     expression = ta.atr(length = 14)[1],
     lookahead = barmerge.lookahead_on
 )

var float qwRangeHigh     = na
var float qwRangeLow      = na
var float qwRangeBaseline = na
var float qwRangeRatio    = na
var bool  qwRangeCaptured = false
var int   qwRangeState    = 0      // 1 wide · 0 normal · -1 narrow
var bool  qwRangeKnown    = false  // classified against a real baseline
int qwRangeBars = math.max(1, math.round(number = qwRangeMinutes * 60.0 / timeframe.in_seconds()))
var int qwRangeBarCount = 0

if qwShowRangeRow and barstate.isconfirmed
    if qwSessionJustOpened
        qwRangeHigh     := high
        qwRangeLow      := low
        qwRangeRatio    := na
        qwRangeCaptured := false
        qwRangeKnown    := false
        qwRangeState    := 0
        qwRangeBarCount := 0
    if qwInRthSession
        qwRangeBarCount += 1
        if not qwRangeCaptured
            qwRangeHigh := na(qwRangeHigh) ? high : math.max(qwRangeHigh, high)
            qwRangeLow  := na(qwRangeLow)  ? low  : math.min(qwRangeLow,  low)
            // Capture at the mark, but only while the window is still meaningful —
            // a "first 30 minutes" first reached at 13:00 (feed gap, half day)
            // would poison the baseline, so it is abandoned past twice the window.
            if qwRangeBarCount >= qwRangeBars and qwRangeBarCount <= qwRangeBars * 2 and
                 not na(qwRangeHigh) and not na(qwRangeLow) and
                 not na(qwRangeDailyAtr) and qwRangeDailyAtr > 0.0
                qwRangeCaptured := true
                float qwRangeWidth = (qwRangeHigh - qwRangeLow) / qwRangeDailyAtr
                if not na(qwRangeBaseline) and qwRangeBaseline > 0.0
                    qwRangeRatio := qwRangeWidth / qwRangeBaseline
                    qwRangeKnown := true
                    qwRangeState := qwRangeRatio >= qwRangeWideRatio ? 1 :
                         qwRangeRatio <= qwRangeNarrowRatio ? -1 : 0
                float qwRangeAlpha = 2.0 / (qwRangeBaselineDays + 1.0)
                qwRangeBaseline := na(qwRangeBaseline) ? qwRangeWidth :
                     qwRangeAlpha * qwRangeWidth + (1.0 - qwRangeAlpha) * qwRangeBaseline

string qwRangeText = not qwRangeKnown ? "◧ RANGE —" :
     qwRangeState == 1 ? "◧ WIDE" : qwRangeState == -1 ? "◧ NARROW" : "◧ NORMAL"
color qwRangeColor = not qwRangeKnown ? qwRangeNormalColor :
     qwRangeState == 1 ? qwRangeWideColor : qwRangeState == -1 ? qwRangeNarrowColor : qwRangeNormalColor
string qwRangeDetail = na(qwRangeRatio) ? "—" : str.tostring(value = qwRangeRatio, format = "0.00") + "×"
var string qwRangeTooltip =
     "📐 OPENING-RANGE EXPANSION\n" +
     "\n" +
     "This chart symbol's first-N-minute range ÷ its daily ATR, against its own trailing baseline. Derived from measuring the Regime Verdict above (SPY + QQQ, 1,041 sessions each), not inherited from it.\n" +
     "\n" +
     "WIDE — more excursion on offer than usual. Targets can breathe; a runner has room.\n" +
     "NORMAL — an ordinary day.\n" +
     "NARROW — less room than usual. Take profits sooner.\n" +
     "\n" +
     "WHY THIS AND NOT THE VERDICT ROW: the Regime Verdict carries no directional information (with-verdict vs against-verdict excursion came in at 1.02x), and as a SIZE forecast the eleven sectors are beaten by this one number — opening range alone explains ~5-7% of next-excursion variance against ~1.5% for sector magnitude and agreement combined, and the sectors add ~0.1% on top of it. This ladder is also monotonic across all five quintiles, which the verdict's is not.\n" +
     "\n" +
     "⚠ TARGETS, NEVER SIZE. A wider expected range means a wider ATR or structure stop, so at fixed risk-per-trade the correct position is SMALLER on a WIDE day, not larger. What scales is the target, and therefore the R available.\n" +
     "\n" +
     "⚠ NOT AN EDGE. R² ≈ 0.05-0.07 is a mild tilt on top of ordinary intraday volatility autocorrelation. It is context for sizing targets, not a signal to trade or a reason to stand down."

// ─────────────────────────────────────────────────────────────────────────────
// Render — single table, two columns, sections separated by header rows.
// Pine requires table.new() at the top level, so we declare it here and
// populate inside barstate.islast.
// ─────────────────────────────────────────────────────────────────────────────
var table qwTable = na
var int qwTableRows = na
var int qwTableColumnsState = na
var string qwTablePositionState = ""
var bool qwTableBannerState = false

// bothColumns renders a third cell (vs-close) so the "Both" baseline mode can
// show the two % columns side by side. In that mode headerValue carries vs-open, headerValue2 vs-close.
f_qwHeaderRow(table tableId, int rowIndex, string headerLabel, string headerValue, bool bothColumns = false, string headerValue2 = "") =>
    table.cell(table_id = tableId, column = 0, row = rowIndex, text = headerLabel,
         text_color = color.new(color = NORD9, transp = 0),
         text_halign = text.align_left,
         text_valign = text.align_center,
         text_size = qwTextSize,
         bgcolor = color.new(color = NORD1, transp = 25))
    table.cell(table_id = tableId, column = 1, row = rowIndex, text = headerValue,
         text_color = color.new(color = NORD4, transp = 30),
         text_halign = text.align_right,
         text_valign = text.align_center,
         text_size = qwTextSize,
         bgcolor = color.new(color = NORD1, transp = 25))
    if bothColumns
        table.cell(table_id = tableId, column = 2, row = rowIndex, text = headerValue2,
             text_color = color.new(color = NORD4, transp = 30),
             text_halign = text.align_right,
             text_valign = text.align_center,
             text_size = qwTextSize,
             bgcolor = color.new(color = NORD1, transp = 25))

f_qwReadingRow(table tableId, int rowIndex, QwReading reading, bool isDimmed, bool bothColumns = false) =>
    color qwRowBg    = color.new(color = NORD0, transp = 100)
    color qwRowDim   = color.new(color = NORD3, transp = 0)
    color qwRowLabel = isDimmed ? qwRowDim : f_qwCellTextColor(pctChange = reading.pctChange)
    table.cell(table_id = tableId, column = 0, row = rowIndex, text = reading.label,
         text_color = qwRowLabel,
         text_halign = text.align_left,
         text_valign = text.align_center,
         text_size = qwTextSize,
         bgcolor = qwRowBg)
    if bothColumns
        color qwRowOpenText  = isDimmed ? qwRowDim : f_qwPctTextColor(pctChange = reading.pctChangeVsOpen, tierScale = QW_OPEN_TIER_SCALE)
        color qwRowCloseText = isDimmed ? qwRowDim : f_qwPctTextColor(pctChange = reading.pctChangeVsClose)
        table.cell(table_id = tableId, column = 1, row = rowIndex, text = f_qwFormatPct(pctChange = reading.pctChangeVsOpen),
             text_color = qwRowOpenText,
             text_halign = text.align_right,
             text_valign = text.align_center,
             text_size = qwTextSize,
             bgcolor = qwRowBg)
        table.cell(table_id = tableId, column = 2, row = rowIndex, text = f_qwFormatPct(pctChange = reading.pctChangeVsClose),
             text_color = qwRowCloseText,
             text_halign = text.align_right,
             text_valign = text.align_center,
             text_size = qwTextSize,
             bgcolor = qwRowBg)
    else
        color qwRowPctText = isDimmed ? qwRowDim : f_qwPctTextColor(pctChange = reading.pctChange, tierScale = qwTierScale)
        table.cell(table_id = tableId, column = 1, row = rowIndex, text = f_qwFormatPct(pctChange = reading.pctChange),
             text_color = qwRowPctText,
             text_halign = text.align_right,
             text_valign = text.align_center,
             text_size = qwTextSize,
             bgcolor = qwRowBg)

// var: the guide is a pure literal — build it once, not on every tick.
var string qwRegimeTooltip =
     "🧭 REGIME GUIDE\n" +
     "\n" +
     "+ COMMITTED\n" +
     "No index split anywhere, at least 75% of counted sectors are moving seriously (0.5%+) in one direction, and no more than 25% of them are the minority color.\n" +
     "This is the cleanest trend environment. Playbook: trade with the direction and trust trends to run — on the strongest days, hold part of the position for extended wave counts (7-9 waves).\n" +
     "\n" +
     "~ MILD\n" +
     "No index split, but either only 50-75% of sectors are moving seriously, or more than 25% of them are the minority color.\n" +
     "There is participation, but not broad enough to treat as a confident regime. Trade the dominant direction with more conservative exits; a >25% minority is a reason to be careful with profits, not to stand aside.\n" +
     "\n" +
     "· LOW CONV\n" +
     "Less than half the counted sectors are moving seriously.\n" +
     "Movement may be drift, chop, or weak rotation rather than a trustworthy trend day.\n" +
     "\n" +
     "÷ BIFURCATED\n" +
     "Internal disagreement — a neutral market, not bearish or bullish, until the indexes resolve one color. Indexes get ZERO tolerance: any cash index or futures index that is red while the others are green (or vice versa, beyond the 0.2% noise floor) splits the group. \"If they are any mix of red and green, then I consider it a bifurcated market. It's that simple.\"\n" +
     "Also fires when any cash/futures pair of the same market (SPY/ES, QQQ/NQ, DIA/YM, IWM/RTY) points in opposite directions vs prior close — hover the detail cell to see WHICH pair, because that one is a veto on that market specifically.\n" +
     "And when the sectors themselves reach a near 50/50 split, the one sector condition severe enough to veto on its own.\n" +
     "Playbook: take profits quickly (do not expect trends to last) or do not trade at all — this is the picture of a choppy day.\n" +
     "\n" +
     "× DATA GAP\n" +
     "At least one group returned too few usable readings — zero, or below half of the expected symbol count.\n" +
     "Do not trust the verdict when part of the intermarket picture is missing.\n" +
     "\n" +
     "📐 COMMITMENT RULES\n" +
     "0.2% or less = noise (not convincing — treated as zero)\n" +
     "Over 0.2% to 0.5% = drift (color counts, conviction doesn't)\n" +
     "0.5-1% = serious (the color is taken seriously)\n" +
     "1% and above = committed to its bullish/bearish posture\n" +
     "Under the 'Today's Open' baseline every tier scales ×0.64 (0.13 / 0.32 / 0.64%) — moves from the open are smaller, and the verdict row names the baseline it ran on.\n" +
     "\n" +
     "🏛️ SECTORS ARE GRADED, INDEXES ARE NOT\n" +
     "\"I don't need these to be all red or green\" — sector mixture is a dial, not a veto. Past a 25% minority the verdict is capped below COMMITTED; only a near 50/50 sector split reads BIFURCATED on its own. Commodity sectors (XLE, XLB) are discounted only when they sit on the MINORITY side: \"if all the sectors were green except for oil and gold, I wouldn't take that too seriously.\"\n" +
     "\n" +
     "📊 DETAIL NUMBER\n" +
     "Normal mode shows seriously-moving (0.5%+) sectors on the dominant side / total counted sectors, plus ⚠ and the minority count when the sector caution is live. Hover it for the minority sector names and any split cash/futures pair.\n" +
     "Data-gap mode shows received/expected counts for Cash, Futures, and Sectors."

if barstate.islast
    int qwRow = 0
    // Display copies: rebased to SPY first when the relative mode is on, then
    // optionally sorted by % change descending (methodology ordering). Sorting
    // AFTER the rebase is the point — that ordering is the out/under-performer
    // out/under-performer ranking. Verdict math above never touches these.
    array<QwReading> qwCashSource    = qwRelativeToSpy ? f_qwRelativeCopy(readings = qwCashReadings,    benchmarkPct = qwSpyBenchmarkPct) : qwCashReadings
    array<QwReading> qwFuturesSource = qwRelativeToSpy ? f_qwRelativeCopy(readings = qwFuturesReadings, benchmarkPct = qwSpyBenchmarkPct) : qwFuturesReadings
    array<QwReading> qwSectorSource  = qwRelativeToSpy ? f_qwRelativeCopy(readings = qwSectorReadings,  benchmarkPct = qwSpyBenchmarkPct) : qwSectorReadings
    array<QwReading> qwCashDisplay    = qwSortRows ? f_qwSortedForDisplay(readings = qwCashSource)    : qwCashSource
    array<QwReading> qwFuturesDisplay = qwSortRows ? f_qwSortedForDisplay(readings = qwFuturesSource) : qwFuturesSource
    array<QwReading> qwSectorDisplay  = qwSortRows ? f_qwSortedForDisplay(readings = qwSectorSource)  : qwSectorSource
    bool qwRegimeOnlyView = (qwShowRegime or qwShowRangeRow) and not qwShowCash and not qwShowFutures and not qwShowSectors
    bool qwShowRegimeHeader = qwShowRegime and not qwRegimeOnlyView
    // "Both" baseline mode adds a third column (vs-open | vs-close) plus a
    // column-label row. The regime-only view never needs the split — it shows
    // no per-symbol percentages — so it stays at 2 columns.
    bool qwBothColumns = qwBothBaselines and not qwRegimeOnlyView
    // Header suffix so the mode is unmistakable on the pane, not just in the
    // settings dialog — SPY's own row reading 0.00% is the other tell.
    string qwRelSuffix = qwRelativeToSpy ? " Δ SPY" : ""
    int qwTableColumns = qwBothColumns ? 3 : 2
    int qwVisibleRows = qwRegimeOnlyView ? ((qwShowRegime ? 1 : 0) + (qwShowRangeRow ? 1 : 0)) :
         (qwBothColumns ? 1 : 0) +
         (qwShowCash ? 1 + array.size(id = qwCashReadings) : 0) +
         (qwShowFutures ? 1 + array.size(id = qwFuturesReadings) : 0) +
         (qwShowSectors ? 1 + array.size(id = qwSectorReadings) : 0) +
         (qwShowRegimeHeader ? 2 : 0) +
         (qwShowRangeRow ? 1 : 0)

    // Banner mode (regime-only view) renders as a clean colored pill: NO cell
    // borders, NO outer frame, fully transparent table background — the state
    // color on the cells IS the banner. The full table keeps the Table-group
    // border/frame inputs.
    if na(qwTable) or qwTableRows != qwVisibleRows or qwTableColumnsState != qwTableColumns or qwTablePositionState != qwTablePosition or qwTableBannerState != qwRegimeOnlyView
        if not na(qwTable)
            table.delete(table_id = qwTable)
        qwTable := table.new(
             position = qwTablePosition,
             columns = qwTableColumns,
             rows = math.max(1, qwVisibleRows),
             bgcolor = qwRegimeOnlyView ? color.new(color = NORD0, transp = 100) : qwTableBgColor,
             border_width = qwRegimeOnlyView ? 0 : qwTableBorderWidth,
             border_color = qwTableBorderColor,
             frame_width = qwRegimeOnlyView ? 0 : qwTableFrameWidth,
             frame_color = qwTableFrameColor
         )
        qwTableRows := qwVisibleRows
        qwTableColumnsState := qwTableColumns
        qwTablePositionState := qwTablePosition
        qwTableBannerState := qwRegimeOnlyView

    // Column labels — only needed when two % columns are on screen.
    if qwBothColumns
        f_qwHeaderRow(tableId = qwTable, rowIndex = qwRow, headerLabel = "", headerValue = "vs OPEN", bothColumns = true, headerValue2 = "vs CLOSE")
        qwRow += 1

    // Cash block
    if qwShowCash
        f_qwHeaderRow(tableId = qwTable, rowIndex = qwRow, headerLabel = "CASH" + qwRelSuffix,
             headerValue = f_qwFormatPct(pctChange = qwRelativeToSpy ? f_qwNetMeanPrimary(readings = qwCashSource) : qwBothColumns ? qwCashNetVsOpen : qwCashNet),
             bothColumns = qwBothColumns,
             headerValue2 = f_qwFormatPct(pctChange = qwCashNetVsClose))
        qwRow += 1
        for cashReading in qwCashDisplay
            f_qwReadingRow(tableId = qwTable, rowIndex = qwRow, reading = cashReading, isDimmed = false, bothColumns = qwBothColumns)
            qwRow += 1

    // Futures block
    if qwShowFutures
        // The suspected roll doesn't just break the pair check — the futures
        // rows and their net are themselves showing the calendar spread, so
        // the flag belongs on this header, not only in the verdict.
        f_qwHeaderRow(tableId = qwTable, rowIndex = qwRow, headerLabel = (qwRollSuspected ? "FUTURES ⟲" : "FUTURES") + qwRelSuffix,
             headerValue = f_qwFormatPct(pctChange = qwRelativeToSpy ? f_qwNetMeanPrimary(readings = qwFuturesSource) : qwBothColumns ? qwFuturesNetVsOpen : qwFuturesNet),
             bothColumns = qwBothColumns,
             headerValue2 = f_qwFormatPct(pctChange = qwFuturesNetVsClose))
        qwRow += 1
        for futuresReading in qwFuturesDisplay
            f_qwReadingRow(tableId = qwTable, rowIndex = qwRow, reading = futuresReading, isDimmed = false, bothColumns = qwBothColumns)
            qwRow += 1

    // Sectors block — header line surfaces the live green/red counts and
    // their since-open delta (the "color rotation" early-warning signal).
    // Uses ● (filled circle, Nord-themed) in place of emoji circles. Delta
    // arrow is "·" when no open snapshot exists yet (chart loaded mid-session
    // or sector feed degraded) so the user can distinguish "we don't know
    // yet" from "no change". Value cell is tinted by the dominant committed
    // lean — NORD8 (green), NORD11 (red), NORD4 (balanced/none). One color
    // covers both ● symbols because Pine table cells are single-color; the
    // numeric counts disambiguate which is greens (first) vs reds (second).
    // Commodity rows (XLE, XLB) are dimmed when "Discount Commodity Sectors"
    // is on, so it's visually obvious they don't contribute to the verdict.
    if qwShowSectors
        string qwGreensArrow = na(qwGreensDelta) ? "·" : qwGreensDelta > 0 ? "▲" : qwGreensDelta < 0 ? "▼" : "→"
        string qwRedsArrow   = na(qwRedsDelta)   ? "·" : qwRedsDelta   > 0 ? "▲" : qwRedsDelta   < 0 ? "▼" : "→"
        string qwGreensDeltaText = na(qwGreensDelta) ? "" : str.tostring(value = math.abs(number = qwGreensDelta))
        string qwRedsDeltaText   = na(qwRedsDelta)   ? "" : str.tostring(value = math.abs(number = qwRedsDelta))
        string qwSectorHeaderValue = str.format("●{0} {1}{2}  ●{3} {4}{5}",
             qwSectorGreensAll, qwGreensArrow, qwGreensDeltaText,
             qwSectorRedsAll,   qwRedsArrow,   qwRedsDeltaText)
        color qwSectorHeaderValueColor = qwSectorGreensSerious > qwSectorRedsSerious ? color.new(color = NORD8, transp = 0) :
             qwSectorGreensSerious < qwSectorRedsSerious ? color.new(color = NORD11, transp = 0) :
             color.new(color = NORD4, transp = 30)
        table.cell(table_id = qwTable, column = 0, row = qwRow, text = "SECTORS" + qwRelSuffix,
             text_color = color.new(color = NORD9, transp = 0),
             text_halign = text.align_left,
             text_valign = text.align_center,
             text_size = qwTextSize,
             bgcolor = color.new(color = NORD1, transp = 25))
        // In both-columns mode the counts sit in the rightmost column; the
        // middle cell is filled with header background so the row reads as one
        // continuous band.
        if qwBothColumns
            table.cell(table_id = qwTable, column = 1, row = qwRow, text = "",
                 text_size = qwTextSize,
                 bgcolor = color.new(color = NORD1, transp = 25))
        table.cell(table_id = qwTable, column = qwBothColumns ? 2 : 1, row = qwRow, text = qwSectorHeaderValue,
             text_color = qwSectorHeaderValueColor,
             text_halign = text.align_right,
             text_valign = text.align_center,
             text_size = qwTextSize,
             bgcolor = color.new(color = NORD1, transp = 25))
        qwRow += 1
        for sectorReading in qwSectorDisplay
            // Dim only the rows ACTUALLY discounted. The rule became
            // conditional 2026-09-25, so a commodity sector on the MAJORITY
            // side now counts and must not read as excluded.
            int qwSectorRowSign = na(sectorReading.pctChange) ? 0 :
                 sectorReading.pctChange > qwNoiseTier ? 1 :
                 sectorReading.pctChange < -qwNoiseTier ? -1 : 0
            bool qwSectorRowDiscounted = qwIgnoreCommoditySectors and sectorReading.isCommodity and
                 qwSectorMinoritySign != 0 and qwSectorRowSign == qwSectorMinoritySign
            f_qwReadingRow(tableId = qwTable, rowIndex = qwRow, reading = sectorReading, isDimmed = qwSectorRowDiscounted, bothColumns = qwBothColumns)
            qwRow += 1

    // Regime verdict — synthesizes the bifurcation / commitment / data checks.
    // The detail cell carries the dominant-serious ratio, and a ⚠ with the
    // minority count when the sector caution is live. Its tooltip NAMES the
    // split index pairs and the minority sectors: "look at the sectors in the
    // minority… and see what industries they represent" is an explicit
    // numbered rule in the manual that the table never surfaced, and a split
    // cash/futures pair is a veto on THAT market specifically.
    if qwShowRegime
        string qwRegimeDetail = qwDataGap ?
             str.format("C{0}/{1} F{2}/{3} S{4}/{5}",
                  qwCashReceived,    qwCashExpected,
                  qwFuturesReceived, qwFuturesExpected,
                  qwSectorReceived,  qwSectorExpected) :
             str.format("{0}/{1}", math.max(qwSectorGreensSerious, qwSectorRedsSerious), qwSectorTotal) +
                  (qwSectorsCaution ? str.format("  ⚠{0}", qwSectorMinorityCount) : "") +
                  (qwRollSuspected ? "  ⟲roll?" : "") +
                  " · " + qwVerdictBaseline
        // A tie leaves qwSectorMinoritySign at 0, so no names are collected —
        // that is "even split", not "one-sided", and saying the latter on a
        // 50/50 tape would contradict the BIFURCATED verdict next to it.
        string qwMinorityText = array.size(id = qwSectorMinorityNames) > 0 ?
             array.join(id = qwSectorMinorityNames, separator = " ") :
             qwSectorGreens > 0 and qwSectorReds > 0 ?
             str.format("even split — {0} green vs {1} red, no minority", qwSectorGreens, qwSectorReds) :
             "none — sectors are one-sided"
        string qwPairText = array.size(id = qwMisalignedPairNames) == 0 ? "none — every cash/futures pair agrees" :
             array.join(id = qwMisalignedPairNames, separator = " ")
        string qwRegimeDetailTooltip = qwDataGap ?
             "Per-group availability when a feed is missing: C=cash, F=futures, S=sectors. Format: received/expected." :
             "Verdict baseline: " + qwVerdictBaseline + " — tiers in force " + str.tostring(value = qwNoiseTier, format = "0.00") + " / " + str.tostring(value = qwSeriousTier, format = "0.00") + " / " + str.tostring(value = qwCommittedTier, format = "0.00") + "% (noise / serious / committed)." +
             (qwBothBaselines or qwRelativeToSpy ? " This display mode keeps the verdict on vs-close." : "") + "\n\n" +
             "Seriously-moving sector count on the dominant side / total sectors counted.\n\n" +
             "Minority sectors: " + qwMinorityText + "\n" +
             "(\"Look at the sectors in the minority and see what industries they represent.\")\n\n" +
             "Split cash/futures pairs: " + qwPairText + "\n" +
             "(A split pair is a veto on THAT market — \"probably a good time to not trade that market\".)" +
             (qwRollSuspected ?
                  "\n\n⟲ FUTURES ROLL SUSPECTED — every comparable cash/futures pair flipped at once, inside the computed quarterly roll window (second Thursday of Mar/Jun/Sep/Dec ±" + str.tostring(value = QW_ROLL_WINDOW_DAYS) + "d). TradingView's continuous contracts are not back-adjusted, so across the splice today's close belongs to the NEW contract and yesterday's to the OLD one: the futures rows are printing the calendar spread (~0.5-0.7%), not a real move. The pair check is suppressed and the FUTURES rows and net should be ignored today." : "") +
             (qwSectorsCaution ? "\n\n⚠ More than 25% of counted sectors are the minority color — be more cautious about letting profits run. COMMITTED is capped off." : "")
        if qwRegimeOnlyView
            // Standalone banner: padded verdict text, banner-size font, input
            // text color on the solid state color. NBSP padding (plain spaces
            // get trimmed in table cells) gives the pill breathing room since
            // cells have no padding control.
            int qwBannerTextSize = qwRegimeBannerTextSize == 0 ? qwTextSize : qwRegimeBannerTextSize
            table.cell(table_id = qwTable, column = 0, row = qwRow, text = " " + qwRegimeText + " ",
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_center,
                 text_valign = text.align_center,
                 text_size = qwBannerTextSize,
                 bgcolor = qwRegimeColor,
                 tooltip = qwRegimeTooltip)
            table.cell(table_id = qwTable, column = 1, row = qwRow, text = " " + qwRegimeDetail + " ",
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_center,
                 text_valign = text.align_center,
                 text_size = qwBannerTextSize,
                 bgcolor = qwRegimeColor,
                 tooltip = qwRegimeDetailTooltip)
            qwRow += 1
        else
            f_qwHeaderRow(tableId = qwTable, rowIndex = qwRow, headerLabel = "REGIME", headerValue = qwBothColumns ? "" : "Verdict " + qwVerdictBaseline, bothColumns = qwBothColumns, headerValue2 = "Verdict " + qwVerdictBaseline)
            qwRow += 1
            table.cell(table_id = qwTable, column = 0, row = qwRow, text = qwRegimeText,
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_left,
                 text_valign = text.align_center,
                 text_size = qwTextSize,
                 bgcolor = qwRegimeColor,
                 tooltip = qwRegimeTooltip)
            if qwBothColumns
                table.cell(table_id = qwTable, column = 1, row = qwRow, text = "",
                     text_size = qwTextSize,
                     bgcolor = qwRegimeColor)
            table.cell(table_id = qwTable, column = qwBothColumns ? 2 : 1, row = qwRow, text = qwRegimeDetail,
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_right,
                 text_valign = text.align_center,
                 text_size = qwTextSize,
                 bgcolor = qwRegimeColor,
                 tooltip = qwRegimeDetailTooltip)
            qwRow += 1

    // ─── Opening-range row — same shape as the verdict row, drawn beneath it.
    // Independently toggled, so it can be the ONLY row on screen.
    if qwShowRangeRow
        if qwRegimeOnlyView
            int qwRangeBannerSize = qwRegimeBannerTextSize == 0 ? qwTextSize : qwRegimeBannerTextSize
            table.cell(table_id = qwTable, column = 0, row = qwRow, text = " " + qwRangeText + " ",
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_center,
                 text_valign = text.align_center,
                 text_size = qwRangeBannerSize,
                 bgcolor = qwRangeColor,
                 tooltip = qwRangeTooltip)
            table.cell(table_id = qwTable, column = 1, row = qwRow, text = " " + qwRangeDetail + " ",
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_center,
                 text_valign = text.align_center,
                 text_size = qwRangeBannerSize,
                 bgcolor = qwRangeColor,
                 tooltip = qwRangeTooltip)
        else
            table.cell(table_id = qwTable, column = 0, row = qwRow, text = qwRangeText,
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_left,
                 text_valign = text.align_center,
                 text_size = qwTextSize,
                 bgcolor = qwRangeColor,
                 tooltip = qwRangeTooltip)
            if qwBothColumns
                table.cell(table_id = qwTable, column = 1, row = qwRow, text = "", text_size = qwTextSize, bgcolor = qwRangeColor)
            table.cell(table_id = qwTable, column = qwBothColumns ? 2 : 1, row = qwRow, text = qwRangeDetail,
                 text_color = qwRegimeTextColor,
                 text_halign = text.align_right,
                 text_valign = text.align_center,
                 text_size = qwTextSize,
                 bgcolor = qwRangeColor,
                 tooltip = qwRangeTooltip)
        qwRow += 1
