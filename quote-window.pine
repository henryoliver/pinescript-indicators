//@version=6
indicator(title = "Quote Window", shorttitle = "🪟 QW", overlay = true)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette
// and the commitment thresholds derived from the Quote Window methodology.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0  = #2E3440
const color NORD1  = #3B4252
const color NORD2  = #434C5E
const color NORD3  = #4C566A
// Snow Storm
const color NORD4  = #D8DEE9
const color NORD5  = #E5E9F0
const color NORD6  = #ECEFF4
// Frost
const color NORD7  = #8FBCBB
const color NORD8  = #88C0D0
const color NORD9  = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// Commitment tiers. Boundaries are asymmetric on purpose: the NOISE cutoff is
// INCLUSIVE (a reading at exactly ±0.2% is noise, so colour counts use STRICT
// >), while serious and committed are inclusive from below.
//   |%| ≤ 0.2  noise — treat as neutral, the colour means nothing
//   0.2 → 0.5  drift — the colour counts, conviction doesn't
//   ≥ 0.5      serious
//   ≥ 1.0      committed to its posture
const float QW_NOISE_THRESHOLD       = 0.2
const float QW_SERIOUS_THRESHOLD     = 0.5
const float QW_COMMITTED_THRESHOLD   = 1.0
// "Today's Open" tier scale. The 0.2/0.5/1.0 tiers are calibrated on change vs
// YESTERDAY'S CLOSE; measured from the open the same tape moves less (median
// |sector %| at 10:00 is 0.299 vs-open against 0.466 vs-close, SPY + QQQ,
// 1,041 sessions), so the unscaled tiers collapse COMMITTED from ~9% of days
// to ~1%. Under that baseline every tier is multiplied by 0.299 / 0.466 —
// the same tiers, measured on the same share of the tape. Derived here.
const float QW_OPEN_TIER_SCALE       = 0.64
// Regime fractions, applied to SERIOUS sector counts (≥0.5%): ≥75% one-sided =
// committed, 50-75% = mild. Derived here, not inherited.
const float QW_COMMITTED_FRACTION    = 0.75
const float QW_MILD_FRACTION         = 0.50
// Sector mixture gates — SECTORS ONLY, and GRADED rather than binary. Sectors
// are never the hard veto that indexes are: past a 25% minority the verdict is
// CAPPED below COMMITTED (a be-more-careful-with-exits state), and only near a
// 50/50 split do the sectors themselves read BIFURCATED. Counted against
// COLOURS beyond the noise floor, not against serious/committed counts — a
// sector at −0.4% is red for this rule.
// 0.45 is a quantification of "close to evenly split", in the same class as the
// 75/50 commitment fractions below: derived here, not inherited.
const float QW_MINORITY_FRACTION     = 0.25
const float QW_SECTOR_SPLIT_FRACTION = 0.45
// Indexes get NO tolerance: every index in cash and futures must be one colour
// or the other, so a single off-colour index beyond ±0.2% bifurcates the group
// (noise threshold, zero minority gate). Applying the ±0.2% floor to indexes is
// an interpretation — the rule as stated names no floor for them.
// Futures roll window. CME equity-index contracts expire the third Friday of
// Mar/Jun/Sep/Dec and TradingView's continuous `1!` series splices to the next
// front month when volume migrates — nominally the SECOND THURSDAY, exactly
// eight days before expiry, and that relationship is fixed (verified across
// 2024-2030). Continuous contracts are NOT back-adjusted by default and B-ADJ
// is a chart setting that a foreign request.security ignores, so across the
// splice `close` is the new contract while `close[1]` is the old one's final
// close: the row prints the calendar spread (~0.5-0.7% at current carry) as a
// phantom move, above the 0.5% "serious" tier, on all four futures at once.
// The actual splice is volume-driven so it can land a day or two off nominal —
// hence a window rather than a single date.
const int   QW_ROLL_WINDOW_DAYS      = 2
// NYSE RTH windows. The OPEN window is deliberately NARROW (2026-09-26 bug
// fix). Testing "am I inside 0930-1600" and looking for a false→true edge does
// NOT detect a new session on an RTH-ONLY chart: every bar is inside that
// window, so the edge fires once on the first loaded bar and never again. This
// repo has been bitten by it before (composite-breadth's daily reseeds
// silently stopped after day one). Pinning the edge to a five-minute window at
// the open fires reliably on BOTH RTH-only and extended-hours charts.
const string QW_SESSION_RTH_OPEN = "0930-0935:23456"
const string QW_SESSION_RTH_FULL = "0930-1600:23456"
// Partial-data gap — if an enabled group returns less than this fraction of
// its expected symbols, treat as DATA GAP. Catches degraded feeds where the
// verdict would otherwise quietly run on too few inputs.
const float QW_PARTIAL_GAP_FRACTION  = 0.5

// ═════════════════════════════════════════════════════════════════════════════
// 🧩 TYPE DEFINITIONS
// Compact records used to keep the three symbol groups (cash / futures /
// sectors) iterable from a single rendering loop.
// ═════════════════════════════════════════════════════════════════════════════
// pctChange is the PRIMARY read used by ALL verdict math and single-baseline
// display, and it follows the % Change Baseline input: vs prior daily close by
// default ("amateurs watch the open and pros watch the close"), vs today's
// open when that baseline is selected. In "Both" and "vs SPY" modes the
// primary is vs-close (the relative rebase happens on display copies only).
// pctChangeVsOpen and pctChangeVsClose are always populated so the two-column
// "Both" view is free. FUTURES vs-open is measured from the price at the 09:30
// CASH open, not from the globex daily open (~18:00 ET prior day), so every
// group's "today's open" means the same moment and cash↔futures pairs stay
// comparable under either baseline.
type QwReading
    string label
    float  pctChange
    float  pctChangeVsOpen
    float  pctChangeVsClose
    bool   isCommodity

// ═════════════════════════════════════════════════════════════════════════════
// 🪟 QUOTE WINDOW
// Intermarket commitment monitor. Reads 4 cash indexes, 4 futures indexes,
// and the 11 SPDR sector ETFs to answer: "Is the broad market committed
// enough to one direction today to trust trends?" Companion to CBI — CBI
// gives the direction, this gives the conviction filter.
//
// REPLAY-ACCURATE as of 2026-09-26. Every value the table shows is sourced
// where it is honestly available at the bar being drawn: the current price
// comes from a chart-timeframe request (nothing to look ahead into), and only
// the prior daily close and today's daily open come from a lookahead_on daily
// request — both of which are settled before the bar exists. Bar Replay,
// history and live therefore all read the same. Nothing in this file
// repaints, and the rotation snapshot no longer needs a live-data gate.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_QW_GENERAL = "⚙️ General"
const string GROUP_QW_TABLE   = "📋 Table"
const string GROUP_QW_CASH    = "💵 Cash Indexes"
const string GROUP_QW_FUTURES = "📈 Futures Indexes"
const string GROUP_QW_SECTORS = "🏛️ Sectors"
const string GROUP_QW_REGIME  = "🧭 Regime"

string qwBaselineMode = input.string(
     defval = "Yesterday's Close",
     title = "% Change Baseline",
     options = ["Yesterday's Close", "Today's Open", "Both", "vs SPY (relative)"],
     tooltip = "Default 'Yesterday's Close' is the conventional reading — the close is the number professionals mark against. 'vs SPY (relative)' subtracts SPY's own change from every row, reproducing the source's sector routine — a TradingView PERCENT-CHANGE chart with SPY overlaid as a thick black line, where the read is each sector against the benchmark rather than against zero. Sorted, that ranks true out- and under-performers: his stated preference is to buy the UNDERperformer breaking its own prior high BEFORE it crosses back above SPY (the early/late principle — once it is parabolic above SPY there is no cycle low left to enter on). SPY's own row reads 0.00% because it is the benchmark; the verdict stays on vs-close here, because index bifurcation against SPY itself is meaningless. 'Today's Open' is the pure-intraday read: cash and sector ETFs from their 09:30 open, and FUTURES from their price at the 09:30 cash open (not the globex open), so the overnight gap is out of every row. The VERDICT, the pair check and the row colours all switch to it, with the 0.2/0.5/1.0 tiers scaled ×0.64 (0.13/0.32/0.64) because moves from the open are smaller. 'Both' shows the two baselines side by side, the way the source keeps both columns up; the verdict then runs on vs-close. The verdict row always names the baseline it ran on. Prices are read at the CHART's timeframe, so on an extended-hours chart the rows move during pre-market; on an RTH-only chart they start at the open.",
     group = GROUP_QW_GENERAL
 )

string qwTablePosition = input.string(
     defval = position.top_right,
     title = "Position",
     options = [position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right],
     tooltip = "Where the table anchors on the chart. Default top-right keeps it out of the price action's way.",
     group = GROUP_QW_TABLE
 )

int qwTextSize = input.int(
     defval = 10,
     title = "Text Size",
     minval = 0,
     maxval = 36,
     tooltip = "Font size in typographic points; 0 = auto. Equivalents of the old presets: Tiny = 8, Small = 10, Normal = 14, Large = 20.",
     group = GROUP_QW_TABLE
 )

bool qwSortRows = input.bool(
     defval = true,
     title = "Sort Rows by % Change",
     tooltip = "Sort each group's rows by net percent change, descending — green at the top, red at the bottom. The market-selection read falls straight out of the ordering: on a directional day, trade the leaders at the top (or laggards at the bottom), not the middle. Display-only — the regime verdict and the cash↔futures pair check always run on the fixed symbol order. Sorts on the primary baseline; in 'Both' mode that is vs CLOSE. Off = fixed symbol order (SPY/QQQ/DIA/IWM etc.).",
     group = GROUP_QW_TABLE
 )

color qwTableBgColor = input.color(
     defval = color.new(color = NORD0, transp = 20),
     title = "Background",
     tooltip = "Table background. Default is Polar Night at 20% transparency so the chart stays readable behind the window.",
     group = GROUP_QW_TABLE
 )

int qwTableBorderWidth = input.int(
     defval = 0,
     title = "Border Width",
     minval = 0,
     maxval = 5,
     inline = "qw_table_border",
     group = GROUP_QW_TABLE
 )

color qwTableBorderColor = input.color(
     defval = color.new(color = NORD1, transp = 70),
     title = "Border Color",
     inline = "qw_table_border",
     tooltip = "Width and color of the inner cell borders. Width 0 removes them.",
     group = GROUP_QW_TABLE
 )

int qwTableFrameWidth = input.int(
     defval = 0,
     title = "Frame Width",
     minval = 0,
     maxval = 5,
     inline = "qw_table_frame",
     group = GROUP_QW_TABLE
 )

color qwTableFrameColor = input.color(
     defval = color.new(color = NORD2, transp = 50),
     title = "Frame Color",
     inline = "qw_table_frame",
     tooltip = "Width and color of the outer table frame. Width 0 removes it.",
     group = GROUP_QW_TABLE
 )

bool qwShowCash = input.bool(
     defval = false,
     title = "Show Cash Indexes",
     tooltip = "SPY, QQQ, DIA, IWM — the four major US cash index ETFs. Bifurcation here = unresolved sentiment. Display only; the regime verdict always considers cash, futures, and sectors regardless of this toggle.",
     group = GROUP_QW_CASH
 )

bool qwShowFutures = input.bool(
     defval = false,
     title = "Show Futures Indexes",
     tooltip = "ES1!, NQ1!, YM1!, RTY1! — the corresponding E-mini front-month continuous futures. Useful as a sentiment check against the cash side. Display only; the regime verdict always considers cash, futures, and sectors regardless of this toggle.",
     group = GROUP_QW_FUTURES
 )

bool qwShowSectors = input.bool(
     defval = false,
     title = "Show Sectors",
     tooltip = "The 11 SPDR Select Sector ETFs. Sector dispersion is the dimension ADD/VOLD can't see — ADD aggregates every stock into one count and hides rotation. Display only; the regime verdict always considers cash, futures, and sectors regardless of this toggle.",
     group = GROUP_QW_SECTORS
 )

bool qwIgnoreCommoditySectors = input.bool(
     defval = true,
     title = "Discount Commodity Sectors (XLE, XLB)",
     tooltip = "Commodity sectors trade on their own drivers and are a weaker read on equity sentiment than the rest. CONDITIONAL by design: a commodity sector is only discounted when it sits on the MINORITY side. On a green day with XLE and XLB red they drop out; on a green day with XLE and XLB green they count normally. (Until 2026-09-25 this excluded them unconditionally, which also threw away their votes when they were part of the majority.)",
     group = GROUP_QW_SECTORS
 )

bool qwShowRegime = input.bool(
     defval = true,
     title = "Show Regime Verdict",
     tooltip = "Synthesizes five checks (cash bifurcation, futures bifurcation, sector bifurcation, cash↔futures misalignment, data gap) into a single tradability call: COMMITTED / MILD / LOW CONV / BIFURCATED / DATA GAP. Standalone banner mode: leave this ON and turn OFF Show Cash/Futures/Sectors — the verdict then renders alone as a borderless colored banner sized by Banner Text Size.",
     group = GROUP_QW_REGIME
 )

int qwRegimeBannerTextSize = input.int(
     defval = 14,
     title = "Banner Text Size",
     minval = 0,
     maxval = 36,
     tooltip = "Text size of the verdict when it renders as the STANDALONE banner (Show Regime on, all three groups hidden). 0 = follow the table Text Size. The regime row inside the full table always follows the table Text Size.",
     group = GROUP_QW_REGIME
 )

color qwRegimeTextColor = input.color(
     defval = NORD0,
     title = "Text",
     tooltip = "Verdict text color, used verbatim. Default is dark Polar Night — every default state background below is a light/mid Nord tone, so dark text keeps high contrast across all of them.",
     group = GROUP_QW_REGIME
 )

color qwRegimeCommittedUpColor = input.color(
     defval = NORD8,
     title = "Committed ↑",
     inline = "qw_regime_committed",
     group = GROUP_QW_REGIME
 )

color qwRegimeCommittedDownColor = input.color(
     defval = NORD11,
     title = "↓",
     inline = "qw_regime_committed",
     tooltip = "Background for the COMMITTED verdict, up / down. All state colors are used VERBATIM — pick transparency in the swatch itself if wanted; conviction strength reads from the detail number, not from opacity.",
     group = GROUP_QW_REGIME
 )

color qwRegimeMildUpColor = input.color(
     defval = NORD7,
     title = "Mild ↑",
     inline = "qw_regime_mild",
     group = GROUP_QW_REGIME
