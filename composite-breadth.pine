//@version=6
// dynamic_requests: the breadth symbols are built from inputs and two requests
// are gated on their weight — both need dynamic requests.
indicator(title = "Composite Breadth Indicator", shorttitle = "📊 CBI", format = format.price, precision = 2, max_labels_count = 500, dynamic_requests = true)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0 = #2E3440
const color NORD1 = #3B4252
const color NORD2 = #434C5E
const color NORD3 = #4C566A
// Snow Storm
const color NORD4 = #D8DEE9
const color NORD5 = #E5E9F0
const color NORD6 = #ECEFF4
// Frost
const color NORD7 = #8FBCBB
const color NORD8 = #88C0D0
const color NORD9 = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// NYSE session windows (ET, Mon–Fri). The RTH-open edge is a NARROW five-minute
// window: a false→true edge on "inside 09:30-16:00" never fires again on an
// RTH-only chart, where every bar is inside it.
const string CBI_SESSION_RTH_OPEN       = "0930-0935:23456"
const string CBI_SESSION_RTH_FULL       = "0930-1600:23456"
const string CBI_SESSION_PREMARKET      = "0700-0930:23456"   // the USI breadth feeds start printing at 07:00 ET
const string CBI_SESSION_PREMARKET_OPEN = "0700-0705:23456"
const string CBI_SESSION_BREADTH_HOURS  = "0700-1600:23456"   // where the line draws; post-market is blanked
const string CBI_SESSION_MOC            = "1545-1600:23456"   // market-on-close: TICK is program-trade noise, CUMTICK holds its last reading

// ═════════════════════════════════════════════════════════════════════════════
// 📊 COMPOSITE BREADTH
// Five legs read the cash market's internals, each normalised to ±1 and
// blended into one ±100 line:
//   VOLD     up-volume minus down-volume ÷ total volume, counted from 09:30
//            (premarket volume leans bullish and would tilt the first hour)
//   ADD      advancers minus decliners ÷ a per-market issue scale
//   %VWAP    percent of stocks above their VWAP, centred on 50
//   CUMTICK  10-minute slope of bias-adjusted cumulative TICK — cash session
//            only
//   NQ PREM  how far NQ1! has run ahead of the chart's price since 09:30 —
//            cash session only, Nasdaq-listed charts only
// Before 09:30 the line runs on VOLD/ADD/%VWAP from 07:00, each recentred on
// its own ~20-session premarket average (the raw premarket feeds lean bullish
// almost every day).
//
// The line is context — the day's internals; the ◆ markers are the reversal
// read.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_CBI = "📊 Composite Breadth"
const string GROUP_CBI_WEIGHTS = "⚖️ Weights"

// Thin and neutral so the signal MA reads as the primary line.
const color CBI_LINE_COLOR = NORD3

const float CBI_SCALE_MAX                    = 100.0
const float CBI_DISPLAY_SMOOTH_MINUTES       = 6.0      // light EMA on the plotted line, in minutes (3 bars on 2-min)
const float CBI_CUMTICK_SLOPE_MINUTES        = 10.0     // cumulative-TICK slope lookback
const float CBI_CUMTICK_SLOPE_SMOOTH_MINUTES = 10.0     // EMA on that slope before normalising — the raw slope flips sign constantly
const float CBI_TICK_FIXED_SCALE             = 500.0    // cumTICK saturation: TICK averaging ±500 across the slope window (NYSE), scaled per universe
const float CBI_TICK_BIAS_DAYS               = 20.0     // Adjusted TICK: trailing ~20-day TICK mean subtracted before cumulating
const float CBI_PREMARKET_BIAS_DAYS          = 20.0     // trailing window of the premarket de-bias
const float CBI_NQ_PREMIUM_SCALE             = 0.0005   // NQ PREMIUM saturates at a 5 bp move of NQ1!/price from its 09:30 value

const string CBI_UNIVERSES_TT = "\n\n🌐 .US All Markets · .NY NYSE · .NQ NASDAQ · .DJ Dow Jones · .AX NYSE Arca · .AM NYSE American"

cbiMarket = input.string(defval = "NASDAQ", title = "Breadth Universe",
     options = ["US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "🌐 Fallback for any leg set to 'Same as Breadth Universe'.\n• NASDAQ (default) — QQQ, NQ, Nasdaq stocks\n• NYSE — SPY, ES", group = GROUP_CBI, display = display.none)
cbiVoldUniverse = input.string(defval = "NASDAQ", title = "VOLD Universe",
     options = ["Same as Breadth Universe", "US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "💰 Up/down volume ÷ total volume (USI:ADVDECV / USI:TVOL).\n• Default NASDAQ — strongest for QQQ" + CBI_UNIVERSES_TT, group = GROUP_CBI, display = display.none)
cbiAddUniverse = input.string(defval = "NYSE", title = "A-D Universe",
     options = ["Same as Breadth Universe", "US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "📈 Advancers − decliners (USI:ADVDEC).\n• Default NYSE — Nasdaq issue counts are distorted by small-cap listing churn" + CBI_UNIVERSES_TT, group = GROUP_CBI, display = display.none)
cbiPctVwapUniverse = input.string(defval = "NYSE", title = "%VWAP Universe",
     options = ["Same as Breadth Universe", "US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "🎯 Percent of stocks above their VWAP (USI:PCTABOVEVWAP).\n• Default NYSE" + CBI_UNIVERSES_TT, group = GROUP_CBI, display = display.none)
cbiTickUniverse = input.string(defval = "NYSE", title = "TICK Universe",
     options = ["Same as Breadth Universe", "US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "⚡ Upticks − downticks across the market.\n• Default NYSE → the classic USI:TICK ($TICK), not the ~3× smaller TICK.NY\n• TICK.NQ makes the composite worse" + CBI_UNIVERSES_TT, group = GROUP_CBI, display = display.none)
cbiShowZeroLine = input.bool(defval = true, title = "Show Zero Line",
     tooltip = "➖ Zero = balanced internals.\n• Above = the cash market is net buying\n• Below = net selling\n• Context, not a trigger", group = GROUP_CBI, display = display.none)

// Weights — only the ratios matter. VOLD carries the most because it is the
// steadiest leg; %VWAP and CUMTICK swing hardest, so small weights already
// move the line; NQ above ~40 would turn the line into futures premium
// rather than breadth.
const string CBI_WEIGHT_TT = "\n\n⚖️ Only the ratios between weights matter · 0 = leg off (no request)"
cbiVoldWeight = input.float(defval = 75, title = "VOLD", minval = 0, maxval = 100, step = 5,
     tooltip = "💰 Up-volume vs down-volume — the money behind the move.\n• Default 75 — the steadiest leg, so it carries the most weight" + CBI_WEIGHT_TT, group = GROUP_CBI_WEIGHTS)
cbiAddWeight = input.float(defval = 5, title = "ADD", minval = 0, maxval = 100, step = 5,
     tooltip = "📈 Advancers − decliners — how many stocks join the move.\n• Default 5 — more weight hurts the direction read" + CBI_WEIGHT_TT, group = GROUP_CBI_WEIGHTS)
cbiPctVwapWeight = input.float(defval = 10, title = "PCTABOVEVWAP", minval = 0, maxval = 100, step = 5,
     tooltip = "🎯 % of stocks above their VWAP — positioning vs the institutional benchmark.\n• Default 10 — loud and close to price, a little goes a long way" + CBI_WEIGHT_TT, group = GROUP_CBI_WEIGHTS)
cbiCumTickWeight = input.float(defval = 20, title = "CUMTICK", minval = 0, maxval = 100, step = 5,
     tooltip = "⚡ Slope of cumulative TICK — the print-by-print rhythm.\n• Default 20 — swings hardest of the five\n• Cash session only" + CBI_WEIGHT_TT, group = GROUP_CBI_WEIGHTS)
cbiNqPremiumWeight = input.float(defval = 40, title = "NQ PREMIUM", minval = 0, maxval = 100, step = 5,
     tooltip = "🚀 NQ1! running rich or cheap vs the chart's price since 09:30 — futures lead price discovery.\n• Default 40\n• Cash session, Nasdaq-listed charts only (off on SPY)\n• Needs real-time CME data — set 0 without it" + CBI_WEIGHT_TT, group = GROUP_CBI_WEIGHTS)

// Universe routing — one dotted USI suffix per leg.
f_cbiResolveUniverse(string universe) =>
    universe == "Same as Breadth Universe" ? cbiMarket : universe

f_cbiUsiSuffix(string universe) =>
    switch universe
        "US All Markets" => "US"
        "NYSE"           => "NY"
        "NASDAQ"         => "NQ"
        "Dow Jones"      => "DJ"
        "NYSE Arca"      => "AX"
        "NYSE American"  => "AM"
        => "NQ"

string cbiVoldUniverseResolved    = f_cbiResolveUniverse(universe = cbiVoldUniverse)
string cbiAddUniverseResolved     = f_cbiResolveUniverse(universe = cbiAddUniverse)
string cbiPctVwapUniverseResolved = f_cbiResolveUniverse(universe = cbiPctVwapUniverse)
string cbiTickUniverseResolved    = f_cbiResolveUniverse(universe = cbiTickUniverse)
string cbiVoldSuffix    = f_cbiUsiSuffix(universe = cbiVoldUniverseResolved)
string cbiAddSuffix     = f_cbiUsiSuffix(universe = cbiAddUniverseResolved)
string cbiPctVwapSuffix = f_cbiUsiSuffix(universe = cbiPctVwapUniverseResolved)
string cbiTickSuffix    = f_cbiUsiSuffix(universe = cbiTickUniverseResolved)

// Per-universe calibration. ADD saturates at the typical extremes (NYSE
// ±2,000, Nasdaq ±2,500, scaled by issue count elsewhere); %VWAP saturates at
// the 35/65 rails on the liquid tapes and wider on the narrow or correlated
// ones; TICK levels scale by an issue-count factor.
float cbiAddScale = switch cbiAddUniverseResolved
    "US All Markets" => 4500.0
    "NYSE"           => 2000.0
    "NASDAQ"         => 2500.0
    "Dow Jones"      => 27.0
    "NYSE Arca"      => 2000.0
    "NYSE American"  => 200.0
    => 2500.0
float cbiPctVwapBand = switch cbiPctVwapUniverseResolved
    "Dow Jones"     => 20.0
    "NYSE Arca"     => 30.0
    "NYSE American" => 30.0
    => 15.0
float cbiTickMarketFactor = switch cbiTickUniverseResolved
    "US All Markets" => 2.25
    "NYSE"           => 1.0
    "NASDAQ"         => 1.25
    "Dow Jones"      => 0.026
    "NYSE Arca"      => 1.6
    "NYSE American"  => 0.17
    => 1.25

// Minutes → bars, so the windows keep their meaning on 1/2/3/6-minute charts.
f_cbiBars(float minutes, int floorBars) =>
    math.max(floorBars, math.round(number = minutes * 60.0 / timeframe.in_seconds()))

int   cbiDisplaySmoothBars       = f_cbiBars(minutes = CBI_DISPLAY_SMOOTH_MINUTES, floorBars = 1)
int   cbiCumTickSlopeWindow      = f_cbiBars(minutes = CBI_CUMTICK_SLOPE_MINUTES, floorBars = 2)
int   cbiCumTickSlopeSmoothBars  = f_cbiBars(minutes = CBI_CUMTICK_SLOPE_SMOOTH_MINUTES, floorBars = 2)
int   cbiTickBiasWindowBars      = f_cbiBars(minutes = CBI_TICK_BIAS_DAYS * 390.0, floorBars = 10)
int   cbiPremarketBiasBars       = f_cbiBars(minutes = CBI_PREMARKET_BIAS_DAYS * 150.0, floorBars = 10)
float cbiCumTickSlopeScale       = cbiCumTickSlopeWindow * CBI_TICK_FIXED_SCALE * cbiTickMarketFactor

// Data requests. Every USI feed is requested on its EXTENDED session so the
// premarket arrives on an extended-hours chart and close[1] on the 09:30 bar
// is the last premarket print on any chart (the RTH-only VOLD baseline).
// gaps_on: no feed = na, never a stale forward-filled value. Chart timeframe
// throughout, so lookahead_off has nothing to look ahead into.
f_cbiUsiTicker(string feed, string suffix) =>
    ticker.new(prefix = "USI", ticker = feed + "." + suffix, session = session.extended)

float cbiAddNet = request.security(symbol = f_cbiUsiTicker(feed = "ADVDEC", suffix = cbiAddSuffix), timeframe = timeframe.period,
     expression = close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[cbiVoldNet, cbiVoldNetPrior] = request.security(symbol = f_cbiUsiTicker(feed = "ADVDECV", suffix = cbiVoldSuffix), timeframe = timeframe.period,
     expression = [close, close[1]], gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[cbiTotalVol, cbiTotalVolPrior] = request.security(symbol = f_cbiUsiTicker(feed = "TVOL", suffix = cbiVoldSuffix), timeframe = timeframe.period,
     expression = [close, close[1]], gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
float cbiPctVwap = request.security(symbol = f_cbiUsiTicker(feed = "PCTABOVEVWAP", suffix = cbiPctVwapSuffix), timeframe = timeframe.period,
     expression = close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

// NYSE TICK routes to the classic USI:TICK (cash session only by nature).
float cbiTickRaw = na
if cbiCumTickWeight > 0.0
    cbiTickRaw := request.security(symbol = cbiTickSuffix == "NY" ? "USI:TICK" : "USI:TICK." + cbiTickSuffix, timeframe = timeframe.period,
         expression = close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

bool  cbiNqEligible = syminfo.prefix == "NASDAQ"
float cbiNqClose = na
if cbiNqPremiumWeight > 0.0 and cbiNqEligible
    cbiNqClose := request.security(symbol = ticker.new(prefix = "CME_MINI", ticker = "NQ1!", session = session.extended), timeframe = timeframe.period,
         expression = close, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

// Session edges. The line's own state reseeds at 07:00 AND 09:30 so the
// premarket starts clean and the cash session starts on its own state.
bool cbiInRthOpen        = not na(time(timeframe = timeframe.period, session = CBI_SESSION_RTH_OPEN, timezone = "America/New_York"))
bool cbiSessionOpened    = cbiInRthOpen and not cbiInRthOpen[1]
bool cbiInPremarketOpen  = not na(time(timeframe = timeframe.period, session = CBI_SESSION_PREMARKET_OPEN, timezone = "America/New_York"))
bool cbiLineReset        = cbiSessionOpened or (cbiInPremarketOpen and not cbiInPremarketOpen[1])
bool cbiInPremarket      = not na(time(timeframe = timeframe.period, session = CBI_SESSION_PREMARKET, timezone = "America/New_York"))
bool cbiInBreadthHours   = not na(time(timeframe = timeframe.period, session = CBI_SESSION_BREADTH_HOURS, timezone = "America/New_York"))
bool cbiInRth            = not na(time(timeframe = timeframe.period, session = CBI_SESSION_RTH_FULL, timezone = "America/New_York"))
bool cbiInMoc            = not na(time(timeframe = timeframe.period, session = CBI_SESSION_MOC, timezone = "America/New_York"))

var int cbiBarsSinceReset = 0
cbiBarsSinceReset := cbiLineReset ? 1 : cbiBarsSinceReset + 1

// Helper function — one EWMA step, seeding from the first sample.
f_cbiEwma(float previous, float sample, float length) =>
    float ewmaAlpha = 2.0 / (length + 1.0)
    na(previous) ? sample : ewmaAlpha * sample + (1.0 - ewmaAlpha) * previous

// Helper function — clamp to the ±1 confidence scale (na passes through).
f_cbiClamp(float value) =>
    na(value) ? na : math.max(-1.0, math.min(1.0, value))

// VOLD, RTH-only from 09:30: both cumulative feeds are read net of their last
// premarket print, so the structurally bullish premarket volume does not tilt
// the cash session.
var float cbiVoldBase = na
var float cbiTotalVolBase = na
if cbiLineReset
    cbiVoldBase     := cbiSessionOpened ? cbiVoldNetPrior : na
    cbiTotalVolBase := cbiSessionOpened ? cbiTotalVolPrior : na
bool  cbiVoldBaseValid = cbiInRth and not na(cbiVoldBase) and not na(cbiTotalVolBase) and not na(cbiTotalVol) and cbiTotalVol > cbiTotalVolBase
float cbiVoldConfidence = cbiVoldBaseValid ? f_cbiClamp(value = (cbiVoldNet - cbiVoldBase) / (cbiTotalVol - cbiTotalVolBase)) :
     not na(cbiTotalVol) and cbiTotalVol > 0.0 ? f_cbiClamp(value = cbiVoldNet / cbiTotalVol) : na

float cbiAddConfidence     = f_cbiClamp(value = cbiAddNet / cbiAddScale)
float cbiPctVwapConfidence = f_cbiClamp(value = (cbiPctVwap - 50.0) / cbiPctVwapBand)

// CUMTICK — cash session only. Bias-adjusted TICK summed from the open; the
// smoothed 10-minute slope is the reading; it holds through the MOC window.
float cbiTick = cbiInRth ? cbiTickRaw : na
var float cbiTickBias = na
if not na(cbiTick)
    cbiTickBias := f_cbiEwma(previous = cbiTickBias, sample = cbiTick, length = cbiTickBiasWindowBars)
float cbiTickAdjusted = na(cbiTick) ? na : cbiTick - nz(source = cbiTickBias)
var float cbiCumTick = na
if cbiLineReset or na(cbiCumTick)
    cbiCumTick := cbiTickAdjusted
else if not na(cbiTickAdjusted)
    cbiCumTick += cbiTickAdjusted
float cbiCumTickSlope = cbiBarsSinceReset > cbiCumTickSlopeWindow ? cbiCumTick - cbiCumTick[cbiCumTickSlopeWindow] : na
var float cbiCumTickSlopeSmoothed = na
if cbiLineReset or na(cbiCumTickSlope)
    cbiCumTickSlopeSmoothed := na
if not na(cbiCumTickSlope)
    cbiCumTickSlopeSmoothed := f_cbiEwma(previous = cbiCumTickSlopeSmoothed, sample = cbiCumTickSlope, length = cbiCumTickSlopeSmoothBars)
var float cbiCumTickHeld = na
float cbiCumTickLive = f_cbiClamp(value = cbiCumTickSlopeSmoothed / cbiCumTickSlopeScale)
if not cbiInMoc
    cbiCumTickHeld := cbiCumTickLive
float cbiCumTickConfidence = cbiInMoc ? cbiCumTickHeld : cbiCumTickLive

// NQ PREMIUM — NQ1!/price against its first cash-session value (blind to the
// fair-value basis and the quarterly roll, which only move it between days).
var float cbiNqAnchor = na
float cbiNqRatio = not na(cbiNqClose) and close > 0.0 ? cbiNqClose / close : na
if cbiSessionOpened
    cbiNqAnchor := na
if cbiInRth and na(cbiNqAnchor) and not na(cbiNqRatio)
    cbiNqAnchor := cbiNqRatio
float cbiNqConfidence = cbiInRth and not na(cbiNqAnchor) ? f_cbiClamp(value = (cbiNqRatio / cbiNqAnchor - 1.0) / CBI_NQ_PREMIUM_SCALE) : na

// Premarket de-bias — each premarket leg recentred on its own trailing
// premarket mean (as of the PRIOR premarket bar), then the mean folds this
// bar in. Without it the premarket line sits above zero almost every day.
var float cbiVoldPremarketBias = na
var float cbiAddPremarketBias = na
var float cbiPctVwapPremarketBias = na
if cbiInPremarket
    float cbiVoldPremarketRaw = cbiVoldConfidence
    float cbiAddPremarketRaw = cbiAddConfidence
    float cbiPctVwapPremarketRaw = cbiPctVwapConfidence
    cbiVoldConfidence    := f_cbiClamp(value = cbiVoldPremarketRaw - nz(source = cbiVoldPremarketBias))
    cbiAddConfidence     := f_cbiClamp(value = cbiAddPremarketRaw - nz(source = cbiAddPremarketBias))
    cbiPctVwapConfidence := f_cbiClamp(value = cbiPctVwapPremarketRaw - nz(source = cbiPctVwapPremarketBias))
    if not na(cbiVoldPremarketRaw)
        cbiVoldPremarketBias := f_cbiEwma(previous = cbiVoldPremarketBias, sample = cbiVoldPremarketRaw, length = cbiPremarketBiasBars)
    if not na(cbiAddPremarketRaw)
        cbiAddPremarketBias := f_cbiEwma(previous = cbiAddPremarketBias, sample = cbiAddPremarketRaw, length = cbiPremarketBiasBars)
    if not na(cbiPctVwapPremarketRaw)
        cbiPctVwapPremarketBias := f_cbiEwma(previous = cbiPctVwapPremarketBias, sample = cbiPctVwapPremarketRaw, length = cbiPremarketBiasBars)

// Weighted average of the legs that have data and a weight — a missing leg
// drops out and the rest renormalise.
float cbiWeightedSum = 0.0
float cbiWeightTotal = 0.0
if not na(cbiVoldConfidence) and cbiVoldWeight > 0.0
    cbiWeightedSum += cbiVoldWeight * cbiVoldConfidence
    cbiWeightTotal += cbiVoldWeight
if not na(cbiAddConfidence) and cbiAddWeight > 0.0
    cbiWeightedSum += cbiAddWeight * cbiAddConfidence
    cbiWeightTotal += cbiAddWeight
if not na(cbiPctVwapConfidence) and cbiPctVwapWeight > 0.0
    cbiWeightedSum += cbiPctVwapWeight * cbiPctVwapConfidence
    cbiWeightTotal += cbiPctVwapWeight
if not na(cbiCumTickConfidence) and cbiCumTickWeight > 0.0
    cbiWeightedSum += cbiCumTickWeight * cbiCumTickConfidence
    cbiWeightTotal += cbiCumTickWeight
if not na(cbiNqConfidence) and cbiNqPremiumWeight > 0.0
    cbiWeightedSum += cbiNqPremiumWeight * cbiNqConfidence
    cbiWeightTotal += cbiNqPremiumWeight
float cbiRaw = cbiWeightTotal > 0.0 and cbiInBreadthHours ? cbiWeightedSum / cbiWeightTotal * CBI_SCALE_MAX : na

// The plotted line — a light EMA, reseeded at 07:00 and 09:30, blank outside
// 07:00-16:00 ET. Read by the ◆ engine and the signal MA.
var float cbiLine = na
if cbiLineReset
    cbiLine := na
cbiLine := na(cbiRaw) ? na : f_cbiEwma(previous = cbiLine, sample = cbiRaw, length = cbiDisplaySmoothBars)

// No vendor volume guard: every leg is a USI or CME feed, never the chart's
// own volume, so an index chart without volume (NDX, SPX) is a valid host.
// Chart volume only weights the VWMA signal MA, which returns na without it.

// ═════════════════════════════════════════════════════════════════════════════
// 🎯 PRICE CONFIRMATION
// Dow non-confirmation at the session's price extremes: price prints a new
// session low (high) at least Min Extreme Separation after the prior one while
// the CBI sits at least Min Breadth Shortfall ABOVE (below) its reading at that
// prior extreme — price got there without breadth. The breadth anchor keeps the
// push's peak/trough, so a grinding move cannot dodge the read. Confirmed bar
// closes only.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_CONFIRM = "🎯 Price Confirmation"
const float CBI_MARKER_OFFSET = 6.0   // pane units the ◆ sits away from the line

cbiShowBullishNonConf = input.bool(defval = true, title = "Bullish ◆ (price low, breadth higher)",
     tooltip = "◆ New session LOW in price that breadth refuses to follow.\n• 📊 65-76% right 30 min later — the read that works\n• Rare — about one every eight sessions", group = GROUP_CONFIRM)
cbiShowBearishNonConf = input.bool(defval = true, title = "Bearish ◆ (price high, breadth lower)",
     tooltip = "◆ New session HIGH in price that breadth refuses to follow.\n• 📊 No edge (33-51% right) — watch it, do not trade it", group = GROUP_CONFIRM)
cbiConfirmBullColor = input.color(defval = color.new(color = NORD8, transp = 20), title = "Bullish Color", group = GROUP_CONFIRM)
cbiConfirmBearColor = input.color(defval = color.new(color = NORD11, transp = 10), title = "Bearish Color", group = GROUP_CONFIRM)
cbiConfirmSeparationMinutes = input.int(defval = 30, title = "Min Extreme Separation (minutes)", minval = 10, maxval = 120, step = 5,
     tooltip = "⏱ Minimum time between the prior price extreme and the new one.\n• Default 30 — back-to-back extremes in one push are one move", group = GROUP_CONFIRM, display = display.none)
cbiConfirmMargin = input.float(defval = 10.0, title = "Min Breadth Shortfall", minval = 0.0, maxval = 25.0, step = 0.5,
     tooltip = "📏 How far breadth must miss its reading at the prior extreme, in CBI points.\n• Default 10", group = GROUP_CONFIRM, display = display.none)

int cbiConfirmSeparationBars = f_cbiBars(minutes = cbiConfirmSeparationMinutes, floorBars = 1)

var float cbiConfirmHighPrice   = na
var float cbiConfirmHighBreadth = na
var int   cbiConfirmHighBar     = na
var float cbiConfirmLowPrice    = na
var float cbiConfirmLowBreadth  = na
var int   cbiConfirmLowBar      = na
if cbiSessionOpened
    cbiConfirmHighPrice   := na
    cbiConfirmHighBreadth := na
    cbiConfirmHighBar     := na
    cbiConfirmLowPrice    := na
    cbiConfirmLowBreadth  := na
    cbiConfirmLowBar      := na

// Helper function — one ◆ with its readings in the tooltip.
f_cbiConfirmMarker(bool isBullish, float priceNow, float breadthPrior) =>
    string confirmText = isBullish ?
         "🟦 BULLISH NON-CONFIRMATION\nNew session low, breadth higher.\n\n• Price " + str.tostring(value = priceNow, format = format.mintick) + "\n• CBI " + str.tostring(value = cbiLine, format = "0.0") + " vs " + str.tostring(value = breadthPrior, format = "0.0") + " at the prior low\n\n📊 65-76% right 30 min later" :
         "🟥 BEARISH NON-CONFIRMATION\nNew session high, breadth lower.\n\n• Price " + str.tostring(value = priceNow, format = format.mintick) + "\n• CBI " + str.tostring(value = cbiLine, format = "0.0") + " vs " + str.tostring(value = breadthPrior, format = "0.0") + " at the prior high\n\n📊 No edge — watch it, do not trade it"
    label.new(x = bar_index, y = cbiLine + (isBullish ? -CBI_MARKER_OFFSET : CBI_MARKER_OFFSET), text = "", tooltip = confirmText,
         xloc = xloc.bar_index, yloc = yloc.price, style = label.style_diamond,
         color = isBullish ? cbiConfirmBullColor : cbiConfirmBearColor, size = size.tiny)

if barstate.isconfirmed and cbiInRth and not na(cbiLine)
    if na(cbiConfirmHighPrice) or high > cbiConfirmHighPrice
        bool cbiConfirmHighSeparated = not na(cbiConfirmHighBar) and bar_index - cbiConfirmHighBar >= cbiConfirmSeparationBars
        if cbiShowBearishNonConf and cbiConfirmHighSeparated and cbiLine < cbiConfirmHighBreadth - cbiConfirmMargin
            f_cbiConfirmMarker(isBullish = false, priceNow = high, breadthPrior = cbiConfirmHighBreadth)
        cbiConfirmHighBreadth := cbiConfirmHighSeparated or na(cbiConfirmHighBreadth) ? cbiLine : math.max(cbiConfirmHighBreadth, cbiLine)
        cbiConfirmHighPrice   := high
        cbiConfirmHighBar     := bar_index
    if na(cbiConfirmLowPrice) or low < cbiConfirmLowPrice
        bool cbiConfirmLowSeparated = not na(cbiConfirmLowBar) and bar_index - cbiConfirmLowBar >= cbiConfirmSeparationBars
        if cbiShowBullishNonConf and cbiConfirmLowSeparated and cbiLine > cbiConfirmLowBreadth + cbiConfirmMargin
            f_cbiConfirmMarker(isBullish = true, priceNow = low, breadthPrior = cbiConfirmLowBreadth)
        cbiConfirmLowBreadth := cbiConfirmLowSeparated or na(cbiConfirmLowBreadth) ? cbiLine : math.min(cbiConfirmLowBreadth, cbiLine)
        cbiConfirmLowPrice   := low
        cbiConfirmLowBar     := bar_index

// ═════════════════════════════════════════════════════════════════════════════
// 〰️ SIGNAL MA
// A moving average OF the CBI line. Above it = breadth building, below =
// fading. Context, not a trigger — a bare above/below read flips many times a
// day.
//
// Calculation timeframe: indicator(timeframe=) is unavailable to a script that
// draws, so a higher timeframe is built by hand — the line is sampled at each
// HTF close and the MA runs over a rolling window of those samples, so its
// length counts HTF bars.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_SIGNAL = "〰️ Signal MA"
const string GROUP_CALC = "🧮 Calculation"
const string TT_SIGNAL_BB = "📐 'SMA + Bollinger Bands' only: band distance from the MA.\n• Default 2.0 standard deviations"

// Signal-line slope colors — one blue family, so up/down read as one line
// while the shade still shows its lean.
const color SIGNAL_UP_COLOR = color.new(color = NORD8, transp = 20)
const color SIGNAL_DOWN_COLOR = color.new(color = NORD9, transp = 60)

signalMaType = input.string(defval = "SMA", title = "Type",
     options = ["None", "SMA", "SMA + Bollinger Bands", "EMA", "SMMA (RMA)", "WMA", "VWMA"],
     tooltip = "〰️ Moving average of the CBI line.\n• Bright = rising, dim = falling\n• CBI above it = breadth building, below = fading\n• Default SMA", group = GROUP_SIGNAL, display = display.none)
signalMaLength = input.int(defval = 20, title = "Length", minval = 1,
     tooltip = "🔢 MA lookback in bars of the Calculation timeframe.\n• Default 20", group = GROUP_SIGNAL, display = display.none)
signalBbMult = input.float(defval = 2.0, title = "BB StdDev", minval = 0.001, maxval = 50, step = 0.5,
     tooltip = TT_SIGNAL_BB, group = GROUP_SIGNAL, display = display.none)

calcTimeframe = input.timeframe(defval = "", title = "Timeframe",
     tooltip = "🧮 Timeframe the CBI and its MA are shown on.\n• Chart (default) — follows the chart\n• Higher — line steps at each higher-timeframe close; MA counts those bars\n• The ◆ stay on the chart's own extremes", group = GROUP_CALC)
calcWaitForClose = input.bool(defval = false, title = "Wait for timeframe closes",
     tooltip = "⏱ Higher timeframe only.\n• On — values only at each close, gaps between\n• Off (default) — CBI stays live, MA holds its last close", group = GROUP_CALC)

bool signalEnabled = signalMaType != "None"
bool signalIsBB = signalMaType == "SMA + Bollinger Bands"

// Helper function — linearly weighted average of the window, newest heaviest.
f_signalWma(array<float> samples) =>
    float wmaWeightedSum = 0.0
    float wmaWeightTotal = 0.0
    for [sampleIndex, sampleValue] in samples
        wmaWeightedSum += sampleValue * (sampleIndex + 1)
        wmaWeightTotal += sampleIndex + 1
    wmaWeightTotal > 0.0 ? wmaWeightedSum / wmaWeightTotal : na

// Helper function — volume-weighted average of the window.
f_signalVwma(array<float> samples, array<float> sampleVolumes) =>
    float vwmaWeightedSum = 0.0
    float vwmaVolumeTotal = 0.0
    for [sampleIndex, sampleValue] in samples
        float sampleVolume = array.get(id = sampleVolumes, index = sampleIndex)
        vwmaWeightedSum += sampleValue * sampleVolume
        vwmaVolumeTotal += sampleVolume
    vwmaVolumeTotal > 0.0 ? vwmaWeightedSum / vwmaVolumeTotal : na

bool calcUsesHtf = calcTimeframe != "" and timeframe.in_seconds(timeframe = calcTimeframe) > timeframe.in_seconds()
bool calcHtfClosing = not calcUsesHtf or time_close == time_close(timeframe = calcTimeframe)

// Rolling window of samples (one per Calculation-timeframe bar). Each type
// reproduces its ta.* built-in: SMA / WMA / VWMA / stdev need a full window,
// EMA and SMMA (RMA) seed from the window's SMA and then recurse. The window
// does not restart at 07:00 / 09:30 — the CBI is an oscillator, not a running
// total, so it has no reset jump.
var array<float> signalSamples = array.new<float>()
var array<float> signalSampleVolumes = array.new<float>()
var float signalVolumeAccumulator = 0.0
var float signalRecursive = na
var float signalLineSample = na
var float signalMa = na
var float signalStDev = na
if not na(cbiLine)
    signalVolumeAccumulator += nz(source = volume)
if calcHtfClosing and not na(cbiLine)
    signalLineSample := cbiLine
    array.push(id = signalSamples, value = cbiLine)
    array.push(id = signalSampleVolumes, value = signalVolumeAccumulator)
    signalVolumeAccumulator := 0.0
    if array.size(id = signalSamples) > signalMaLength
        array.shift(id = signalSamples)
        array.shift(id = signalSampleVolumes)
    bool signalWindowFull = array.size(id = signalSamples) == signalMaLength
    float signalSma = signalWindowFull ? array.avg(id = signalSamples) : na
    if signalMaType == "EMA" or signalMaType == "SMMA (RMA)"
        float signalAlpha = signalMaType == "EMA" ? 2.0 / (signalMaLength + 1.0) : 1.0 / signalMaLength
        signalRecursive := na(signalRecursive) ? signalSma : signalAlpha * cbiLine + (1.0 - signalAlpha) * signalRecursive
    signalMa := switch signalMaType
        "SMA"                   => signalSma
        "SMA + Bollinger Bands" => signalSma
        "EMA"                   => signalRecursive
        "SMMA (RMA)"            => signalRecursive
        "WMA"                   => signalWindowFull ? f_signalWma(samples = signalSamples) : na
        "VWMA"                  => signalWindowFull ? f_signalVwma(samples = signalSamples, sampleVolumes = signalSampleVolumes) : na
        => na
    signalStDev := signalIsBB and signalWindowFull ? array.stdev(id = signalSamples) * signalBbMult : na

// MA slope drives the color; hold the last direction on flat bars so it doesn't
// flicker.
var bool signalRising = true
signalRising := signalMa > signalMa[1] ? true : signalMa < signalMa[1] ? false : signalRising
color signalColor = signalRising ? SIGNAL_UP_COLOR : SIGNAL_DOWN_COLOR

// Plot series — chart timeframe: the line and MA wherever the CBI draws;
// higher timeframe with wait-for-close: only on HTF closes.
bool  calcGapNow = calcUsesHtf and calcWaitForClose and not calcHtfClosing
float cbiPlotValue = calcGapNow ? na : calcUsesHtf and calcWaitForClose ? signalLineSample : cbiLine
float signalPlotValue = calcGapNow or na(cbiLine) and not calcUsesHtf ? na : signalMa

// ═════════════════════════════════════════════════════════════════════════════
// 🎨 PLOTS
// Final plot, hline and fill statements only — every series and color is
// computed in its owning section above.
// ═════════════════════════════════════════════════════════════════════════════
hline(price = 0, title = "Zero Line", color = NORD3, linewidth = 1, linestyle = hline.style_dashed,
     display = cbiShowZeroLine ? display.all : display.none)
plot(series = cbiPlotValue, title = "CBI", color = CBI_LINE_COLOR, linewidth = 2)
plot(series = signalPlotValue, title = "Signal MA", color = signalColor, linewidth = 3,
     display = signalEnabled ? display.all : display.none)

// Bollinger Bands — only drawn in 'SMA + Bollinger Bands' mode.
bbUpperPlot = plot(series = signalIsBB ? signalPlotValue + signalStDev : na, title = "Upper Bollinger Band",
     color = color.new(color = NORD8, transp = 40), display = signalIsBB ? display.all : display.none)
bbLowerPlot = plot(series = signalIsBB ? signalPlotValue - signalStDev : na, title = "Lower Bollinger Band",
     color = color.new(color = NORD8, transp = 40), display = signalIsBB ? display.all : display.none)
fill(plot1 = bbUpperPlot, plot2 = bbLowerPlot, color = signalIsBB ? color.new(color = NORD8, transp = 92) : na,
     title = "Bollinger Bands Background Fill", display = signalIsBB ? display.all : display.none)
