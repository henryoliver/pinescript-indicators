//@version=6
// dynamic_requests: explicit (it is the v6 default) — every breadth feed's
// symbol is built from the Market input suffix, so the request.security calls
// take a series (input-derived) symbol, which requires dynamic requests.
indicator(title = "Composite Breadth Indicator", shorttitle = "📊 CBI", format = format.price, precision = 2, max_lines_count = 500, max_labels_count = 500, dynamic_requests = true)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0  = #2E3440
const color NORD1  = #3B4252
const color NORD2  = #434C5E
const color NORD3  = #4C566A
// Snow Storm
const color NORD4  = #D8DEE9
const color NORD5  = #E5E9F0
const color NORD6  = #ECEFF4
// Frost
const color NORD7  = #8FBCBB
const color NORD8  = #88C0D0
const color NORD9  = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// 📊 COMPOSITE BREADTH — CONVICTION TEST BUILD (temporary, 2026-07-29)
// Market breadth composite from VOLD, ADD, PCTABOVEVWAP, and CUMTICK
// (session-cumulative TICK slope). The composite is a CONFIRMATION instrument:
// price discovery happens in the futures, breadth answers "did the cash basket
// ratify the move". The LINE is the smooth weighted stance; consensus renders
// as line OPACITY (2026-07-13 volatility rework), never a multiplier.
//
// This is a REDUCED TEST build with three lines — the composite line and the
// fast/slow signal MAs — plus the INDEPENDENT CONVICTION read rendered as a
// background strength WASH (a −100..+100 "trust the move" score from the
// opening-volume-regime + gap backbone, shaded behind the lines only where it
// clears its threshold). Every other sub-indicator (TICK extremes, persistence,
// early-shift,
// trend-tell, last-hour, VOLD extremes, adaptive levels, PCCE, Lowry) and its
// config was stripped for the test. Restore the full indicator from
// composite-breadth.FULL-2026-07-29.pine (scratchpad) afterward. Panel groups:
// General (market + zero line + engine tuning), Composite, Weights, Signal,
// Conviction (with its regime/gap params). This section owns the inputs, data
// requests, calculations, and plots.
const string GROUP_COMPOSITE_BREADTH_MARKET  = "⚙️ General"
const string GROUP_COMPOSITE_BREADTH_LINE    = "🌊 Composite"
const string GROUP_COMPOSITE_BREADTH_WEIGHTS = "⚖️ Weights"
const string GROUP_COMPOSITE_BREADTH_SIGNAL  = "🧮 Signal"
const string GROUP_COMPOSITE_BREADTH_CONVICTION = "🧭 Conviction"

const float CBI_SCALE_MAX               = 100.0
const float CBI_TICK_FIXED_SCALE        = 500.0    // NYSE-reference cumTICK saturation base — "TICK averaged ±500 across the slope window"; scaled per market by the TICK market factor
const int   CBI_SIGNAL_WARMUP_BARS      = 5        // bars to seed display before first signal value — slightly longer than legacy 3 so the EMA isn't dominated by the seed at session open
const int   CBI_DISPLAY_SMOOTH_LENGTH   = 3        // light EMA on composite for the plot only — reduces visual noise without affecting calc
const float CBI_OPACITY_ANCHOR          = 50.0     // |line| value where the color gradient + magnitude opacity saturate. Recalibrated 35 → 50 with the consensus-squeeze removal: the unsqueezed line runs 1.4-3× larger on disagreement bars, so the old anchor saturated most of the session and erased the vivid-means-strong dynamic range
const int   CBI_SIGNAL_MIN_TRANSP       = 40

const float CBI_CUMTICK_SLOPE_MINUTES   = 10.0     // cumulative-TICK slope lookback in MINUTES — bar count derived from the chart timeframe (5 bars on 2-min) so the window keeps its meaning on 1m/2m/5m charts. Short enough to catch real-time inflections, long enough to filter single-bar noise
const float CBI_CUMTICK_SLOPE_SMOOTH_MINUTES = 10.0 // EMA window (minutes → bars) applied to the cumTICK slope BEFORE normalization — the raw 10-minute ROC flips sign constantly (TICK oscillates ±300 around zero all day), and that per-bar sign chatter was the composite's main fast-noise injector at 25% weight. Smoothing the slope keeps the component's leading character while dropping the flicker
const float CBI_TICK_BIAS_DAYS          = 20.0     // Steenbarger Adjusted-TICK trailing-mean window in trading days — raw TICK carries a persistent positive bias; subtracting a ~20-day mean before cumulating recenters the cumTICK slope

const int   CBI_TIME_DIM_EXTRA_TRANSP   = 10       // extra transparency added to the composite line during the lunch trough and MOC window when time-of-day dimming is on (10 = a light touch; the earlier 35 stacked with consensus dimming into an overly faint midday line — Henry 2026-07-28)
const float CBI_OPEN_VOL_WINDOW_MINUTES = 30.0     // opening-volume capture window — Raschke's number-one day-type criterion is FIRST-30-MINUTE NYSE volume ("The very number one criteria I look at is volume and I will usually look at the first 30-minute volume"). Measured as the market's TVOL print at the 30-minute mark — the exact total-volume series, already requested as the VOLD ratio denominator
const float CBI_OPEN_VOL_MEAN_DAYS      = 10.0     // trailing mean window (sessions) for the opening-volume baseline the regime ratio compares against — cross-session EMA, same seeding pattern as the TICK bias mean
// NYSE RTH session windows (ET, Mon–Fri). RTH_OPEN anchors every session-wide
// state reset; RTH_FULL marks the whole cash session (its exit edge anchors
// the close-side session divider); LUNCH is the documented intraday
// volume/volatility trough (low-information breadth); MOC is the
// market-on-close rebalancing window where TICK is contaminated by
// index-rebalance program spikes.
const string CBI_SESSION_RTH_OPEN       = "0930-0935:23456"
const string CBI_SESSION_RTH_FULL       = "0930-1600:23456"
const string CBI_SESSION_LUNCH          = "1200-1330:23456"
const string CBI_SESSION_MOC            = "1545-1600:23456"

// ─── General (market + zero line + engine tuning) ──────────────────────────────
// Six breadth universes, one per USI dotted suffix (all four feed families —
// ADVDEC, ADVDECV, PCTABOVEVWAP, TICK — plus the TVOL denominator are
// verified live for every suffix; ICE data). Pick the universe that matches
// the instrument being confirmed: NQ/NDX futures → NASDAQ; ES/SPX → NYSE
// (the classic S&P breadth read); YM/Dow → Dow Jones; RTY/Russell and
// total-market reads → US All Markets (no Russell-specific feed exists);
// ETF tape → NYSE Arca; small-cap/micro tape → NYSE American.
string compositeBreadthMarket = input.string(
     defval = "NASDAQ",
     title = "Market",
     options = ["NASDAQ", "NYSE", "US All Markets", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "Breadth universe — all feeds (ADVDEC, ADVDECV, TVOL, PCTABOVEVWAP, TICK) route to the matching exchange suffix. NASDAQ (.NQ) for NQ/NDX. NYSE (.NY) for ES/SPX — the classic S&P breadth read. US All Markets (.US) for RTY/Russell or total-market confirmation (no Russell-specific feed exists). Dow Jones (.DJ) is the exact Dow 30 basket — coarse (30 issues) but exchange-exact for YM. NYSE Arca (.AX) is the ETF tape — highly correlated issues, expect saturated readings on directional days. NYSE American (.AM) is the small/micro-cap tape — thin, read with its coarser calibration in mind.",
     group = GROUP_COMPOSITE_BREADTH_MARKET
 )

// TICK options (engine tuning for the composite's CUMTICK component) — below Market.
bool compositeBreadthTickNyseOnly = input.bool(
     defval = false,
     title = "Use NYSE TICK only (Barry's preference)",
     tooltip = "OFF (default): TICK routes to the selected market's feed (USI:TICK.<suffix>) with all TICK levels scaled by that market's factor. ON: forces USI:TICK.NY at the native NYSE ±1000 calibration regardless of selected market. Barry Burns explicitly prefers NYSE TICK for all markets — \"the technique that I use for the tick indicator works best with the New York Stock Exchange tick … I just use the New York Stock Exchange tick\", and on the Nasdaq/Dow ticks: \"they just don't reach the extremes as much.\" Asked about trading the NQ: \"I would still use the tick index.\" Turn on to follow his approach.",
     group = GROUP_COMPOSITE_BREADTH_MARKET
 )

bool compositeBreadthCumTickBiasAdjust = input.bool(
     defval = true,
     title = "Bias-Adjust CUMTICK (Steenbarger)",
     tooltip = "Subtract a trailing ~20-trading-day mean of per-bar TICK before cumulating (Steenbarger's Adjusted TICK construction). Raw TICK carries a persistent positive bias, which tilts the cumulative slope bullish and makes negative saturation structurally rarer than positive — consistent with the backtest record where fading negative TICK extremes worked and fading positive ones didn't. OFF cumulates raw TICK (legacy behavior). Applies to the CUMTICK composite component only.",
     group = GROUP_COMPOSITE_BREADTH_MARKET
 )

// Zero line.
bool compositeBreadthShowZeroLine = input.bool(defval = true, title = "Zero Line", tooltip = "Show the zero baseline.", group = GROUP_COMPOSITE_BREADTH_MARKET)
color compositeBreadthZeroLineColor = input.color(defval = NORD3, title = "Color", tooltip = "Zero line color.", group = GROUP_COMPOSITE_BREADTH_MARKET)
int compositeBreadthZeroLineWidth = input.int(defval = 1, title = "Line Width", minval = 1, maxval = 4, tooltip = "Zero line width.", group = GROUP_COMPOSITE_BREADTH_MARKET)
string compositeBreadthZeroLineStyle = input.string(defval = "Solid", title = "Line Style", options = ["Solid", "Dashed", "Dotted"], tooltip = "Zero line style.", group = GROUP_COMPOSITE_BREADTH_MARKET)

// Session dividers — vertical lines at each RTH open/close so trade days are separated.
bool compositeBreadthShowSessionDivider = input.bool(defval = true, title = "Session Dividers", tooltip = "Vertical lines at each NYSE RTH session's open and close (time-anchored in the gap between bars, so they never cover the first/last bar). On an RTH-only chart the 16:00 and next 09:30 share one gap = a single divider.", group = GROUP_COMPOSITE_BREADTH_MARKET)
color compositeBreadthSessionDividerColor = input.color(defval = color.new(color = NORD3, transp = 0), title = "Divider Color", tooltip = "Session divider line color.", group = GROUP_COMPOSITE_BREADTH_MARKET)
int compositeBreadthSessionDividerWidth = input.int(defval = 2, title = "Divider Width", minval = 1, maxval = 10, tooltip = "Session divider line width.", group = GROUP_COMPOSITE_BREADTH_MARKET)
string compositeBreadthSessionDividerStyle = input.string(defval = "Dashed", title = "Divider Style", options = ["Solid", "Dashed", "Dotted"], tooltip = "Session divider line style.", group = GROUP_COMPOSITE_BREADTH_MARKET)

// ─── Composite line ───────────────────────────────────────────────────────────
// The composite line's own display config, first in the panel. Two color
// modes: the consensus gradient (magnitude gradient through neutral grey +
// agreement rendered as opacity — the 2026-07-13 volatility-rework rendering)
// and a plain solid color for a minimal single-hue read. The two dim layers
// (consensus + time-of-day) are gradient-mode features: solid means solid.
bool compositeBreadthShowCompositeLine = input.bool(
     defval = true,
     title = "Show Composite Line",
     tooltip = "Show/hide the composite line itself. DISPLAY-ONLY — the composite is the engine, so the signal MAs and the conviction line keep computing off it even when hidden (e.g. hide it to read the pane as signals + conviction only).",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

// The composite line ships as a plain SOLID color (its value/logic untouched).
// The moment you enable a STRENGTH feature — Consensus (here) and/or Conviction
// (in the 🧭 group) — the line switches to the directional red↔neutral↔cyan
// gradient and the enabled feature(s) fade its OPACITY (vivid where strong /
// agreed / backed, faint otherwise). Opacity only — the composite's number is
// never touched. Both features toggle independently.
color compositeBreadthLineSolidColor = input.color(
     defval = color.new(color = NORD4, transp = 40),
     title = "Line Color",
     tooltip = "The composite line's color when NO strength feature is on — a plain flat line (the picker owns hue and opacity). When Consensus Strength or Conviction Strength is enabled the line switches to the directional gradient and this solid color is not used.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

int compositeBreadthLineWidth = input.int(
     defval = 4,
     title = "Line Width",
     minval = 1,
     maxval = 10,
     tooltip = "Composite line width in pixels.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

bool compositeBreadthShowConsensusStrength = input.bool(
     defval = false,
     title = "Consensus Strength",
     tooltip = "OFF by default (line stays solid). ON: the line fades on internal component DISAGREEMENT — vivid when VOLD / ADD / %VWAP / CUMTICK agree on the sign, pale when they split — and switches to the directional gradient. Opacity only; the composite value is untouched.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

int compositeBreadthConsensusDimStrength = input.int(
     defval = 45,
     title = "Consensus Dim Strength",
     minval = 0,
     maxval = 90,
     step = 5,
     tooltip = "Extra transparency at maximum internal disagreement (only when Consensus Strength is on). (1 − consensus) × this is added to the line's transparency: full agreement = vivid, split = pale. Capped at 95.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

bool compositeBreadthShowTimeOfDayDim = input.bool(
     defval = true,
     title = "Time-of-Day Dimming",
     tooltip = "Dim the line during the two structurally low-information windows — the lunch trough (12:00–13:30 ET) and the MOC window (15:45–16:00 ET). Applies only when the line is in gradient mode (i.e. a strength feature is on). Visual only; the composite value is unchanged.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

// ─── Weights (30/25/20/25 = VOLD/ADD/PCTABOVEVWAP/CUMTICK) ────────────────────
// Research synthesis: TRIN is a non-independent transformation of VOLD+ADD so
// adding it would double-count. VOLD and ADD are correlated siblings (net
// breadth measured in volume vs issues — their DISAGREEMENT is the
// information, and the consensus read extracts it (surfacing as line
// opacity, the badge dissent readout, and the early-shift event)), so their
// combined weight is capped at 55% instead of the legacy 70%; VOLD keeps the
// edge over ADD as the higher-conviction leg and the cleanest trend-day
// identifier in practitioner use. PCTABOVEVWAP captures positioning vs the
// dominant institutional execution benchmark and is independent of the
// volume/issue dimensions. CUMTICK (cumulative intraday TICK,
// slope-normalized) is the only component with a documented LEADING use case
// — Steenbarger's cumulative-TICK divergence read — so it carries 25%
// instead of the legacy 15%. Raw TICK remains context-only (extreme
// markers): the per-bar value is too noisy to be a weighted signal.
//
// Weight-optimality check (2026-07-08): no published correlation matrix,
// intraday predictive decomposition, or consensus composite weighting exists
// for this stack — every published composite's weights are folklore. The one
// rigorous, replicated literature (forecast-combination puzzle, DeMiguel's
// 1/N, Grinold's signal-weighting) says: with correlated noisy signals and
// no out-of-sample estimation, stay near equal weights with at most mild
// conviction tilts, and give a correlated pair a shared capped budget.
// 30/25/20/25 is exactly that construction (max 5-point tilt from equal,
// VOLD+ADD capped at 55%) — re-tuning it without a proper out-of-sample
// sweep would be worse than leaving it alone.
float compositeBreadthVoldWeight = input.float(
     defval = 30,
     title = "VOLD Weight",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Volume trend — conviction. Barry's primary intraday breadth read on NDX (\"up/down volume difference\") and the strongest trend-day identifier in practitioner use.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

float compositeBreadthAddWeight = input.float(
     defval = 25,
     title = "ADD Weight",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Advance-Decline — direction (how many stocks). Distinct from VOLD which measures conviction (how much volume). Weighted slightly below VOLD: the two are correlated siblings and VOLD is the higher-conviction of the pair.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

float compositeBreadthPctVwapWeight = input.float(
     defval = 20,
     title = "PCTABOVEVWAP Weight",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Percent of stocks trading above their intraday VWAP — independent breadth dimension capturing real-time positioning vs the institutional execution benchmark (VWAP-pegged algos are the single largest execution style). The slowest-turning component: reads as the composite's stance, not its trigger. Routes to the selected market's PCTABOVEVWAP feed.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

float compositeBreadthCumTickWeight = input.float(
     defval = 25,
     title = "CUMTICK Weight",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Cumulative session TICK, slope-normalized. Confidence is the 10-minute (timeframe-derived bar count) rate-of-change of the running session sum of (optionally bias-adjusted) TICK, smoothed by a 10-minute EMA before normalization (the raw slope flips sign constantly), saturating at ±1 when TICK averaged ±500 NYSE-scale (scaled per market by the TICK factor) across the window. Positive = breadth strengthening on the bid; negative = weakening. This is the divergence-grade breadth series — the only component with a documented LEADING use case (Steenbarger) — hence its 25% weight. Frozen during the 15:45–16:00 MOC window (rebalancing spikes aren't directional information). Resets at each NYSE RTH open.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

// ─── Signal / smoothing ───────────────────────────────────────────────────────
// Signal PAIR (2026-07-24 rework of the single signal line): a fast trigger
// MA and a slow baseline MA on the smoothed composite, both session-
// reseeding. Defaults = 10-minute EMA / 20-minute SMA — the "9/20 setup"
// anchored in MINUTES, with the fast leg nudged 9 → 10 so it divides the
// 2-MINUTE bar exactly (this indicator lives on a dedicated 2-min internals
// chart — Barry's documented practice: "I like two-minute bars … that's
// what I use on this"): on 2-min the pair renders as 5 EMA / 10 SMA bars
// exactly, on 1-min as 10 EMA / 20 SMA (the classic pair, one tick slower),
// on 3-min as ~3 EMA / 7 SMA (almost exactly Raschke 3/10-oscillator
// geometry). The ~2:1 fast:slow ratio matches the
// canonical MA pair applied to breadth rather than price — McClellan's
// 19/39 EMA oscillator (2.05) and MACD's 12/26 (2.17) — and the EMA-fast /
// SMA-slow mix is the trigger-vs-structure split, not folklore: an EMA lags
// ~1/3 of its length (early trigger), an SMA lags half (smoother,
// harder-to-whipsaw baseline). Bar-count lengths were rejected because a
// 20-BAR SMA on the 3-min chart = 60 minutes of post-09:30 convergence —
// the entire prime open window burned on warmup.
bool compositeBreadthShowSignalFast = input.bool(
     defval = true,
     title = "Show Fast Signal Line",
     tooltip = "FAST leg of the signal pair — the trigger line on the smoothed composite (fed from the same series that's plotted, so crosses and divergences read true). Toggling OFF turns the leg fully off — not computed. The slow leg keeps running on its own.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

bool compositeBreadthShowSignalSlow = input.bool(
     defval = true,
     title = "Show Slow Signal Line",
     tooltip = "SLOW leg of the signal pair — the baseline. Composite above/below it = momentum building that way (the legacy single-signal read). Toggling OFF turns the leg fully off — not computed. The fast leg keeps running on its own.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

string compositeBreadthSignalFastType = input.string(
     defval = "EMA",
     title = "Fast Type",
     options = ["EMA", "SMA"],
     tooltip = "Moving-average type for the FAST leg. EMA (default): exponentially weighted — hugs the composite tighter and turns earlier, the trigger line. SMA: plain rolling mean of the leg's window. Both reseed at every session open (a window never reaches across the 09:30 boundary).",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalFastMinutes = input.int(
     defval = 10,
     title = "Fast Length (minutes)",
     minval = 2,
     maxval = 120,
     step = 1,
     tooltip = "FAST leg window in MINUTES — converted to a bar count from the chart timeframe (5 bars on the 2-min internals chart, 10 on 1-min, 3 on 3-min) so the leg keeps its meaning on every chart the pair is traded on. Default 10 is the classic 9-minute trigger nudged up one so it divides the 2-minute bar exactly — the input reads exactly what plots.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

color compositeBreadthSignalFastColor = input.color(
     defval = NORD3,
     title = "Fast Color",
     tooltip = "Fast leg color — the picker owns hue and opacity. Default = NORD3 at full opacity; the fast leg is kept lightest by its width (1px), not by transparency, so it reads clearly against the composite.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalFastWidth = input.int(
     defval = 1,
     title = "Fast Width",
     minval = 1,
     maxval = 10,
     tooltip = "Fast leg line width in pixels — default 1 keeps the trigger visually lightest of the three lines.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

string compositeBreadthSignalSlowType = input.string(
     defval = "SMA",
     title = "Slow Type",
     options = ["SMA", "EMA"],
     tooltip = "Moving-average type for the SLOW leg. SMA (default): every bar in the window weighs the same, so the baseline reads as \"where has the composite been over the last leg\" — the smoother, harder-to-whipsaw structure line (Raschke's 3/10 deliberately uses the smoother SMA type for the same reason). EMA: turns earlier at the cost of more lunch-chop crosses.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalSlowMinutes = input.int(
     defval = 20,
     title = "Slow Length (minutes)",
     minval = 5,
     maxval = 240,
     step = 1,
     tooltip = "SLOW leg window in MINUTES — converted to a bar count from the chart timeframe (10 bars on the 2-min internals chart, 20 on 1-min, 7 on 3-min). Default 20 pairs with the 10-minute fast leg at the 2:1 crossover geometry (McClellan 19/39, MACD 12/26) and is converged by ~09:50 after the session reseed on any of those charts.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

color compositeBreadthSignalSlowColor = input.color(
     defval = NORD3,
     title = "Slow Color",
     tooltip = "Slow leg color (transparency supported via the picker).",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalSlowWidth = input.int(
     defval = 3,
     title = "Slow Width",
     minval = 1,
     maxval = 10,
     tooltip = "Slow leg line width in pixels — default 3 matches the composite's weight (the baseline reads as its equal) while the fast trigger stays lightest at 1.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

// ─── Consensus (engine) ───────────────────────────────────────────────────────
// The deadband drives the composite's consensus vote (line opacity).
float compositeBreadthConsensusDeadband = input.float(
     defval = 0.1,
     title = "Consensus Vote Deadband",
     minval = 0.0,
     maxval = 0.5,
     step = 0.05,
     tooltip = "Confidence magnitude a component must exceed before it VOTES in the consensus read. Near-zero components abstain — flat is not dissent — and an established vote holds through the band (hysteresis), flipping only when confidence crosses the band on the OPPOSITE side. Kills the consensus flicker from a component's sign chattering around zero without delaying real rollovers. Consensus renders as the composite line's opacity.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

// ─── Conviction verdict tag (open-quality read) ─────────────────────────────
// A ONE-PER-SESSION verdict tag, NOT a line overlay. Conviction is the
// independent-context read (opening-volume regime + gap character — the two
// signals that carry information the composite's four components don't). It is
// a slow, session-level, near-binary "trust the open vs fade it" call decided
// once the open resolves (~30 min) — the wrong shape for per-bar line opacity,
// which is why it lives here as its own tag. The composite line + consensus
// carry the per-bar picture; this tag carries the day's open-quality verdict.
// Regime + Gap compute automatically when this is on (zero cost).
bool compositeBreadthShowConviction = input.bool(
     defval = false,
     title = "Conviction Verdict Tag",
     tooltip = "OFF by default. ON: drops a single tag per session, once the open resolves (~30 min), reading the independent open-context — opening-volume regime + gap character. TRUST (cyan) = context backs the move (expansion day and/or gap-and-go); FADE (red) = it doesn't (light day and/or gap-close); MIXED (grey) = the two disagree or neither resolved. A second line names the drivers (e.g. EXP · GO). Uses only signals NOT in the composite's four components, so it adds information rather than restating the line. Nothing here touches the composite line or its value.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

float compositeBreadthConvRegimeWeight = input.float(
     defval = 40.0,
     title = "Regime Weight",
     minval = 0.0,
     maxval = 100.0,
     step = 5.0,
     tooltip = "Weight of the opening-volume regime in the verdict score (expansion +, light −, neutral 0). Regime is the backbone — classified once at the 30-min mark. Sign of the combined score picks TRUST vs FADE; when regime and gap disagree the larger weight wins. Computes automatically when the tag is on.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

float compositeBreadthConvGapWeight = input.float(
     defval = 30.0,
     title = "Gap Weight",
     minval = 0.0,
     maxval = 100.0,
     step = 5.0,
     tooltip = "Weight of the gap verdict in the verdict score (gap-and-go +, gap-close −, mixed 0). Resolves at the gap read window (~15 min). Sign of the combined regime+gap score picks TRUST vs FADE; when the two disagree the larger weight wins. Computes automatically when the tag is on.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

string compositeBreadthConvTagSize = input.string(
     defval = "Small",
     title = "Verdict Tag Size",
     options = ["Tiny", "Small", "Normal", "Large"],
     tooltip = "Text size of the once-per-session conviction verdict tag.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

// Regime tuning — the opening-volume regime feeds the conviction backbone.
float compositeBreadthOpenVolExpansionRatio = input.float(
     defval = 1.2,
     title = "Expansion Regime Ratio",
     minval = 1.0,
     maxval = 3.0,
     step = 0.05,
     tooltip = "Opening volume at or above this multiple of the trailing mean = range-expansion (trend-capable) regime. Raschke's rule is categorical (\"good volume day\" vs \"light volume day\") with no published number — 1.2× (20% above average) is a reasonable default; re-validate on current data rather than trusting it (breadth thresholds decay across regimes, Qi & Zhao 2008).",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

float compositeBreadthOpenVolLightRatio = input.float(
     defval = 0.8,
     title = "Light Regime Ratio",
     minval = 0.3,
     maxval = 1.0,
     step = 0.05,
     tooltip = "Opening volume at or below this multiple of the trailing mean = light-volume (rotation, fade-friendly) regime. Between the two ratios the day is classified neutral.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

// Gap tuning — the opening-gap verdict feeds the conviction backbone.
float compositeBreadthGapReadMinutes = input.float(
     defval = 15.0,
     title = "Gap Read Window (minutes)",
     minval = 10.0,
     maxval = 30.0,
     step = 1.0,
     tooltip = "Minutes after 09:30 before the Gap Close / Gap and Go verdict is evaluated (bar count derived from the chart timeframe). The first ~10 minutes are gap-distorted (Raschke: \"don't look at the breadth reading in the first five or ten minutes\"), so the verdict waits past that but fires before the 30-minute cross-alert gate lifts — long enough for VOLD to develop a clean change-since-open sign, early enough that the read still matters. 15 minutes is the default middle; the verdict is a one-shot per session, evaluated on the first confirmed bar at/after this mark.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

float compositeBreadthGapSmallPct = input.float(
     defval = 20.0,
     title = "Small-Gap Threshold (% of prior range)",
     minval = 5.0,
     maxval = 50.0,
     step = 5.0,
     tooltip = "Gap size (as a percent of the PRIOR day's high-low range) at or below which the gap is 'small' — Steenbarger's volatility-normalized gap study (SPY, N=897): gaps under ~20% of the prior range filled ~88% of the time. A small gap barely pre-loads the composite, and its early one-sidedness is most likely intraday noise around a fill-prone open. Normalizing by the prior range rather than a fixed percent is the point — a 0.3% gap means something different in a quiet tape than a wild one.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

float compositeBreadthGapLargePct = input.float(
     defval = 40.0,
     title = "Large-Gap Threshold (% of prior range)",
     minval = 20.0,
     maxval = 100.0,
     step = 5.0,
     tooltip = "Gap size (percent of the prior day's range) at or above which the gap is 'large' — Steenbarger: gaps beyond ~40% of the prior range filled only about half the time (a coin flip between gap-and-go and gap-fade). A large gap pre-loads the composite hardest AND deserves no automatic fade prior — respect the open until the verdict says otherwise. Between the small and large thresholds the gap is 'medium'. Thresholds are regime-dependent priors from a 2003-06 low-volatility sample; re-validate on current data before leaning on them.",
     group = GROUP_COMPOSITE_BREADTH_CONVICTION
 )

// ═════════════════════════════════════════════════════════════════════════════
// 🔗 SYMBOL ROUTING + PER-MARKET CALIBRATION
// One suffix drives every feed family — the whole point of the dotted USI
// catalog is that ADVDEC/ADVDECV/TVOL/PCTABOVEVWAP/TICK exist for the SAME
// six universes (verified 2026-07-13 against TradingView's symbol-search API
// and symbol pages, provider ICE): .NY = NYSE, .NQ = Nasdaq, .US = all US
// markets combined, .DJ = Dow 30, .AX = NYSE Arca (ARCX — the ETF tape),
// .AM = NYSE American (former AMEX). The legacy bare symbols (USI:TICK,
// TICKQ, TICKI, ADD, UVOL/DVOL…) coexist as a separate partial family; the
// dotted family is used exclusively so every market gets the same
// construction.
// ═════════════════════════════════════════════════════════════════════════════
string compositeBreadthMarketSuffix = switch compositeBreadthMarket
    "NASDAQ"         => "NQ"
    "NYSE"           => "NY"
    "US All Markets" => "US"
    "Dow Jones"      => "DJ"
    "NYSE Arca"      => "AX"
    "NYSE American"  => "AM"
    => "NQ"

// ADD saturation scale — the net-issues reading that maps to full ±1
// confidence. Net issues is bounded by the exchange's tradable issue count
// and practitioners read it at ABSOLUTE levels, so a fixed per-market scale
// is the right normalization (calibration research 2026-07-13):
//   NYSE ~2,800 issues — ±1,500 strong / ±2,000 extreme is the documented
//     practitioner level (52-wk $ADDN extremes ≈ ±1,700) → scale 2000.
//   NASDAQ ~3,450 issues — scaled by issue ratio, matches observed 52-wk
//     $ADDQ extremes ≈ ±2,300-2,500 → scale 2500.
//   US combined ~8,000 tradable securities ≈ NY+NQ scales → 4500.
//   Dow: hard bound ±30; 27 = 28+ of 30 one-sided (lore extreme ±22-26).
//   Arca ~2,500 ETPs, but ETFs tick together → 2000 saturates appropriately.
//   American ~242 issues → 200.
float compositeBreadthAddScale = switch compositeBreadthMarket
    "NASDAQ"         => 2500.0
    "NYSE"           => 2000.0
    "US All Markets" => 4500.0
    "Dow Jones"      => 27.0
    "NYSE Arca"      => 2000.0
    "NYSE American"  => 200.0
    => 2500.0

// TICK market factor — scales every NYSE-calibrated TICK level (cumTICK
// saturation base ±500, extreme threshold ±985, trend-tell ±1500) to the
// selected feed. NYSE ±1,000 extreme is the documented anchor; the other
// factors derive from issue counts anchored to what IS documented (Nasdaq
// climax ~±1,200-1,300; Dow TICKI extreme lore ±22-26 of its ±30 bound —
// small baskets tick together, so the factor is NOT purely proportional to
// issue count). No practitioner levels exist for .US/.AX/.AM — factors are
// issue-count-derived, honest but unvalidated; re-check against the live
// feed's actual range before leaning on their extreme markers.
float compositeBreadthTickMarketFactor = switch compositeBreadthMarket
    "NASDAQ"         => 1.25
    "NYSE"           => 1.0
    "US All Markets" => 2.25
    "Dow Jones"      => 0.026
    "NYSE Arca"      => 1.6
    "NYSE American"  => 0.17
    => 1.25

// PCTABOVEVWAP band — ±band around 50 mapped to full ±1 confidence. The
// documented practitioner rails are 40/60 (>60 = don't short, <40 = don't
// long), so ±15 saturates right where the liquid tapes treat the reading as
// extreme (the legacy ±25 band chronically under-scaled the component — a
// strong 65 print scored only 0.6). Narrow/correlated universes swing
// harder and need wider rails: Dow is quantized in 3.33% steps (30 stocks)
// → ±20; Arca ETFs move together and pin toward 0/100 on any directional
// day, and American is thin → ±30. Derived, not documented — no
// per-exchange practitioner rails exist.
float compositeBreadthPctVwapBand = switch compositeBreadthMarket
    "NASDAQ"         => 15.0
    "NYSE"           => 15.0
    "US All Markets" => 15.0
    "Dow Jones"      => 20.0
    "NYSE Arca"      => 30.0
    "NYSE American"  => 30.0
    => 15.0

string compositeBreadthAddNetSymbol   = "USI:ADVDEC."       + compositeBreadthMarketSuffix
string compositeBreadthVoldNetSymbol  = "USI:ADVDECV."      + compositeBreadthMarketSuffix
string compositeBreadthTotalVolSymbol = "USI:TVOL."         + compositeBreadthMarketSuffix
string compositeBreadthPctVwapSymbol  = "USI:PCTABOVEVWAP." + compositeBreadthMarketSuffix

// TICK routes to the same suffix; the NYSE-only toggle (Barry's stated
// practice) forces TICK.NY and neutralizes the market factor so all levels
// read on the NYSE ±1000 calibration he teaches.
string compositeBreadthTickSymbol = compositeBreadthTickNyseOnly ?
     "USI:TICK.NY" : "USI:TICK." + compositeBreadthMarketSuffix

// ═════════════════════════════════════════════════════════════════════════════
// 🎛️ DERIVED CALIBRATION
// Timeframe- and feed-aware scaling so the calibration constants keep their
// MEANING when the chart interval or the TICK feed changes.
//
// Windows are specified in minutes and converted to a bar count from the
// chart timeframe — a "10-minute slope" is 5 bars on 2-min, 10 bars on 1-min,
// 2 bars on 5-min, instead of silently becoming a 50-minute slope on a 10-min
// chart. Floors keep degenerate timeframes (daily+) from producing 0-bar
// windows; the breadth feeds are intraday-only anyway.
//
// TICK scaling: every TICK level in this indicator is authored on the NYSE
// calibration (±500 saturation base, ±985 extreme, ±1500 tell) and scaled to
// the resolved feed by the per-market factor — one factor, applied
// uniformly, replacing the old special-cased TICKQ handling. Scaled
// thresholds cap at 95% of the feed's theoretical bound so they stay
// reachable on tiny universes (see the bound switch above). Saturation
// always means "TICK averaged ±1 full scale for the entire slope window".
//
// The bias window (~20 trading days of chart bars, 390 RTH minutes per day)
// drives the Steenbarger trailing-mean adjustment on the cumTICK input.
// ═════════════════════════════════════════════════════════════════════════════
int compositeBreadthCumTickSlopeWindow  = math.max(2, math.round(number = CBI_CUMTICK_SLOPE_MINUTES * 60.0 / timeframe.in_seconds()))
int compositeBreadthCumTickSlopeSmoothBars = math.max(2, math.round(number = CBI_CUMTICK_SLOPE_SMOOTH_MINUTES * 60.0 / timeframe.in_seconds()))
int compositeBreadthTickBiasWindowBars  = math.max(10, math.round(number = CBI_TICK_BIAS_DAYS * 390.0 * 60.0 / timeframe.in_seconds()))
int compositeBreadthOpenVolWindowBars   = math.max(1, math.round(number = CBI_OPEN_VOL_WINDOW_MINUTES * 60.0 / timeframe.in_seconds()))
int compositeBreadthGapReadBars         = math.max(1, math.round(number = compositeBreadthGapReadMinutes * 60.0 / timeframe.in_seconds()))
int compositeBreadthSignalFastBars      = math.max(2, math.round(number = compositeBreadthSignalFastMinutes * 60.0 / timeframe.in_seconds()))
int compositeBreadthSignalSlowBars      = math.max(2, math.round(number = compositeBreadthSignalSlowMinutes * 60.0 / timeframe.in_seconds()))
float compositeBreadthTickFactor        = compositeBreadthTickNyseOnly ? 1.0 : compositeBreadthTickMarketFactor
float compositeBreadthTickScale         = CBI_TICK_FIXED_SCALE * compositeBreadthTickFactor
float compositeBreadthCumTickSlopeScale = compositeBreadthCumTickSlopeWindow * compositeBreadthTickScale

// ═════════════════════════════════════════════════════════════════════════════
// 📡 DATA REQUESTS
// ═════════════════════════════════════════════════════════════════════════════
// The pre-computed nets (ADVDEC = advancers − decliners, ADVDECV = up-vol −
// down-vol) replace the old four-request ADVN/DECL + UPVOL/DNVOL
// construction. The normalization changed with them: ADD reads the net
// against a fixed per-market issue scale (net issues is bounded and
// practitioner levels are absolute), and VOLD reads net ÷ TVOL — the
// Lowry-style up/down volume ratio, the standard stationary form (±0.4 =
// trend-day tape, ±0.8 = a 90% day). TVOL includes unchanged volume, which
// damps the ratio a hair vs the old (U−D)/(U+D) — negligible on modern
// tapes, and TVOL doubles as the exact Raschke opening-volume source. Net
// effect: five CORE requests instead of six, one construction for all six
// markets; the optional layers (PCCE, Lowry UPVOL/DNVOL) add gated requests
// that cost nothing while disabled.
//
// All breadth feeds use gaps_on so out-of-session bars come back as na rather
// than being forward-filled with the last RTH value. On a futures or extended-
// hours chart, gaps_off would keep plotting Friday's last RTH breadth all
// weekend; gaps_on lets the composite blank when the feeds aren't live (paired
// with explicit na-clearing of the display/signal state below). For TICK
// specifically, the session-reset detector also relies on a real na→value
// transition to reseed the EMA at each NYSE RTH open.
//
// lookahead = barmerge.lookahead_off is intentional and correct here, NOT an
// oversight against the repo's "use lookahead_on for real-time accuracy" note
// (that guidance applies to HIGHER-timeframe requests). Every request below
// uses timeframe = timeframe.period — the chart's own timeframe — so there is
// no higher-timeframe bar to look ahead into and lookahead has no effect on the
// returned series. lookahead_off is also the non-repainting default; flipping
// to lookahead_on with `close` would leak future data on HTF requests, so off
// stays the safe choice if these are ever pointed at a higher timeframe.
float compositeBreadthAddNetValue = request.security(
     symbol = compositeBreadthAddNetSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

float compositeBreadthVoldNetValue = request.security(
     symbol = compositeBreadthVoldNetSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

float compositeBreadthTotalVolValue = request.security(
     symbol = compositeBreadthTotalVolSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

float compositeBreadthPctVwapValue = request.security(
     symbol = compositeBreadthPctVwapSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

// TICK close — feeds the composite's CUMTICK component (and its bias mean),
// where per-bar settlement is the right series. (The high/low tuple that fed
// the removed extreme-detection layer is gone in this test build.)
float compositeBreadthTickValue = request.security(
     symbol = compositeBreadthTickSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

// ═════════════════════════════════════════════════════════════════════════════
// 🔔 SESSION DETECTION
// AnyFeedLive = at least one of the five breadth feeds is non-na this bar.
// SessionJustOpened = the 09:30 ET time-anchored session-open edge — the
// canonical trigger for ALL session-wide state resets (display smoothing /
// signal average,
// cumTick, pending TICK-extreme flags, VOLD extremes, feed-health counters).
// One mechanism for every reset: earlier versions split
// resets between this edge and na→value feed edges, and the feed edges never
// fire on an RTH-only chart (no dark bars between sessions), which silently
// disabled the daily reseeds after day one.
//
// BarsSinceSessionOpen counts chart bars since the most recent session-open
// transition, increments only while at least one feed is live (so the
// off-RTH gap doesn't bloat the count). Used to gate cumTick slope
// computation against the cross-session lookback leak, to arm the
// composite-vs-signal cross alerts after the opening noise window, and to
// mature the feed-health warning even when TICK is the missing feed.
//
// InLunchWindow / InMocWindow mark the two structurally low-information
// windows: the midday volume/volatility trough (visual dimming only) and the
// market-on-close rebalancing window (CUMTICK frozen, TICK extremes
// suppressed, plus dimming).
// ═════════════════════════════════════════════════════════════════════════════
bool compositeBreadthAnyFeedLive =
     not na(compositeBreadthTickValue)     or
     not na(compositeBreadthAddNetValue)   or
     not na(compositeBreadthVoldNetValue)  or
     not na(compositeBreadthTotalVolValue) or
     not na(compositeBreadthPctVwapValue)

// Session-open edge is TIME-anchored, not feed-presence-anchored. The earlier
// "AnyFeedLive false→true" approach relied on a real off-session bar existing
// between sessions to create the na→value transition. That holds on futures /
// extended-hours charts (overnight bars come back na), but on an RTH-only chart
// there are NO dark bars between sessions: the bar before 09:30 is yesterday's
// 16:00, whose feeds were live, so AnyFeedLive[1] is true and the edge never
// fires — silently skipping the daily reset of the EMAs, cumTick, VOLD
// extremes, feed-health flags, and the session divider. Pinning to the NYSE RTH
// open window (09:30–09:35 ET, weekdays) fires reliably on BOTH chart types and
// decouples the reset from feed health — a session still opens at 09:30 even if
// a feed is dead, which is more correct than gating on whether data arrived.
bool compositeBreadthInRthOpen = not na(time(timeframe = timeframe.period, session = CBI_SESSION_RTH_OPEN, timezone = "America/New_York"))
bool compositeBreadthSessionJustOpened = compositeBreadthInRthOpen and not compositeBreadthInRthOpen[1]
bool compositeBreadthInLunchWindow = not na(time(timeframe = timeframe.period, session = CBI_SESSION_LUNCH, timezone = "America/New_York"))
bool compositeBreadthInMocWindow   = not na(time(timeframe = timeframe.period, session = CBI_SESSION_MOC,   timezone = "America/New_York"))
// In the cash session (09:30–16:00 ET) — gates the gap layer's RTH-only
// prior-day price tracking so an extended-hours chart doesn't fold an overnight
// print into the range. SessionJustClosed = the RTH-exit edge (first post-16:00
// bar on extended charts) — drives the close-side session divider.
bool compositeBreadthInRthFull = not na(time(timeframe = timeframe.period, session = CBI_SESSION_RTH_FULL, timezone = "America/New_York"))
bool compositeBreadthSessionJustClosed = not compositeBreadthInRthFull and compositeBreadthInRthFull[1]

var int compositeBreadthBarsSinceSessionOpen = 0
if compositeBreadthSessionJustOpened
    compositeBreadthBarsSinceSessionOpen := 1
else if compositeBreadthAnyFeedLive
    compositeBreadthBarsSinceSessionOpen += 1

// ═════════════════════════════════════════════════════════════════════════════
// 🧮 HELPERS
// ═════════════════════════════════════════════════════════════════════════════
f_compositeBreadthClampedRatio(float numerator, float denominator) =>
    float compositeBreadthRatio = na
    if not na(numerator) and not na(denominator) and denominator > 0.0
        compositeBreadthRatio := math.max(-1.0, math.min(1.0, numerator / denominator))
    compositeBreadthRatio

// One EWMA step — the file's single most repeated fragment (every trailing
// baseline fold and every session EMA seed uses the same seed-or-fold
// expression). PURE — no internal state: each call site keeps its own var
// and assigns the return, so the helper stays safe inside conditional
// scopes (a var-holding helper called conditionally would break Pine's
// every-bar execution guarantee).
f_compositeBreadthEwmaStep(float previous, float sample, float length) =>
    float compositeBreadthEwmaAlpha = 2.0 / (length + 1.0)
    na(previous) ? sample : compositeBreadthEwmaAlpha * sample + (1.0 - compositeBreadthEwmaAlpha) * previous

// One signal-MA step — EMA folds through the shared EWMA helper; SMA keeps a
// rolling window array (capped at lengthBars) and returns its mean. PURE like
// the EWMA step: each call site owns its window/previous var and assigns the
// return, so the helper stays safe inside conditional scopes.
f_compositeBreadthSignalStep(array<float> window, float previous, string maType, int lengthBars, float sample) =>
    float compositeBreadthSignalResult = na
    if maType == "SMA"
        array.push(id = window, value = sample)
        if array.size(id = window) > lengthBars
            array.shift(id = window)
        compositeBreadthSignalResult := array.avg(id = window)
    else
        compositeBreadthSignalResult := f_compositeBreadthEwmaStep(previous = previous, sample = sample, length = lengthBars)
    compositeBreadthSignalResult


// Hysteresis consensus vote: a component votes +1/−1 only after its
// confidence leaves the ±deadband, holds that vote through the band, and
// flips only when confidence crosses the band on the OPPOSITE side. 0 =
// never established a side (abstains from consensus). Same pattern as
// ma-waves' hysteresis read direction — real rollovers register,
// micro-wiggles around zero don't.
f_compositeBreadthVoteSign(int currentVote, float confidence, float deadband) =>
    int compositeBreadthVoteResult = currentVote
    if not na(confidence)
        if confidence > deadband
            compositeBreadthVoteResult := 1
        else if confidence < -deadband
            compositeBreadthVoteResult := -1
    compositeBreadthVoteResult

f_compositeBreadthProgressiveColor(float value, float scale, int minTransp, float extraTransp) =>
    color compositeBreadthResultColor = na
    if not na(value)
        // Two-stage gradient — NORD11 → NORD3 (neutral grey at zero) → NORD8 — produces
        // a continuous hue walk through neutral instead of the abrupt cyan↔red flip at
        // zero that previously left visible bright bars at color transitions.
        color compositeBreadthBaseColor = value >= 0.0 ?
             color.from_gradient(value = value, bottom_value = 0.0,    top_value = scale, bottom_color = NORD3,  top_color = NORD8) :
             color.from_gradient(value = value, bottom_value = -scale, top_value = 0.0,   bottom_color = NORD11, top_color = NORD3)
        // Magnitude-based transparency (faded near zero, vivid at |value| ≥
        // scale) plus the caller's extra dim (consensus + time-of-day),
        // folded into ONE color.new — the old two-stage color.t() unwrap +
        // rewrap allocated a second color on nearly every bar.
        float compositeBreadthMagnitude = math.min(1.0, math.abs(number = value) / scale)
        float compositeBreadthTransparency = math.min(95.0, minTransp - minTransp * compositeBreadthMagnitude + extraTransp)
        compositeBreadthResultColor := color.new(color = compositeBreadthBaseColor, transp = compositeBreadthTransparency)
    compositeBreadthResultColor

// ═════════════════════════════════════════════════════════════════════════════
// 🎯 PER-COMPONENT CONFIDENCE
// VOLD, ADD, PCTABOVEVWAP, and CUMTICK feed the weighted composite. Raw
// per-bar TICK only feeds the extreme markers — never the weighted sum.
// ═════════════════════════════════════════════════════════════════════════════
// VOLD: the ADVDECV net is session-cumulative — its envelope grows with
// total volume all day, so a fixed scale would under-read the open and peg
// the close. Dividing by TVOL yields the Lowry-style up/down volume ratio,
// the standard stationary form: ±0.4 = trend-day tape, ±0.8 = a 90% day.
// Same clamp helper as the legacy (U−D)/(U+D) form, so the component's
// scaling semantics under the tuned 30-weight are unchanged.
float compositeBreadthVoldConfidence = f_compositeBreadthClampedRatio(
     numerator = compositeBreadthVoldNetValue,
     denominator = compositeBreadthTotalVolValue
 )

// ADD: net issues (ADVDEC) is bounded by the exchange's issue count and
// quasi-stationary after the first ~30-60 minutes — each issue's
// advance/decline status is set by its first trades — so a FIXED per-market
// saturation scale is the right normalization, and it matches how
// practitioners actually read $ADD (absolute levels: ±1,500 strong, ±2,000
// extreme on NYSE). The scale is the per-market switch in symbol routing.
float compositeBreadthAddConfidence = not na(compositeBreadthAddNetValue) ?
     math.max(-1.0, math.min(1.0, compositeBreadthAddNetValue / compositeBreadthAddScale)) : na

// PCTABOVEVWAP is published as a 0..100 percentage. Center on 50 (true
// neutral positioning) and map to the same -1..+1 confidence scale as
// VOLD/ADD over the per-market band (±15 on the liquid tapes — saturating at
// the 35/65 rails where practitioners treat the reading as extreme — wider
// on the narrow/correlated universes; see the band switch in symbol
// routing).
float compositeBreadthPctVwapConfidence = not na(compositeBreadthPctVwapValue) ?
     math.max(-1.0, math.min(1.0, (compositeBreadthPctVwapValue - 50.0) / compositeBreadthPctVwapBand)) : na

// TICK bias mean (Steenbarger adjustment). Raw TICK carries a persistent
// positive bias — Steenbarger's Adjusted TICK subtracts a trailing ~20-day
// mean of the per-bar TICK before cumulating, and without that recentering
// the cumTICK slope tilts bullish (negative saturation becomes structurally
// rarer than positive). Approximated here as a long EMA (~20 trading days of
// chart bars, timeframe-derived) that only updates on live TICK bars, so
// off-RTH na gaps neither decay nor pollute it. Seeded from the first live
// TICK value — early-history adjusted values start near zero and converge as
// the window fills, which only affects the oldest loaded bars.
var float compositeBreadthTickBiasMean = na
if not na(compositeBreadthTickValue)
    compositeBreadthTickBiasMean := f_compositeBreadthEwmaStep(previous = compositeBreadthTickBiasMean, sample = compositeBreadthTickValue, length = compositeBreadthTickBiasWindowBars)

float compositeBreadthTickAdjustedValue = na(compositeBreadthTickValue) ? na :
     compositeBreadthCumTickBiasAdjust and not na(compositeBreadthTickBiasMean) ?
     compositeBreadthTickValue - compositeBreadthTickBiasMean : compositeBreadthTickValue

// CUMTICK (cumulative session TICK, slope-normalized)
// Sum of (bias-adjusted) TICK across the session, reset at
// compositeBreadthSessionJustOpened (the time-anchored 09:30 edge). The LEVEL
// of CUMTICK grows with session length, so it's not directly comparable
// across bars; the SLOPE (CBI_CUMTICK_SLOPE_MINUTES of rate-of-change, bar
// count derived from the chart timeframe — 5 bars on 2-min) is what carries
// the signal: positive slope = breadth strengthening on the bid right now,
// negative = weakening. Normalize slope by the derived slope scale so
// confidence saturates at ±1 when TICK has averaged a full scale
// (±500 NYSE-scale × the market factor) across the slope window — a strong
// directional regime.
//
// Cross-session leak guard: the slope lookback compositeBreadthCumTickValue[
// compositeBreadthCumTickSlopeWindow] would otherwise reach back across the
// off-RTH gap into the PRIOR session's accumulated value, making the first
// few bars of every new session register a bogus full-magnitude slope
// (this-session reset value minus yesterday's huge cumulative). The slope is
// therefore gated on compositeBreadthBarsSinceSessionOpen >
// compositeBreadthCumTickSlopeWindow — only computed when the entire
// lookback window is provably in-session.
//
// This is the divergence-grade breadth series. Raw TICK is too jagged to
// spot pivot-style turns; PCTABOVEVWAP plateaus mid-session. CUMTICK slope
// captures the inflections that price reversals actually pivot against.
var float compositeBreadthCumTickValue = na
if compositeBreadthSessionJustOpened or na(compositeBreadthCumTickValue)
    compositeBreadthCumTickValue := compositeBreadthTickAdjustedValue
else if not na(compositeBreadthTickAdjustedValue)
    compositeBreadthCumTickValue := compositeBreadthCumTickValue + compositeBreadthTickAdjustedValue
// When TICK is na (off-RTH gap), leave cumTick at its last value — the next
// session-open edge will reseed it via compositeBreadthSessionJustOpened.

bool compositeBreadthCumTickSlopeReady = compositeBreadthBarsSinceSessionOpen > compositeBreadthCumTickSlopeWindow and
     not na(compositeBreadthCumTickValue) and not na(compositeBreadthCumTickValue[compositeBreadthCumTickSlopeWindow])
float compositeBreadthCumTickSlope = compositeBreadthCumTickSlopeReady ?
     compositeBreadthCumTickValue - compositeBreadthCumTickValue[compositeBreadthCumTickSlopeWindow] : na

// Slope smoothing — the raw 10-minute ROC of cumTICK flips sign constantly
// (TICK oscillates around zero all day), so the unsmoothed slope injected
// per-bar sign chatter into 25% of the weighted sum and, before the consensus
// rework, flickered the consensus tier on top. A short EMA on the slope keeps
// the leading inflections and drops the flicker. Session-scoped like
// everything upstream: reseeds at 09:30, blanks with the slope.
var float compositeBreadthCumTickSlopeSmoothed = na
if compositeBreadthSessionJustOpened
    compositeBreadthCumTickSlopeSmoothed := na
if not na(compositeBreadthCumTickSlope)
    compositeBreadthCumTickSlopeSmoothed := f_compositeBreadthEwmaStep(previous = compositeBreadthCumTickSlopeSmoothed, sample = compositeBreadthCumTickSlope, length = compositeBreadthCumTickSlopeSmoothBars)
else
    compositeBreadthCumTickSlopeSmoothed := na

float compositeBreadthCumTickConfidenceLive = not na(compositeBreadthCumTickSlopeSmoothed) ?
     math.max(-1.0, math.min(1.0, compositeBreadthCumTickSlopeSmoothed / compositeBreadthCumTickSlopeScale)) : na

// MOC freeze — TICK after 15:45 ET is dominated by market-on-close
// rebalancing program spikes and is ignored for directional analysis by
// practitioner consensus. Rather than dropping the component to na (which
// would renormalize the weights and jolt the composite), CUMTICK confidence
// HOLDS its last pre-15:45 value through the close: the component keeps its
// weight and its stance, it just stops reacting to contaminated prints.
var float compositeBreadthCumTickHeldConfidence = na
if not compositeBreadthInMocWindow
    compositeBreadthCumTickHeldConfidence := compositeBreadthCumTickConfidenceLive
float compositeBreadthCumTickConfidence = compositeBreadthInMocWindow ?
     compositeBreadthCumTickHeldConfidence : compositeBreadthCumTickConfidenceLive

// ═════════════════════════════════════════════════════════════════════════════
// 🧬 COMPOSITE SCORE
// Weighted sum × CBI_SCALE_MAX, using FOUR weighted components: VOLD, ADD,
// PCTABOVEVWAP, CUMTICK. The LINE is the weighted directional alone — the
// smooth stance, the same session-cumulative character as the feeds it
// summarizes. Consensus (cross-component agreement) is still computed, but it
// no longer multiplies the line (2026-07-13 volatility rework): the old
// `directional × consensus` construction rescaled the entire line by 30%
// (one dissenter) to 70% (split) every time a component's sign flickered,
// producing sawtooth swings the underlying feeds never printed. Disagreement
// now renders as line OPACITY (colors section), the badge's dissent readout,
// and the early-shift event — visible without distorting the stance's
// magnitude. Raw per-bar TICK is NOT a weighted component — it only drives
// the extreme triangle markers and their alerts.
// ═════════════════════════════════════════════════════════════════════════════
// A component is "active" only when both its data is present AND its weight is
// non-zero. Setting a weight to 0 must fully remove that component from BOTH
// the directional weighted sum AND the consensus calculation — otherwise a
// disabled component would still vote in the consensus read, dimming the
// line's opacity and blocking the impulse alerts' consensus gate.
bool compositeBreadthVoldActive    = not na(compositeBreadthVoldConfidence)    and compositeBreadthVoldWeight    > 0.0
bool compositeBreadthAddActive     = not na(compositeBreadthAddConfidence)     and compositeBreadthAddWeight     > 0.0
bool compositeBreadthPctVwapActive = not na(compositeBreadthPctVwapConfidence) and compositeBreadthPctVwapWeight > 0.0
bool compositeBreadthCumTickActive = not na(compositeBreadthCumTickConfidence) and compositeBreadthCumTickWeight > 0.0

float compositeBreadthWeightedSum = 0.0
float compositeBreadthWeightTotal = 0.0
if compositeBreadthVoldActive
    compositeBreadthWeightedSum += compositeBreadthVoldWeight * compositeBreadthVoldConfidence
    compositeBreadthWeightTotal += compositeBreadthVoldWeight
if compositeBreadthAddActive
    compositeBreadthWeightedSum += compositeBreadthAddWeight * compositeBreadthAddConfidence
    compositeBreadthWeightTotal += compositeBreadthAddWeight
if compositeBreadthPctVwapActive
    compositeBreadthWeightedSum += compositeBreadthPctVwapWeight * compositeBreadthPctVwapConfidence
    compositeBreadthWeightTotal += compositeBreadthPctVwapWeight
if compositeBreadthCumTickActive
    compositeBreadthWeightedSum += compositeBreadthCumTickWeight * compositeBreadthCumTickConfidence
    compositeBreadthWeightTotal += compositeBreadthCumTickWeight

float compositeBreadthDirectional = compositeBreadthWeightTotal > 0.0 ?
     compositeBreadthWeightedSum / compositeBreadthWeightTotal : na

// Consensus = SIGN agreement in categorical tiers, measured on HYSTERESIS
// VOTES rather than instantaneous signs (2026-07-13 volatility rework). Two
// changes from the raw-sign version:
//   1. DEADBAND + ABSTENTION — a component votes only after its confidence
//      leaves the ±deadband. Near-zero is flat, not dissent: the raw-sign
//      version let CUMTICK's chatter inside ±0.05 flip the tier 1.0↔0.7
//      every few bars.
//   2. HYSTERESIS — an established vote holds through the band and flips
//      only when confidence crosses the band on the opposite side, so real
//      rollovers register and micro-wiggles don't (see the vote helper).
// Practitioner logic stays categorical: all voters align = full agreement,
// one dissents = reduce, split = stand down. Agreement is measured against
// the sign of the weighted directional itself, so the reference respects the
// user's weights. Votes reseed at 09:30 with the rest of the session state.
var int compositeBreadthVoldVoteSign        = 0
var int compositeBreadthAddVoteSign         = 0
var int compositeBreadthPctVwapVoteSign     = 0
var int compositeBreadthCumTickVoteSign     = 0
var int compositeBreadthDirectionalVoteSign = 0
if compositeBreadthSessionJustOpened
    compositeBreadthVoldVoteSign        := 0
    compositeBreadthAddVoteSign         := 0
    compositeBreadthPctVwapVoteSign     := 0
    compositeBreadthCumTickVoteSign     := 0
    compositeBreadthDirectionalVoteSign := 0

compositeBreadthVoldVoteSign    := f_compositeBreadthVoteSign(currentVote = compositeBreadthVoldVoteSign,    confidence = compositeBreadthVoldConfidence,    deadband = compositeBreadthConsensusDeadband)
compositeBreadthAddVoteSign     := f_compositeBreadthVoteSign(currentVote = compositeBreadthAddVoteSign,     confidence = compositeBreadthAddConfidence,     deadband = compositeBreadthConsensusDeadband)
compositeBreadthPctVwapVoteSign := f_compositeBreadthVoteSign(currentVote = compositeBreadthPctVwapVoteSign, confidence = compositeBreadthPctVwapConfidence, deadband = compositeBreadthConsensusDeadband)
compositeBreadthCumTickVoteSign := f_compositeBreadthVoteSign(currentVote = compositeBreadthCumTickVoteSign, confidence = compositeBreadthCumTickConfidence, deadband = compositeBreadthConsensusDeadband)

// The REFERENCE sign carries the same hysteresis as the votes (review fix
// 2026-07-14): an instantaneous reference re-admitted the flicker the votes
// were built to kill — the weighted directional chopping across 0.0 at lunch
// flipped ALL held votes to "dissenters" against a stance they collectively
// set, sawtoothing the consensus tier (and the line's opacity) per bar.
compositeBreadthDirectionalVoteSign := f_compositeBreadthVoteSign(currentVote = compositeBreadthDirectionalVoteSign, confidence = compositeBreadthDirectional, deadband = compositeBreadthConsensusDeadband)
bool compositeBreadthRefPositive = compositeBreadthDirectionalVoteSign >= 0

// One VOTING and one DISSENTS boolean per component — the consensus tier,
// the alignment ratio, and the badge dissent readout all derive from these
// same booleans, so the three surfaces can never disagree about who is
// dissenting.
bool compositeBreadthVoldVoting    = compositeBreadthVoldActive    and compositeBreadthVoldVoteSign    != 0
bool compositeBreadthAddVoting     = compositeBreadthAddActive     and compositeBreadthAddVoteSign     != 0
bool compositeBreadthPctVwapVoting = compositeBreadthPctVwapActive and compositeBreadthPctVwapVoteSign != 0
bool compositeBreadthCumTickVoting = compositeBreadthCumTickActive and compositeBreadthCumTickVoteSign != 0
bool compositeBreadthVoldDissents    = compositeBreadthVoldVoting    and (compositeBreadthVoldVoteSign    == 1) != compositeBreadthRefPositive
bool compositeBreadthAddDissents     = compositeBreadthAddVoting     and (compositeBreadthAddVoteSign     == 1) != compositeBreadthRefPositive
bool compositeBreadthPctVwapDissents = compositeBreadthPctVwapVoting and (compositeBreadthPctVwapVoteSign == 1) != compositeBreadthRefPositive
bool compositeBreadthCumTickDissents = compositeBreadthCumTickVoting and (compositeBreadthCumTickVoteSign == 1) != compositeBreadthRefPositive

int compositeBreadthVotingCount =
     (compositeBreadthVoldVoting ? 1 : 0) + (compositeBreadthAddVoting ? 1 : 0) +
     (compositeBreadthPctVwapVoting ? 1 : 0) + (compositeBreadthCumTickVoting ? 1 : 0)
int compositeBreadthDissentCount =
     (compositeBreadthVoldDissents ? 1 : 0) + (compositeBreadthAddDissents ? 1 : 0) +
     (compositeBreadthPctVwapDissents ? 1 : 0) + (compositeBreadthCumTickDissents ? 1 : 0)
float compositeBreadthSignAlignmentRatio = compositeBreadthVotingCount > 0 ?
     (compositeBreadthVotingCount - compositeBreadthDissentCount) / float(compositeBreadthVotingCount) : 1.0

// Tiers: full agreement (4/4, 3/3, 2/2) = 1.0; one dissenter among 3-4
// (ratio ≥ 0.666) = 0.7; split (ratio ≥ 0.333, e.g. 2/4 or 1/2) = 0.3;
// outvoted majority-vs-weight edge cases below that = 0.1. With 0 or 1
// voters, or no established reference sign, there is nothing to agree
// about — consensus stays 1.0 (the badge still names a lone dissenter).
float compositeBreadthConsensus = compositeBreadthVotingCount <= 1 or compositeBreadthDirectionalVoteSign == 0 ? 1.0 :
     compositeBreadthSignAlignmentRatio >= 0.999 ? 1.0 :
     compositeBreadthSignAlignmentRatio >= 0.666 ? 0.7 :
     compositeBreadthSignAlignmentRatio >= 0.333 ? 0.3 : 0.1

// The line is the UNSQUEEZED weighted stance — consensus renders as opacity
// and events instead of multiplying the magnitude (see the section header).
float compositeBreadthLineValue = na(compositeBreadthDirectional) ? na :
     compositeBreadthDirectional * CBI_SCALE_MAX

// ═════════════════════════════════════════════════════════════════════════════
// 🌊 DISPLAY + SIGNAL PAIR
// Display EMA is short (3) and tames per-bar jitter so intraday swings on the
// composite read cleanly. Both signal legs are fed FROM the display line (not
// from the raw composite) so the visible composite-vs-signal relationship is
// internally consistent — divergences read true rather than reflecting two
// different lag profiles.
//
// Two reset paths, both required. (1) na blanking: when the upstream
// composite is unavailable (off-RTH on futures/extended charts, paired with
// gaps_on) the lines blank instead of freezing into a stale flat line.
// (2) The time-anchored session-open edge: on an RTH-only chart there ARE no
// na bars between sessions, so without this reset the EMAs would carry
// yesterday's smoothed state into today's open and the warmup would only
// ever run on the first loaded session. Reseeding at each open is
// structurally required here: the internals themselves are session-scoped
// series that discontinuously reset at 09:30 — a continuous EMA would smooth
// yesterday's closing regime into today's gap.
// ═════════════════════════════════════════════════════════════════════════════
var float compositeBreadthDisplayLine = na
if compositeBreadthSessionJustOpened
    compositeBreadthDisplayLine := na
if not na(compositeBreadthLineValue)
    compositeBreadthDisplayLine := f_compositeBreadthEwmaStep(previous = compositeBreadthDisplayLine, sample = compositeBreadthLineValue, length = CBI_DISPLAY_SMOOTH_LENGTH)
else
    compositeBreadthDisplayLine := na

// Signal PAIR — fast trigger + slow baseline, one state machine each, both
// stepped by the shared helper. Both legs reseed on the 09:30 edge and share
// the warmup gate, so switching a leg's type never changes the session-reset
// semantics. Lengths arrive as minutes-derived bar counts (see the derived
// calibration), so the pair keeps one meaning on the 1-min and 3-min charts
// traded side by side.
var float compositeBreadthSignalFastValue = na
var float compositeBreadthSignalSlowValue = na
var int compositeBreadthSignalSeedCount = 0
var array<float> compositeBreadthSignalFastWindow = array.new<float>()
var array<float> compositeBreadthSignalSlowWindow = array.new<float>()
if compositeBreadthSessionJustOpened
    compositeBreadthSignalFastValue := na
    compositeBreadthSignalSlowValue := na
    compositeBreadthSignalSeedCount := 0
    array.clear(id = compositeBreadthSignalFastWindow)
    array.clear(id = compositeBreadthSignalSlowWindow)
if (compositeBreadthShowSignalFast or compositeBreadthShowSignalSlow) and not na(compositeBreadthDisplayLine)
    compositeBreadthSignalSeedCount += 1
    if compositeBreadthSignalSeedCount > CBI_SIGNAL_WARMUP_BARS
        if compositeBreadthShowSignalFast
            compositeBreadthSignalFastValue := f_compositeBreadthSignalStep(window = compositeBreadthSignalFastWindow, previous = compositeBreadthSignalFastValue, maType = compositeBreadthSignalFastType, lengthBars = compositeBreadthSignalFastBars, sample = compositeBreadthDisplayLine)
        if compositeBreadthShowSignalSlow
            compositeBreadthSignalSlowValue := f_compositeBreadthSignalStep(window = compositeBreadthSignalSlowWindow, previous = compositeBreadthSignalSlowValue, maType = compositeBreadthSignalSlowType, lengthBars = compositeBreadthSignalSlowBars, sample = compositeBreadthDisplayLine)
else
    compositeBreadthSignalFastValue := na
    compositeBreadthSignalSlowValue := na
    compositeBreadthSignalSeedCount := 0
    array.clear(id = compositeBreadthSignalFastWindow)
    array.clear(id = compositeBreadthSignalSlowWindow)


// ═════════════════════════════════════════════════════════════════════════════
// 🔊 OPENING-VOLUME REGIME (Raschke)
// Raschke's number-one day-type criterion: first-30-minute NYSE volume. High
// opening volume = range-expansion / trend-capable day; light = rotation.
// This is also the regime that resolves TICK-extreme interpretation — her
// verified rule is volume-conditional: "If it's a light volume day TICKS very
// often will match the extreme of the move" (exit/fade read), "If you've got
// a good volume day, you want to use the TICKS as a momentum indicator"
// (continuation read). The regime note in the TICK extremes section was
// comment-only until now; this flag turns it into data.
//
// Volume source: TVOL — the market's exact total-volume feed, already
// requested as the VOLD ratio denominator. It's session-cumulative, so its
// value at the 30-minute mark IS the first-30-min volume. No extra request
// needed, and it's a strictly better source than the old UPVOL+DNVOL proxy
// (which excluded unchanged volume).
//
// Baseline: cross-session EMA (~10 sessions) of the captured opening volume,
// seeded from the first captured session like the TICK bias mean. Today is
// classified against the mean of PRIOR days first, then folded in. Until the
// baseline exists (first session on a fresh chart load) the regime is
// UNKNOWN, which consumers treat like neutral.
//
// Capture fires on the first CONFIRMED bar at/after the 30-minute live-bar
// mark with a valid VOLD total (na gaps push it to the next valid bar). If
// the feeds were dead long enough that the mark is only reached past twice
// the window, the session is skipped entirely — a "first 30 minutes" captured
// at 11:00 would poison the baseline.
// ═════════════════════════════════════════════════════════════════════════════
var float compositeBreadthOpenVolMean     = na
var bool  compositeBreadthOpenVolCaptured = false
var float compositeBreadthOpenVolRatio    = na
var int   compositeBreadthVolRegime       = 0      // 1 = expansion, -1 = light, 0 = neutral (or unknown)
var bool  compositeBreadthVolRegimeKnown  = false

if compositeBreadthSessionJustOpened
    compositeBreadthOpenVolCaptured := false
    compositeBreadthOpenVolRatio    := na
    compositeBreadthVolRegime       := 0
    compositeBreadthVolRegimeKnown  := false

// The regime exists only to feed the conviction line's backbone, so it
// computes whenever that line is on. Zero cost when off.
bool compositeBreadthNeedRegime = compositeBreadthShowConviction
if compositeBreadthNeedRegime and not compositeBreadthOpenVolCaptured and barstate.isconfirmed and
     compositeBreadthBarsSinceSessionOpen >= compositeBreadthOpenVolWindowBars and
     compositeBreadthBarsSinceSessionOpen <= compositeBreadthOpenVolWindowBars * 2 and
     not na(compositeBreadthTotalVolValue) and compositeBreadthTotalVolValue > 0.0
    compositeBreadthOpenVolCaptured := true
    if not na(compositeBreadthOpenVolMean) and compositeBreadthOpenVolMean > 0.0
        compositeBreadthOpenVolRatio   := compositeBreadthTotalVolValue / compositeBreadthOpenVolMean
        compositeBreadthVolRegimeKnown := true
        compositeBreadthVolRegime      := compositeBreadthOpenVolRatio >= compositeBreadthOpenVolExpansionRatio ? 1 :
             compositeBreadthOpenVolRatio <= compositeBreadthOpenVolLightRatio ? -1 : 0
    compositeBreadthOpenVolMean := f_compositeBreadthEwmaStep(previous = compositeBreadthOpenVolMean, sample = compositeBreadthTotalVolValue, length = CBI_OPEN_VOL_MEAN_DAYS)

// ═════════════════════════════════════════════════════════════════════════════
// 🌅 GAP CONTEXT (opening-gap reading layer)
// The false-direction-at-the-open problem, made into a reading aid. On a gap
// day the session-cumulative composite opens strongly one-sided purely because
// the overnight gap pre-loads the ADD feed — advance/decline starts gapped
// (Barry: it "did not start at zero … because of gaps"), while up/down volume
// resets to zero at 09:30. That early one-sidedness is overnight-regime echo,
// not intraday conviction (Cooper-Cliff-Gulen 2008 / NY Fed SR917: the
// overnight session carries the average index drift, the cash session ≈ zero).
//
// Two reads, both pure interpretation — nothing here touches the weighted sum:
//   1. GAP CLASSIFICATION at 09:30 — gap = today's RTH open vs the prior RTH
//      close, sized against the PRIOR day's high-low range (Steenbarger's
//      volatility-normalized construction: <~20% of prior range ≈ 88% fill /
//      fade-prone open, >~40% ≈ coin flip / respect the open), plus the open's
//      location vs the prior range (inside vs gapped clear).
//   2. GAP CLOSE vs GAP AND GO (Barry) — evaluated once at the read-window
//      mark. Barry's rule keys on whether BOTH breadth tools confirm or oppose
//      the gap: both confirm = Gap and Go (the early composite is real, respect
//      the gap), both oppose = Gap Close (fade toward the prior close, the
//      early composite is echo), "if only one is against, this is not a Gap
//      Close" = mixed. Measured on the CHANGE-since-open of VOLD and ADD
//      (delta-from-open strips the gap pre-load — the Lou-Polk-Skouras
//      first-half-hour-baseline construction: read the internals' move off
//      their opening print, not their gap-loaded level).
//
// Gap is measured on the CHART's own price series (open/high/low/close) — no
// new request.security. Prior-session close/high/low are folded at the 09:30
// edge exactly like the VOLD extremes, tracked over RTH bars only so an
// extended-hours chart doesn't fold an overnight print into the range. The
// whole layer no-ops when disabled. Consumers (badge, marker, alerts, the
// optional early dim) treat an unknown gap (first session, or a data gap) as
// neutral — no read, no dim.
// ═════════════════════════════════════════════════════════════════════════════
var float compositeBreadthGapPriorClose   = na
var float compositeBreadthGapPriorHigh    = na
var float compositeBreadthGapPriorLow     = na
var float compositeBreadthGapCurClose     = na
var float compositeBreadthGapCurHigh      = na
var float compositeBreadthGapCurLow       = na
var float compositeBreadthGapTodayOpen    = na
var float compositeBreadthGapValue        = na    // signed gap in chart price points
var float compositeBreadthGapPctOfRange   = na    // |gap| ÷ prior day's range
var int   compositeBreadthGapDir          = 0     // +1 gap up, -1 gap down, 0 flat/unknown
var int   compositeBreadthGapSizeClass    = 0     // 1 small, 2 medium, 3 large; 0 unknown
var int   compositeBreadthGapOpenLoc      = 0     // +1 open above prior range, -1 below, 0 inside
var bool  compositeBreadthGapKnown        = false
var float compositeBreadthGapVoldOpenPrint = na
var float compositeBreadthGapAddOpenPrint  = na
var int   compositeBreadthGapVerdict      = 0     // +1 gap-and-go, -1 gap-close, 0 mixed/unknown
var bool  compositeBreadthGapVerdictEvaluated = false

// Compute the gap read whenever the Conviction Verdict Tag is on — it is the
// only consumer of the gap verdict (gap is zero-cost: chart price + the
// already-computed confidences). No standalone gap layer / gap alerts remain;
// the verdict feeds only the once-per-session conviction tag.
if compositeBreadthShowConviction
    float compositeBreadthGapSmallFrac = compositeBreadthGapSmallPct / 100.0
    float compositeBreadthGapLargeFrac = compositeBreadthGapLargePct / 100.0
    if compositeBreadthSessionJustOpened
        // Fold the COMPLETED session's price extremes into the prior-day
        // reference BEFORE resetting them — the same classify-against-prior-
        // then-reset boundary pattern as every baseline in this file.
        if not na(compositeBreadthGapCurClose) and not na(compositeBreadthGapCurHigh) and not na(compositeBreadthGapCurLow)
            compositeBreadthGapPriorClose := compositeBreadthGapCurClose
            compositeBreadthGapPriorHigh  := compositeBreadthGapCurHigh
            compositeBreadthGapPriorLow   := compositeBreadthGapCurLow
        // Today's RTH open is this bar's open (the session-open edge is the
        // 09:30 bar). Reset the verdict/open-print state for the new session.
        compositeBreadthGapTodayOpen       := open
        compositeBreadthGapValue           := na
        compositeBreadthGapPctOfRange      := na
        compositeBreadthGapDir             := 0
        compositeBreadthGapSizeClass       := 0
        compositeBreadthGapOpenLoc         := 0
        compositeBreadthGapKnown           := false
        compositeBreadthGapVoldOpenPrint   := na
        compositeBreadthGapAddOpenPrint    := na
        compositeBreadthGapVerdict         := 0
        compositeBreadthGapVerdictEvaluated := false
        // Classify the gap against the prior day's range (needs a prior day).
        if not na(compositeBreadthGapPriorClose) and not na(compositeBreadthGapPriorHigh) and not na(compositeBreadthGapPriorLow)
            float compositeBreadthGapPriorRange = compositeBreadthGapPriorHigh - compositeBreadthGapPriorLow
            if compositeBreadthGapPriorRange > 0.0 and not na(compositeBreadthGapTodayOpen)
                compositeBreadthGapValue      := compositeBreadthGapTodayOpen - compositeBreadthGapPriorClose
                compositeBreadthGapPctOfRange := math.abs(number = compositeBreadthGapValue) / compositeBreadthGapPriorRange
                compositeBreadthGapDir        := compositeBreadthGapValue > 0.0 ? 1 : compositeBreadthGapValue < 0.0 ? -1 : 0
                compositeBreadthGapSizeClass  := compositeBreadthGapPctOfRange <= compositeBreadthGapSmallFrac ? 1 :
                     compositeBreadthGapPctOfRange >= compositeBreadthGapLargeFrac ? 3 : 2
                compositeBreadthGapOpenLoc    := compositeBreadthGapTodayOpen > compositeBreadthGapPriorHigh ? 1 :
                     compositeBreadthGapTodayOpen < compositeBreadthGapPriorLow ? -1 : 0
                compositeBreadthGapKnown      := compositeBreadthGapDir != 0
        // Start today's price trackers empty — filled on the confirmed RTH
        // bars below (this bar included once it confirms).
        compositeBreadthGapCurClose := na
        compositeBreadthGapCurHigh  := na
        compositeBreadthGapCurLow   := na

    // Accumulate today's RTH price extremes + running close. RTH-gated so an
    // extended-hours chart never folds an overnight print into the range; on
    // an RTH-only chart every bar qualifies. The last RTH close of the day
    // becomes tomorrow's prior close at the fold.
    if barstate.isconfirmed and compositeBreadthInRthFull and not na(close)
        compositeBreadthGapCurClose := close
        compositeBreadthGapCurHigh  := na(compositeBreadthGapCurHigh) ? high : math.max(compositeBreadthGapCurHigh, high)
        compositeBreadthGapCurLow   := na(compositeBreadthGapCurLow)  ? low  : math.min(compositeBreadthGapCurLow, low)

    // Capture the OPENING prints of the breadth confidences — the gap-loaded
    // first read each is measured against (delta-from-open). First valid
    // confirmed bar of the session wins; reset to na at the fold above.
    if barstate.isconfirmed
        if na(compositeBreadthGapVoldOpenPrint) and not na(compositeBreadthVoldConfidence)
            compositeBreadthGapVoldOpenPrint := compositeBreadthVoldConfidence
        if na(compositeBreadthGapAddOpenPrint) and not na(compositeBreadthAddConfidence)
            compositeBreadthGapAddOpenPrint := compositeBreadthAddConfidence

    // Verdict — one-shot at the read-window mark (skipped if the feeds were
    // dark past twice the window, same poison guard as the opening-volume
    // capture). Both legs read the CHANGE since their opening print, so the
    // gap echo in ADD's level is subtracted out. Barry's rule: both confirm =
    // Gap and Go, both oppose = Gap Close, one each = mixed (no verdict).
    if not compositeBreadthGapVerdictEvaluated and compositeBreadthGapKnown and barstate.isconfirmed and
         compositeBreadthGapDir != 0 and compositeBreadthBarsSinceSessionOpen >= compositeBreadthGapReadBars and
         compositeBreadthBarsSinceSessionOpen <= compositeBreadthGapReadBars * 2 and
         not na(compositeBreadthGapVoldOpenPrint) and not na(compositeBreadthGapAddOpenPrint) and
         not na(compositeBreadthVoldConfidence) and not na(compositeBreadthAddConfidence)
        float compositeBreadthGapVoldDelta = compositeBreadthVoldConfidence - compositeBreadthGapVoldOpenPrint
        float compositeBreadthGapAddDelta  = compositeBreadthAddConfidence  - compositeBreadthGapAddOpenPrint
        int compositeBreadthGapVoldDeltaDir = compositeBreadthGapVoldDelta > 0.0 ? 1 : compositeBreadthGapVoldDelta < 0.0 ? -1 : 0
        int compositeBreadthGapAddDeltaDir  = compositeBreadthGapAddDelta  > 0.0 ? 1 : compositeBreadthGapAddDelta  < 0.0 ? -1 : 0
        bool compositeBreadthGapBothConfirm = compositeBreadthGapVoldDeltaDir == compositeBreadthGapDir and compositeBreadthGapAddDeltaDir == compositeBreadthGapDir
        bool compositeBreadthGapBothOppose  = compositeBreadthGapVoldDeltaDir == -compositeBreadthGapDir and compositeBreadthGapAddDeltaDir == -compositeBreadthGapDir
        compositeBreadthGapVerdict          := compositeBreadthGapBothConfirm ? 1 : compositeBreadthGapBothOppose ? -1 : 0
        compositeBreadthGapVerdictEvaluated := true

// ═════════════════════════════════════════════════════════════════════════════
// 🧭 CONVICTION VERDICT (open-quality snapshot)
// The independent open-context — opening-volume regime + gap character —
// collapsed into ONE "trust the open vs fade it" verdict, snapshotted ONCE per
// session the moment the open resolves. Regime (±1 expansion/light) is the
// later of the two reads (30-min mark); the gap verdict (±1 go/close) is in by
// the ~15-min mark. This is deliberately NOT a per-bar series: conviction is a
// slow, session-level, near-binary call, so it is captured once and rendered
// as a single tag (see PLOTS), never folded into the per-bar line opacity.
//
// Score = regimeWeight·regime + gapWeight·gap (each ±1), clamped to the larger
// weight's budget — no summed double-count, and when the two disagree the
// larger weight decides the sign. Sign → TRUST (+) / FADE (−) / MIXED (0). The
// snapshot also stores the raw regime + gap so the tag can name the drivers.
// ═════════════════════════════════════════════════════════════════════════════
var int   compositeBreadthConvVerdictSign   = 0     // +1 trust, -1 fade, 0 mixed/neutral
var int   compositeBreadthConvVerdictRegime = 0     // regime snapshot at resolve (±1/0)
var int   compositeBreadthConvVerdictGap    = 0     // gap-verdict snapshot at resolve (±1/0)
var bool  compositeBreadthConvVerdictReady  = false // resolved & tagged this session?

if compositeBreadthShowConviction and compositeBreadthSessionJustOpened
    compositeBreadthConvVerdictSign   := 0
    compositeBreadthConvVerdictRegime := 0
    compositeBreadthConvVerdictGap    := 0
    compositeBreadthConvVerdictReady  := false

// Resolve once regime is settled — either classified, or its capture window has
// fully elapsed (feeds dark → abandoned). Require at least one of regime/gap to
// have produced a read, else there is no verdict to show (no empty tag).
bool compositeBreadthConvRegimeSettled = compositeBreadthVolRegimeKnown or compositeBreadthBarsSinceSessionOpen > compositeBreadthOpenVolWindowBars * 2
bool compositeBreadthConvHaveAnyRead   = compositeBreadthVolRegimeKnown or compositeBreadthGapVerdictEvaluated
if compositeBreadthShowConviction and not compositeBreadthConvVerdictReady and barstate.isconfirmed and
     compositeBreadthConvRegimeSettled and compositeBreadthConvHaveAnyRead
    float compositeBreadthConvRegimePart = compositeBreadthVolRegimeKnown ? (compositeBreadthConvRegimeWeight / 100.0) * compositeBreadthVolRegime : 0.0
    float compositeBreadthConvGapPart    = compositeBreadthGapVerdictEvaluated ? (compositeBreadthConvGapWeight / 100.0) * compositeBreadthGapVerdict : 0.0
    float compositeBreadthConvBudget     = math.max(compositeBreadthConvRegimeWeight, compositeBreadthConvGapWeight) / 100.0
    float compositeBreadthConvScore      = math.max(-compositeBreadthConvBudget, math.min(compositeBreadthConvBudget, compositeBreadthConvRegimePart + compositeBreadthConvGapPart))
    compositeBreadthConvVerdictSign   := compositeBreadthConvScore > 0.0 ? 1 : compositeBreadthConvScore < 0.0 ? -1 : 0
    compositeBreadthConvVerdictRegime := compositeBreadthVolRegimeKnown ? compositeBreadthVolRegime : 0
    compositeBreadthConvVerdictGap    := compositeBreadthGapVerdictEvaluated ? compositeBreadthGapVerdict : 0
    compositeBreadthConvVerdictReady  := true

// ═════════════════════════════════════════════════════════════════════════════
// 🎨 COLORS
// ═════════════════════════════════════════════════════════════════════════════
// The composite line is a plain SOLID color UNLESS a line-strength feature is
// on. Enabling Consensus Strength (or the Time-of-Day dim) switches it to the
// directional red↔neutral↔cyan gradient and fades its OPACITY (never its
// value):
//   • CONSENSUS strength — (1 − consensus) × Consensus Dim Strength, so full
//     internal agreement is vivid and a split vote goes pale.
//   • TIME-OF-DAY dim (its own toggle) adds a lunch/MOC fade.
// Conviction is NOT here — it renders as its own once-per-session tag (see the
// verdict block above + PLOTS), decoupled from the per-bar line. With no
// strength feature on, the solid color is used verbatim (picker owns hue+opacity).
bool compositeBreadthInLowInfoWindow = compositeBreadthInLunchWindow or compositeBreadthInMocWindow
bool compositeBreadthUseGradient = compositeBreadthShowConsensusStrength or compositeBreadthShowTimeOfDayDim
color compositeBreadthLineColor = compositeBreadthLineSolidColor
if compositeBreadthUseGradient
    float compositeBreadthExtraTransp =
         (compositeBreadthShowConsensusStrength ? (1.0 - compositeBreadthConsensus) * compositeBreadthConsensusDimStrength : 0.0) +
         (compositeBreadthShowTimeOfDayDim and compositeBreadthInLowInfoWindow ? CBI_TIME_DIM_EXTRA_TRANSP : 0)
    compositeBreadthLineColor := f_compositeBreadthProgressiveColor(value = compositeBreadthDisplayLine, scale = CBI_OPACITY_ANCHOR, minTransp = CBI_SIGNAL_MIN_TRANSP, extraTransp = compositeBreadthExtraTransp)


// ═════════════════════════════════════════════════════════════════════════════
// 📊 PLOTS
// ═════════════════════════════════════════════════════════════════════════════
// No type annotation — hline.style_* values are hline_style, not string; an
// explicit `string` annotation locks the variable to const string and rejects them.
compositeBreadthZeroHlineStyle = compositeBreadthZeroLineStyle == "Dashed" ? hline.style_dashed : compositeBreadthZeroLineStyle == "Dotted" ? hline.style_dotted : hline.style_solid
hline(price = 0, title = "Zero", color = compositeBreadthZeroLineColor, linestyle = compositeBreadthZeroHlineStyle, linewidth = compositeBreadthZeroLineWidth, display = compositeBreadthShowZeroLine ? display.all : display.none)
plot(series = compositeBreadthShowCompositeLine ? compositeBreadthDisplayLine : na, title = "Composite", color = compositeBreadthLineColor, linewidth = compositeBreadthLineWidth)
plot(series = compositeBreadthShowSignalFast ? compositeBreadthSignalFastValue : na, title = "Signal Fast", color = compositeBreadthSignalFastColor, linewidth = compositeBreadthSignalFastWidth)
plot(series = compositeBreadthShowSignalSlow ? compositeBreadthSignalSlowValue : na, title = "Signal Slow", color = compositeBreadthSignalSlowColor, linewidth = compositeBreadthSignalSlowWidth)
// ─── Session dividers ─────────────────────────────────────────────────────────
// Vertical lines at the RTH open and close edges, time-anchored in the gap
// between bars (so they never cover the first/last bar). On an RTH-only chart
// the 16:00/09:30 boundary is one shared gap = a single divider. The style map
// is a var initializer — inputs are constant, so it evaluates once.
var compositeBreadthSessionDividerLineStyle = switch compositeBreadthSessionDividerStyle
    "Solid"  => line.style_solid
    "Dashed" => line.style_dashed
    => line.style_dotted
if compositeBreadthShowSessionDivider and (compositeBreadthSessionJustOpened or compositeBreadthSessionJustClosed)
    int compositeBreadthDividerTime = na(time[1]) ?
         time - timeframe.in_seconds(timeframe = timeframe.period) * 500 :
         (time + time[1]) / 2
    line.new(x1 = compositeBreadthDividerTime, y1 = -1.0, x2 = compositeBreadthDividerTime, y2 = 1.0, xloc = xloc.bar_time, extend = extend.both, color = compositeBreadthSessionDividerColor, style = compositeBreadthSessionDividerLineStyle, width = compositeBreadthSessionDividerWidth)

// ─── Conviction verdict tag ─────────────────────────────────────────────────
// ONE label per session, minted on the confirmed bar the open-quality verdict
// resolves (rising edge of ConvVerdictReady — set only on barstate.isconfirmed,
// so no intrabar mint/delete). Anchored on the composite line at that bar (so
// it is always on-screen and sits where the open resolved), box hanging above.
// TRUST cyan / FADE red / MIXED grey; a driver line names regime + gap; dots
// show how many of the two drivers back the verdict.
var compositeBreadthConvTagTextSize = switch compositeBreadthConvTagSize
    "Tiny"   => size.tiny
    "Normal" => size.normal
    "Large"  => size.large
    => size.small
if compositeBreadthShowConviction and compositeBreadthConvVerdictReady and not compositeBreadthConvVerdictReady[1]
    string compositeBreadthConvVerdictWord = compositeBreadthConvVerdictSign > 0 ? "TRUST" : compositeBreadthConvVerdictSign < 0 ? "FADE" : "MIXED"
    int compositeBreadthConvAligned = (compositeBreadthConvVerdictSign != 0 and compositeBreadthConvVerdictRegime == compositeBreadthConvVerdictSign ? 1 : 0) +
         (compositeBreadthConvVerdictSign != 0 and compositeBreadthConvVerdictGap == compositeBreadthConvVerdictSign ? 1 : 0)
    string compositeBreadthConvDots = compositeBreadthConvVerdictSign == 0 ? "" : compositeBreadthConvAligned >= 2 ? " ●●" : " ●"
    string compositeBreadthConvRegimeStr = compositeBreadthConvVerdictRegime > 0 ? "EXP" : compositeBreadthConvVerdictRegime < 0 ? "LIGHT" : "NEUT"
    string compositeBreadthConvGapStr = compositeBreadthConvVerdictGap > 0 ? "GO" : compositeBreadthConvVerdictGap < 0 ? "CLOSE" : "MIXED"
    string compositeBreadthConvTagText = compositeBreadthConvVerdictWord + compositeBreadthConvDots + "\n" + compositeBreadthConvRegimeStr + " · " + compositeBreadthConvGapStr
    color compositeBreadthConvTagHue = compositeBreadthConvVerdictSign > 0 ? NORD8 : compositeBreadthConvVerdictSign < 0 ? NORD11 : NORD3
    color compositeBreadthConvTagTextColor = compositeBreadthConvVerdictSign > 0 ? NORD0 : NORD6
    label.new(x = bar_index, y = na(compositeBreadthDisplayLine) ? 0.0 : compositeBreadthDisplayLine, text = compositeBreadthConvTagText, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(color = compositeBreadthConvTagHue, transp = 10), textcolor = compositeBreadthConvTagTextColor, size = compositeBreadthConvTagTextSize)