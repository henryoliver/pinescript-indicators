//@version=6
// dynamic_requests: explicit (it is the v6 default) — every breadth feed's
// symbol is built from the Market input suffix, so the request.security calls
// take a series (input-derived) symbol, which requires dynamic requests.
indicator(title = "Composite Breadth Indicator", shorttitle = "📊 CBI", format = format.price, precision = 2, max_lines_count = 500, max_labels_count = 500, dynamic_requests = true)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0  = #2E3440
const color NORD1  = #3B4252
const color NORD2  = #434C5E
const color NORD3  = #4C566A
// Snow Storm
const color NORD4  = #D8DEE9
const color NORD5  = #E5E9F0
const color NORD6  = #ECEFF4
// Frost
const color NORD7  = #8FBCBB
const color NORD8  = #88C0D0
const color NORD9  = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// 📊 COMPOSITE BREADTH — CONVICTION TEST BUILD (temporary, 2026-07-29)
// Market breadth composite from VOLD, ADD, PCTABOVEVWAP, and CUMTICK
// (session-cumulative TICK slope). The composite is a CONFIRMATION instrument:
// price discovery happens in the futures, breadth answers "did the cash basket
// ratify the move". The LINE is the smooth weighted stance; consensus renders
// as line OPACITY (2026-07-13 volatility rework), never a multiplier.
//
// This is a REDUCED TEST build with three lines — the composite line and the
// fast/slow signal MAs — plus two collaborator layers on the line itself
// (2026-08-01 rework, replacing the Direction Conviction verdict tag):
//   🧭 LINE TRUST — the opening regime (first-30-min volume + open volatility
//      vs trailing baselines) sets the line's vividness CEILING for the
//      session and unlocks the "trusted" max-vivid step on expansion tapes;
//      quiet-regime vivid-grade pushes get an ▲ unsupported-move marker.
//   🎯 PRICE CONFIRMATION — Dow-style read of price vs breadth at session
//      extremes; a failure (price new extreme, breadth doesn't follow) drops
//      a ◆ non-confirmation diamond.
// Every other sub-indicator (TICK extremes, persistence, early-shift,
// trend-tell, last-hour, VOLD extremes, adaptive levels, PCCE, Lowry) and its
// config was stripped for the test. Restore the full indicator from
// composite-breadth.FULL-2026-07-29.pine (scratchpad) afterward. Panel groups
// (in settings order): Market, Zero Line, Session Divider, Composite, Weights,
// Signal, Line Trust, Price Confirmation. This section owns the inputs, data
// requests, calculations, and plots.
const string GROUP_COMPOSITE_BREADTH_MARKET  = "🏛️ Market"
const string GROUP_COMPOSITE_BREADTH_ZEROLINE = "➖ Zero Line"
const string GROUP_COMPOSITE_BREADTH_DIVIDER = "‖ Session Divider"
const string GROUP_COMPOSITE_BREADTH_LINE    = "🌊 Composite"
const string GROUP_COMPOSITE_BREADTH_WEIGHTS = "⚖️ Weights"
const string GROUP_COMPOSITE_BREADTH_SIGNAL  = "🧮 Signal"
const string GROUP_COMPOSITE_BREADTH_TRUST   = "🧭 Line Trust"
const string GROUP_COMPOSITE_BREADTH_CONFIRM = "🎯 Price Confirmation"

const float CBI_SCALE_MAX               = 100.0
const float CBI_TICK_FIXED_SCALE        = 500.0    // NYSE-reference cumTICK saturation base — "TICK averaged ±500 across the slope window"; scaled per market by the TICK market factor
const int   CBI_SIGNAL_WARMUP_BARS      = 5        // bars to seed display before first signal value — slightly longer than legacy 3 so the EMA isn't dominated by the seed at session open
const int   CBI_DISPLAY_SMOOTH_LENGTH   = 3        // light EMA on composite for the plot only — reduces visual noise without affecting calc
const int   CBI_OPACITY_SMOOTH_LENGTH   = 4        // EMA (bars) on the line's RENDERED transparency only — every opacity driver is a step function (agreement tiers, impulse/retrace flips, boost, ceiling, time-of-day edges), so the raw target jumps up to ~58 points bar-to-bar; smoothing the render turns each step into a few-bar glide while the STATE stays discrete (markers, table, data window all read the unsmoothed truth)
const int   CBI_MARKER_REARM_BARS       = 5        // confirmed bars the unsupported-move condition must stay OFF before the marker re-arms — without this, a one-bar slope wiggle inside one quiet-day push re-fires the ▲ every few bars

const float CBI_CUMTICK_SLOPE_MINUTES   = 10.0     // cumulative-TICK slope lookback in MINUTES — bar count derived from the chart timeframe (5 bars on 2-min) so the window keeps its meaning on 1m/2m/5m charts. Short enough to catch real-time inflections, long enough to filter single-bar noise
const float CBI_CUMTICK_SLOPE_SMOOTH_MINUTES = 10.0 // EMA window (minutes → bars) applied to the cumTICK slope BEFORE normalization — the raw 10-minute ROC flips sign constantly (TICK oscillates ±300 around zero all day), and that per-bar sign chatter was the composite's main fast-noise injector at 25% weight. Smoothing the slope keeps the component's early-turning responsiveness while dropping the flicker
const float CBI_TICK_BIAS_DAYS          = 20.0     // Steenbarger Adjusted-TICK trailing-mean window in trading days — raw TICK carries a persistent positive bias; subtracting a ~20-day mean before cumulating recenters the cumTICK slope

const float CBI_OPEN_VOL_WINDOW_MINUTES = 30.0     // opening-volume capture window — Raschke's number-one day-type criterion is FIRST-30-MINUTE NYSE volume ("The very number one criteria I look at is volume and I will usually look at the first 30-minute volume"). Measured as the market's TVOL print at the 30-minute mark — the exact total-volume series, already requested as the VOLD ratio denominator
const float CBI_OPEN_VOL_MEAN_DAYS      = 10.0     // trailing mean window (sessions) for the opening-volume AND opening-range baselines the regime ratios compare against — cross-session EMA, same seeding pattern as the TICK bias mean
const float CBI_NONCONF_MARGIN          = 2.0      // minimum breadth shortfall (composite units, ±100 scale) for a lower-high/higher-low to count as a non-confirmation — filters numerical-noise "divergences" between back-to-back price extremes
const float CBI_MARKER_OFFSET           = 6.0      // pane units the ▲/◆ markers sit ABOVE the display line (fixed ±100 scale) so they never cover it
// NYSE RTH session windows (ET, Mon–Fri). RTH_OPEN anchors every session-wide
// state reset; RTH_FULL marks the whole cash session (its exit edge anchors
// the close-side session divider); LUNCH is the documented intraday
// volume/volatility trough (low-information breadth); MOC is the
// market-on-close rebalancing window where TICK is contaminated by
// index-rebalance program spikes.
const string CBI_SESSION_RTH_OPEN       = "0930-0935:23456"
const string CBI_SESSION_RTH_FULL       = "0930-1600:23456"
const string CBI_SESSION_LUNCH          = "1200-1330:23456"
const string CBI_SESSION_MORNING        = "1000-1100:23456"   // post-open reversion window — 135-session log analysis (2026-08-01): the 10:xx hour is where following the stance loses in 2 of 3 regime chunks (−1.6/−4.4 bps per 30min); the open's echo mean-reverts before the tape picks a side
const string CBI_SESSION_MOC            = "1545-1600:23456"

// ─── Market ───────────────────────────────────────────────────────────────────
// Six breadth universes, one per USI dotted suffix (all four feed families —
// ADVDEC, ADVDECV, PCTABOVEVWAP, TICK — plus the TVOL denominator are
// verified live for every suffix; ICE data). PER-COMPONENT ROUTING
// (2026-07-31 research verdict): no single universe wins — the Breadth
// Universe below drives VOLD, TVOL and PCTABOVEVWAP (volume breadth is
// self-cap-weighted toward the same mega-caps the traded index holds, so it
// belongs on the traded market), while A-D and TICK get their own universe
// inputs defaulting to NYSE: Nasdaq issue-count A/D is structurally
// contaminated by small-cap listing churn (McClellan — false divergences are
// its background condition, the cumulative line has never made an all-time
// high since 1972) and NYSE A-D is the highest-quality issue-count read even
// for judging Nasdaq strength; the Steenbarger Adjusted-TICK canon and
// practitioner practice (incl. Nasdaq-only traders, incl. Barry Burns) are
// explicitly NYSE TICK — no evidence survived for a TICK.NQ advantage.
string compositeBreadthMarket = input.string(
     defval = "NASDAQ",
     title = "Breadth Universe",
     options = ["US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "Universe for the VOLD, TVOL and PCTABOVEVWAP feeds — pick the market being traded (volume breadth is self-cap-weighted toward the index's own mega-caps, so it belongs on the traded tape). US All Markets (.US) for RTY/Russell or total-market confirmation (no Russell-specific feed exists). NYSE (.NY) for ES/SPX — the classic S&P breadth read. NASDAQ (.NQ) for NQ/NDX/QQQ. Dow Jones (.DJ) is the exact Dow 30 basket — coarse (30 issues) but exchange-exact for YM. NYSE Arca (.AX) is the ETF tape — highly correlated issues, expect saturated readings on directional days. NYSE American (.AM) is the small/micro-cap tape — thin, read with its coarser calibration in mind. The A-D and TICK components route via their own universe inputs below.",
     group = GROUP_COMPOSITE_BREADTH_MARKET
 )

string compositeBreadthAddUniverse = input.string(
     defval = "NYSE",
     title = "A-D Universe",
     options = ["Same as Breadth Universe", "US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "Universe for the ADD component's issue-count feed (ADVDEC), with its saturation scale following the pick. NYSE default (2026-07-31 research): Nasdaq issue-count A/D carries a structural negative bias from small-cap listing churn — marginal listings spend their IPO-to-delisting decline feeding the declines column, so divergences vs the index are its normal background condition (McClellan), and equal-weighted counting under-represents the mega-caps that drive a cap-weighted index ~300×. NYSE A-D is the documented highest-quality issue-count read even for judging Nasdaq strength. The same contamination argument covers US All Markets (it contains the Nasdaq tape) and NYSE American; caveat: the documented bias is cumulative daily-scale drift — a session-resetting intraday ADD inherits the mechanism only weakly.",
     group = GROUP_COMPOSITE_BREADTH_MARKET
 )

string compositeBreadthTickUniverse = input.string(
     defval = "NYSE",
     title = "TICK Universe",
     options = ["Same as Breadth Universe", "US All Markets", "NYSE", "NASDAQ", "Dow Jones", "NYSE Arca", "NYSE American"],
     tooltip = "Universe for the CUMTICK component's TICK feed, with every TICK level scaled by the picked universe's factor. NYSE default (2026-07-31 research): Steenbarger's Adjusted-TICK canon is explicitly NYSE TICK, and practitioner practice — including dedicated Nasdaq-only traders and Barry Burns (\"I just use the New York Stock Exchange tick\"; the Nasdaq/Dow ticks \"just don't reach the extremes as much\") — routes to NYSE TICK for every instrument. No evidence survived for a TICK.NQ advantage.",
     group = GROUP_COMPOSITE_BREADTH_MARKET
 )

// ─── Zero Line ────────────────────────────────────────────────────────────────
bool compositeBreadthShowZeroLine = input.bool(defval = false, title = "Show", group = GROUP_COMPOSITE_BREADTH_ZEROLINE)
color compositeBreadthZeroLineColor = input.color(defval = NORD3, title = "Color", group = GROUP_COMPOSITE_BREADTH_ZEROLINE)
int compositeBreadthZeroLineWidth = input.int(defval = 3, title = "Width", minval = 1, maxval = 4, group = GROUP_COMPOSITE_BREADTH_ZEROLINE)
string compositeBreadthZeroLineStyle = input.string(defval = "Solid", title = "Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_COMPOSITE_BREADTH_ZEROLINE)

// ─── Session Divider ──────────────────────────────────────────────────────────
// Vertical lines at each RTH open/close so trade days are separated.
bool compositeBreadthShowSessionDivider = input.bool(defval = false, title = "Show", tooltip = "Vertical lines at each NYSE RTH session's open and close (time-anchored in the gap between bars, so they never cover the first/last bar). On an RTH-only chart the 16:00 and next 09:30 share one gap = a single divider.", group = GROUP_COMPOSITE_BREADTH_DIVIDER)
color compositeBreadthSessionDividerColor = input.color(defval = color.new(color = NORD3, transp = 0), title = "Color", group = GROUP_COMPOSITE_BREADTH_DIVIDER)
int compositeBreadthSessionDividerWidth = input.int(defval = 2, title = "Width", minval = 1, maxval = 10, group = GROUP_COMPOSITE_BREADTH_DIVIDER)
string compositeBreadthSessionDividerStyle = input.string(defval = "Dashed", title = "Style", options = ["Solid", "Dashed", "Dotted"], group = GROUP_COMPOSITE_BREADTH_DIVIDER)

// ─── Composite line ───────────────────────────────────────────────────────────
// The composite line's own display config, first in the panel. The line is
// SLOPE-colored (2026-07-31 rework, same engine as ma-waves' trend line and
// macd-waves' slope colors): rising = Up Color, falling = Down Color, last
// direction held on flat bars — NOT the old above/below-zero gradient.
// CONSENSUS is always on and renders as opacity ON TOP of the slope color,
// symmetrically on both sides: vivid rising = components agree behind the up
// move, vivid falling = components agree behind the down move, pale either
// way = internal disagreement. TIME-OF-DAY DIMMING is a separate, agnostic
// overlay — it just adds transparency to whatever color resulted and never
// touches the consensus calc. Opacity only; the composite's value is never
// modified.
bool compositeBreadthShowCompositeLine = input.bool(
     defval = true,
     title = "Show",
     tooltip = "Show/hide the composite line itself. DISPLAY-ONLY — the composite is the engine, so the signal MAs and the conviction verdict keep computing off it even when hidden (e.g. hide it to read the pane as signals only).",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

// Zero-cut color pair — two hues, one dial (2026-08-01): NORD8 owns the whole
// ABOVE-ZERO side, NORD11 the whole BELOW-ZERO side (the composite is a
// zero-anchored stance line, so its sign IS the trend — the standard
// internals-pane read), and OPACITY alone walks each from ghost (the retrace
// — no internal backing) through split/dissent to vivid (the impulse with
// full agreement) and the trusted max-vivid step the expansion regime
// unlocks. The hue changes only where the line crosses zero — never per
// slope segment, never on a vote. The picker owns hue AND the vivid-tier
// base opacity; agreement/regime only move transparency.
color compositeBreadthLineUpColor = input.color(
     defval = color.new(color = NORD8, transp = 28),
     title = "Bullish Color",
     tooltip = "Line color for the whole ABOVE-ZERO side — impulses and retraces alike (opacity separates them: with-trend impulses run the agreement ladder to vivid, retraces ghost). The hue changes only where the line crosses zero. The picker owns hue and the VIVID-tier base opacity: agreement dims from there and the expansion-regime trust boost brightens past it. Hue answers only \"which side of zero\"; opacity answers \"how much to believe the current move\".",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

color compositeBreadthLineDownColor = input.color(
     defval = color.new(color = NORD11, transp = 28),
     title = "Bearish Color",
     tooltip = "Line color for the whole BELOW-ZERO side — down-impulses run the agreement ladder to vivid (the predominant read), bounces ghost. Same treatment as the Bullish Color: picker owns hue and the vivid-tier base opacity; agreement and the regime ceiling/boost only move transparency. At full vividness on an expansion tape this reads as CONFIRMED WEAKNESS.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

int compositeBreadthLineWidth = input.int(
     defval = 4,
     title = "Line Width",
     minval = 1,
     maxval = 10,
     tooltip = "Composite line width in pixels.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

int compositeBreadthConsensusDimStrength = input.int(
     defval = 65,
     title = "Consensus Dim Strength",
     minval = 0,
     maxval = 90,
     step = 5,
     tooltip = "Extra transparency at maximum internal disagreement — always on, applied symmetrically to whichever slope color is active. (1 − move consensus) × this is added to the line's transparency: components aligned behind the move = vivid, split = pale, countertrend drift = ghost, on the way up and on the way down alike. 0 disables the dim entirely. Capped at 95.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

// The deadband drives the composite's consensus vote (line opacity).
float compositeBreadthConsensusDeadband = input.float(
     defval = 0.1,
     title = "Consensus Vote Deadband",
     minval = 0.0,
     maxval = 0.5,
     step = 0.05,
     tooltip = "Confidence magnitude a component must exceed before it VOTES in the consensus read. Near-zero components abstain — flat is not dissent — and an established vote holds through the band (hysteresis), flipping only when confidence crosses the band on the OPPOSITE side. Kills the consensus flicker from a component's sign chattering around zero without delaying real rollovers. Consensus renders as the composite line's opacity.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

bool compositeBreadthShowTimeOfDayDim = input.bool(
     defval = false,
     title = "Time-of-Day Dimming",
     tooltip = "OFF by default. An INDEPENDENT overlay that dims the line during the two structurally low-information windows — the lunch trough (12:00–13:30 ET) and the MOC window (15:45–16:00 ET) — on top of whatever the trend color + consensus dim produced. It adds transparency agnostically and does NOT affect the consensus calculation. Purely time-based; leave it off unless you specifically want the midday/close fade. Visual only; the composite value is unchanged.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

bool compositeBreadthShowMorningDim = input.bool(
     defval = true,
     title = "Morning Reversion Dim",
     tooltip = "ON by default — the most consistent finding in the 135-session log analysis: the 10:00–11:00 ET hour is where following the composite's stance LOSES (negative in 2 of 3 regime chunks, worst of the day), while 14:00+ is positive in all three — the open's echo mean-reverts before the tape picks a side (Gao et al.: the first half-hour's information pays at the close, not right after). Dims the line by the Time-of-Day Dim Strength during 10:00–11:00, independent of the lunch/MOC toggle. Opacity only; the composite value is unchanged.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

int compositeBreadthTimeDimStrength = input.int(
     defval = 40,
     title = "Time-of-Day Dim Strength",
     minval = 0,
     maxval = 90,
     step = 5,
     tooltip = "Transparency the time-based dims add to the line — the lunch/MOC windows (Time-of-Day Dimming toggle) and the 10:00–11:00 morning-reversion window (Morning Reversion Dim toggle) share this one strength. Added on top of the line's current opacity and capped at 95.",
     group = GROUP_COMPOSITE_BREADTH_LINE
 )

// ─── Weights (40/30/30/0 = VOLD/ADD/PCTABOVEVWAP/CUMTICK) ─────────────────────
// Research synthesis: TRIN is a non-independent transformation of VOLD+ADD so
// adding it would double-count. VOLD and ADD are correlated siblings (net
// breadth measured in volume vs issues — their DISAGREEMENT is the
// information, and the consensus read extracts it, surfacing as line
// opacity); VOLD keeps the edge over ADD as the higher-conviction leg, the
// cleanest trend-day identifier in practitioner use, and the largest-|IC|
// component in the 135-session log analysis. PCTABOVEVWAP captures
// positioning vs the dominant institutional execution benchmark and is
// independent of the volume/issue dimensions.
//
// CUMTICK DEFAULTS TO 0 (2026-08-01 log verdict): across three regime chunks
// (Jan–Mar down, Mar–May rally, May–Jul chop; 135 sessions of 2-min QQQ
// bars) its IC vs forward returns was NEGATIVE in all three (−0.01..−0.04 at
// 60min) and no alternative slope window rescued it — the one component that
// was weak in every regime, confirming the earlier research round's refuted
// "cumulative TICK leads price" premise. Weight 0 fully deactivates it (no
// weighted-sum contribution, no consensus vote) while the engine keeps
// computing, so re-enabling is a one-input change. Raw TICK
// remains context-only: the per-bar value is too noisy to be a weighted
// signal.
//
// Weight doctrine (2026-07-08, reaffirmed 2026-07-31): with correlated noisy
// signals and no out-of-sample estimation, stay near equal weights with at
// most mild conviction tilts (forecast-combination puzzle, DeMiguel's 1/N).
// 40/30/30 is near-1/N across the three LIVE components with VOLD's
// evidence-backed tilt — re-tuning further without a proper out-of-sample
// sweep would be worse than leaving it alone.
float compositeBreadthVoldWeight = input.float(
     defval = 40,
     title = "VOLD",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Volume trend — conviction. Barry's primary intraday breadth read on NDX (\"up/down volume difference\"), the strongest trend-day identifier in practitioner use, and the largest-magnitude component in the 135-session log analysis (its sign tracks the prevailing regime — IC +0.11 in the Mar–May rally).",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

float compositeBreadthAddWeight = input.float(
     defval = 30,
     title = "ADD",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Advance-Decline — direction (how many stocks). Distinct from VOLD which measures conviction (how much volume). Weighted slightly below VOLD: the two are correlated siblings and VOLD is the higher-conviction of the pair.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

float compositeBreadthPctVwapWeight = input.float(
     defval = 30,
     title = "PCTABOVEVWAP",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "Percent of stocks trading above their intraday VWAP — independent breadth dimension capturing real-time positioning vs the institutional execution benchmark (VWAP-pegged algos are the single largest execution style). The slowest-turning component: reads as the composite's stance, not its trigger. Routes to the Breadth Universe's PCTABOVEVWAP feed.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

float compositeBreadthCumTickWeight = input.float(
     defval = 0,
     title = "CUMTICK",
     minval = 0,
     maxval = 100,
     step = 5,
     tooltip = "DEFAULT 0 — DEACTIVATED by the 2026-08-01 log analysis: its correlation with forward returns was negative in all three regime chunks (135 sessions) and no slope window rescued it, confirming the refuted \"cumulative TICK leads price\" premise. At 0 it contributes nothing to the weighted sum and casts no consensus vote; the engine keeps computing so re-enabling is a one-input change. Construction if re-enabled: 10-minute ROC of the session sum of bias-adjusted TICK (Steenbarger-style trailing ~20-day mean subtraction), 10-minute EMA smoothed, saturating at ±500 NYSE-scale × the TICK universe's factor; frozen in the MOC window; resets each RTH open.",
     group = GROUP_COMPOSITE_BREADTH_WEIGHTS
 )

// ─── Signal / smoothing ───────────────────────────────────────────────────────
// Signal PAIR (2026-07-24 rework of the single signal line): a fast trigger
// MA and a slow baseline MA on the smoothed composite, both session-
// reseeding. Defaults = 10-minute EMA / 20-minute SMA — the "9/20 setup"
// anchored in MINUTES, with the fast leg nudged 9 → 10 so it divides the
// 2-MINUTE bar exactly (this indicator lives on a dedicated 2-min internals
// chart — Barry's documented practice: "I like two-minute bars … that's
// what I use on this"): on 2-min the pair renders as 5 EMA / 10 SMA bars
// exactly, on 1-min as 10 EMA / 20 SMA (the classic pair, one tick slower),
// on 3-min as ~3 EMA / 7 SMA (almost exactly Raschke 3/10-oscillator
// geometry). The ~2:1 fast:slow ratio matches the
// canonical MA pair applied to breadth rather than price — McClellan's
// 19/39 EMA oscillator (2.05) and MACD's 12/26 (2.17) — and the EMA-fast /
// SMA-slow mix is the trigger-vs-structure split, not folklore: an EMA lags
// ~1/3 of its length (early trigger), an SMA lags half (smoother,
// harder-to-whipsaw baseline). Bar-count lengths were rejected because a
// 20-BAR SMA on the 3-min chart = 60 minutes of post-09:30 convergence —
// the entire prime open window burned on warmup.
bool compositeBreadthShowSignalFast = input.bool(
     defval = false,
     title = "Show Fast",
     tooltip = "FAST leg of the signal pair — the trigger line on the smoothed composite (fed from the same series that's plotted, so crosses and divergences read true). Toggling OFF turns the leg fully off — not computed. The slow leg keeps running on its own.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

bool compositeBreadthShowSignalSlow = input.bool(
     defval = false,
     title = "Show Slow",
     tooltip = "SLOW leg of the signal pair — the baseline. Composite above/below it = momentum building that way (the legacy single-signal read). Toggling OFF turns the leg fully off — not computed. The fast leg keeps running on its own.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

string compositeBreadthSignalFastType = input.string(
     defval = "EMA",
     title = "Fast Type",
     options = ["EMA", "SMA"],
     tooltip = "Moving-average type for the FAST leg. EMA (default): exponentially weighted — hugs the composite tighter and turns earlier, the trigger line. SMA: plain rolling mean of the leg's window. Both reseed at every session open (a window never reaches across the 09:30 boundary).",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalFastMinutes = input.int(
     defval = 10,
     title = "Fast Length (minutes)",
     minval = 2,
     maxval = 120,
     step = 1,
     tooltip = "FAST leg window in MINUTES — converted to a bar count from the chart timeframe (5 bars on the 2-min internals chart, 10 on 1-min, 3 on 3-min) so the leg keeps its meaning on every chart the pair is traded on. Default 10 is the classic 9-minute trigger nudged up one so it divides the 2-minute bar exactly — the input reads exactly what plots.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

color compositeBreadthSignalFastColor = input.color(
     defval = NORD3,
     title = "Fast Color",
     tooltip = "Fast leg color — the picker owns hue and opacity. Default = NORD3 at full opacity; the fast leg is kept lightest by its width (1px), not by transparency, so it reads clearly against the composite.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalFastWidth = input.int(
     defval = 1,
     title = "Fast Width",
     minval = 1,
     maxval = 10,
     tooltip = "Fast leg line width in pixels — default 1 keeps the trigger visually lightest of the three lines.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

string compositeBreadthSignalSlowType = input.string(
     defval = "SMA",
     title = "Slow Type",
     options = ["SMA", "EMA"],
     tooltip = "Moving-average type for the SLOW leg. SMA (default): every bar in the window weighs the same, so the baseline reads as \"where has the composite been over the last leg\" — the smoother, harder-to-whipsaw structure line (Raschke's 3/10 deliberately uses the smoother SMA type for the same reason). EMA: turns earlier at the cost of more lunch-chop crosses.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalSlowMinutes = input.int(
     defval = 20,
     title = "Slow Length (minutes)",
     minval = 5,
     maxval = 240,
     step = 1,
     tooltip = "SLOW leg window in MINUTES — converted to a bar count from the chart timeframe (10 bars on the 2-min internals chart, 20 on 1-min, 7 on 3-min). Default 20 pairs with the 10-minute fast leg at the 2:1 crossover geometry (McClellan 19/39, MACD 12/26) and is converged by ~09:50 after the session reseed on any of those charts.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

color compositeBreadthSignalSlowColor = input.color(
     defval = NORD3,
     title = "Slow Color",
     tooltip = "Slow leg color (transparency supported via the picker).",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

int compositeBreadthSignalSlowWidth = input.int(
     defval = 3,
     title = "Slow Width",
     minval = 1,
     maxval = 10,
     tooltip = "Slow leg line width in pixels — default 3 matches the composite's weight (the baseline reads as its equal) while the fast trigger stays lightest at 1.",
     group = GROUP_COMPOSITE_BREADTH_SIGNAL
 )

// ─── Line Trust (session regime → the line's vividness ceiling) ─────────────
// Replaces the Direction Conviction verdict tag (2026-08-01, research-driven
// rebuild). Conviction is no longer a parallel opinion next to the line — it
// QUALIFIES the line: the opening regime (first-30-min volume + open
// volatility vs ~10-session trailing baselines, the two evidence-backed
// conditioners) decides how loud the line is allowed to speak today.
// Expansion = full voice + the "trusted" max-vivid step; neutral = mild cap;
// quiet = whisper (follow-through signal on quiet opens is statistically
// ≈ zero — JFE 2018 low-volatility tercile). Vivid-grade pushes on a quiet
// tape get an ▲ unsupported-move marker. The gap leg, the weighted TRUST/FADE
// score, and the 1–4 meter tag were removed outright (gap base rates never
// verified at a primary source; the combined score's nearest tested analogue
// failed out-of-sample). Nothing here touches the composite's value — ceiling,
// boost, and markers are opacity/labels only.
bool compositeBreadthShowLineTrust = input.bool(
     defval = true,
     title = "Show",
     tooltip = "Master toggle for the Line Trust layer: the opening-regime read (volume + open volatility), the session vividness ceiling, the expansion trust boost, the ▲ unsupported-move markers, and the Trust Readout table. OFF = the line renders on agreement alone (no ceiling, no boost) and none of this computes.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

float compositeBreadthOpenVolExpansionRatio = input.float(
     defval = 1.2,
     title = "Volume Expansion Ratio",
     minval = 1.0,
     maxval = 3.0,
     step = 0.05,
     tooltip = "First-30-minute volume (or opening range) at or above this multiple of its trailing ~10-session mean = EXPANSION regime — full ceiling, trusted step unlocked. Raschke's rule is categorical (\"good volume day\" vs \"light volume day\") with no published number; 1.2× is this indicator's parameterization, not hers — re-validate on current data rather than trusting it.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

float compositeBreadthOpenVolLightRatio = input.float(
     defval = 0.8,
     title = "Volume Quiet Ratio",
     minval = 0.3,
     maxval = 1.0,
     step = 0.05,
     tooltip = "First-30-minute volume at or below this multiple of the trailing mean — AND open volatility at or below it too (quiet needs both: the follow-through evidence dies only when volume and open range are both low) = QUIET regime: the whole line runs at the Quiet Ceiling all session and vivid-grade pushes get flagged. Between the two ratios = NEUTRAL.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

float compositeBreadthOpenRangeMinutes = input.float(
     defval = 30.0,
     title = "Open Volatility Window (minutes)",
     minval = 10.0,
     maxval = 60.0,
     step = 5.0,
     tooltip = "Window for the opening-volatility leg: the chart's high-low range over the first N minutes, compared to its ~10-session trailing mean exactly like the volume leg. Open volatility conditions follow-through even more sharply than volume (JFE 2018: the low-volatility tercile carries NO statistically significant signal), so it shares the regime vote: either leg expanding = expansion, both quiet = quiet.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

int compositeBreadthQuietCeilingDim = input.int(
     defval = 40,
     title = "Quiet Ceiling Dim",
     minval = 0,
     maxval = 90,
     step = 5,
     tooltip = "Transparency added to the ENTIRE line for the rest of the session when the regime reads QUIET — the visual statement that today's directional reads are low-information. Applied on top of the agreement dim, capped at 95.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

int compositeBreadthNeutralCeilingDim = input.int(
     defval = 15,
     title = "Neutral Ceiling Dim",
     minval = 0,
     maxval = 90,
     step = 5,
     tooltip = "Transparency added to the line on a NEUTRAL (or unclassifiable — no baseline yet, feeds dark) session. Mild by default: the tape is participating, just not expanding. Expansion sessions get no ceiling at all.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

int compositeBreadthTrustBoost = input.int(
     defval = 23,
     title = "Trust Vividness Boost",
     minval = 0,
     maxval = 28,
     step = 1,
     tooltip = "Transparency REMOVED from the line (brighter than the picker's vivid tier) when everything stacks: EXPANSION regime + full agreement across the voting components + an established stance the slope is moving with. This is the \"trusted rising / confirmed weakness\" max-vivid step — the only state that renders brighter than the base color.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

bool compositeBreadthShowTrustTable = input.bool(
     defval = true,
     title = "Trust Readout Table",
     tooltip = "Corner table with the live numbers: STATE (trusted/vivid/dimmed/pale/ghost), CBI value + slope, agreement count with the dissenter, stance vote, and the regime with its volume/volatility ratios. Redrawn on last-bar ticks only — a handful of cells, negligible cost; OFF creates nothing.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

bool compositeBreadthShowUnsupportedMarkers = input.bool(
     defval = true,
     title = "Unsupported-Move Markers",
     tooltip = "▲/▼ marker on the first confirmed bar of a vivid-grade push (full agreement of the voting components behind the slope) during a QUIET regime — a move without tape participation; quiet opens carry ≈ zero follow-through signal, don't chase it. One marker per push episode; hover for the numbers. Silence everywhere else is the design: expansion days draw nothing.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

color compositeBreadthUnsupportedMarkerColor = input.color(
     defval = color.new(color = NORD13, transp = 25),
     title = "Marker Color",
     tooltip = "Unsupported-move marker color — used verbatim (the picker owns hue and opacity).",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

int compositeBreadthUnsupportedMarkerSize = input.int(
     defval = 4,
     title = "Marker Size",
     minval = 4,
     maxval = 20,
     tooltip = "Unsupported-move marker size in points.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

bool compositeBreadthNewsDaySuppression = input.bool(
     defval = false,
     title = "News-Day Suppression (today)",
     tooltip = "Manual kill switch for scheduled-news sessions (FOMC, CPI, opex) — Raschke's own explicit exception to the opening-volume rule: announcement-day volume expansion is event noise, not a higher-timeframe player. ON: the regime is forced NEUTRAL for the session (neutral ceiling, no trusted step, no unsupported-move markers) and the Trust Readout reads SUPPRESSED. Flip it on in the morning, off after.",
     group = GROUP_COMPOSITE_BREADTH_TRUST
 )

// ─── Price Confirmation (Dow-style price-vs-breadth read at the extremes) ────
// The one layer that adds NEW information rather than re-rendering state:
// price is the missing validator of the breadth line. At each new confirmed
// session price extreme, breadth must have followed; when price prints a new
// high (low) and the composite sits materially below (above) where it stood at
// the prior price extreme, that is a Dow-style NON-CONFIRMATION — the classic
// confirm-grade use of cumulative internals (Steenbarger's documented read is
// divergence at turns, not lead). Evaluated on confirmed closes only — no
// intrabar diamonds, no repaint. Chart OHLC only, zero new feeds.
bool compositeBreadthShowPriceConfirmation = input.bool(
     defval = true,
     title = "Show",
     tooltip = "Watch the chart's session price extremes against the composite: a new confirmed price high (low) with breadth at a materially lower high (higher low) vs the prior price extreme = a ◆ non-confirmation marker on the line. Confirmation itself is silent — agreement is the normal state; only the failure draws. Evaluated on bar close only.",
     group = GROUP_COMPOSITE_BREADTH_CONFIRM
 )

color compositeBreadthNonConfMarkerColor = input.color(
     defval = color.new(color = NORD12, transp = 15),
     title = "Non-Confirmation Marker Color",
     tooltip = "◆ non-confirmation marker color — used verbatim (the picker owns hue and opacity).",
     group = GROUP_COMPOSITE_BREADTH_CONFIRM
 )

int compositeBreadthNonConfMarkerSize = input.int(
     defval = 4,
     title = "Marker Size",
     minval = 4,
     maxval = 20,
     tooltip = "Non-confirmation marker size in points.",
     group = GROUP_COMPOSITE_BREADTH_CONFIRM
 )

int compositeBreadthNonConfSeparationMinutes = input.int(
     defval = 30,
     title = "Min Extreme Separation (minutes)",
     minval = 10,
     maxval = 120,
     step = 5,
     tooltip = "Minimum time between the prior price extreme and the new one before a non-confirmation can fire (bar count derived from the chart timeframe). Back-to-back new highs during one push are one advance, not a divergence — this keeps the diamond meaning \"price came BACK to a new extreme and breadth declined to follow\".",
     group = GROUP_COMPOSITE_BREADTH_CONFIRM
 )

// ═════════════════════════════════════════════════════════════════════════════
// 🔗 SYMBOL ROUTING + PER-MARKET CALIBRATION
// Three resolved universes drive the feed families — VOLD/TVOL/PCTABOVEVWAP
// on the base Breadth Universe, ADVDEC on the A-D universe, TICK on the TICK
// universe (per-component routing, 2026-07-31). The dotted USI catalog makes
// this possible: ADVDEC/ADVDECV/TVOL/PCTABOVEVWAP/TICK exist for the SAME
// six universes (verified 2026-07-13 against TradingView's symbol-search API
// and symbol pages, provider ICE): .NY = NYSE, .NQ = Nasdaq, .US = all US
// markets combined, .DJ = Dow 30, .AX = NYSE Arca (ARCX — the ETF tape),
// .AM = NYSE American (former AMEX). The legacy bare symbols (USI:TICK,
// TICKQ, TICKI, ADD, UVOL/DVOL…) coexist as a separate partial family; the
// dotted family is used exclusively so every market gets the same
// construction.
// ═════════════════════════════════════════════════════════════════════════════
// Per-component routing: the A-D and TICK universe inputs resolve here —
// "Same as Breadth Universe" collapses onto the base pick, anything else
// overrides just that component's feed AND its calibration (ADD scale / TICK
// factor follow the component's universe, not the base market's). The suffix
// switches stay bare global statements (no helper function) so the symbol
// strings keep the simple qualifier request.security requires.
string compositeBreadthAddUniverseResolved = compositeBreadthAddUniverse == "Same as Breadth Universe" ?
     compositeBreadthMarket : compositeBreadthAddUniverse
string compositeBreadthTickUniverseResolved = compositeBreadthTickUniverse == "Same as Breadth Universe" ?
     compositeBreadthMarket : compositeBreadthTickUniverse

string compositeBreadthMarketSuffix = switch compositeBreadthMarket
    "US All Markets" => "US"
    "NYSE"           => "NY"
    "NASDAQ"         => "NQ"
    "Dow Jones"      => "DJ"
    "NYSE Arca"      => "AX"
    "NYSE American"  => "AM"
    => "NQ"

string compositeBreadthAddSuffix = switch compositeBreadthAddUniverseResolved
    "US All Markets" => "US"
    "NYSE"           => "NY"
    "NASDAQ"         => "NQ"
    "Dow Jones"      => "DJ"
    "NYSE Arca"      => "AX"
    "NYSE American"  => "AM"
    => "NQ"

string compositeBreadthTickSuffix = switch compositeBreadthTickUniverseResolved
    "US All Markets" => "US"
    "NYSE"           => "NY"
    "NASDAQ"         => "NQ"
    "Dow Jones"      => "DJ"
    "NYSE Arca"      => "AX"
    "NYSE American"  => "AM"
    => "NQ"

// ADD saturation scale — the net-issues reading that maps to full ±1
// confidence. Net issues is bounded by the exchange's tradable issue count
// and practitioners read it at ABSOLUTE levels, so a fixed per-market scale
// is the right normalization (calibration research 2026-07-13). Keys off the
// A-D component's own universe:
//   NYSE ~2,800 issues — ±1,500 strong / ±2,000 extreme is the documented
//     practitioner level (52-wk $ADDN extremes ≈ ±1,700) → scale 2000.
//   NASDAQ ~3,450 issues — scaled by issue ratio, matches observed 52-wk
//     $ADDQ extremes ≈ ±2,300-2,500 → scale 2500.
//   US combined ~8,000 tradable securities ≈ NY+NQ scales → 4500.
//   Dow: hard bound ±30; 27 = 28+ of 30 one-sided (lore extreme ±22-26).
//   Arca ~2,500 ETPs, but ETFs tick together → 2000 saturates appropriately.
//   American ~242 issues → 200.
float compositeBreadthAddScale = switch compositeBreadthAddUniverseResolved
    "US All Markets" => 4500.0
    "NYSE"           => 2000.0
    "NASDAQ"         => 2500.0
    "Dow Jones"      => 27.0
    "NYSE Arca"      => 2000.0
    "NYSE American"  => 200.0
    => 2500.0

// TICK market factor — scales every NYSE-calibrated TICK level (cumTICK
// saturation base ±500, extreme threshold ±985, trend-tell ±1500) to the
// resolved TICK feed (keys off the TICK component's own universe — NYSE
// default = factor 1.0, the calibration the levels were authored on). NYSE
// ±1,000 extreme is the documented anchor; the other factors derive from
// issue counts anchored to what IS documented (Nasdaq climax ~±1,200-1,300;
// Dow TICKI extreme lore ±22-26 of its ±30 bound — small baskets tick
// together, so the factor is NOT purely proportional to issue count). No
// practitioner levels exist for .US/.AX/.AM — factors are
// issue-count-derived, honest but unvalidated; re-check against the live
// feed's actual range before leaning on their extreme markers.
float compositeBreadthTickMarketFactor = switch compositeBreadthTickUniverseResolved
    "US All Markets" => 2.25
    "NYSE"           => 1.0
    "NASDAQ"         => 1.25
    "Dow Jones"      => 0.026
    "NYSE Arca"      => 1.6
    "NYSE American"  => 0.17
    => 1.25

// PCTABOVEVWAP band — ±band around 50 mapped to full ±1 confidence. The
// documented practitioner rails are 40/60 (>60 = don't short, <40 = don't
// long), so ±15 saturates right where the liquid tapes treat the reading as
// extreme (the legacy ±25 band chronically under-scaled the component — a
// strong 65 print scored only 0.6). Narrow/correlated universes swing
// harder and need wider rails: Dow is quantized in 3.33% steps (30 stocks)
// → ±20; Arca ETFs move together and pin toward 0/100 on any directional
// day, and American is thin → ±30. Derived, not documented — no
// per-exchange practitioner rails exist.
float compositeBreadthPctVwapBand = switch compositeBreadthMarket
    "US All Markets" => 15.0
    "NYSE"           => 15.0
    "NASDAQ"         => 15.0
    "Dow Jones"      => 20.0
    "NYSE Arca"      => 30.0
    "NYSE American"  => 30.0
    => 15.0

string compositeBreadthAddNetSymbol   = "USI:ADVDEC."       + compositeBreadthAddSuffix
string compositeBreadthVoldNetSymbol  = "USI:ADVDECV."      + compositeBreadthMarketSuffix
string compositeBreadthTotalVolSymbol = "USI:TVOL."         + compositeBreadthMarketSuffix
string compositeBreadthPctVwapSymbol  = "USI:PCTABOVEVWAP." + compositeBreadthMarketSuffix
string compositeBreadthTickSymbol     = "USI:TICK."         + compositeBreadthTickSuffix

// ═════════════════════════════════════════════════════════════════════════════
// 🎛️ DERIVED CALIBRATION
// Timeframe- and feed-aware scaling so the calibration constants keep their
// MEANING when the chart interval or the TICK feed changes.
//
// Windows are specified in minutes and converted to a bar count from the
// chart timeframe — a "10-minute slope" is 5 bars on 2-min, 10 bars on 1-min,
// 2 bars on 5-min, instead of silently becoming a 50-minute slope on a 10-min
// chart. Floors keep degenerate timeframes (daily+) from producing 0-bar
// windows; the breadth feeds are intraday-only anyway.
//
// TICK scaling: every TICK level in this indicator is authored on the NYSE
// calibration (±500 saturation base, ±985 extreme, ±1500 tell) and scaled to
// the resolved feed by the per-market factor — one factor, applied
// uniformly, replacing the old special-cased TICKQ handling. Scaled
// thresholds cap at 95% of the feed's theoretical bound so they stay
// reachable on tiny universes (see the bound switch above). Saturation
// always means "TICK averaged ±1 full scale for the entire slope window".
//
// The bias window (~20 trading days of chart bars, 390 RTH minutes per day)
// drives the Steenbarger trailing-mean adjustment on the cumTICK input.
// ═════════════════════════════════════════════════════════════════════════════
int compositeBreadthCumTickSlopeWindow  = math.max(2, math.round(number = CBI_CUMTICK_SLOPE_MINUTES * 60.0 / timeframe.in_seconds()))
int compositeBreadthCumTickSlopeSmoothBars = math.max(2, math.round(number = CBI_CUMTICK_SLOPE_SMOOTH_MINUTES * 60.0 / timeframe.in_seconds()))
int compositeBreadthTickBiasWindowBars  = math.max(10, math.round(number = CBI_TICK_BIAS_DAYS * 390.0 * 60.0 / timeframe.in_seconds()))
int compositeBreadthOpenVolWindowBars   = math.max(1, math.round(number = CBI_OPEN_VOL_WINDOW_MINUTES * 60.0 / timeframe.in_seconds()))
int compositeBreadthOpenRangeWindowBars = math.max(1, math.round(number = compositeBreadthOpenRangeMinutes * 60.0 / timeframe.in_seconds()))
int compositeBreadthNonConfSeparationBars = math.max(1, math.round(number = compositeBreadthNonConfSeparationMinutes * 60.0 / timeframe.in_seconds()))
int compositeBreadthSignalFastBars      = math.max(2, math.round(number = compositeBreadthSignalFastMinutes * 60.0 / timeframe.in_seconds()))
int compositeBreadthSignalSlowBars      = math.max(2, math.round(number = compositeBreadthSignalSlowMinutes * 60.0 / timeframe.in_seconds()))
float compositeBreadthTickScale         = CBI_TICK_FIXED_SCALE * compositeBreadthTickMarketFactor
float compositeBreadthCumTickSlopeScale = compositeBreadthCumTickSlopeWindow * compositeBreadthTickScale

// ═════════════════════════════════════════════════════════════════════════════
// 📡 DATA REQUESTS
// ═════════════════════════════════════════════════════════════════════════════
// The pre-computed nets (ADVDEC = advancers − decliners, ADVDECV = up-vol −
// down-vol) replace the old four-request ADVN/DECL + UPVOL/DNVOL
// construction. The normalization changed with them: ADD reads the net
// against a fixed per-market issue scale (net issues is bounded and
// practitioner levels are absolute), and VOLD reads net ÷ TVOL — the
// Lowry-style up/down volume ratio, the standard stationary form (±0.4 =
// trend-day tape, ±0.8 = a 90% day). TVOL includes unchanged volume, which
// damps the ratio a hair vs the old (U−D)/(U+D) — negligible on modern
// tapes, and TVOL doubles as the exact Raschke opening-volume source. Net
// effect: five CORE requests instead of six, one construction for all six
// markets; the optional layers (PCCE, Lowry UPVOL/DNVOL) add gated requests
// that cost nothing while disabled.
//
// All breadth feeds use gaps_on so out-of-session bars come back as na rather
// than being forward-filled with the last RTH value. On a futures or extended-
// hours chart, gaps_off would keep plotting Friday's last RTH breadth all
// weekend; gaps_on lets the composite blank when the feeds aren't live (paired
// with explicit na-clearing of the display/signal state below). For TICK
// specifically, the session-reset detector also relies on a real na→value
// transition to reseed the EMA at each NYSE RTH open.
//
// lookahead = barmerge.lookahead_off is intentional and correct here, NOT an
// oversight against the repo's "use lookahead_on for real-time accuracy" note
// (that guidance applies to HIGHER-timeframe requests). Every request below
// uses timeframe = timeframe.period — the chart's own timeframe — so there is
// no higher-timeframe bar to look ahead into and lookahead has no effect on the
// returned series. lookahead_off is also the non-repainting default; flipping
// to lookahead_on with `close` would leak future data on HTF requests, so off
// stays the safe choice if these are ever pointed at a higher timeframe.
float compositeBreadthAddNetValue = request.security(
     symbol = compositeBreadthAddNetSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

float compositeBreadthVoldNetValue = request.security(
     symbol = compositeBreadthVoldNetSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

float compositeBreadthTotalVolValue = request.security(
     symbol = compositeBreadthTotalVolSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

float compositeBreadthPctVwapValue = request.security(
     symbol = compositeBreadthPctVwapSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

// TICK close — feeds the composite's CUMTICK component (and its bias mean),
// where per-bar settlement is the right series. (The high/low tuple that fed
// the removed extreme-detection layer is gone in this test build.)
float compositeBreadthTickValue = request.security(
     symbol = compositeBreadthTickSymbol,
     timeframe = timeframe.period,
     expression = close,
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off,
     ignore_invalid_symbol = true
 )

// ═════════════════════════════════════════════════════════════════════════════
// 🔔 SESSION DETECTION
// AnyFeedLive = at least one of the five breadth feeds is non-na this bar.
// SessionJustOpened = the 09:30 ET time-anchored session-open edge — the
// canonical trigger for ALL session-wide state resets (display smoothing /
// signal average,
// cumTick, pending TICK-extreme flags, VOLD extremes, feed-health counters).
// One mechanism for every reset: earlier versions split
// resets between this edge and na→value feed edges, and the feed edges never
// fire on an RTH-only chart (no dark bars between sessions), which silently
// disabled the daily reseeds after day one.
//
// BarsSinceSessionOpen counts chart bars since the most recent session-open
// transition, increments only while at least one feed is live (so the
// off-RTH gap doesn't bloat the count). Used to gate cumTick slope
// computation against the cross-session lookback leak, to arm the
// composite-vs-signal cross alerts after the opening noise window, and to
// mature the feed-health warning even when TICK is the missing feed.
//
// InLunchWindow / InMocWindow mark the two structurally low-information
// windows: the midday volume/volatility trough (visual dimming only) and the
// market-on-close rebalancing window (CUMTICK frozen, TICK extremes
// suppressed, plus dimming).
// ═════════════════════════════════════════════════════════════════════════════
bool compositeBreadthAnyFeedLive =
     not na(compositeBreadthTickValue)     or
     not na(compositeBreadthAddNetValue)   or
     not na(compositeBreadthVoldNetValue)  or
     not na(compositeBreadthTotalVolValue) or
     not na(compositeBreadthPctVwapValue)

// Session-open edge is TIME-anchored, not feed-presence-anchored. The earlier
// "AnyFeedLive false→true" approach relied on a real off-session bar existing
// between sessions to create the na→value transition. That holds on futures /
// extended-hours charts (overnight bars come back na), but on an RTH-only chart
// there are NO dark bars between sessions: the bar before 09:30 is yesterday's
// 16:00, whose feeds were live, so AnyFeedLive[1] is true and the edge never
// fires — silently skipping the daily reset of the EMAs, cumTick, VOLD
// extremes, feed-health flags, and the session divider. Pinning to the NYSE RTH
// open window (09:30–09:35 ET, weekdays) fires reliably on BOTH chart types and
// decouples the reset from feed health — a session still opens at 09:30 even if
// a feed is dead, which is more correct than gating on whether data arrived.
bool compositeBreadthInRthOpen = not na(time(timeframe = timeframe.period, session = CBI_SESSION_RTH_OPEN, timezone = "America/New_York"))
bool compositeBreadthSessionJustOpened = compositeBreadthInRthOpen and not compositeBreadthInRthOpen[1]
bool compositeBreadthInLunchWindow = not na(time(timeframe = timeframe.period, session = CBI_SESSION_LUNCH, timezone = "America/New_York"))
bool compositeBreadthInMorningWindow = not na(time(timeframe = timeframe.period, session = CBI_SESSION_MORNING, timezone = "America/New_York"))
bool compositeBreadthInMocWindow   = not na(time(timeframe = timeframe.period, session = CBI_SESSION_MOC,   timezone = "America/New_York"))
// In the cash session (09:30–16:00 ET) — gates the gap layer's RTH-only
// prior-day price tracking so an extended-hours chart doesn't fold an overnight
// print into the range. SessionJustClosed = the RTH-exit edge (first post-16:00
// bar on extended charts) — drives the close-side session divider.
bool compositeBreadthInRthFull = not na(time(timeframe = timeframe.period, session = CBI_SESSION_RTH_FULL, timezone = "America/New_York"))
bool compositeBreadthSessionJustClosed = not compositeBreadthInRthFull and compositeBreadthInRthFull[1]

var int compositeBreadthBarsSinceSessionOpen = 0
if compositeBreadthSessionJustOpened
    compositeBreadthBarsSinceSessionOpen := 1
else if compositeBreadthAnyFeedLive
    compositeBreadthBarsSinceSessionOpen += 1

// ═════════════════════════════════════════════════════════════════════════════
// 🧮 HELPERS
// ═════════════════════════════════════════════════════════════════════════════
f_compositeBreadthClampedRatio(float numerator, float denominator) =>
    float compositeBreadthRatio = na
    if not na(numerator) and not na(denominator) and denominator > 0.0
        compositeBreadthRatio := math.max(-1.0, math.min(1.0, numerator / denominator))
    compositeBreadthRatio

// One EWMA step — the file's single most repeated fragment (every trailing
// baseline fold and every session EMA seed uses the same seed-or-fold
// expression). PURE — no internal state: each call site keeps its own var
// and assigns the return, so the helper stays safe inside conditional
// scopes (a var-holding helper called conditionally would break Pine's
// every-bar execution guarantee).
f_compositeBreadthEwmaStep(float previous, float sample, float length) =>
    float compositeBreadthEwmaAlpha = 2.0 / (length + 1.0)
    na(previous) ? sample : compositeBreadthEwmaAlpha * sample + (1.0 - compositeBreadthEwmaAlpha) * previous

// One signal-MA step — EMA folds through the shared EWMA helper; SMA keeps a
// rolling window array (capped at lengthBars) and returns its mean. PURE like
// the EWMA step: each call site owns its window/previous var and assigns the
// return, so the helper stays safe inside conditional scopes.
f_compositeBreadthSignalStep(array<float> window, float previous, string maType, int lengthBars, float sample) =>
    float compositeBreadthSignalResult = na
    if maType == "SMA"
        array.push(id = window, value = sample)
        if array.size(id = window) > lengthBars
            array.shift(id = window)
        compositeBreadthSignalResult := array.avg(id = window)
    else
        compositeBreadthSignalResult := f_compositeBreadthEwmaStep(previous = previous, sample = sample, length = lengthBars)
    compositeBreadthSignalResult

// Hysteresis consensus vote: a component votes +1/−1 only after its
// confidence leaves the ±deadband, holds that vote through the band, and
// flips only when confidence crosses the band on the OPPOSITE side. 0 =
// never established a side (abstains from consensus). Same pattern as
// ma-waves' hysteresis read direction — real rollovers register,
// micro-wiggles around zero don't.
f_compositeBreadthVoteSign(int currentVote, float confidence, float deadband) =>
    int compositeBreadthVoteResult = currentVote
    if not na(confidence)
        if confidence > deadband
            compositeBreadthVoteResult := 1
        else if confidence < -deadband
            compositeBreadthVoteResult := -1
    compositeBreadthVoteResult

// ═════════════════════════════════════════════════════════════════════════════
// 🎯 PER-COMPONENT CONFIDENCE
// VOLD, ADD, PCTABOVEVWAP, and CUMTICK feed the weighted composite. Raw
// per-bar TICK only feeds the extreme markers — never the weighted sum.
// ═════════════════════════════════════════════════════════════════════════════
// VOLD: the ADVDECV net is session-cumulative — its envelope grows with
// total volume all day, so a fixed scale would under-read the open and peg
// the close. Dividing by TVOL yields the Lowry-style up/down volume ratio,
// the standard stationary form: ±0.4 = trend-day tape, ±0.8 = a 90% day.
// Same clamp helper as the legacy (U−D)/(U+D) form, so the component's
// scaling semantics under the tuned 30-weight are unchanged.
float compositeBreadthVoldConfidence = f_compositeBreadthClampedRatio(
     numerator = compositeBreadthVoldNetValue,
     denominator = compositeBreadthTotalVolValue
 )

// ADD: net issues (ADVDEC) is bounded by the exchange's issue count and
// quasi-stationary after the first ~30-60 minutes — each issue's
// advance/decline status is set by its first trades — so a FIXED per-market
// saturation scale is the right normalization, and it matches how
// practitioners actually read $ADD (absolute levels: ±1,500 strong, ±2,000
// extreme on NYSE). The scale is the per-market switch in symbol routing.
float compositeBreadthAddConfidence = not na(compositeBreadthAddNetValue) ?
     math.max(-1.0, math.min(1.0, compositeBreadthAddNetValue / compositeBreadthAddScale)) : na

// PCTABOVEVWAP is published as a 0..100 percentage. Center on 50 (true
// neutral positioning) and map to the same -1..+1 confidence scale as
// VOLD/ADD over the per-market band (±15 on the liquid tapes — saturating at
// the 35/65 rails where practitioners treat the reading as extreme — wider
// on the narrow/correlated universes; see the band switch in symbol
// routing).
float compositeBreadthPctVwapConfidence = not na(compositeBreadthPctVwapValue) ?
     math.max(-1.0, math.min(1.0, (compositeBreadthPctVwapValue - 50.0) / compositeBreadthPctVwapBand)) : na

// TICK bias mean (Steenbarger adjustment). Raw TICK carries a persistent
// positive bias — Steenbarger's Adjusted TICK subtracts a trailing ~20-day
// mean of the per-bar TICK before cumulating, and without that recentering
// the cumTICK slope tilts bullish (negative saturation becomes structurally
// rarer than positive). Approximated here as a long EMA (~20 trading days of
// chart bars, timeframe-derived) that only updates on live TICK bars, so
// off-RTH na gaps neither decay nor pollute it. Seeded from the first live
// TICK value — early-history adjusted values start near zero and converge as
// the window fills, which only affects the oldest loaded bars.
var float compositeBreadthTickBiasMean = na
if not na(compositeBreadthTickValue)
    compositeBreadthTickBiasMean := f_compositeBreadthEwmaStep(previous = compositeBreadthTickBiasMean, sample = compositeBreadthTickValue, length = compositeBreadthTickBiasWindowBars)

float compositeBreadthTickAdjustedValue = na(compositeBreadthTickValue) ? na :
     not na(compositeBreadthTickBiasMean) ?
     compositeBreadthTickValue - compositeBreadthTickBiasMean : compositeBreadthTickValue

// CUMTICK (cumulative session TICK, slope-normalized)
// Sum of (bias-adjusted) TICK across the session, reset at
// compositeBreadthSessionJustOpened (the time-anchored 09:30 edge). The LEVEL
// of CUMTICK grows with session length, so it's not directly comparable
// across bars; the SLOPE (CBI_CUMTICK_SLOPE_MINUTES of rate-of-change, bar
// count derived from the chart timeframe — 5 bars on 2-min) is what carries
// the signal: positive slope = breadth strengthening on the bid right now,
// negative = weakening. Normalize slope by the derived slope scale so
// confidence saturates at ±1 when TICK has averaged a full scale
// (±500 NYSE-scale × the market factor) across the slope window — a strong
// directional regime.
//
// Cross-session leak guard: the slope lookback compositeBreadthCumTickValue[
// compositeBreadthCumTickSlopeWindow] would otherwise reach back across the
// off-RTH gap into the PRIOR session's accumulated value, making the first
// few bars of every new session register a bogus full-magnitude slope
// (this-session reset value minus yesterday's huge cumulative). The slope is
// therefore gated on compositeBreadthBarsSinceSessionOpen >
// compositeBreadthCumTickSlopeWindow — only computed when the entire
// lookback window is provably in-session.
//
// This is the divergence-grade breadth series. Raw TICK is too jagged to
// spot pivot-style turns; PCTABOVEVWAP plateaus mid-session. CUMTICK slope
// captures the inflections that price reversals actually pivot against.
var float compositeBreadthCumTickValue = na
if compositeBreadthSessionJustOpened or na(compositeBreadthCumTickValue)
    compositeBreadthCumTickValue := compositeBreadthTickAdjustedValue
else if not na(compositeBreadthTickAdjustedValue)
    compositeBreadthCumTickValue := compositeBreadthCumTickValue + compositeBreadthTickAdjustedValue
// When TICK is na (off-RTH gap), leave cumTick at its last value — the next
// session-open edge will reseed it via compositeBreadthSessionJustOpened.

bool compositeBreadthCumTickSlopeReady = compositeBreadthBarsSinceSessionOpen > compositeBreadthCumTickSlopeWindow and
     not na(compositeBreadthCumTickValue) and not na(compositeBreadthCumTickValue[compositeBreadthCumTickSlopeWindow])
float compositeBreadthCumTickSlope = compositeBreadthCumTickSlopeReady ?
     compositeBreadthCumTickValue - compositeBreadthCumTickValue[compositeBreadthCumTickSlopeWindow] : na

// Slope smoothing — the raw 10-minute ROC of cumTICK flips sign constantly
// (TICK oscillates around zero all day), so the unsmoothed slope injected
// per-bar sign chatter into 25% of the weighted sum and, before the consensus
// rework, flickered the consensus tier on top. A short EMA on the slope keeps
// the early inflections and drops the flicker. Session-scoped like
// everything upstream: reseeds at 09:30, blanks with the slope.
var float compositeBreadthCumTickSlopeSmoothed = na
if compositeBreadthSessionJustOpened
    compositeBreadthCumTickSlopeSmoothed := na
if not na(compositeBreadthCumTickSlope)
    compositeBreadthCumTickSlopeSmoothed := f_compositeBreadthEwmaStep(previous = compositeBreadthCumTickSlopeSmoothed, sample = compositeBreadthCumTickSlope, length = compositeBreadthCumTickSlopeSmoothBars)
else
    compositeBreadthCumTickSlopeSmoothed := na

float compositeBreadthCumTickConfidenceLive = not na(compositeBreadthCumTickSlopeSmoothed) ?
     math.max(-1.0, math.min(1.0, compositeBreadthCumTickSlopeSmoothed / compositeBreadthCumTickSlopeScale)) : na

// MOC freeze — TICK after 15:45 ET is dominated by market-on-close
// rebalancing program spikes and is ignored for directional analysis by
// practitioner consensus. Rather than dropping the component to na (which
// would renormalize the weights and jolt the composite), CUMTICK confidence
// HOLDS its last pre-15:45 value through the close: the component keeps its
// weight and its stance, it just stops reacting to contaminated prints.
var float compositeBreadthCumTickHeldConfidence = na
if not compositeBreadthInMocWindow
    compositeBreadthCumTickHeldConfidence := compositeBreadthCumTickConfidenceLive
float compositeBreadthCumTickConfidence = compositeBreadthInMocWindow ?
     compositeBreadthCumTickHeldConfidence : compositeBreadthCumTickConfidenceLive

// ═════════════════════════════════════════════════════════════════════════════
// 🧬 COMPOSITE SCORE
// Weighted sum × CBI_SCALE_MAX, using FOUR weighted components: VOLD, ADD,
// PCTABOVEVWAP, CUMTICK. The LINE is the weighted directional alone — the
// smooth stance, the same session-cumulative character as the feeds it
// summarizes. Consensus (cross-component agreement) is still computed, but it
// no longer multiplies the line (2026-07-13 volatility rework): the old
// `directional × consensus` construction rescaled the entire line by 30%
// (one dissenter) to 70% (split) every time a component's sign flickered,
// producing sawtooth swings the underlying feeds never printed. Disagreement
// now renders as line OPACITY (colors section), the badge's dissent readout,
// and the early-shift event — visible without distorting the stance's
// magnitude. Raw per-bar TICK is NOT a weighted component — it only drives
// the extreme triangle markers and their alerts.
// ═════════════════════════════════════════════════════════════════════════════
// A component is "active" only when both its data is present AND its weight is
// non-zero. Setting a weight to 0 must fully remove that component from BOTH
// the directional weighted sum AND the consensus calculation — otherwise a
// disabled component would still vote in the consensus read, dimming the
// line's opacity and blocking the impulse alerts' consensus gate.
bool compositeBreadthVoldActive    = not na(compositeBreadthVoldConfidence)    and compositeBreadthVoldWeight    > 0.0
bool compositeBreadthAddActive     = not na(compositeBreadthAddConfidence)     and compositeBreadthAddWeight     > 0.0
bool compositeBreadthPctVwapActive = not na(compositeBreadthPctVwapConfidence) and compositeBreadthPctVwapWeight > 0.0
bool compositeBreadthCumTickActive = not na(compositeBreadthCumTickConfidence) and compositeBreadthCumTickWeight > 0.0

float compositeBreadthWeightedSum = 0.0
float compositeBreadthWeightTotal = 0.0
if compositeBreadthVoldActive
    compositeBreadthWeightedSum += compositeBreadthVoldWeight * compositeBreadthVoldConfidence
    compositeBreadthWeightTotal += compositeBreadthVoldWeight
if compositeBreadthAddActive
    compositeBreadthWeightedSum += compositeBreadthAddWeight * compositeBreadthAddConfidence
    compositeBreadthWeightTotal += compositeBreadthAddWeight
if compositeBreadthPctVwapActive
    compositeBreadthWeightedSum += compositeBreadthPctVwapWeight * compositeBreadthPctVwapConfidence
    compositeBreadthWeightTotal += compositeBreadthPctVwapWeight
if compositeBreadthCumTickActive
    compositeBreadthWeightedSum += compositeBreadthCumTickWeight * compositeBreadthCumTickConfidence
    compositeBreadthWeightTotal += compositeBreadthCumTickWeight

float compositeBreadthDirectional = compositeBreadthWeightTotal > 0.0 ?
     compositeBreadthWeightedSum / compositeBreadthWeightTotal : na

// Consensus = SIGN agreement in categorical tiers, measured on HYSTERESIS
// VOTES rather than instantaneous signs (2026-07-13 volatility rework). Two
// changes from the raw-sign version:
//   1. DEADBAND + ABSTENTION — a component votes only after its confidence
//      leaves the ±deadband. Near-zero is flat, not dissent: the raw-sign
//      version let CUMTICK's chatter inside ±0.05 flip the tier 1.0↔0.7
//      every few bars.
//   2. HYSTERESIS — an established vote holds through the band and flips
//      only when confidence crosses the band on the opposite side, so real
//      rollovers register and micro-wiggles don't (see the vote helper).
// Practitioner logic stays categorical: all voters align = full agreement,
// one dissents = reduce, split = stand down. Agreement is measured against
// the sign of the weighted directional itself, so the reference respects the
// user's weights. Votes reseed at 09:30 with the rest of the session state.
var int compositeBreadthVoldVoteSign        = 0
var int compositeBreadthAddVoteSign         = 0
var int compositeBreadthPctVwapVoteSign     = 0
var int compositeBreadthCumTickVoteSign     = 0
var int compositeBreadthDirectionalVoteSign = 0
if compositeBreadthSessionJustOpened
    compositeBreadthVoldVoteSign        := 0
    compositeBreadthAddVoteSign         := 0
    compositeBreadthPctVwapVoteSign     := 0
    compositeBreadthCumTickVoteSign     := 0
    compositeBreadthDirectionalVoteSign := 0

compositeBreadthVoldVoteSign    := f_compositeBreadthVoteSign(currentVote = compositeBreadthVoldVoteSign,    confidence = compositeBreadthVoldConfidence,    deadband = compositeBreadthConsensusDeadband)
compositeBreadthAddVoteSign     := f_compositeBreadthVoteSign(currentVote = compositeBreadthAddVoteSign,     confidence = compositeBreadthAddConfidence,     deadband = compositeBreadthConsensusDeadband)
compositeBreadthPctVwapVoteSign := f_compositeBreadthVoteSign(currentVote = compositeBreadthPctVwapVoteSign, confidence = compositeBreadthPctVwapConfidence, deadband = compositeBreadthConsensusDeadband)
compositeBreadthCumTickVoteSign := f_compositeBreadthVoteSign(currentVote = compositeBreadthCumTickVoteSign, confidence = compositeBreadthCumTickConfidence, deadband = compositeBreadthConsensusDeadband)

// The REFERENCE sign carries the same hysteresis as the votes (review fix
// 2026-07-14): an instantaneous reference re-admitted the flicker the votes
// were built to kill — the weighted directional chopping across 0.0 at lunch
// flipped ALL held votes to "dissenters" against a stance they collectively
// set, sawtoothing the consensus tier (and the line's opacity) per bar.
compositeBreadthDirectionalVoteSign := f_compositeBreadthVoteSign(currentVote = compositeBreadthDirectionalVoteSign, confidence = compositeBreadthDirectional, deadband = compositeBreadthConsensusDeadband)
bool compositeBreadthRefPositive = compositeBreadthDirectionalVoteSign >= 0

// One VOTING and one DISSENTS boolean per component — the consensus tier,
// the alignment ratio, and the badge dissent readout all derive from these
// same booleans, so the three surfaces can never disagree about who is
// dissenting.
bool compositeBreadthVoldVoting    = compositeBreadthVoldActive    and compositeBreadthVoldVoteSign    != 0
bool compositeBreadthAddVoting     = compositeBreadthAddActive     and compositeBreadthAddVoteSign     != 0
bool compositeBreadthPctVwapVoting = compositeBreadthPctVwapActive and compositeBreadthPctVwapVoteSign != 0
bool compositeBreadthCumTickVoting = compositeBreadthCumTickActive and compositeBreadthCumTickVoteSign != 0
bool compositeBreadthVoldDissents    = compositeBreadthVoldVoting    and (compositeBreadthVoldVoteSign    == 1) != compositeBreadthRefPositive
bool compositeBreadthAddDissents     = compositeBreadthAddVoting     and (compositeBreadthAddVoteSign     == 1) != compositeBreadthRefPositive
bool compositeBreadthPctVwapDissents = compositeBreadthPctVwapVoting and (compositeBreadthPctVwapVoteSign == 1) != compositeBreadthRefPositive
bool compositeBreadthCumTickDissents = compositeBreadthCumTickVoting and (compositeBreadthCumTickVoteSign == 1) != compositeBreadthRefPositive

int compositeBreadthVotingCount =
     (compositeBreadthVoldVoting ? 1 : 0) + (compositeBreadthAddVoting ? 1 : 0) +
     (compositeBreadthPctVwapVoting ? 1 : 0) + (compositeBreadthCumTickVoting ? 1 : 0)
int compositeBreadthDissentCount =
     (compositeBreadthVoldDissents ? 1 : 0) + (compositeBreadthAddDissents ? 1 : 0) +
     (compositeBreadthPctVwapDissents ? 1 : 0) + (compositeBreadthCumTickDissents ? 1 : 0)
float compositeBreadthSignAlignmentRatio = compositeBreadthVotingCount > 0 ?
     (compositeBreadthVotingCount - compositeBreadthDissentCount) / float(compositeBreadthVotingCount) : 1.0

// Tiers: full agreement (4/4, 3/3, 2/2) = 1.0; one dissenter among 3-4
// (ratio ≥ 0.666) = 0.7; split (ratio ≥ 0.333, e.g. 2/4 or 1/2) = 0.3;
// outvoted majority-vs-weight edge cases below that = 0.1. With 0 or 1
// voters, or no established reference sign, there is nothing to agree
// about — consensus stays 1.0 (the badge still names a lone dissenter).
float compositeBreadthConsensus = compositeBreadthVotingCount <= 1 or compositeBreadthDirectionalVoteSign == 0 ? 1.0 :
     compositeBreadthSignAlignmentRatio >= 0.999 ? 1.0 :
     compositeBreadthSignAlignmentRatio >= 0.666 ? 0.7 :
     compositeBreadthSignAlignmentRatio >= 0.333 ? 0.3 : 0.1

// The line is the UNSQUEEZED weighted stance — consensus renders as opacity
// and events instead of multiplying the magnitude (see the section header).
float compositeBreadthLineValue = na(compositeBreadthDirectional) ? na :
     compositeBreadthDirectional * CBI_SCALE_MAX

// ═════════════════════════════════════════════════════════════════════════════
// 🌊 DISPLAY + SIGNAL PAIR
// Display EMA is short (3) and tames per-bar jitter so intraday swings on the
// composite read cleanly. Both signal legs are fed FROM the display line (not
// from the raw composite) so the visible composite-vs-signal relationship is
// internally consistent — divergences read true rather than reflecting two
// different lag profiles.
//
// Two reset paths, both required. (1) na blanking: when the upstream
// composite is unavailable (off-RTH on futures/extended charts, paired with
// gaps_on) the lines blank instead of freezing into a stale flat line.
// (2) The time-anchored session-open edge: on an RTH-only chart there ARE no
// na bars between sessions, so without this reset the EMAs would carry
// yesterday's smoothed state into today's open and the warmup would only
// ever run on the first loaded session. Reseeding at each open is
// structurally required here: the internals themselves are session-scoped
// series that discontinuously reset at 09:30 — a continuous EMA would smooth
// yesterday's closing regime into today's gap.
// ═════════════════════════════════════════════════════════════════════════════
var float compositeBreadthDisplayLine = na
if compositeBreadthSessionJustOpened
    compositeBreadthDisplayLine := na
if not na(compositeBreadthLineValue)
    compositeBreadthDisplayLine := f_compositeBreadthEwmaStep(previous = compositeBreadthDisplayLine, sample = compositeBreadthLineValue, length = CBI_DISPLAY_SMOOTH_LENGTH)
else
    compositeBreadthDisplayLine := na

// Signal PAIR — fast trigger + slow baseline, one state machine each, both
// stepped by the shared helper. Both legs reseed on the 09:30 edge and share
// the warmup gate, so switching a leg's type never changes the session-reset
// semantics. Lengths arrive as minutes-derived bar counts (see the derived
// calibration), so the pair keeps one meaning on the 1-min and 3-min charts
// traded side by side.
var float compositeBreadthSignalFastValue = na
var float compositeBreadthSignalSlowValue = na
var int compositeBreadthSignalSeedCount = 0
var array<float> compositeBreadthSignalFastWindow = array.new<float>()
var array<float> compositeBreadthSignalSlowWindow = array.new<float>()
if compositeBreadthSessionJustOpened
    compositeBreadthSignalFastValue := na
    compositeBreadthSignalSlowValue := na
    compositeBreadthSignalSeedCount := 0
    array.clear(id = compositeBreadthSignalFastWindow)
    array.clear(id = compositeBreadthSignalSlowWindow)
if (compositeBreadthShowSignalFast or compositeBreadthShowSignalSlow) and not na(compositeBreadthDisplayLine)
    compositeBreadthSignalSeedCount += 1
    if compositeBreadthSignalSeedCount > CBI_SIGNAL_WARMUP_BARS
        if compositeBreadthShowSignalFast
            compositeBreadthSignalFastValue := f_compositeBreadthSignalStep(window = compositeBreadthSignalFastWindow, previous = compositeBreadthSignalFastValue, maType = compositeBreadthSignalFastType, lengthBars = compositeBreadthSignalFastBars, sample = compositeBreadthDisplayLine)
        if compositeBreadthShowSignalSlow
            compositeBreadthSignalSlowValue := f_compositeBreadthSignalStep(window = compositeBreadthSignalSlowWindow, previous = compositeBreadthSignalSlowValue, maType = compositeBreadthSignalSlowType, lengthBars = compositeBreadthSignalSlowBars, sample = compositeBreadthDisplayLine)
else
    compositeBreadthSignalFastValue := na
    compositeBreadthSignalSlowValue := na
    compositeBreadthSignalSeedCount := 0
    array.clear(id = compositeBreadthSignalFastWindow)
    array.clear(id = compositeBreadthSignalSlowWindow)

// ═════════════════════════════════════════════════════════════════════════════
// 🧭 LINE TRUST REGIME (opening volume + opening volatility)
// The session regime that sets the composite line's vividness ceiling — the
// two evidence-backed conditioners of "how much to trust the open's
// direction" (2026-07-31 research):
//   VOLUME LEG (Raschke): first-30-minute total volume. High opening volume =
//   range-expansion / trend-capable day; light = rotation ("The very number
//   one criteria I look at is volume … the first 30-minute volume"). Source:
//   TVOL — session-cumulative, so its value at the 30-minute mark IS the
//   first-30-min volume; already requested as the VOLD denominator.
//   VOLATILITY LEG (JFE 2018): the chart's first-N-minute high-low range.
//   Open-direction follow-through conditions on open volatility even more
//   sharply than on volume — the low-volatility tercile carries NO
//   statistically significant signal, which is what the QUIET ceiling
//   renders. Chart OHLC only, no request.
// Both legs compare against a cross-session ~10-day EMA baseline (classified
// against PRIOR days' mean first, then folded in — same seeding pattern as
// the TICK bias mean). Vote: either leg expanding = EXPANSION; both at/below
// the quiet ratio = QUIET; else NEUTRAL. Until a baseline exists the regime
// is UNKNOWN, which consumers treat like neutral. News-Day Suppression forces
// the whole session to a SUPPRESSED neutral (Raschke's FOMC exception).
//
// Captures fire on the first CONFIRMED bar at/after each window mark (na gaps
// push to the next valid bar); a capture only reached past twice its window
// is skipped entirely — a "first 30 minutes" captured at 11:00 would poison
// the baseline. The resolve is one-shot per session once both windows settle.
// ═════════════════════════════════════════════════════════════════════════════
var float compositeBreadthOpenVolMean       = na
var bool  compositeBreadthOpenVolCaptured   = false
var float compositeBreadthOpenVolRatio      = na
var float compositeBreadthOpenRangeMean     = na
var bool  compositeBreadthOpenRangeCaptured = false
var float compositeBreadthOpenRangeRatio    = na
var float compositeBreadthOpenRangeHigh     = na
var float compositeBreadthOpenRangeLow      = na
var int   compositeBreadthTrustRegime         = 0      // 1 = expansion, -1 = quiet, 0 = neutral (or unknown/suppressed)
var bool  compositeBreadthTrustRegimeKnown    = false  // classified against a real baseline this session
var bool  compositeBreadthTrustRegimeResolved = false  // read settled: classified, abandoned, or suppressed

if compositeBreadthSessionJustOpened
    compositeBreadthOpenVolCaptured     := false
    compositeBreadthOpenVolRatio        := na
    compositeBreadthOpenRangeCaptured   := false
    compositeBreadthOpenRangeRatio      := na
    compositeBreadthOpenRangeHigh       := na
    compositeBreadthOpenRangeLow        := na
    compositeBreadthTrustRegime         := 0
    compositeBreadthTrustRegimeKnown    := false
    compositeBreadthTrustRegimeResolved := false

// Volume leg — capture at the 30-minute mark, fold into the baseline.
if compositeBreadthShowLineTrust and not compositeBreadthOpenVolCaptured and barstate.isconfirmed and
     compositeBreadthBarsSinceSessionOpen >= compositeBreadthOpenVolWindowBars and
     compositeBreadthBarsSinceSessionOpen <= compositeBreadthOpenVolWindowBars * 2 and
     not na(compositeBreadthTotalVolValue) and compositeBreadthTotalVolValue > 0.0
    compositeBreadthOpenVolCaptured := true
    if not na(compositeBreadthOpenVolMean) and compositeBreadthOpenVolMean > 0.0
        compositeBreadthOpenVolRatio := compositeBreadthTotalVolValue / compositeBreadthOpenVolMean
    compositeBreadthOpenVolMean := f_compositeBreadthEwmaStep(previous = compositeBreadthOpenVolMean, sample = compositeBreadthTotalVolValue, length = CBI_OPEN_VOL_MEAN_DAYS)

// Volatility leg — accumulate the opening high-low range over RTH bars inside
// the window, capture at the mark, fold into its own baseline.
if compositeBreadthShowLineTrust and barstate.isconfirmed and compositeBreadthInRthFull and
     not compositeBreadthOpenRangeCaptured and compositeBreadthBarsSinceSessionOpen < compositeBreadthOpenRangeWindowBars
    compositeBreadthOpenRangeHigh := na(compositeBreadthOpenRangeHigh) ? high : math.max(compositeBreadthOpenRangeHigh, high)
    compositeBreadthOpenRangeLow  := na(compositeBreadthOpenRangeLow)  ? low  : math.min(compositeBreadthOpenRangeLow, low)
if compositeBreadthShowLineTrust and not compositeBreadthOpenRangeCaptured and barstate.isconfirmed and
     compositeBreadthBarsSinceSessionOpen >= compositeBreadthOpenRangeWindowBars and
     compositeBreadthBarsSinceSessionOpen <= compositeBreadthOpenRangeWindowBars * 2 and
     not na(compositeBreadthOpenRangeHigh) and not na(compositeBreadthOpenRangeLow) and
     compositeBreadthOpenRangeHigh > compositeBreadthOpenRangeLow
    compositeBreadthOpenRangeCaptured := true
    float compositeBreadthOpenRangeSample = compositeBreadthOpenRangeHigh - compositeBreadthOpenRangeLow
    if not na(compositeBreadthOpenRangeMean) and compositeBreadthOpenRangeMean > 0.0
        compositeBreadthOpenRangeRatio := compositeBreadthOpenRangeSample / compositeBreadthOpenRangeMean
    compositeBreadthOpenRangeMean := f_compositeBreadthEwmaStep(previous = compositeBreadthOpenRangeMean, sample = compositeBreadthOpenRangeSample, length = CBI_OPEN_VOL_MEAN_DAYS)

// Resolve — one shot per session once both capture windows have settled
// (captured, or abandoned past twice the window). Suppression wins: the
// session stays a forced neutral, not a classification.
bool compositeBreadthOpenVolSettled   = compositeBreadthOpenVolCaptured   or compositeBreadthBarsSinceSessionOpen > compositeBreadthOpenVolWindowBars * 2
bool compositeBreadthOpenRangeSettled = compositeBreadthOpenRangeCaptured or compositeBreadthBarsSinceSessionOpen > compositeBreadthOpenRangeWindowBars * 2
if compositeBreadthShowLineTrust and not compositeBreadthTrustRegimeResolved and barstate.isconfirmed and
     compositeBreadthOpenVolSettled and compositeBreadthOpenRangeSettled
    compositeBreadthTrustRegimeResolved := true
    if not compositeBreadthNewsDaySuppression and not na(compositeBreadthOpenVolRatio)
        bool compositeBreadthTrustExpansion = compositeBreadthOpenVolRatio >= compositeBreadthOpenVolExpansionRatio or
             (not na(compositeBreadthOpenRangeRatio) and compositeBreadthOpenRangeRatio >= compositeBreadthOpenVolExpansionRatio)
        bool compositeBreadthTrustQuiet = compositeBreadthOpenVolRatio <= compositeBreadthOpenVolLightRatio and
             (na(compositeBreadthOpenRangeRatio) or compositeBreadthOpenRangeRatio <= compositeBreadthOpenVolLightRatio)
        compositeBreadthTrustRegime      := compositeBreadthTrustExpansion ? 1 : compositeBreadthTrustQuiet ? -1 : 0
        compositeBreadthTrustRegimeKnown := true

// ═════════════════════════════════════════════════════════════════════════════
// 🎨 COLORS
// ═════════════════════════════════════════════════════════════════════════════
// Two hues, one dial: hue answers only "which SIDE OF ZERO" (Bullish Color
// above, Bearish Color below), opacity answers "how much to believe the
// current move". Four layers, applied in order, all opacity-only — the
// composite value is never modified:
//   1. ZERO-CUT COLOR (2026-08-01, third iteration — slope hue chopped per
//      segment, stance hue still read wrong): the composite is a
//      zero-anchored stance line, so its SIGN is the trend. Above zero the
//      whole line is the Bullish Color, below zero the Bearish Color — the
//      standard internals-pane read — and the hue changes only where the
//      line actually crosses zero. Slope and stance never touch the hue;
//      they drive impulse-vs-retrace opacity (layer 2). The picker owns hue
//      and the vivid-tier base opacity.
//   2. CONSENSUS DIM (impulse vs retrace) — always on, symmetric in both
//      trends: when the slope moves WITH the trend (the impulse), the
//      consensus tiers apply — components aligned behind the move = vivid,
//      split = pale. When the slope moves AGAINST the trend (the retrace),
//      the move has no internal backing by construction and gets the max dim
//      (ghost) — the inverse read, so in a downtrend the impulse is the
//      predominant vivid red and the retrace is a red whisper, and a bright
//      line ONLY ever means the trend's own move with the internals behind
//      it. (1 − move consensus) × Consensus Dim Strength is ADDED to the
//      trend color's transparency.
//   3. REGIME CEILING + TRUST BOOST (Line Trust) — the session regime decides
//      how loud the line may speak: QUIET adds the Quiet Ceiling Dim to the
//      whole line, NEUTRAL / unknown / suppressed adds the Neutral Ceiling
//      Dim, EXPANSION adds nothing and additionally REMOVES the Trust
//      Vividness Boost when the move carries full agreement behind an
//      established stance — the "trusted rising / confirmed weakness"
//      max-vivid step, the only state brighter than the picker's base. During
//      the ~30-min read window (pre-resolve) the line renders un-capped.
//   4. TIME-OF-DAY OVERLAY — an agnostic dim folded into the transparency
//      target during the lunch/MOC windows (its own toggle, off) and the
//      10:00–11:00 morning-reversion window (its own toggle, ON — the
//      135-session log analysis' most consistent finding: the 10:xx hour is
//      where following the stance loses across regimes). Capped 95; never
//      touches the consensus calc. Purely visual.
//   5. RENDER SMOOTHING — a short EMA on the final rendered transparency
//      only: every driver above is a step function, so the raw target jumps
//      between states; the render glides between them instead while the
//      discrete state keeps feeding the markers, table, and data window.
bool compositeBreadthInLowInfoWindow = compositeBreadthInLunchWindow or compositeBreadthInMocWindow
// 1. Zero-cut color — hue is the line's own side of zero (na bars read
// bullish; the plot is blank there anyway). The slope state below feeds only
// the impulse/retrace split, the marker triangle direction, and the table
// arrow — never the hue.
var bool compositeBreadthLineRising = true
compositeBreadthLineRising := compositeBreadthDisplayLine > compositeBreadthDisplayLine[1] ? true :
     compositeBreadthDisplayLine < compositeBreadthDisplayLine[1] ? false : compositeBreadthLineRising
bool compositeBreadthAboveZero = nz(source = compositeBreadthDisplayLine, replacement = 0.0) >= 0.0
color compositeBreadthLineBaseColor = compositeBreadthAboveZero ? compositeBreadthLineUpColor : compositeBreadthLineDownColor
// 2. Consensus dim, read against the move (impulse vs retrace). The stance
// reference and the component votes keep all their hysteresis (deadband,
// hold-through-band, session reseed) — this only decides which consensus
// applies to the visible segment: slope WITH the trend (impulse) → the
// engine's tiers; slope AGAINST the trend (retrace) → the floor tier (0.1,
// same as an outvoted split), because a move the internals aren't behind is
// a countertrend drift whichever trend it's inside. No established stance
// (vote 0) → the engine already reports 1.0 and the held trend color stands.
bool compositeBreadthSlopeWithStance = compositeBreadthDirectionalVoteSign == 0 or
     (compositeBreadthLineRising ? compositeBreadthDirectionalVoteSign > 0 : compositeBreadthDirectionalVoteSign < 0)
float compositeBreadthMoveConsensus = compositeBreadthSlopeWithStance ? compositeBreadthConsensus : 0.1
float compositeBreadthConsensusExtraTransp = (1.0 - compositeBreadthMoveConsensus) * compositeBreadthConsensusDimStrength
// 3. Regime ceiling + trust boost. Expansion = no ceiling; quiet = quiet dim;
// neutral, unknown, or suppressed = neutral dim; pre-resolve = un-capped. The
// boost fires only on the full stack: expansion regime (which suppression
// blocks at the resolve) + full agreement + established stance + slope with it.
float compositeBreadthTrustCeilingDim = not compositeBreadthShowLineTrust or not compositeBreadthTrustRegimeResolved ? 0.0 :
     compositeBreadthTrustRegimeKnown and compositeBreadthTrustRegime == 1 ? 0.0 :
     compositeBreadthTrustRegimeKnown and compositeBreadthTrustRegime == -1 ? compositeBreadthQuietCeilingDim :
     compositeBreadthNeutralCeilingDim
bool compositeBreadthTrustBoostActive = compositeBreadthShowLineTrust and compositeBreadthTrustRegimeKnown and
     compositeBreadthTrustRegime == 1 and compositeBreadthSlopeWithStance and
     compositeBreadthDirectionalVoteSign != 0 and compositeBreadthMoveConsensus >= 0.999
float compositeBreadthLineTranspTarget = math.max(0.0, math.min(95.0,
     color.t(color = compositeBreadthLineBaseColor) + compositeBreadthConsensusExtraTransp +
     compositeBreadthTrustCeilingDim - (compositeBreadthTrustBoostActive ? compositeBreadthTrustBoost : 0)))
// 4. Time-of-day overlay — folded into the target BEFORE the render smoothing
// so the window edges glide like every other transition. Lunch/MOC and the
// morning-reversion window share one strength; they never overlap, so a
// single add covers whichever is active.
if (compositeBreadthShowTimeOfDayDim and compositeBreadthInLowInfoWindow) or
     (compositeBreadthShowMorningDim and compositeBreadthInMorningWindow)
    compositeBreadthLineTranspTarget := math.min(95.0, compositeBreadthLineTranspTarget + compositeBreadthTimeDimStrength)
// 5. Render smoothing — every driver above is a STEP function (agreement
// tiers, impulse/retrace flips, boost on/off, ceiling engagement, window
// edges), so the raw target jumps up to ~58 transparency points bar-to-bar
// and the line reads choppy. A short EMA on the rendered transparency turns
// each step into a few-bar glide. RENDER-ONLY: the discrete state keeps
// driving the markers, the Trust Readout table, and the trigger logic —
// only the pixels ease between states. Session-reseeded and na-blanked like
// the display line it paints.
var float compositeBreadthLineTransp = na
if compositeBreadthSessionJustOpened
    compositeBreadthLineTransp := na
compositeBreadthLineTransp := na(compositeBreadthDisplayLine) ? na :
     f_compositeBreadthEwmaStep(previous = compositeBreadthLineTransp, sample = compositeBreadthLineTranspTarget, length = CBI_OPACITY_SMOOTH_LENGTH)
color compositeBreadthLineColor = color.new(color = compositeBreadthLineBaseColor, transp = nz(source = compositeBreadthLineTransp, replacement = compositeBreadthLineTranspTarget))

// ═════════════════════════════════════════════════════════════════════════════
// 📊 PLOTS
// ═════════════════════════════════════════════════════════════════════════════
// No type annotation — hline.style_* values are hline_style, not string; an
// explicit `string` annotation locks the variable to const string and rejects them.
compositeBreadthZeroHlineStyle = compositeBreadthZeroLineStyle == "Dashed" ? hline.style_dashed : compositeBreadthZeroLineStyle == "Dotted" ? hline.style_dotted : hline.style_solid
hline(price = 0, title = "Zero", color = compositeBreadthZeroLineColor, linestyle = compositeBreadthZeroHlineStyle, linewidth = compositeBreadthZeroLineWidth, display = compositeBreadthShowZeroLine ? display.all : display.none)
plot(series = compositeBreadthShowCompositeLine ? compositeBreadthDisplayLine : na, title = "Composite", color = compositeBreadthLineColor, linewidth = compositeBreadthLineWidth)
plot(series = compositeBreadthShowSignalFast ? compositeBreadthSignalFastValue : na, title = "Signal Fast", color = compositeBreadthSignalFastColor, linewidth = compositeBreadthSignalFastWidth)
plot(series = compositeBreadthShowSignalSlow ? compositeBreadthSignalSlowValue : na, title = "Signal Slow", color = compositeBreadthSignalSlowColor, linewidth = compositeBreadthSignalSlowWidth)
// ─── Session dividers ─────────────────────────────────────────────────────────
// Vertical lines at the RTH open and close edges, time-anchored in the gap
// between bars (so they never cover the first/last bar). On an RTH-only chart
// the 16:00/09:30 boundary is one shared gap = a single divider. The style map
// is a var initializer — inputs are constant, so it evaluates once.
var compositeBreadthSessionDividerLineStyle = switch compositeBreadthSessionDividerStyle
    "Solid"  => line.style_solid
    "Dashed" => line.style_dashed
    => line.style_dotted
if compositeBreadthShowSessionDivider and (compositeBreadthSessionJustOpened or compositeBreadthSessionJustClosed)
    int compositeBreadthDividerTime = na(time[1]) ?
         time - timeframe.in_seconds(timeframe = timeframe.period) * 500 :
         (time + time[1]) / 2
    line.new(x1 = compositeBreadthDividerTime, y1 = -1.0, x2 = compositeBreadthDividerTime, y2 = 1.0, xloc = xloc.bar_time, extend = extend.both, color = compositeBreadthSessionDividerColor, style = compositeBreadthSessionDividerLineStyle, width = compositeBreadthSessionDividerWidth)

// ─── ▲ Unsupported-move markers (Line Trust) ─────────────────────────────────
// A vivid-grade push (full agreement behind the slope, stance established)
// during a QUIET regime is a move without tape participation — quiet opens
// carry ≈ zero follow-through signal, so the push gets flagged instead of
// trusted. One marker per push episode: fires on the first confirmed bar the
// condition establishes, and re-arms only after the condition has stayed OFF
// for CBI_MARKER_REARM_BARS confirmed bars — a one-bar slope wiggle inside
// the same push is not a new episode. Expansion/neutral days draw nothing —
// silence is agreement. Labels are minted on confirmed bars only (no intrabar
// mint/delete) and carry the situation numbers in their native hover tooltip.
var bool compositeBreadthUnsupportedArmed = true
var int  compositeBreadthUnsupportedOffBars = 0
if compositeBreadthSessionJustOpened
    compositeBreadthUnsupportedArmed   := true
    compositeBreadthUnsupportedOffBars := 0
bool compositeBreadthUnsupportedNow = compositeBreadthShowLineTrust and compositeBreadthShowUnsupportedMarkers and
     compositeBreadthTrustRegimeKnown and compositeBreadthTrustRegime == -1 and
     compositeBreadthSlopeWithStance and compositeBreadthDirectionalVoteSign != 0 and
     compositeBreadthMoveConsensus >= 0.999 and not na(compositeBreadthDisplayLine)
if barstate.isconfirmed
    if compositeBreadthUnsupportedNow and compositeBreadthUnsupportedArmed
        compositeBreadthUnsupportedArmed   := false
        compositeBreadthUnsupportedOffBars := 0
        string compositeBreadthUnsupportedDirWord = compositeBreadthLineRising ? "up" : "down"
        string compositeBreadthUnsupportedVolText = na(compositeBreadthOpenVolRatio) ? "n/a" :
             str.tostring(value = compositeBreadthOpenVolRatio, format = "0.00") + "×"
        string compositeBreadthUnsupportedRangeText = na(compositeBreadthOpenRangeRatio) ? "n/a" :
             str.tostring(value = compositeBreadthOpenRangeRatio, format = "0.00") + "×"
        string compositeBreadthUnsupportedTooltip = "▲ UNSUPPORTED MOVE\n\n" +
             "CBI " + str.tostring(value = compositeBreadthDisplayLine, format = "0.0") + " — vivid-grade " + compositeBreadthUnsupportedDirWord + " push, full agreement of the voting components\n" +
             "Regime: QUIET — volume " + compositeBreadthUnsupportedVolText + " baseline · open range " + compositeBreadthUnsupportedRangeText + "\n\n" +
             "Quiet opens carry ≈ zero follow-through signal — a vivid-grade move on a non-participating tape. The line stays capped; don't chase it."
        label.new(x = bar_index, y = compositeBreadthDisplayLine + CBI_MARKER_OFFSET, text = "", tooltip = compositeBreadthUnsupportedTooltip, xloc = xloc.bar_index, yloc = yloc.price, style = compositeBreadthLineRising ? label.style_triangleup : label.style_triangledown, color = compositeBreadthUnsupportedMarkerColor, size = compositeBreadthUnsupportedMarkerSize)
    else if not compositeBreadthUnsupportedNow
        compositeBreadthUnsupportedOffBars += 1
        if compositeBreadthUnsupportedOffBars >= CBI_MARKER_REARM_BARS
            compositeBreadthUnsupportedArmed := true
    else
        // Condition on while disarmed — still the same push episode.
        compositeBreadthUnsupportedOffBars := 0

// ─── 🎯 Price Confirmation (Dow-style non-confirmation at session extremes) ──
// Price is the external validator of the breadth line. Track the session's
// confirmed price extremes with the composite's value at each; when price
// prints a NEW extreme at least Min Extreme Separation after the prior one
// and the composite sits materially below its prior-extreme reading (above,
// for lows), that is a non-confirmation — price came back to a new extreme
// and breadth declined to follow. Within-separation new extremes are one
// advance: the price/bar anchors roll forward and the breadth anchor keeps
// the push's PEAK (trough) so a grinding move can't dodge the read by
// refreshing the anchor every bar. Confirmation itself never draws —
// agreement is the normal state. Confirmed closes only; chart OHLC only.
var float compositeBreadthPcHiPrice   = na
var float compositeBreadthPcHiBreadth = na
var int   compositeBreadthPcHiBar     = na
var float compositeBreadthPcLoPrice   = na
var float compositeBreadthPcLoBreadth = na
var int   compositeBreadthPcLoBar     = na
if compositeBreadthSessionJustOpened
    compositeBreadthPcHiPrice   := na
    compositeBreadthPcHiBreadth := na
    compositeBreadthPcHiBar     := na
    compositeBreadthPcLoPrice   := na
    compositeBreadthPcLoBreadth := na
    compositeBreadthPcLoBar     := na
if compositeBreadthShowPriceConfirmation and barstate.isconfirmed and compositeBreadthInRthFull and not na(compositeBreadthDisplayLine)
    int compositeBreadthPcAgreeing = compositeBreadthVotingCount - compositeBreadthDissentCount
    string compositeBreadthPcAgreementText = str.tostring(value = compositeBreadthPcAgreeing) + "/" + str.tostring(value = compositeBreadthVotingCount)
    // Highs: price higher high vs breadth lower high = bearish non-confirmation.
    if na(compositeBreadthPcHiPrice) or high > compositeBreadthPcHiPrice
        bool compositeBreadthPcHiSeparated = not na(compositeBreadthPcHiBar) and bar_index - compositeBreadthPcHiBar >= compositeBreadthNonConfSeparationBars
        if compositeBreadthPcHiSeparated and compositeBreadthDisplayLine < compositeBreadthPcHiBreadth - CBI_NONCONF_MARGIN
            string compositeBreadthPcHiTooltip = "◆ NON-CONFIRMATION (bearish)\n\n" +
                 "Price new session high " + str.tostring(value = high, format = format.mintick) + " — breadth lower high\n" +
                 "CBI " + str.tostring(value = compositeBreadthDisplayLine, format = "0.0") + " vs " + str.tostring(value = compositeBreadthPcHiBreadth, format = "0.0") + " at the prior price high\n" +
                 "Agreement now: " + compositeBreadthPcAgreementText + "\n\n" +
                 "Price is not being ratified by breadth at the new extreme (Dow non-confirmation). Confirmed on bar close."
            label.new(x = bar_index, y = compositeBreadthDisplayLine + CBI_MARKER_OFFSET, text = "", tooltip = compositeBreadthPcHiTooltip, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_diamond, color = compositeBreadthNonConfMarkerColor, size = compositeBreadthNonConfMarkerSize)
        compositeBreadthPcHiBreadth := compositeBreadthPcHiSeparated or na(compositeBreadthPcHiBreadth) ?
             compositeBreadthDisplayLine : math.max(compositeBreadthPcHiBreadth, compositeBreadthDisplayLine)
        compositeBreadthPcHiPrice := high
        compositeBreadthPcHiBar   := bar_index
    // Lows: price lower low vs breadth higher low = bullish non-confirmation.
    if na(compositeBreadthPcLoPrice) or low < compositeBreadthPcLoPrice
        bool compositeBreadthPcLoSeparated = not na(compositeBreadthPcLoBar) and bar_index - compositeBreadthPcLoBar >= compositeBreadthNonConfSeparationBars
        if compositeBreadthPcLoSeparated and compositeBreadthDisplayLine > compositeBreadthPcLoBreadth + CBI_NONCONF_MARGIN
            string compositeBreadthPcLoTooltip = "◆ NON-CONFIRMATION (bullish)\n\n" +
                 "Price new session low " + str.tostring(value = low, format = format.mintick) + " — breadth higher low\n" +
                 "CBI " + str.tostring(value = compositeBreadthDisplayLine, format = "0.0") + " vs " + str.tostring(value = compositeBreadthPcLoBreadth, format = "0.0") + " at the prior price low\n" +
                 "Agreement now: " + compositeBreadthPcAgreementText + "\n\n" +
                 "Price is not being ratified by breadth at the new extreme (Dow non-confirmation). Confirmed on bar close."
            label.new(x = bar_index, y = compositeBreadthDisplayLine + CBI_MARKER_OFFSET, text = "", tooltip = compositeBreadthPcLoTooltip, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_diamond, color = compositeBreadthNonConfMarkerColor, size = compositeBreadthNonConfMarkerSize)
        compositeBreadthPcLoBreadth := compositeBreadthPcLoSeparated or na(compositeBreadthPcLoBreadth) ?
             compositeBreadthDisplayLine : math.min(compositeBreadthPcLoBreadth, compositeBreadthDisplayLine)
        compositeBreadthPcLoPrice := low
        compositeBreadthPcLoBar   := bar_index

// ─── Data Window read-out ─────────────────────────────────────────────────────
// The per-bar hover numbers, shipped the native way: display.data_window plots
// never draw on the pane — TradingView's own crosshair shows them for whatever
// bar the cursor is on, at the cost of a plain plot (nothing measurable).
plot(series = compositeBreadthVotingCount - compositeBreadthDissentCount, title = "· Agreement (aligned voters)", color = NORD4, display = display.data_window)
plot(series = compositeBreadthVotingCount, title = "· Voting components", color = NORD4, display = display.data_window)
plot(series = compositeBreadthMoveConsensus, title = "· Move consensus tier", color = NORD4, display = display.data_window)
plot(series = compositeBreadthDirectionalVoteSign, title = "· Stance vote (+1/0/−1)", color = NORD4, display = display.data_window)
plot(series = compositeBreadthShowLineTrust and compositeBreadthTrustRegimeResolved and compositeBreadthTrustRegimeKnown ? compositeBreadthTrustRegime : na, title = "· Regime (+1 exp / 0 / −1 quiet)", color = NORD4, display = display.data_window)
plot(series = compositeBreadthOpenVolRatio, title = "· Opening volume ×baseline", color = NORD4, display = display.data_window)
plot(series = compositeBreadthOpenRangeRatio, title = "· Opening range ×baseline", color = NORD4, display = display.data_window)
plot(series = compositeBreadthLineTransp, title = "· Line transparency (rendered)", color = NORD4, display = display.data_window)

// ─── Trust Readout table ──────────────────────────────────────────────────────
// The live "now" corner readout: STATE / CBI / AGREEMENT / STANCE / REGIME.
// Cells are rewritten on EVERY islast tick — table mutations on uncommitted
// realtime ticks roll back like all drawings, so gating the render on "data
// changed" flashes stale committed snapshots (see the 2026-07-24 revert).
// A handful of cells, negligible cost; OFF creates nothing.
var table compositeBreadthTrustTable = compositeBreadthShowLineTrust and compositeBreadthShowTrustTable ?
     table.new(position = position.top_right, columns = 2, rows = 5, bgcolor = color.new(color = NORD0, transp = 15), frame_color = NORD1, frame_width = 1, border_color = NORD1, border_width = 1) : na
if compositeBreadthShowLineTrust and compositeBreadthShowTrustTable and barstate.islast
    string compositeBreadthTrustStateText = na(compositeBreadthDisplayLine) ? "—" :
         not compositeBreadthSlopeWithStance ? "GHOST (retrace)" :
         compositeBreadthTrustBoostActive ? (compositeBreadthAboveZero ? "TRUSTED" : "CONFIRMED WEAKNESS") :
         compositeBreadthMoveConsensus >= 0.999 ? "VIVID" :
         compositeBreadthMoveConsensus >= 0.7 ? "DIMMED" : "PALE"
    color compositeBreadthTrustStateColor = color.new(color = compositeBreadthAboveZero ? compositeBreadthLineUpColor : compositeBreadthLineDownColor, transp = 0)
    string compositeBreadthTrustCbiText = na(compositeBreadthDisplayLine) ? "—" :
         str.tostring(value = compositeBreadthDisplayLine, format = "0.0") + (compositeBreadthLineRising ? " ↑" : " ↓")
    string compositeBreadthTrustDissenters = (compositeBreadthVoldDissents ? " VOLD" : "") + (compositeBreadthAddDissents ? " ADD" : "") +
         (compositeBreadthPctVwapDissents ? " %VWAP" : "") + (compositeBreadthCumTickDissents ? " CUMTICK" : "")
    string compositeBreadthTrustAgreementText = not compositeBreadthSlopeWithStance ? "against stance" :
         compositeBreadthVotingCount == 0 ? "no voters" :
         str.tostring(value = compositeBreadthVotingCount - compositeBreadthDissentCount) + "/" + str.tostring(value = compositeBreadthVotingCount) +
         (compositeBreadthDissentCount > 0 ? " · out:" + compositeBreadthTrustDissenters : "")
    string compositeBreadthTrustStanceText = compositeBreadthDirectionalVoteSign > 0 ? "bullish +1" :
         compositeBreadthDirectionalVoteSign < 0 ? "bearish −1" : "none"
    string compositeBreadthTrustRatiosText = (na(compositeBreadthOpenVolRatio) ? "n/a" : str.tostring(value = compositeBreadthOpenVolRatio, format = "0.00") + "×") +
         " / " + (na(compositeBreadthOpenRangeRatio) ? "n/a" : str.tostring(value = compositeBreadthOpenRangeRatio, format = "0.00") + "×")
    string compositeBreadthTrustRegimeText = compositeBreadthNewsDaySuppression ? "SUPPRESSED" :
         not compositeBreadthTrustRegimeResolved ? "reading…" :
         not compositeBreadthTrustRegimeKnown ? "UNKNOWN" :
         (compositeBreadthTrustRegime == 1 ? "EXPANSION " : compositeBreadthTrustRegime == -1 ? "QUIET " : "NEUTRAL ") + compositeBreadthTrustRatiosText
    table.cell(table_id = compositeBreadthTrustTable, column = 0, row = 0, text = "STATE",     text_color = NORD3, text_halign = text.align_left,  text_size = size.small)
    table.cell(table_id = compositeBreadthTrustTable, column = 0, row = 1, text = "CBI",       text_color = NORD3, text_halign = text.align_left,  text_size = size.small)
    table.cell(table_id = compositeBreadthTrustTable, column = 0, row = 2, text = "AGREEMENT", text_color = NORD3, text_halign = text.align_left,  text_size = size.small)
    table.cell(table_id = compositeBreadthTrustTable, column = 0, row = 3, text = "STANCE",    text_color = NORD3, text_halign = text.align_left,  text_size = size.small)
    table.cell(table_id = compositeBreadthTrustTable, column = 0, row = 4, text = "REGIME",    text_color = NORD3, text_halign = text.align_left,  text_size = size.small)
    table.cell(table_id = compositeBreadthTrustTable, column = 1, row = 0, text = compositeBreadthTrustStateText,     text_color = compositeBreadthTrustStateColor, text_halign = text.align_right, text_size = size.small)
