//@version=6
indicator(title = "Energy Alignment", shorttitle = "⚡ EA", overlay = true, max_labels_count = 500)


// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0  = #2E3440
const color NORD1  = #3B4252
const color NORD2  = #434C5E
const color NORD3  = #4C566A
// Snow Storm
const color NORD4  = #D8DEE9
const color NORD5  = #E5E9F0
const color NORD6  = #ECEFF4
// Frost
const color NORD7  = #8FBCBB
const color NORD8  = #88C0D0
const color NORD9  = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// ⚙️ ENGINE
// ═════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// 🔄 CYCLES
// ─────────────────────────────────────────────────────────────────────────────
const string GROUP_CYCLE = "🔄 Cycle"

int cycleKLength = input.int(defval = 5, title = "%K Length", minval = 1, group = GROUP_CYCLE)
int cycleKSmoothing = input.int(defval = 2, title = "%K Smoothing", minval = 1, group = GROUP_CYCLE)
int cycleDSmoothing = input.int(defval = 3, title = "%D Smoothing", minval = 1, group = GROUP_CYCLE)

float cycleK = ta.sma(source = ta.stoch(source = close, high = high, low = low, length = cycleKLength), length = cycleKSmoothing)
float cycleD = ta.sma(source = cycleK, length = cycleDSmoothing)

var bool cycleDRising = true
cycleDRising := cycleD > cycleD[1] ? true : cycleD < cycleD[1] ? false : cycleDRising

// ─────────────────────────────────────────────────────────────────────────────
// 📈 TREND
// ─────────────────────────────────────────────────────────────────────────────
const string GROUP_TREND = "📈 Trend"
const int TREND_SMA_LENGTH = 50
const int TREND_FLAT_WINDOW = 10

float trendFlatAtrFraction = input.float(defval = 0.0, title = "Flat ATR Fraction", minval = 0.0, maxval = 5.0, step = 0.05,
     tooltip = "Flat-regime sensitivity: the 50 SMA is flat when its net movement over the flat window (10 bars) is at most this fraction of ATR(14). A flat stretch ends the wave count like a direction change. 0 (default) disables the regime — strictly UP/DOWN.", group = GROUP_TREND)
float trendBreakAtrFraction = input.float(defval = 0.0, title = "Break ATR Fraction", minval = 0.0, maxval = 5.0, step = 0.05,
     tooltip = "Direction-break sensitivity for the wave count: its trend reading only flips once the SMA moves against it by at least this fraction of ATR(14) from its running extreme, so a micro-wiggle never resets the count. 0 (default) = pure sign-of-slope.", group = GROUP_TREND)

float trendAtr = ta.atr(length = 14)
float trendSma = ta.sma(source = close, length = TREND_SMA_LENGTH)
float trendSlope = trendSma - trendSma[1]
float trendNetChange = ta.change(source = trendSma, length = TREND_FLAT_WINDOW)
bool trendFlatRegime = trendFlatAtrFraction > 0 and not na(trendNetChange) and not na(trendAtr) and
     math.abs(number = trendNetChange) <= trendFlatAtrFraction * trendAtr
var int trendDir = 0
trendDir := trendFlatRegime ? 0 : trendSlope > 0 ? 1 : trendSlope < 0 ? -1 : trendDir

var int waveReadDir = 0
var float waveReadSmaExtreme = na
if not na(trendSma)
    float breakThreshold = trendBreakAtrFraction * nz(source = trendAtr, replacement = 0)
    if waveReadDir == 0
        waveReadSmaExtreme := trendSma
        waveReadDir := trendSlope > 0 ? 1 : trendSlope < 0 ? -1 : 0
    else if waveReadDir == 1
        waveReadSmaExtreme := math.max(waveReadSmaExtreme, trendSma)
        if trendSma < waveReadSmaExtreme and waveReadSmaExtreme - trendSma >= breakThreshold
            waveReadDir := -1
            waveReadSmaExtreme := trendSma
    else
        waveReadSmaExtreme := math.min(waveReadSmaExtreme, trendSma)
        if trendSma > waveReadSmaExtreme and trendSma - waveReadSmaExtreme >= breakThreshold
            waveReadDir := 1
            waveReadSmaExtreme := trendSma

const float CYCLE_LOW_BOUNDARY = 45.0
const float CYCLE_HIGH_BOUNDARY = 55.0
const int CYCLE_SEED_MAX_LOOKBACK = 200
const string WAVE_ALPHABET = "abcdefghijklmnopqrstuvwxyz"

max_bars_back(high, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(low, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(open, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(close, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(waveReadDir, CYCLE_SEED_MAX_LOOKBACK)
max_bars_back(trendSma, CYCLE_SEED_MAX_LOOKBACK)

bool cycleCrossedAbove45 = ta.crossover(source1 = cycleD, source2 = CYCLE_LOW_BOUNDARY)
bool cycleCrossedAbove55 = ta.crossover(source1 = cycleD, source2 = CYCLE_HIGH_BOUNDARY)
bool cycleCrossedBelow55 = ta.crossunder(source1 = cycleD, source2 = CYCLE_HIGH_BOUNDARY)
bool cycleCrossedBelow45 = ta.crossunder(source1 = cycleD, source2 = CYCLE_LOW_BOUNDARY)

var int cycleZone = 0
bool cycleStartedHigh = cycleCrossedAbove45 or (cycleCrossedAbove55 and cycleZone == -1)
bool cycleStartedLow = cycleCrossedBelow55 or (cycleCrossedBelow45 and cycleZone == 1)
bool cycleStartedThisBar = cycleStartedHigh or cycleStartedLow

var float cycleExtreme = na
var int cycleExtremeBar = na
var float cycleExtremeOpen = na
var float cycleExtremeClose = na
var float cycleExtremeSma = na
var int cycleExtremeDir = 0
if cycleZone != 0 and not cycleStartedThisBar and
     (na(cycleExtreme) or (cycleZone == 1 and high >= cycleExtreme) or (cycleZone == -1 and low <= cycleExtreme))
    cycleExtreme := cycleZone == 1 ? high : low
    cycleExtremeBar := bar_index
    cycleExtremeOpen := open
    cycleExtremeClose := close
    cycleExtremeSma := trendSma
    cycleExtremeDir := waveReadDir

var int waveTrendDir = 0
var float waveLastImpulseExtreme = na
var int waveNextImpulseNumber = 1
var int waveZoneNextLetterIndex = 0
var int waveZoneRetraceCount = 0
var float waveZoneBestExtreme = na
var int waveZoneBestLetterIndex = -1
var bool waveZoneOwnerAConfirmed = true
var bool waveZoneOwnerAPending = false
var float wavePendingAPrice = na
var int wavePendingABar = na
var bool wavePendingAIsHighSide = false
var int waveCycleLetterIndex = -1

var bool waveCycleSawFlat = false
var int waveLastFlatBar = na
var bool waveCycleSawOpposite = false
if trendDir == 0
    waveCycleSawFlat := true
    waveLastFlatBar := bar_index
if waveTrendDir != 0 and waveReadDir != 0 and waveReadDir != waveTrendDir
    waveCycleSawOpposite := true

f_waveLetterAt(int letterIndex) =>
    int wrappedIndex = letterIndex % 26
    str.substring(source = WAVE_ALPHABET, begin_pos = wrappedIndex, end_pos = wrappedIndex + 1)

f_waveRetraceText(int retraceNumber, int letterIndex, bool zoneIsComplex, bool isHighSide) =>
    string numberText = str.tostring(value = retraceNumber)
    if zoneIsComplex and letterIndex >= 0
        string letterText = f_waveLetterAt(letterIndex = letterIndex)
        isHighSide ? numberText + "\n" + letterText : letterText + "\n" + numberText
    else
        numberText

f_qualifyImpulse(int qualifyDir, float extremePrice, float extremeOpen, float extremeClose, float extremeSma, float baselineExtreme) =>
    bool wickBeyond = not na(baselineExtreme) and
         (qualifyDir == 1 ? extremePrice > baselineExtreme : extremePrice < baselineExtreme)
    bool bodyCommits = not na(baselineExtreme) and
         (qualifyDir == 1 ?
             extremeOpen >= baselineExtreme and extremeClose > baselineExtreme :
             extremeOpen <= baselineExtreme and extremeClose < baselineExtreme)
    bool wave1Qualifies = not na(extremeSma) and
         (qualifyDir == 1 ? extremeClose > extremeSma : extremeClose < extremeSma)
    [wickBeyond, bodyCommits, wave1Qualifies]

string waveEndedLabelText = ""
float waveEndedPinPrice = na
int waveEndedPinBar = na
bool waveEndedPinIsHighSide = false
bool waveEndedBecomesOwner = false
string waveEndedOwnerDowngradeText = ""
bool waveEndedOwnerDelete = false
bool waveOwnerClear = false
float wavePendingAReleasePrice = na
int wavePendingAReleaseBar = na
bool wavePendingAReleaseIsHighSide = false
bool waveEndedIsComplexC = false

if cycleStartedThisBar and barstate.isconfirmed
    bool boundaryClaimed = cycleZone != 0 and
         (na(cycleExtreme) or (cycleZone == 1 ? high >= cycleExtreme : low <= cycleExtreme))
    if boundaryClaimed
        cycleExtreme := cycleZone == 1 ? high : low
        cycleExtremeBar := bar_index
        cycleExtremeOpen := open
        cycleExtremeClose := close
        cycleExtremeSma := trendSma
        cycleExtremeDir := waveReadDir
    float endedExtreme = cycleExtreme
    int endedExtremeBar = cycleExtremeBar
    float endedOpen = cycleExtremeOpen
    float endedClose = cycleExtremeClose
    float endedSma = cycleExtremeSma
    bool hadPendingA = not na(wavePendingAPrice)
    bool hadOwnerAPending = waveZoneOwnerAPending
    bool endedPinnedBareLetter = false

    int endedDir = na(endedExtreme) ? waveReadDir : cycleExtremeDir
    bool endedFlatBroke = waveCycleSawFlat and waveTrendDir != 0
    bool endedRebirth = waveCycleSawOpposite and not endedFlatBroke and waveTrendDir != 0 and
         endedDir == waveTrendDir and waveReadDir == waveTrendDir
    bool endedBarMismatch = not endedFlatBroke and endedDir != 0 and waveReadDir != 0 and endedDir != waveReadDir
    if endedBarMismatch
        endedDir := waveReadDir
    if endedFlatBroke and not na(endedExtremeBar) and endedExtremeBar <= waveLastFlatBar
        endedDir := 0
    if endedDir != waveTrendDir or endedFlatBroke or endedRebirth or endedBarMismatch
        waveLastImpulseExtreme := na
        waveNextImpulseNumber := 1
        waveZoneNextLetterIndex := 0
        waveZoneRetraceCount := 0
        waveZoneBestExtreme := na
        waveZoneBestLetterIndex := -1
        waveOwnerClear := true
    waveTrendDir := endedDir

    if waveTrendDir != 0 and not na(endedExtreme) and (not endedBarMismatch or waveNextImpulseNumber == 1)
        bool endedIsImpulseSide = (waveTrendDir == 1) == cycleStartedLow
        if endedIsImpulseSide
            [endedWickBeyond, endedBodyCommits, endedWave1Qualifies] = f_qualifyImpulse(qualifyDir = waveTrendDir,
                 extremePrice = endedExtreme, extremeOpen = endedOpen, extremeClose = endedClose,
                 extremeSma = endedSma, baselineExtreme = waveLastImpulseExtreme)
            if waveNextImpulseNumber == 1 ? endedWave1Qualifies : endedBodyCommits
                waveEndedLabelText := str.tostring(value = waveNextImpulseNumber)
                waveLastImpulseExtreme := endedExtreme
                waveNextImpulseNumber := waveNextImpulseNumber + 2
                waveZoneNextLetterIndex := 0
                waveZoneRetraceCount := 0
                waveZoneBestExtreme := na
                waveZoneBestLetterIndex := -1
                waveOwnerClear := true
            else if endedWickBeyond
                waveZoneNextLetterIndex := 0
                waveZoneRetraceCount := 0
            else if waveNextImpulseNumber > 1 and waveCycleLetterIndex >= 0
                waveEndedLabelText := f_waveLetterAt(letterIndex = waveCycleLetterIndex)
                endedPinnedBareLetter := true
        else if waveNextImpulseNumber > 1
            waveZoneRetraceCount := waveZoneRetraceCount + 1
            waveEndedIsComplexC := waveCycleLetterIndex == 2
            bool zoneIsComplex = waveZoneRetraceCount >= 2
            bool takesOwnership = na(waveZoneBestExtreme) or
                 (waveTrendDir == 1 ? endedExtreme < waveZoneBestExtreme : endedExtreme > waveZoneBestExtreme)
            if takesOwnership
                if not na(waveZoneBestExtreme) and waveZoneBestLetterIndex >= 0
                    if waveZoneBestLetterIndex == 0 and not waveZoneOwnerAConfirmed
                        waveEndedOwnerDelete := true
                    else
                        waveEndedOwnerDowngradeText := f_waveLetterAt(letterIndex = waveZoneBestLetterIndex)
                waveZoneBestExtreme := endedExtreme
                waveZoneBestLetterIndex := waveCycleLetterIndex
                waveZoneOwnerAConfirmed := waveCycleLetterIndex != 0
                waveZoneOwnerAPending := waveCycleLetterIndex == 0
                waveEndedLabelText := f_waveRetraceText(retraceNumber = waveNextImpulseNumber - 1,
                     letterIndex = waveCycleLetterIndex == 0 ? -1 : waveCycleLetterIndex,
                     zoneIsComplex = zoneIsComplex, isHighSide = waveTrendDir == -1)
                waveEndedBecomesOwner := true
            else if zoneIsComplex and waveCycleLetterIndex >= 1
                waveEndedLabelText := f_waveLetterAt(letterIndex = waveCycleLetterIndex)
                endedPinnedBareLetter := true
            else if waveCycleLetterIndex == 0
                wavePendingAPrice := endedExtreme
                wavePendingABar := endedExtremeBar
                wavePendingAIsHighSide := cycleStartedLow
    waveEndedPinPrice := endedExtreme
    waveEndedPinBar := endedExtremeBar
    waveEndedPinIsHighSide := cycleStartedLow

    waveCycleLetterIndex := -1
    if waveTrendDir != 0 and waveNextImpulseNumber > 1
        waveCycleLetterIndex := waveZoneNextLetterIndex
        waveZoneNextLetterIndex := waveZoneNextLetterIndex + 1
    if hadPendingA
        if endedPinnedBareLetter
            wavePendingAReleasePrice := wavePendingAPrice
            wavePendingAReleaseBar := wavePendingABar
            wavePendingAReleaseIsHighSide := wavePendingAIsHighSide
        wavePendingAPrice := na
        wavePendingABar := na
    if hadOwnerAPending
        waveZoneOwnerAConfirmed := endedPinnedBareLetter
        waveZoneOwnerAPending := false
    waveCycleSawFlat := false
    waveCycleSawOpposite := false

    cycleZone := cycleStartedHigh ? 1 : -1
    if boundaryClaimed
        cycleExtreme := na
        cycleExtremeBar := na
        cycleExtremeOpen := na
        cycleExtremeClose := na
        cycleExtremeSma := na
        cycleExtremeDir := 0
    else
        int cycleSeedLookback = na(endedExtremeBar) ? 1 : math.min(bar_index - endedExtremeBar - 1, CYCLE_SEED_MAX_LOOKBACK)
        float cycleSeedExtreme = cycleStartedHigh ? high : low
        int cycleSeedOffset = 0
        if cycleSeedLookback > 0
            for barOffset = 1 to cycleSeedLookback
                float seedCandidate = cycleStartedHigh ? high[barOffset] : low[barOffset]
                if cycleStartedHigh ? seedCandidate > cycleSeedExtreme : seedCandidate < cycleSeedExtreme
                    cycleSeedExtreme := seedCandidate
                    cycleSeedOffset := barOffset
        cycleExtreme := cycleSeedExtreme
        cycleExtremeBar := bar_index - cycleSeedOffset
        cycleExtremeOpen := open[cycleSeedOffset]
        cycleExtremeClose := close[cycleSeedOffset]
        cycleExtremeSma := trendSma[cycleSeedOffset]
        cycleExtremeDir := waveReadDir[cycleSeedOffset]

bool waveOwnerHasZone = not na(waveZoneBestExtreme)
string waveOwnerText = ""
if waveOwnerHasZone
    bool ownerLetterShowable = waveZoneBestLetterIndex >= 1 or (waveZoneBestLetterIndex == 0 and waveZoneOwnerAConfirmed)
    waveOwnerText := f_waveRetraceText(retraceNumber = waveNextImpulseNumber - 1,
         letterIndex = ownerLetterShowable ? waveZoneBestLetterIndex : -1,
         zoneIsComplex = waveZoneRetraceCount >= 2, isHighSide = waveTrendDir == -1)

// ─────────────────────────────────────────────────────────────────────────────
// 📊 MOMENTUM
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// 📉 VOLUME & ADVANCE/DECLINE [BREADTH]
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// 🚦 SUPPORT & RESISTANCE
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// 🏗️ PRICE/MOMENTUM PATTERNS
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// VOLATILITY
// ─────────────────────────────────────────────────────────────────────────────

// ═════════════════════════════════════════════════════════════════════════════
// 📊 PLOT
// White price-bar labels only. All minting is close-gated.
// ═════════════════════════════════════════════════════════════════════════════
f_whiteLabel(int labelBarIndex, float labelPrice, string labelText, bool isHighSide, string labelSize) =>
    label.new(x = labelBarIndex, y = labelPrice, text = labelText, xloc = xloc.bar_index, yloc = yloc.price,
         style = isHighSide ? label.style_label_down : label.style_label_up,
         color = NORD6, textcolor = NORD0, size = labelSize)

// ─────────────────────────────────────────────────────────────────────────────
// 🔄 CYCLE
// - extremes
// ─────────────────────────────────────────────────────────────────────────────
if barstate.isconfirmed and cycleStartedThisBar and not na(waveEndedPinPrice)
    f_whiteLabel(labelBarIndex = waveEndedPinBar, labelPrice = waveEndedPinPrice, labelText = "",
         isHighSide = waveEndedPinIsHighSide, labelSize = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// 📈 TREND
// - trend shifts up/down
// - first and second retrace
// - complex retrace C
// ─────────────────────────────────────────────────────────────────────────────
var int plotTrendDir = 0
var label plotRetraceLabel = na

if barstate.isconfirmed
    if trendDir != 0 and trendDir != plotTrendDir
        label.new(x = bar_index, y = trendDir == 1 ? low : high,
             yloc = trendDir == 1 ? yloc.belowbar : yloc.abovebar,
             style = trendDir == 1 ? label.style_label_up : label.style_label_down,
             text = trendDir == 1 ? "TREND UP" : "TREND DOWN",
             color = NORD6, textcolor = NORD0, size = size.small)
        plotTrendDir := trendDir
    if cycleStartedThisBar
        int plotRetraceNumber = waveNextImpulseNumber - 1
        if (waveEndedOwnerDelete or waveEndedOwnerDowngradeText != "") and not na(plotRetraceLabel)
            label.delete(id = plotRetraceLabel)
            plotRetraceLabel := na
        if waveEndedBecomesOwner and (plotRetraceNumber == 2 or plotRetraceNumber == 4)
            string plotRetraceText = waveEndedIsComplexC ?
                 (waveEndedPinIsHighSide ? str.tostring(value = plotRetraceNumber) + "\nC" : "C\n" + str.tostring(value = plotRetraceNumber)) :
                 str.tostring(value = plotRetraceNumber)
            plotRetraceLabel := f_whiteLabel(labelBarIndex = waveEndedPinBar, labelPrice = waveEndedPinPrice,
                 labelText = plotRetraceText, isHighSide = waveEndedPinIsHighSide, labelSize = size.small)
        else if waveEndedIsComplexC
            f_whiteLabel(labelBarIndex = waveEndedPinBar, labelPrice = waveEndedPinPrice, labelText = "C",
                 isHighSide = waveEndedPinIsHighSide, labelSize = size.small)
        if waveOwnerClear
            plotRetraceLabel := na
