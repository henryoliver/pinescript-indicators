        f_gexDrawLevel(slotIndex = GEX_SLOT_VEX1, levelPrice = gexVex1, levelText = array.get(id = gexSlotCodes, index = GEX_SLOT_VEX1), stackIndex = array.get(id = gexSlotStack, index = GEX_SLOT_VEX1), levelColor = gexVexColor, nameColor = gexVexColor, levelTooltip = gexVexTooltip, levelWidth = GEX_THIN_WIDTH, levelStyle = line.style_dotted, drawLine = true, visible = array.get(id = gexSlotVisible, index = GEX_SLOT_VEX1), ownsStrike = array.get(id = gexSlotOwnsStrike, index = GEX_SLOT_VEX1))
        f_gexDrawLevel(slotIndex = GEX_SLOT_VEX2, levelPrice = gexVex2, levelText = array.get(id = gexSlotCodes, index = GEX_SLOT_VEX2), stackIndex = array.get(id = gexSlotStack, index = GEX_SLOT_VEX2), levelColor = gexVexColor, nameColor = gexVexColor, levelTooltip = gexVexTooltip, levelWidth = GEX_THIN_WIDTH, levelStyle = line.style_dotted, drawLine = true, visible = array.get(id = gexSlotVisible, index = GEX_SLOT_VEX2), ownsStrike = array.get(id = gexSlotOwnsStrike, index = GEX_SLOT_VEX2))
        f_gexDrawLevel(slotIndex = GEX_SLOT_VEX3, levelPrice = gexVex3, levelText = array.get(id = gexSlotCodes, index = GEX_SLOT_VEX3), stackIndex = array.get(id = gexSlotStack, index = GEX_SLOT_VEX3), levelColor = gexVexColor, nameColor = gexVexColor, levelTooltip = gexVexTooltip, levelWidth = GEX_THIN_WIDTH, levelStyle = line.style_dotted, drawLine = true, visible = array.get(id = gexSlotVisible, index = GEX_SLOT_VEX3), ownsStrike = array.get(id = gexSlotOwnsStrike, index = GEX_SLOT_VEX3))
        f_gexDrawLevel(slotIndex = GEX_SLOT_RANGE_HIGH, levelPrice = gexRangeHigh, levelText = array.get(id = gexSlotCodes, index = GEX_SLOT_RANGE_HIGH), stackIndex = array.get(id = gexSlotStack, index = GEX_SLOT_RANGE_HIGH), levelColor = gexRangeColor, nameColor = gexRangeColor, levelTooltip = GEX_TIP_RANGE, levelWidth = GEX_THIN_WIDTH, levelStyle = line.style_dashed, drawLine = false, visible = gexRangeVisible, ownsStrike = array.get(id = gexSlotOwnsStrike, index = GEX_SLOT_RANGE_HIGH))
        f_gexDrawLevel(slotIndex = GEX_SLOT_RANGE_LOW, levelPrice = gexRangeLow, levelText = array.get(id = gexSlotCodes, index = GEX_SLOT_RANGE_LOW), stackIndex = array.get(id = gexSlotStack, index = GEX_SLOT_RANGE_LOW), levelColor = gexRangeColor, nameColor = gexRangeColor, levelTooltip = GEX_TIP_RANGE, levelWidth = GEX_THIN_WIDTH, levelStyle = line.style_dashed, drawLine = false, visible = gexRangeVisible, ownsStrike = array.get(id = gexSlotOwnsStrike, index = GEX_SLOT_RANGE_LOW))

        // The regime symbol shares the FLIP anchor and is pushed clear of it
        // with character padding, so the gap holds however far you zoom.
        bool gexSymbolVisible = gexShowFlip and gexShowLabels and not na(gexFlip)
        bool gexSymbolRight = gexLabelSide == "Right"
        int gexSymbolShift = (array.get(id = gexSlotStack, index = GEX_SLOT_FLIP) + 1) * gexStackGapChars
        label.set_xy(id = gexRegimeLabel, x = gexSymbolRight ? bar_index + GEX_RIGHT_PAD_BARS + gexLabelOffset : gexDayStartBar - gexLabelOffset, y = gexSymbolVisible ? gexFlip : close)
        string gexSymbolPad = ""
        if gexSymbolShift > 0
            for padIndex = 1 to gexSymbolShift
                gexSymbolPad += " "
        label.set_text(id = gexRegimeLabel, text = gexSymbolVisible ? gexSymbolPad + gexRegimeSymbol : "")
        label.set_style(id = gexRegimeLabel, style = label.style_label_left)
        label.set_size(id = gexRegimeLabel, size = gexLabelTextSize)
        label.set_text_font_family(id = gexRegimeLabel, text_font_family = f_gexLabelFontFamily())
        label.set_tooltip(id = gexRegimeLabel, tooltip = gexFlipTooltip)

        gexLastDrawnBar := bar_index
        // Cleared only on the execution that COMMITS this render. A repaint made
        // on an unconfirmed tick rolls back, so until the bar closes the flag has
        // to keep buying the next tick's repaint — otherwise a mid-bar paste
        // shows once and then flashes back to the previous snapshot.
        if barstate.isconfirmed
            gexNeedsRefresh := false

    // The regime symbol shares the FLIP anchor and is pushed clear of it with
    // character padding, so the gap holds however far the chart is zoomed.
    // A vertical marker at the minute the mapped expiry stops trading. x1 == x2
    // with extend.both is how Pine draws a full-height vertical: the two price
    // points only fix the line's slope, which here is undefined, so it spans.
    bool gexExpiryVisible = gexShowExpiryLine and gexExpiry != "" and gexExpiryTime != ""
    if gexShouldRedraw and gexExpiryVisible
        int gexExpiryStamp = timestamp(timezone = GEX_DATA_TIMEZONE, year = int(f_gexSafeFloat(rawText = str.substring(source = gexExpiry, begin_pos = 0, end_pos = 4))), month = int(f_gexSafeFloat(rawText = str.substring(source = gexExpiry, begin_pos = 4, end_pos = 6))), day = int(f_gexSafeFloat(rawText = str.substring(source = gexExpiry, begin_pos = 6, end_pos = 8))), hour = int(f_gexSafeFloat(rawText = str.substring(source = gexExpiryTime, begin_pos = 0, end_pos = 2))), minute = int(f_gexSafeFloat(rawText = str.substring(source = gexExpiryTime, begin_pos = 2, end_pos = 4))), second = 0)
        line.set_xloc(id = gexExpiryLine, x1 = gexExpiryStamp, x2 = gexExpiryStamp, xloc = xloc.bar_time)
        line.set_y1(id = gexExpiryLine, y = close)
        line.set_y2(id = gexExpiryLine, y = close + syminfo.mintick)
        line.set_extend(id = gexExpiryLine, extend = extend.both)
        line.set_style(id = gexExpiryLine, style = line.style_dotted)
        line.set_width(id = gexExpiryLine, width = 1)

    // The only reading that follows price tick by tick: which side of the flip
    // we are on. One set_* call, not a full repaint.
    // Three states, not two: above the flip, below it, and sitting on it.
    float gexFlipBand = na(gexFlip) ? 0 : gexFlip * GEX_FLIP_BAND_PCT / 100
    color gexRegimeColor = na(gexFlip) or math.abs(number = close - gexFlip) <= gexFlipBand ? NORD4 : close > gexFlip ? NORD8 : NORD11
    label.set_textcolor(id = gexRegimeLabel, textcolor = gexShowFlip and gexShowLabels and not na(gexFlip) ? gexRegimeColor : GEX_HIDDEN)
    line.set_color(id = gexExpiryLine, color = gexExpiryVisible ? gexRegimeColor : GEX_HIDDEN)
