// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © henry_oliver
// Major Swings — two-degree swing structure as support & resistance.
//
// MEDIUM (degree 1): a pivot with `Swing Strength` bars of containment on each
//   side. Same definition as support-resistance.pine's "Swing Strength" — bars
//   required each side to confirm a swing high or low. Drawn thin.
// MAJOR (degree 2): "a major swing high happens when a swing high has a lower
//   SWING high to the left and to the right." Majorness is NESTING, not window
//   width. A medium is UPGRADED IN PLACE when both flanking mediums are lower (or
//   both higher), so one swing is one object and no level is ever drawn twice.
//   Drawn bold.
// STRONG structure: a break of structure promotes the origin of the breaking leg
//   to a strong extreme — the one "that will not be violated and therefore can
//   be used as a safer place to put stop losses". This is a SEQUENCE property,
//   which is why prominence and touch counts cannot see it.
// BREAK vs PIERCE is Barry's rule, not Fractal Flow's close-based one: a zone is
//   broken only when the whole bar clears it. Part of a bar through is a pierce,
//   the zone stays live, and that is the fade setup.

//@version=6
indicator(title = "Major Swings", shorttitle = "💦 Swings", overlay = true, max_lines_count = 100, max_labels_count = 100, max_bars_back = 1000, calc_bars_count = 5000)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0  = #2E3440
const color NORD1  = #3B4252
const color NORD2  = #434C5E
const color NORD3  = #4C566A
// Snow Storm
const color NORD4  = #D8DEE9
const color NORD5  = #E5E9F0
const color NORD6  = #ECEFF4
// Frost
const color NORD7  = #8FBCBB
const color NORD8  = #88C0D0
const color NORD9  = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// 🧩 TYPE DEFINITIONS
// Custom Pine types and enums used by the indicator.
// ═════════════════════════════════════════════════════════════════════════════
enum LevelSourceMode
    BODIES = "Bodies"
    WICKS  = "Wicks"

enum LineStyleMode
    SOLID  = "Solid"
    DASHED = "Dashed"
    DOTTED = "Dotted"

// A swing DRAWS as one line but is STORED as a zone. Barry: "all of these levels
// are really zones. Zones, not lines… connect from the real body to the high, and
// then there's your zone." The rectangle proved too loud on a 3m/1m chart, so the
// zone survives only as the tolerance band the pierce and break tests measure
// against, while the chart shows one line at `levelPrice`.
type Swing
    float levelPrice
    float zoneTop
    float zoneBottom
    int barIndex
    bool isHigh
    // DEGREE_MEDIUM on registration, upgraded IN PLACE to DEGREE_MAJOR when the
    // nesting test passes. Because the upgrade mutates the stored object rather
    // than creating a second one, a promoted swing carries its zone, touch count
    // and break state across the promotion, and the two tiers can never paint the
    // same price twice.
    int degree
    string structureType
    bool isBroken
    bool isPierced
    int touchCount
    // Topographic prominence: how far this peak stands above the HIGHER of its two
    // flanking peaks of the same degree, in units of the yardstick. Measuring
    // height above a detection window's LOW instead scored the size of the leg
    // into the swing rather than the dominance of the swing itself. Only set at
    // the nesting test, so it stays 0 for anything still degree-1.
    float prominence
    bool isStrong
    int brokenBarIndex
    // Re-entry latch. Without it, price parked at a level for ten bars scored ten
    // touches — one visit, not ten respected tests.
    bool isInsideZone

// One drawing pool slot. The line and the label are always allocated, parked and
// painted together, so they travel as one object rather than as two arrays held
// in lockstep by a shared index.
type LevelSlot
    line levelLine
    label levelLabel

// ═════════════════════════════════════════════════════════════════════════════
// ⚙️ GENERAL
// Shared controls and state read by more than one section below.
// ═════════════════════════════════════════════════════════════════════════════
// All three groups are populated from BOTH sections — detection owns the strength
// and the pivot source, render owns the slot counts, separation and colors — so the
// group names are shared infrastructure rather than section-local constants.
const string GROUP_STRUCTURE = "🌊 Structure"
const string GROUP_LEVELS = "🎚️ Levels"
const string GROUP_STYLE = "🎨 Style"

const int DEGREE_MEDIUM = 1
const int DEGREE_MAJOR = 2

bool confirmedBar = barstate.isconfirmed

// ═════════════════════════════════════════════════════════════════════════════
// 🌊 DETECTION
// Two-pass, two-degree swing detection. Exports the swing store, the volatility
// yardstick, the reference window and the structure stamp for the sections below.
// ═════════════════════════════════════════════════════════════════════════════
const int MAX_SWINGS_STORED = 40
// Left, middle, right — the three consecutive mediums the nesting test needs.
const int NESTING_DEPTH = 3
const int MEDIUM_BUFFER = 4
// Floor on the thickness of the invisible body-to-wick zone the pierce and break
// tests measure against, as a share of the yardstick. Intraday bodies and wicks
// sit pennies apart, so without a floor a one-tick poke would read as a pierce.
const float ZONE_TOLERANCE_PERCENT = 5.0
// The yardstick window is this multiple of the swing strength. Scaling it off the
// strength keeps every percentage threshold meaning the same thing when the
// strength changes.
const int YARDSTICK_MULTIPLE = 8

int swingStrength = input.int(defval = 11, title = "Swing Strength", minval = 2, maxval = 30, tooltip = "Bars required on each side to confirm a swing high or swing low — this is the MEDIUM (degree-1) tier, and it is the same meaning the input carries in support-resistance.pine. A degree-2 MAJOR is then a medium swing with a lower medium swing on each side.\n\nCounted in BARS, so each interval resolves its own swings. To keep Barry's 3:1 fractal alignment by hand, set 33 here on a 1m confirmation chart against 11 on a 3m setup chart, and both will show the same levels.", group = GROUP_STRUCTURE)
float minProminencePercent = input.float(defval = 10.0, title = "Min Prominence (%)", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "How far a medium swing must stand above the HIGHER of its two flanking mediums, as a share of the reference range, to be upgraded to MAJOR. Nesting alone decides majorness; this drops the ones that only just cleared their neighbours. 0 promotes every nested swing.", group = GROUP_STRUCTURE)
LevelSourceMode levelSource = input.enum(defval = LevelSourceMode.BODIES, title = "Level Source", tooltip = "Which extreme locates the pivots, drives the nesting comparison, and carries the drawn line. Bodies is Barry's rule — 'I would draw it from the real body, not from the high' — and is the edge price meets first on the approach. The tolerance zone always spans body to wick regardless.", group = GROUP_STRUCTURE)

// EXPORTED to the render section as the role-flip retest window. Also the
// volatility yardstick's window: every percentage threshold is measured against a
// window RANGE, which is interval-invariant, unlike ATR — a mean per-bar range
// would make the same percentage mean different things on 1m and 3m.
int referenceBars = int(math.min(math.max(swingStrength * YARDSTICK_MULTIPLE, 20), 200))

var array<Swing> structuralSwings = array.new<Swing>()
// Buffers of recent mediums, newest first. They hold REFERENCES into the store,
// which is what lets the nesting test upgrade a stored swing in place.
var array<Swing> mediumHighs = array.new<Swing>()
var array<Swing> mediumLows = array.new<Swing>()
var float lastHighPrice = na
var float lastLowPrice = na
var string lastHighType = na
var string lastLowType = na
// 1 uptrend, -1 downtrend, 0 range. Used for one thing: a broken high is only a
// tradeable role-flip in an uptrend. In a downtrend it is a stop-run.
var int trendState = 0
// EXPORTED to the render section. Bumped once per pivot event — every event both
// registers a medium and may upgrade one, and both change what belongs in which
// tier. The render pass reselects ONLY when this moves, which is what keeps drawn
// lines in place instead of letting a re-shuffled ranking hide them.
var int structureStamp = 0

// EXPORTED to the render section as the unit behind Min Separation.
float yardstick = ta.highest(source = high, length = referenceBars) - ta.lowest(source = low, length = referenceBars)
float bodyHigh = math.max(open, close)
float bodyLow = math.min(open, close)
bool useWicks = levelSource == LevelSourceMode.WICKS

// PASS ONE — medium (degree-1) pivots. Symmetric by definition: a swing has a
// lower high on BOTH sides, so there is no asymmetry to tune.
float pivotHigh = ta.pivothigh(source = useWicks ? high : bodyHigh, leftbars = swingStrength, rightbars = swingStrength)
float pivotLow = ta.pivotlow(source = useWicks ? low : bodyLow, leftbars = swingStrength, rightbars = swingStrength)

// Hoisted out of the conditional blocks below, because history references inside
// a conditionally-called function can defeat Pine's referencing-length detection.
// Every offset is the constant `swingStrength` — no dynamic-offset history anywhere.
float pivotWickHigh = high[swingStrength]
float pivotWickLow = low[swingStrength]
float pivotBodyHigh = bodyHigh[swingStrength]
float pivotBodyLow = bodyLow[swingStrength]
int pivotBarIndex = bar_index - swingStrength

// Higher highs AND higher lows is an uptrend, lower highs AND lower lows a
// downtrend, anything else a range — "a sideways market is characterized by flat
// highs and lows".
f_trendState() =>
    lastHighType == "HH" and lastLowType == "HL" ? 1 : lastHighType == "LH" and lastLowType == "LL" ? -1 : 0

f_register(bool isHigh, string structureType, float pivotPrice, float wickEdge, float bodyEdge) =>
    // Zone spans real body to extreme wick, widened at the inner (approach) edge
    // when the raw span is thinner than the floor.
    float minHeight = yardstick * ZONE_TOLERANCE_PERCENT / 100.0
    float innerEdge = isHigh ? math.min(bodyEdge, wickEdge - minHeight) : math.max(bodyEdge, wickEdge + minHeight)
    Swing newSwing = Swing.new(levelPrice = pivotPrice, zoneTop = isHigh ? wickEdge : innerEdge, zoneBottom = isHigh ? innerEdge : wickEdge, barIndex = pivotBarIndex, isHigh = isHigh, degree = DEGREE_MEDIUM, structureType = structureType, isBroken = false, isPierced = false, touchCount = 0, prominence = 0.0, isStrong = false, brokenBarIndex = int(na), isInsideZone = false)
    array.unshift(id = structuralSwings, value = newSwing)
    while array.size(id = structuralSwings) > MAX_SWINGS_STORED
        array.pop(id = structuralSwings)
    newSwing

f_pushMedium(array<Swing> buffer, Swing newSwing) =>
    array.unshift(id = buffer, value = newSwing)
    while array.size(id = buffer) > MEDIUM_BUFFER
        array.pop(id = buffer)
    // Explicit terminal expression: a Pine function ending on a `while` has no
    // determinable return type.
    array.size(id = buffer)

// PASS TWO — degree-2 nesting. Each new medium shifts the buffer, so index 1 is
// tested as the middle peak exactly once and can never be upgraded twice.
//
// The lag is real: a major is confirmed only when the NEXT medium confirms. In
// exchange the definition self-guards — if price had exceeded the middle peak, a
// higher medium would exist on the right and `middle > right` would fail, so a
// confirmed major has not been taken out by any medium since. This costs nothing
// in visibility now that the medium tier draws too: the level is already on the
// chart as a medium and simply thickens when the nesting completes.
f_tryUpgrade(array<Swing> buffer, bool isHigh) =>
    bool upgraded = false
    if array.size(id = buffer) >= NESTING_DEPTH
        Swing rightSwing = array.get(id = buffer, index = 0)
        Swing middleSwing = array.get(id = buffer, index = 1)
        Swing leftSwing = array.get(id = buffer, index = 2)
        // Strict comparison: flat highs are a range, not a major swing.
        bool nests = isHigh ? middleSwing.levelPrice > rightSwing.levelPrice and middleSwing.levelPrice > leftSwing.levelPrice : middleSwing.levelPrice < rightSwing.levelPrice and middleSwing.levelPrice < leftSwing.levelPrice
        if nests
            float flank = isHigh ? math.max(rightSwing.levelPrice, leftSwing.levelPrice) : math.min(rightSwing.levelPrice, leftSwing.levelPrice)
            float prominence = yardstick > 0 ? math.abs(number = middleSwing.levelPrice - flank) / yardstick : 0.0
            if prominence * 100.0 >= minProminencePercent
                middleSwing.degree := DEGREE_MAJOR
                middleSwing.prominence := prominence
                upgraded := true
    upgraded

if confirmedBar and not na(pivotHigh)
    string structureType = na(lastHighPrice) ? "SH" : pivotHigh > lastHighPrice ? "HH" : "LH"
    lastHighPrice := pivotHigh
    lastHighType := structureType
    trendState := f_trendState()
    Swing registeredHigh = f_register(isHigh = true, structureType = structureType, pivotPrice = pivotHigh, wickEdge = pivotWickHigh, bodyEdge = pivotBodyHigh)
    f_pushMedium(buffer = mediumHighs, newSwing = registeredHigh)
    f_tryUpgrade(buffer = mediumHighs, isHigh = true)
    structureStamp := structureStamp + 1

if confirmedBar and not na(pivotLow)
    string structureType = na(lastLowPrice) ? "SL" : pivotLow < lastLowPrice ? "LL" : "HL"
    lastLowPrice := pivotLow
    lastLowType := structureType
    trendState := f_trendState()
    Swing registeredLow = f_register(isHigh = false, structureType = structureType, pivotPrice = pivotLow, wickEdge = pivotWickLow, bodyEdge = pivotBodyLow)
    f_pushMedium(buffer = mediumLows, newSwing = registeredLow)
    f_tryUpgrade(buffer = mediumLows, isHigh = false)
    structureStamp := structureStamp + 1

int swingCount = array.size(id = structuralSwings)

// ═════════════════════════════════════════════════════════════════════════════
// 🔨 BREAK, PIERCE, PROMOTION
// Advances every stored swing's state on confirmed bars, and promotes the origin
// of a breaking leg to strong structure.
// ═════════════════════════════════════════════════════════════════════════════
// The origin of a breaking leg is the newest unbroken swing on the OPPOSITE side:
// price broke a high, so the rally that broke it started from the last low. That
// low is now strong structure.
f_promoteLegOrigin(bool brokenWasHigh) =>
    bool promoted = false
    for candidate in structuralSwings
        if not promoted and candidate.isHigh != brokenWasHigh and not candidate.isBroken
            candidate.isStrong := true
            promoted := true
    promoted

// Requiring the whole bar to clear means this runs at bar close and only at bar
// close.
//
// A break deliberately does NOT bump `structureStamp`. The level keeps its slot
// and simply repaints in the broken style, which is how the state change becomes
// something you can watch happen instead of the line vanishing.
bool brokeHigh = false
bool brokeLow = false
bool mssThisBar = false

if confirmedBar and swingCount > 0
    for swing in structuralSwings
        if not swing.isBroken
            bool cleared = swing.isHigh ? low > swing.zoneTop : high < swing.zoneBottom
            // Side-agnostic: zoneTop/zoneBottom already carry the orientation.
            bool inside = high >= swing.zoneBottom and low <= swing.zoneTop
            if cleared
                swing.isBroken := true
                swing.brokenBarIndex := bar_index
                swing.isInsideZone := false
                // Breaking STRONG structure is the market structure shift —
                // "price violates a market extreme that shouldn't be violated in
                // theory". `isStrong` is left set so the level can be labelled as
                // the shift; every PRIVILEGE that flows from strong structure is
                // keyed off `isStrong and not isBroken` instead of `isStrong`.
                mssThisBar := mssThisBar or swing.isStrong
                if swing.isHigh
                    brokeHigh := true
                else
                    brokeLow := true
            else if inside
                // Count a visit on ENTRY only; the latch clears on the first bar
                // that does not intersect the zone at all.
                if not swing.isInsideZone
                    swing.touchCount := swing.touchCount + 1
                    swing.isInsideZone := true
                swing.isPierced := swing.isPierced or (swing.isHigh ? high > swing.zoneTop : low < swing.zoneBottom)
            else
                swing.isInsideZone := false

    // After the scan, so the store is never iterated from two places at once.
    if brokeHigh
        f_promoteLegOrigin(brokenWasHigh = true)
    if brokeLow
        f_promoteLegOrigin(brokenWasHigh = false)

alertcondition(condition = mssThisBar, title = "Market Structure Shift", message = "Major Swings: strong structure broken on {{ticker}} {{interval}}")

// ═════════════════════════════════════════════════════════════════════════════
// 🎨 RENDER
// Selects one bucket of levels per tier and side, holds that selection until the
// structure itself changes, and repaints the held levels every bar.
// ═════════════════════════════════════════════════════════════════════════════
const int LABEL_SIZE = 12
const int LABEL_DISTANCE_TICKS = 2

int majorLevelsPerSide = input.int(defval = 2, title = "Major Levels Per Side", minval = 0, maxval = 10, tooltip = "Degree-2 levels drawn above and below, thick. These are the chart's skeleton, so keep the count low. 0 hides the tier.", group = GROUP_LEVELS)
int mediumLevelsPerSide = input.int(defval = 3, title = "Medium Levels Per Side", minval = 0, maxval = 10, tooltip = "Degree-1 levels drawn above and below, thin. This is the tier that keeps structure visible NEAR price in between the majors. 0 hides the tier.", group = GROUP_LEVELS)
bool reserveNearest = input.bool(defval = true, title = "Always Show Nearest", tooltip = "Reserves one slot per side, per tier, for the level closest to price — the nearest resistance above and the nearest support below always draw, even when stronger levels further away would otherwise take every slot. Same behaviour as structure-and-levels.pine's intraday S/R. Turn off for a pure strength ranking.", group = GROUP_LEVELS)
float minSeparationPercent = input.float(defval = 10.0, title = "Min Separation (%)", minval = 0.0, maxval = 100.0, step = 5.0, tooltip = "Levels in the same tier and on the same side closer together than this much of the reference range collapse to the stronger one, so three readings of the same shelf cannot eat every slot. Live strong structure and the reserved nearest level are exempt.", group = GROUP_LEVELS)

bool showSwingLabels = input.bool(defval = false, title = "Show Labels", tooltip = "Tier and state: ★ marks a major (degree 2), ◆ marks live strong structure, then the HH/LH/HL/LL type, the visit count, and the state — PRC pierced, BRK broken, FLIP broken and retesting with the trend, MSS a broken strong level.", group = GROUP_STYLE)
// Monochrome-ish ramp on purpose — two Snow Storm/Polar Night neutrals for the
// ordinary states and two Frost blues for the states that mean something. No
// Aurora: a level is structure, not a signal, and a red or yellow line reads as a
// call to act. Opacity carries the hierarchy, brightest and most opaque on top:
//   strong  NORD9  /20  brightest — the stop-loss level
//   pierced NORD10 /40  deeper blue — the fade setup, still live
//   broken  NORD3  /30  dark, recedes into the chart — history
//   live    NORD4  /60  neutral gray, deliberately quiet — the default state
color liveColor = input.color(defval = color.new(color = NORD4, transp = 60), title = "Live", tooltip = "A level price has neither pierced nor broken.", group = GROUP_STYLE, inline = "live")
LineStyleMode liveStyle = input.enum(defval = LineStyleMode.DOTTED, title = "", group = GROUP_STYLE, inline = "live")
color piercedColor = input.color(defval = color.new(color = NORD10, transp = 40), title = "Pierced", tooltip = "Part of a bar poked through without the whole bar clearing. Barry's fade setup — the level is still live and we do not trade pierces of resistance.", group = GROUP_STYLE, inline = "pierced")
LineStyleMode piercedStyle = input.enum(defval = LineStyleMode.SOLID, title = "", group = GROUP_STYLE, inline = "pierced")
color brokenColor = input.color(defval = color.new(color = NORD3, transp = 30), title = "Broken", tooltip = "A whole bar — high, low and close — has cleared the zone. The level is held in place rather than dropped, so the style change is visible and the retest is tradeable.", group = GROUP_STYLE, inline = "broken")
LineStyleMode brokenStyle = input.enum(defval = LineStyleMode.DASHED, title = "", group = GROUP_STYLE, inline = "broken")
color strongColor = input.color(defval = color.new(color = NORD9, transp = 20), title = "Strong", tooltip = "Strong structure — an extreme promoted by a break of structure on the opposite side. These are the stop-loss levels.", group = GROUP_STYLE, inline = "strong")
LineStyleMode strongStyle = input.enum(defval = LineStyleMode.SOLID, title = "", group = GROUP_STYLE, inline = "strong")

// A fixed pool, allocated on confirmed bars, mutated forever, never deleted.
// AI.md pitfall #10: intrabar ticks may only MODIFY a live drawing. At the
// max_*_count cap an intrabar creation garbage-collects the oldest COMMITTED
// drawing, and that collection does not roll back. Setting properties on an
// already-minted object is safe on any tick.
//
// Levels are rays. A line whose right end is recomputed as bar_index + N only
// reaches N bars past the last refresh, so a stalled refresh leaves it behind
// price — which reads to the eye as "the indicator disappeared" even though the
// line is still sitting there off-screen. extend.right needs no per-bar update.
color hiddenColor = color.new(color = NORD4, transp = 100)
int poolSize = (majorLevelsPerSide + mediumLevelsPerSide) * 2
var array<LevelSlot> levelSlots = array.new<LevelSlot>()

if confirmedBar and array.size(id = levelSlots) < poolSize
    while array.size(id = levelSlots) < poolSize
        array.push(id = levelSlots, value = LevelSlot.new(levelLine = line.new(x1 = bar_index, y1 = close, x2 = bar_index, y2 = close, xloc = xloc.bar_index, extend = extend.right, color = hiddenColor, width = 1), levelLabel = label.new(x = bar_index, y = close, text = "", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = hiddenColor, size = LABEL_SIZE, textalign = text.align_left)))

f_lineStyle(LineStyleMode styleMode) =>
    styleMode == LineStyleMode.DASHED ? line.style_dashed : styleMode == LineStyleMode.DOTTED ? line.style_dotted : line.style_solid

// A broken level is only a role-flip candidate while the flip agrees with the
// trend: a high broken in an uptrend is former resistance that just became
// support, which is the retest actually worth trading.
f_isFreshFlip(Swing swing) =>
    bool inWindow = swing.isBroken and not na(swing.brokenBarIndex) and (bar_index - swing.brokenBarIndex) <= referenceBars
    inWindow and (swing.isHigh ? trendState == 1 : trendState == -1)

// Takes the array as a parameter so the caller can pick a side with a ternary at
// the CALL site. A ternary that returns an array reference is not reliable inside
// a `for ... in` header.
f_isTooClose(array<float> renderedEdges, float candidateEdge, float minSeparation) =>
    bool tooClose = false
    for rendered in renderedEdges
        if math.abs(number = rendered - candidateEdge) < minSeparation
            tooClose := true
    tooClose

f_parkSlot(int slotIndex) =>
    LevelSlot parkedSlot = array.get(id = levelSlots, index = slotIndex)
    line.set_xy1(id = parkedSlot.levelLine, x = bar_index, y = close)
    line.set_xy2(id = parkedSlot.levelLine, x = bar_index, y = close)
    line.set_color(id = parkedSlot.levelLine, color = hiddenColor)
    label.set_xy(id = parkedSlot.levelLabel, x = bar_index, y = close)
    label.set_text(id = parkedSlot.levelLabel, text = "")
    label.set_textcolor(id = parkedSlot.levelLabel, textcolor = hiddenColor)

// STICKY SELECTION. `heldLevels` is rebuilt only when `structureStamp` moves, i.e.
// when a new swing registers or a medium is upgraded. Between those events the
// SAME levels repaint every bar with fresh state.
//
// Rebuilding the ranking every bar was the disappearing-lines bug, and it had
// nothing to do with garbage collection: the pool is six to twenty objects against
// a 500-line cap, so nothing was ever collected. Scores drift continuously as touch
// counts rise, flip windows expire and the trend flips, so a level would fall out
// of the top-N, get parked, and come back a few bars later. Under replay, where you
// watch every bar land, that reads as lines flickering in and out.
//
// Declared ahead of f_fillBucket because the function writes into it, and a Pine
// function cannot reference a global declared below it.
var array<Swing> heldLevels = array.new<Swing>()
var array<float> scores = array.new<float>()
var int lastSelectionStamp = -1

// Fills one tier/side bucket into `heldLevels`: the reserved nearest level first,
// then by descending score. `ranked` holds STORE indices directly — see the
// scoring loop for why there is no lookup table between the two.
f_fillBucket(int wantDegree, bool wantHigh, int limit, float minSeparation, array<int> ranked) =>
    array<float> taken = array.new<float>()
    int filled = 0

    // RESERVED NEAREST. Strength-first ranking alone will happily fill every slot
    // with dominant peaks far from price, leaving nothing to trade against at the
    // hard right edge. One slot per side per tier is reserved for the closest level
    // so there is always structure adjacent to price action.
    if reserveNearest and limit > 0
        Swing nearest = na
        float bestDistance = na
        for candidate in structuralSwings
            if candidate.degree == wantDegree and candidate.isHigh == wantHigh
                // Nearest resistance ABOVE price, nearest support BELOW it.
                float distance = wantHigh ? candidate.levelPrice - close : close - candidate.levelPrice
                if distance > 0 and (na(bestDistance) or distance < bestDistance)
                    bestDistance := distance
                    nearest := candidate
        if not na(nearest)
            array.push(id = heldLevels, value = nearest)
            array.push(id = taken, value = nearest.levelPrice)
            filled += 1

    if array.size(id = ranked) > 0
        for rank = 0 to array.size(id = ranked) - 1
            if filled < limit
                Swing candidate = array.get(id = structuralSwings, index = array.get(id = ranked, index = rank))
                if candidate.degree == wantDegree and candidate.isHigh == wantHigh
                    // A one-tick separation test doubles as the "is this the level
                    // the reserved pass already took" check.
                    bool alreadyHeld = f_isTooClose(renderedEdges = taken, candidateEdge = candidate.levelPrice, minSeparation = syminfo.mintick)
                    // Collapse duplicate readings of the same shelf. Live strong
                    // structure is EXEMPT: collapsing a strong low into a fresher
                    // shelf that happens to sit inside the band throws away the one
                    // level the stop is supposed to hang from.
                    bool tooClose = candidate.isStrong and not candidate.isBroken ? false : f_isTooClose(renderedEdges = taken, candidateEdge = candidate.levelPrice, minSeparation = minSeparation)
                    if not alreadyHeld and not tooClose
                        array.push(id = heldLevels, value = candidate)
                        array.push(id = taken, value = candidate.levelPrice)
                        filled += 1
    filled

if barstate.islast or barstate.islastconfirmedhistory
    float minSeparation = yardstick * minSeparationPercent / 100.0
    // The ACTUAL pool size, not the configured one: if a rolled-back execution
    // ever left the pool short, indexing to the configured size is out of bounds.
    int livePool = array.size(id = levelSlots)

    if structureStamp != lastSelectionStamp
        lastSelectionStamp := structureStamp
        array.clear(id = heldLevels)
        array.clear(id = scores)

        // Bands, largest term first:
        //   4000  live strong structure. The stop-loss level; nothing outranks it.
        //   3000  fresh role-flip. Above a generic unbroken level on purpose — a
        //         flat penalty on broken levels buried them the moment enough
        //         unbroken candidates existed, i.e. exactly when the retest became
        //         tradeable.
        //   2000  unbroken.
        //   x100  respected visits, then prominence. Visits weigh first: a level the
        //         market turned at three times beats a taller untested peak. Both
        //         are CLAMPED, and the clamps are what keep the bands bands: the two
        //         sum to at most 700, inside the 1000-wide gap to the tier above. An
        //         unclamped term bleeds across and inverts the ordering it sits under.
        //   +eps  recency, so the ordering is deterministic.
        //
        // Every stored swing is scored — there is no filter — so `scores` is indexed
        // by store index and a sorted index IS a store index, with no lookup table in
        // between. Reintroducing a filter here means reintroducing that table. The
        // tier and side filtering happens in f_fillBucket, while WALKING the ranked
        // order, precisely so this property survives.
        if swingCount > 0
            for swingIndex = 0 to swingCount - 1
                Swing swing = array.get(id = structuralSwings, index = swingIndex)
                float strongBonus = swing.isStrong and not swing.isBroken ? 4000.0 : 0.0
                float flipBonus = f_isFreshFlip(swing = swing) ? 3000.0 : 0.0
                float unbrokenBonus = swing.isBroken ? 0.0 : 2000.0
                float recency = (swingCount - swingIndex) / (swingCount * 100.0)
                array.push(id = scores, value = strongBonus + flipBonus + unbrokenBonus + math.min(swing.touchCount, 5) * 100.0 + math.min(swing.prominence, 2.0) * 100.0 + recency)

        if array.size(id = scores) > 0
            array<int> ranked = array.sort_indices(id = scores, order = order.descending)
            // Majors first so they take the low slot indices, then mediums.
            f_fillBucket(wantDegree = DEGREE_MAJOR, wantHigh = true, limit = majorLevelsPerSide, minSeparation = minSeparation, ranked = ranked)
            f_fillBucket(wantDegree = DEGREE_MAJOR, wantHigh = false, limit = majorLevelsPerSide, minSeparation = minSeparation, ranked = ranked)
            f_fillBucket(wantDegree = DEGREE_MEDIUM, wantHigh = true, limit = mediumLevelsPerSide, minSeparation = minSeparation, ranked = ranked)
            f_fillBucket(wantDegree = DEGREE_MEDIUM, wantHigh = false, limit = mediumLevelsPerSide, minSeparation = minSeparation, ranked = ranked)

    // REPAINT every pass, so a break, a pierce or a strong-structure promotion
    // shows up on a level that is already drawn.
    int heldCount = array.size(id = heldLevels)
    int slotIndex = 0
    int highsDrawn = 0
    int lowsDrawn = 0
    if heldCount > 0
        for heldIndex = 0 to heldCount - 1
            if slotIndex < livePool
                Swing swing = array.get(id = heldLevels, index = heldIndex)
                bool isMajor = swing.degree == DEGREE_MAJOR
                // A level that WAS strong and has since broken is history, not
                // structure. It keeps `isStrong` only so it can be labelled MSS,
                // so every privilege — the score bonus, the separation exemption,
                // the color, the style — reads this instead.
                bool isLiveStrong = swing.isStrong and not swing.isBroken
                color stateColor = isLiveStrong ? strongColor : swing.isBroken ? brokenColor : swing.isPierced ? piercedColor : liveColor
                LineStyleMode stateStyle = isLiveStrong ? strongStyle : swing.isBroken ? brokenStyle : swing.isPierced ? piercedStyle : liveStyle

                LevelSlot paintedSlot = array.get(id = levelSlots, index = slotIndex)
                line.set_xy1(id = paintedSlot.levelLine, x = swing.barIndex, y = swing.levelPrice)
                line.set_xy2(id = paintedSlot.levelLine, x = bar_index, y = swing.levelPrice)
                line.set_color(id = paintedSlot.levelLine, color = stateColor)
                // Width is the TIER, not the state — that is the whole point of
                // drawing two degrees: the skeleton reads at a glance.
                line.set_width(id = paintedSlot.levelLine, width = isMajor ? 3 : 2)
                line.set_style(id = paintedSlot.levelLine, style = f_lineStyle(styleMode = stateStyle))

                if showSwingLabels
                    // Sequence is per side across both tiers, and majors fill first,
                    // so H1 is the strongest major above price. The ★ is what tells
                    // you which tier a given line belongs to.
                    int sequence = swing.isHigh ? highsDrawn + 1 : lowsDrawn + 1
                    // MSS outranks BRK: a broken level that was strong is a market
                    // structure shift, not routine history.
                    string state = swing.isBroken ? (swing.isStrong ? " MSS" : f_isFreshFlip(swing = swing) ? " FLIP" : " BRK") : swing.isPierced ? " PRC" : ""
                    // Not named `text` — that shadows Pine's `text.*` namespace.
                    string labelText = (swing.isHigh ? "H" : "L") + str.tostring(value = sequence) + (isMajor ? " ★" : "") + (isLiveStrong ? " ◆" : "") + " " + swing.structureType + (swing.touchCount > 0 ? " ×" + str.tostring(value = swing.touchCount) : "") + state
                    label.set_text(id = paintedSlot.levelLabel, text = labelText)
                    label.set_textcolor(id = paintedSlot.levelLabel, textcolor = stateColor)
                    // Push labels away from price: above resistance, below support.
                    label.set_xy(id = paintedSlot.levelLabel, x = bar_index, y = swing.levelPrice + syminfo.mintick * LABEL_DISTANCE_TICKS * (swing.levelPrice >= close ? 1.0 : -1.0))
                else
                    label.set_text(id = paintedSlot.levelLabel, text = "")
                    label.set_textcolor(id = paintedSlot.levelLabel, textcolor = hiddenColor)

                if swing.isHigh
                    highsDrawn += 1
                else
                    lowsDrawn += 1
                slotIndex += 1

    // Park whatever the selection did not fill. Guarded because a Pine `for` with
    // start > end counts DOWN instead of skipping.
    if slotIndex < livePool
        for parkIndex = slotIndex to livePool - 1
            f_parkSlot(slotIndex = parkIndex)
