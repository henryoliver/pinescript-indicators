//@version=6
indicator(title = "MACD & Waves", shorttitle = "📉 MACD&W", max_labels_count = 500)

// ═════════════════════════════════════════════════════════════════════════════
// 🧱 CONSTANTS
// Shared immutable values used by the indicator, including the Nord palette.
// ═════════════════════════════════════════════════════════════════════════════
// Nord Theme Color
// Polar Night
const color NORD0 = #2E3440
const color NORD1 = #3B4252
const color NORD2 = #434C5E
const color NORD3 = #4C566A
// Snow Storm
const color NORD4 = #D8DEE9
const color NORD5 = #E5E9F0
const color NORD6 = #ECEFF4
// Frost
const color NORD7 = #8FBCBB
const color NORD8 = #88C0D0
const color NORD9 = #81A1C1
const color NORD10 = #5E81AC
// Aurora
const color NORD11 = #BF616A
const color NORD12 = #D08770
const color NORD13 = #EBCB8B
const color NORD14 = #A3BE8C
const color NORD15 = #B48EAD

// ═════════════════════════════════════════════════════════════════════════════
// 🎛️ USER INPUT SETTINGS
// All input groups are declared together so the settings dialog keeps the
// built-in ordering — MACD, Waves, then Calculation last (same rule as
// ma-waves). Pine's top-to-bottom declaration rule would otherwise force the
// Calculation inputs above the sections that consume them, moving the group
// to the top.
// ═════════════════════════════════════════════════════════════════════════════
const string GROUP_MACD = "📈 MACD"
const string GROUP_WAVES = "🌊 Waves"
const string GROUP_CALC = "🧮 Calculation"

// MACD Settings
macdSource = input.source(defval = close, title = "Source",
     tooltip = "Series the MACD is calculated on.", group = GROUP_MACD)
macdFastLength = input.int(defval = 5, title = "Fast Length", minval = 1,
     tooltip = "Fast MA length. Defaults are Barry's momentum settings: 5/20/30.", group = GROUP_MACD)
macdSlowLength = input.int(defval = 20, title = "Slow Length", minval = 1,
     tooltip = "Slow MA length. The MACD (MOM) line is the fast MA minus the slow MA.", group = GROUP_MACD)
macdSignalLength = input.int(defval = 30, title = "Signal Length", minval = 1,
     tooltip = "Smoothing length of the signal (DAD) line over the MACD (MOM) line.", group = GROUP_MACD)
macdOscMAType = input.string(defval = "EMA", title = "Oscillator MA Type", options = ["EMA", "SMA"],
     tooltip = "MA type used for the fast and slow averages behind the MACD line.", group = GROUP_MACD, display = display.none)
macdSignalMAType = input.string(defval = "EMA", title = "Signal MA Type", options = ["EMA", "SMA"],
     tooltip = "MA type used for the signal line.", group = GROUP_MACD, display = display.none)
macdColorMode = input.string(defval = "Slope", title = "MACD Color Mode", options = ["Slope", "Solid"],
     tooltip = "Slope colors the MACD line by its own rise/fall — the same behavior and colors as the signal line. Solid keeps the single neutral color.", group = GROUP_MACD, display = display.none)

// Wave Settings (Barry's cycle defaults: %K Length 5, %K Smoothing 2, %D Smoothing 3)
cycleKLength = input.int(defval = 5, title = "%K Length", minval = 1,
     tooltip = "Stochastic %K lookback. Defaults are Barry's cycle settings: 5/2/3.", group = GROUP_WAVES)
cycleKSmoothing = input.int(defval = 2, title = "%K Smoothing", minval = 1,
     tooltip = "SMA smoothing applied to %K.", group = GROUP_WAVES)
cycleDSmoothing = input.int(defval = 3, title = "%D Smoothing", minval = 1,
     tooltip = "SMA smoothing producing %D — the cycle line whose 45/55 crossings open and close the half-cycle wave windows.", group = GROUP_WAVES)
waveUpColor = input.color(defval = color.new(color = NORD8, transp = 20), title = "Up Trend Wave Color",
     tooltip = "Label color for waves counted under an up MOM trend (matches ma-waves' wave colors).", group = GROUP_WAVES)
waveDownColor = input.color(defval = color.new(color = NORD11, transp = 10), title = "Down Trend Wave Color",
     tooltip = "Label color for waves counted under a down MOM trend.", group = GROUP_WAVES)
waveLabelSize = input.int(defval = 12, title = "Wave Label Size", minval = 8, maxval = 40,
     tooltip = "Text size of the wave number labels.", group = GROUP_WAVES)

// Calculation Settings (manual equivalent of the built-in section — the
// indicator() `timeframe` parameter can't be used in scripts that create drawings)
calcTimeframe = input.timeframe(defval = "", title = "Timeframe",
     tooltip = "Timeframe the MACD and signal lines are calculated on. Leave on Chart to follow the chart's timeframe. Note: an HTF MACD with chart-timeframe cycles is a hybrid — Barry's multi-timeframe handling uses separate charts at 3:1, so the wave count is no longer his pure system.", group = GROUP_CALC)
calcWaitForClose = input.bool(defval = false, title = "Wait for timeframe closes",
     tooltip = "On a higher timeframe, only show values once that timeframe's bar closes (gaps between closes). Off updates the lines with the forming bar.", group = GROUP_CALC)

// ═════════════════════════════════════════════════════════════════════════════
// 📈 MACD
// MOM/DAD engine: MACD line, signal line, and their plot colors.
// Line colors read each line's own slope (visual only); the MACD line can
// opt out to a solid neutral color. Both lines are computed inside the
// requested Calculation timeframe, so on an HTF setting the averages read
// HTF bars, not chart bars. Exports the raw (gapped) series for the plots
// and the fill-forwarded `macd`/`signal` everything downstream consumes.
// ═════════════════════════════════════════════════════════════════════════════
// Signal-line slope colors (same pair as ma-waves' trend colors).
const color TREND_UP_COLOR = color.new(color = NORD8, transp = 20)
const color TREND_DOWN_COLOR = color.new(color = NORD9, transp = 60)

// Helper function to calculate an EMA or SMA of a source series.
f_ma(float maSource, int maLength, simple string maType) =>
    maType == "EMA" ? ta.ema(source = maSource, length = maLength) : ta.sma(source = maSource, length = maLength)

// Inputs to signal — "Wait for timeframe closes" maps to gaps: na between HTF
// closes when on. lookahead stays off so historical HTF values never leak early.
f_macdEngine() =>
    float macdValue = f_ma(maSource = macdSource, maLength = macdFastLength, maType = macdOscMAType) - f_ma(maSource = macdSource, maLength = macdSlowLength, maType = macdOscMAType)
    float signalValue = f_ma(maSource = macdValue, maLength = macdSignalLength, maType = macdSignalMAType)
    [macdValue, signalValue]

// gaps_on only applies when an actual HIGHER timeframe is selected — that is
// the only case "Wait for timeframe closes" is about (its tooltip says so).
// On the default chart timeframe the request maps 1:1 and gaps_off removes
// any chance of the same-TF-with-gaps realtime edge starving the wave engine
// (na macd on live ticks would freeze the extremes, turn gate, and label
// anchors for the whole session).
[macdRaw, signalRaw] = request.security(symbol = syminfo.tickerid, timeframe = calcTimeframe,
     expression = f_macdEngine(), gaps = calcWaitForClose and calcTimeframe != "" ? barmerge.gaps_on : barmerge.gaps_off,
     lookahead = barmerge.lookahead_off)

// Fill-forward for everything downstream — on an HTF setting with gaps on,
// the bars between HTF closes read na; the wave engine needs a MACD value on
// every bar (extreme tracking, boundary seeds, label anchors, turn gate) and
// the slope colors need one to hold their direction. Only the PLOTS read the
// raw series, so the lines still gap between HTF closes.
float macd = fixnan(source = macdRaw)
float signal = fixnan(source = signalRaw)

// Signal slope drives the color; hold the last direction on flat bars so it
// doesn't flicker (same treatment as the stochastic %D and the obv signal MA).
var bool signalRising = true
signalRising := signal > signal[1] ? true : signal < signal[1] ? false : signalRising
color signalColor = signalRising ? TREND_UP_COLOR : TREND_DOWN_COLOR

// MACD line color mode: Slope reuses the signal line's engine on the MACD's
// own slope, same color pair; Solid keeps the neutral line.
var bool macdRising = true
macdRising := macd > macd[1] ? true : macd < macd[1] ? false : macdRising
color macdColor = macdColorMode == "Solid" ? NORD3 : macdRising ? TREND_UP_COLOR : TREND_DOWN_COLOR

// ═════════════════════════════════════════════════════════════════════════════
// 🌊 WAVES
// Cycle engine (same as stochastic/ma-waves): %D 5/2/3 against the 45/55 band.
// Crossing above 45 starts a high half-cycle, crossing below 55 starts a low
// half-cycle (plus the band-skip variants). Every half-cycle is a MOM wave
// (Barry: "every cycle on the cycle indicator is considered a MOM wave" —
// numbers only, never letters), so boundaries are pure %D events: never
// delayed, never skipped. Every wave plots INSIDE its own half-cycle zone:
// each bar belongs to the window matching its own %D state, so the crossing
// bar is the new half-cycle's first (seed) bar and the ended cycle's extreme
// freezes on the bar before it — the extreme search never reaches across a
// boundary in either direction, which is also why two waves can never share
// a bar. Each half-cycle tracks its extreme MACD value live and exports it,
// plus its wave number, for the wave labels rendered at the end of this
// section.
// ═════════════════════════════════════════════════════════════════════════════
// Cycle band (same as ma-waves): %D above 55 = high zone, below 45 = low zone.
const float CYCLE_LOW_BOUNDARY = 45.0
const float CYCLE_HIGH_BOUNDARY = 55.0

float cycleK = ta.sma(source = ta.stoch(source = close, high = high, low = low, length = cycleKLength), length = cycleKSmoothing)
float cycleD = ta.sma(source = cycleK, length = cycleDSmoothing)
bool crossedAbove45 = ta.crossover(source1 = cycleD, source2 = CYCLE_LOW_BOUNDARY)
bool crossedAbove55 = ta.crossover(source1 = cycleD, source2 = CYCLE_HIGH_BOUNDARY)
bool crossedBelow55 = ta.crossunder(source1 = cycleD, source2 = CYCLE_HIGH_BOUNDARY)
bool crossedBelow45 = ta.crossunder(source1 = cycleD, source2 = CYCLE_LOW_BOUNDARY)

var int cycleZone = 0  // 1 = high half-cycle, -1 = low half-cycle, 0 = unseeded
bool startedHighCycle = crossedAbove45 or (crossedAbove55 and cycleZone == -1)
bool startedLowCycle = crossedBelow55 or (crossedBelow45 and cycleZone == 1)
bool cycleStartedThisBar = startedHighCycle or startedLowCycle

// Exported for the wave count and labels below: the open half-cycle's extreme
// MACD value and its bar, plus the just-ended half-cycle's final extreme (na
// unless a new half-cycle started this bar).
var float cycleExtreme = na
var int cycleExtremeBar = na
float endedCycleExtreme = na
int endedCycleExtremeBar = na

// Track the open half-cycle's extreme. Skipped on boundary bars: the crossing
// bar's %D already reads the other zone, so it belongs to the NEW half-cycle
// — it becomes that cycle's seed below, never the ended cycle's extreme.
// Ties stay at the oldest bar (strict >/<).
if not cycleStartedThisBar and ((cycleZone == 1 and macd > cycleExtreme) or (cycleZone == -1 and macd < cycleExtreme))
    cycleExtreme := macd
    cycleExtremeBar := bar_index

if cycleStartedThisBar
    endedCycleExtreme := cycleExtreme
    endedCycleExtremeBar := cycleExtremeBar
    cycleZone := startedHighCycle ? 1 : -1
    // Seed the new half-cycle from its first bar — every wave plots inside
    // its own %D window, so the extreme search never reaches back across the
    // boundary.
    cycleExtreme := macd
    cycleExtremeBar := bar_index

// ── Display extremes — label anchors only; the COUNT stays on the window
// extremes above. The label belongs on the MACD line's true turn, which the
// window partition can miss on both sides: the %D cross can LEAD the MACD
// turn (the old swing's extreme prints after the window closes — covered by
// the pinned-label migration in the label section) or LAG it (the new
// swing's extreme printed before the window opened — covered by the boundary
// back-scan seed here, which reaches back to the ended wave's display
// extreme, exclusive, so no two labels ever claim the same bar).
const int DISPLAY_BACKSCAN_MAX = 200
max_bars_back(macd, DISPLAY_BACKSCAN_MAX)
var float displayExtreme = na
var int displayExtremeBar = na
float endedDisplayExtreme = na
int endedDisplayExtremeBar = na

if not cycleStartedThisBar and ((cycleZone == 1 and macd > displayExtreme) or (cycleZone == -1 and macd < displayExtreme))
    displayExtreme := macd
    displayExtremeBar := bar_index

if cycleStartedThisBar
    endedDisplayExtreme := displayExtreme
    endedDisplayExtremeBar := displayExtremeBar
    float displaySeed = macd
    int displaySeedOffset = 0
    // Back-scan only once the line has actually turned off the ended wave's
    // display extreme; while it is still extending the old swing (rare — %D
    // crossing against a running MACD), every back bar belongs to the old
    // swing and the migration owns the turn instead.
    bool oldSwingTurned = not na(endedDisplayExtreme) and
         (startedHighCycle ? macd > endedDisplayExtreme : macd < endedDisplayExtreme)
    if oldSwingTurned
        int displayBackscan = math.min(bar_index - endedDisplayExtremeBar - 1, DISPLAY_BACKSCAN_MAX)
        if displayBackscan > 0
            for barOffset = 1 to displayBackscan
                float displayCandidate = macd[barOffset]
                if startedHighCycle ? displayCandidate > displaySeed : displayCandidate < displaySeed
                    displaySeed := displayCandidate
                    displaySeedOffset := barOffset
    displayExtreme := displaySeed
    displayExtremeBar := bar_index - displaySeedOffset

// Wave count — rooted in structure TAKES (Henry 2026-07-27 final form). A
// wave only moves the trend by strictly TAKING a previous extreme; the
// ENGINE only moves on the MACD line's value breaking the current trend's
// structure at a bar close (the DISPLAY may show the shift's 1/2 earlier —
// angle-gated provisional, 2026-08-01, see the shift plot block):
// • A take WITH the trend (HH in up, LL in down) just counts up.
// • A take AGAINST the trend (a low through the up trend's last HL, a high
//   through the down trend's last LH) IS the shift: it plots as the new
//   trend's 1 — or 3 when a failed impulse (below) set the shift up, in
//   which case the take also relabels the old retrace to "1" and flips the
//   failed impulse to "2" (provisionally shown angle-gated tick-time via
//   the pending machinery in the label section; a confirmed close with the
//   take standing commits it).
// • A FAILED IMPULSE (a high that can't take the up trend's HH, a low that
//   can't take the down trend's LL) displays as the RUNNING trend's next
//   number — the shift it hints at hasn't broken anything yet — and arms a
//   provisional that resolves ONE half-cycle later: confirmed if the next
//   wave takes the old retrace level (that close repaints it "2" in the new
//   trend's color), otherwise the shift dies and nothing ever showed. A
//   contraction (alternating LH/HL with nothing taken) therefore plots a
//   clean monotone count and can never flip the trend back and forth.
// • Healthy retraces (HL in up, LH in down) and unclassifiable extremes
//   count up under the running trend. Exactly-equal extremes take nothing.
// • PLOT QUALIFICATION (Henry 2026-07-27): a wave only PLOTS if its extreme
//   strictly took the previous same-side extreme in the TREND direction —
//   HH and HL in an up trend, LL and LH in a down trend (one comparison:
//   strictly beyond in the trend direction) — or if it is the shift's take
//   itself. A wave that took nothing (the failed impulse, an equal extreme)
//   still COUNTS (parity survives) but pins BLANK; the failed impulse's blank
//   pin is what the shift confirmation repaints to "2". Warmup
//   (unseeded/unclassifiable) plots as before. DISPLAY EXCEPTION since
//   2026-08-07: a failed impulse first-shows live as the shift's provisional
//   "2" (see the live shift candidate below) — its PIN is still blank, and an
//   equal extreme still never shows at all.
// Extremes are built from closes only (intrabar values roll back), so every
// take is close-confirmed by construction. The open half-cycle's number is
// recomputed live from its provisional extreme, so a still-extending extreme
// corrects its own number intrabar — an impulse that finally takes the HH
// mid-half-cycle starts qualifying (and can first-show) from that close on.
var int waveTrend = 0  // 1 = up (HH/HL), -1 = down (LL/LH), 0 = unseeded
var int waveCount = 0
var float lastHighExtreme = na
var float lastLowExtreme = na
// Provisional shift — armed by a failed impulse, resolved at the very next
// boundary (confirm or die); the label-side copies live in the label section.
var int shiftTrend = 0     // candidate trend direction (0 = no shift in play)
var float shiftLevel = na  // the old trend's retrace extreme the shift must take
bool shiftDiedAtBoundary = false

// Helper function classifying an extreme purely by TAKES: returns its wave
// number, the trend direction it displays under (label color), whether it is
// a failed impulse arming a provisional shift, and whether it QUALIFIES to
// plot (strictly took its previous same-side extreme in the trend direction,
// or is the shift's take itself; warmup always qualifies). A take with the
// trend counts up; a take against it breaks the trend (1, or 3 on a
// provisional match); everything else counts up under the running trend.
f_waveNumber(float extremeValue, float sameSideExtreme, bool isHighExtreme, int trendDirection, int confirmedCount, int provisionalTrend) =>
    bool classifiable = not na(sameSideExtreme)
    bool takes = classifiable and (isHighExtreme ? extremeValue > sameSideExtreme : extremeValue < sameSideExtreme)
    int takeDirection = isHighExtreme ? 1 : -1
    bool breaksTrend = takes and takeDirection != trendDirection
    bool failsImpulse = classifiable and not takes and trendDirection != 0 and isHighExtreme == (trendDirection == 1)
    int waveNumber = breaksTrend ? provisionalTrend == takeDirection ? 3 : 1 : confirmedCount + 1
    int waveDirection = breaksTrend ? takeDirection : trendDirection
    bool qualifies = breaksTrend or not classifiable or trendDirection == 0 or
         (trendDirection == 1 ? extremeValue > sameSideExtreme : extremeValue < sameSideExtreme)
    [waveNumber, waveDirection, failsImpulse, qualifies]

int endedWaveNumber = na
bool endedWaveFailed = false
int endedWaveTrend = 0
bool endedWaveQualifies = false
if cycleStartedThisBar and not na(endedCycleExtreme)
    bool endedIsHighExtreme = startedLowCycle  // the ended half-cycle is the new one's opposite
    float sameSideExtreme = endedIsHighExtreme ? lastHighExtreme : lastLowExtreme
    [confirmedWaveNumber, confirmedWaveTrend, confirmedWaveFailed, confirmedWaveQualifies] = f_waveNumber(extremeValue = endedCycleExtreme, sameSideExtreme = sameSideExtreme, isHighExtreme = endedIsHighExtreme, trendDirection = waveTrend, confirmedCount = waveCount, provisionalTrend = shiftTrend)
    endedWaveNumber := confirmedWaveNumber
    endedWaveTrend := confirmedWaveTrend
    endedWaveFailed := confirmedWaveFailed
    endedWaveQualifies := confirmedWaveQualifies
    // A provisional armed at the PREVIOUS boundary resolves here, one way or
    // the other: this wave either confirmed it (took the old retrace level —
    // it classified as the new trend's 3) or killed it (the died flag clears
    // the label-side pending below; nothing displayed, nothing to revert).
    // Either way it is spent.
    if shiftTrend != 0
        shiftDiedAtBoundary := confirmedWaveTrend != shiftTrend
        shiftTrend := 0
        shiftLevel := na
    waveCount := confirmedWaveNumber
    waveTrend := confirmedWaveTrend
    if confirmedWaveFailed
        shiftTrend := -waveTrend
        shiftLevel := waveTrend == 1 ? lastLowExtreme : lastHighExtreme
    if endedIsHighExtreme
        lastHighExtreme := endedCycleExtreme
    else
        lastLowExtreme := endedCycleExtreme

[liveWaveNumber, liveWaveTrend, liveWaveFailed, liveWaveQualifies] = f_waveNumber(extremeValue = cycleExtreme, sameSideExtreme = cycleZone == 1 ? lastHighExtreme : lastLowExtreme, isHighExtreme = cycleZone == 1, trendDirection = waveTrend, confirmedCount = waveCount, provisionalTrend = shiftTrend)
// Helper function returning the label color for a wave's trend direction.
f_waveTrendColor(int trendDirection) =>
    trendDirection == -1 ? waveDownColor : waveUpColor

// Live turn gate (display only — TICK-TIME since 2026-07-27 pm, Henry's ask
// after the close-gated triple confirmation plotted a bar late): the live
// label first shows AS SOON AS a tick has BOTH the MACD line and %K angling
// against the open half-cycle (current tick value vs the last committed
// close) while the wave qualifies. No bar-close confirmation. After the
// first show the MACD term ALONE rules visibility tick by tick (2026-08-01,
// Henry: a plotted wave with the line running against it misleads): the
// label shows only while the MACD line points in the wave's direction —
// angling down for a high half-cycle's wave, up for a low half-cycle's —
// hides (blank text) the moment the line turns back with the cycle, and
// re-shows on the next tick it points against again. Accepted trade-off,
// same as the old tick-time latch: an intrabar-only show may not reproduce
// on a reload (history has closes only). Everything ELSE stays
// close-committed — engine takes, renumbering, pins, relabels — so the
// shift machinery is untouched by this earliness.
bool macdTurnAgainstCycle = cycleZone == 1 ? macd < macd[1] : macd > macd[1]
bool liveTurnAgainstCycle = macdTurnAgainstCycle and (cycleZone == 1 ? cycleK < cycleK[1] : cycleK > cycleK[1])
// Shown-state snapshot (display only): the number/trend the live label
// says while visible. varip — the FIRST show commits mid-bar and survives Pine's
// rollback. AFTER the show it re-reads the live classification on confirmed
// QUALIFIED ticks only: intrabar the provisional extreme is non-monotone —
// var state rolls back each tick, so the extreme breathes with the current
// tick's MACD — and while the line straddles the previous same-side extreme
// the live number flips every tick, churning the label 2↔3 (log-proven
// 2026-07-24 @ bar 40,976). Post-show renumbering therefore still waits for
// a close: the first-show number is the showing tick's read, corrected if
// needed at the next qualified close, and the boundary pin remains the
// committed authority (a wave whose take didn't hold to the close still
// pins BLANK there). On historical bars every execution is a close.
varip int liveShownNumber = na
varip int liveShownTrend = 0
// Shift flag of the same snapshot (2026-08-07): the shown wave is a failed
// impulse displayed as the shift's provisional "2". It keeps the shift's "1"
// relabel in lockstep with that "2" — one snapshot, one visibility rule.
varip bool liveShownIsShift = false

// Helper function to create the cycle label on first use or move it afterwards.
// High-cycle labels sit above the extreme, low-cycle labels below it.
f_upsertCycleLabel(label existingLabel, int labelBarIndex, float labelPrice, string labelText, color labelTextColor, bool isHighCycle) =>
    label updatedLabel = existingLabel
    if na(updatedLabel)
        updatedLabel := label.new(x = labelBarIndex, y = labelPrice, text = labelText,
             style = isHighCycle ? label.style_label_down : label.style_label_up,
             color = color.new(color = color.gray, transp = 100), textcolor = labelTextColor, size = waveLabelSize)
    else
        label.set_xy(id = updatedLabel, x = labelBarIndex, y = labelPrice)
        label.set_text(id = updatedLabel, text = labelText)
        label.set_textcolor(id = updatedLabel, textcolor = labelTextColor)
    updatedLabel

// Cycle label — the wave number at the half-cycle's extreme MACD value, colored
// by the wave's trend. Every wave — impulse and retrace alike — draws as soon
// as a TICK has the MACD line and %K both angling against the half-cycle
// (the tick-time turn gate above) AND the wave qualifies (its extreme
// strictly took its level — waves that took nothing never show), from then
// on tracks the provisional extreme and number live — visible only on ticks
// where the MACD line still points against the half-cycle — and is pinned (or
// backfilled, or pinned BLANK when unqualified) at the final extreme when
// the half-cycle ends on the %D cross.
// After the pin the label migrates with the MACD line to the swing's true
// turn (the line lags the %D cross), so it always ends up ON the visual
// extreme even when that bar belongs to the next window.
var label cycleExtremeLabel = na
var label prevWaveLabel = na
// prevWaveLabel's OWN pinned text/trend — the restore source whenever a
// provisional "1" written over it has to be undone. Taken from the pin, never
// from label.get_text: the live provisional below can COMMIT a "1" onto that
// label at a close, and a read would then snapshot the "1" as the original.
var string prevWaveText = na
var int prevWaveTrend = 0
// The label a live provisional "1" is currently written on, with its own
// restore text/trend (display only). Held as its OWN reference, not re-read
// from prevWaveLabel at restore time: when a take and the %D cross land on
// the same close the pin has already moved prevWaveLabel to the next wave,
// and restoring through it would leave the stale "1" standing forever.
var label liveShiftOneLabel = na
var string liveShiftOneText = na
var int liveShiftOneTrend = 0
// Pending shift labels (display only, label-side copies of the engine's
// provisional — they survive the engine's boundary clear so a confirm and
// its relabels can land on the same close): a failed impulse pins under the
// RUNNING trend. ANGLE-GATED PROVISIONAL since 2026-08-01 (Henry: waiting
// for the value break plotted the 1/2 too late): any tick where the MACD
// line angles in the shift direction (or its value is already through the
// old retrace level) shows the shift in one shot: the old retrace relabels
// to the new trend's "1" and the failed impulse repaints as its "2". Since
// 2026-08-07 that no longer waits for the %D cross either — the pair starts
// at the failed impulse's own live first show, and this pending state is the
// handoff that carries it past the pin. A tick angling back restores the
// originals explicitly (a
// close can COMMIT the provisional, so rollback alone can't undo it — the
// snapshot text below is the restore source). Only a confirmed close with
// the MACD's VALUE strictly through the level clears the pending — the 1/2
// are permanent from that close on, and the ENGINE's trend/count still move
// only on the strict take (untouched — this is display). If the next
// boundary instead kills the shift, the death path restores the originals.
var label pendingShiftLabel = na      // the previous retrace's label, waiting to become "1"
var float pendingShiftLevel = na      // the structure level the shift must take
var int pendingShiftTrend = 0         // pending shift direction: 1 up, -1 down, 0 none
var label provisionalShiftLabel = na  // the failed impulse's own label, waiting to become "2"
var string pendingShiftOneText = na   // the retrace label's original text — fade/death restore source
// Pinned-label migration state (display only): the MACD (5/20) turns AFTER
// the faster stochastic %D (5/2/3) crosses, so the swing's real extreme often
// prints ON the crossing bar or a few bars into the next window. The wave
// count stays on the window extreme — plot-in-zone is the engine's rule — but
// the LABEL follows the line to its actual turn, stopping for good on the
// first confirmed bar that fails to extend it.
var int pinnedExtremeSide = 0      // 1 = the pinned label marks a MACD high, -1 a low
var float pinnedExtremeValue = na  // the label's current (possibly migrated) value
var bool pinnedExtremeMigrating = false
var int pinnedAnchorBar = na       // the pin's ORIGINAL anchor, kept so the next
var float pinnedAnchorValue = na   // pin's ordering guard can revert an overshoot
// The PIN stays close-gated: an intrabar %D cross can recede before the
// close, so the pinned label waits for the confirming tick. Wave STATE above
// is untouched — it still updates every tick and rolls back.
if cycleStartedThisBar and barstate.isconfirmed
    if not na(endedCycleExtreme)
        color endedWaveColor = f_waveTrendColor(trendDirection = endedWaveTrend)
        if shiftDiedAtBoundary
            // The shift never took its level — undo anything the angle-gated
            // provisional committed (the retrace's original number and color
            // back, the failed impulse back to blank), then drop the pending.
            if not na(pendingShiftLabel)
                label.set_text(id = pendingShiftLabel, text = pendingShiftOneText)
                label.set_textcolor(id = pendingShiftLabel, textcolor = f_waveTrendColor(trendDirection = -pendingShiftTrend))
            if not na(provisionalShiftLabel)
                label.set_text(id = provisionalShiftLabel, text = "")
            pendingShiftLabel := na
            pendingShiftLevel := na
            pendingShiftTrend := 0
            provisionalShiftLabel := na
            pendingShiftOneText := na
        if endedWaveFailed and not na(prevWaveLabel)
            // Failed impulse pinning under the running trend: arm the pending
            // relabels for a confirmed shift. The engine set shiftTrend and
            // shiftLevel this bar from the still-untouched opposite-side
            // extreme. The restore text comes from the retrace's own pin
            // record, not a label read: the live provisional may already have
            // committed a "1" onto that label at an earlier close.
            pendingShiftLabel := prevWaveLabel
            pendingShiftLevel := shiftLevel
            pendingShiftTrend := shiftTrend
            pendingShiftOneText := prevWaveText
            liveShiftOneLabel := na  // handoff — the pending path owns the "1" now
        // The pin anchors at the DISPLAY extreme (the line's true turn, which
        // may sit before the window opened); the number comes from the
        // window-partitioned engine above.
        float pinAnchorValue = na(endedDisplayExtreme) ? endedCycleExtreme : endedDisplayExtreme
        int pinAnchorBar = na(endedDisplayExtremeBar) ? endedCycleExtremeBar : endedDisplayExtremeBar
        // Ordering guard: when the MACD runs monotone through a whole window
        // (price %D cycles while the line doesn't), the previous label's
        // migration never meets a turn and chases the line to/past this pin's
        // anchor — plotting the older wave number to the RIGHT of the newer
        // one. Migration is display sugar, so revert the old label to its
        // original anchor; original anchors are strictly time-ordered by the
        // window partition, which restores the count's left-to-right order.
        if not na(prevWaveLabel) and not na(pinnedAnchorBar) and label.get_x(id = prevWaveLabel) >= pinAnchorBar
            label.set_xy(id = prevWaveLabel, x = pinnedAnchorBar, y = pinnedAnchorValue)
        // A wave that took nothing pins BLANK — it is counted (parity) but
        // never displays a number of its own; a failed impulse's blank pin is
        // exactly what the shift repaints to "2" (the shift block below runs
        // after this one and re-applies on this same tick, so a live "2"
        // already showing does not blink through the pin).
        cycleExtremeLabel := f_upsertCycleLabel(existingLabel = cycleExtremeLabel,
             labelBarIndex = pinAnchorBar, labelPrice = pinAnchorValue,
             labelText = endedWaveQualifies ? str.tostring(value = endedWaveNumber) : "",
             labelTextColor = endedWaveColor, isHighCycle = cycleZone == -1)
        if endedWaveFailed
            provisionalShiftLabel := cycleExtremeLabel
        prevWaveLabel := cycleExtremeLabel
        prevWaveText := endedWaveQualifies ? str.tostring(value = endedWaveNumber) : ""
        prevWaveTrend := endedWaveTrend
        pinnedExtremeSide := cycleZone == -1 ? 1 : -1
        pinnedExtremeValue := pinAnchorValue
        pinnedExtremeMigrating := true
        pinnedAnchorBar := pinAnchorBar
        pinnedAnchorValue := pinAnchorValue
    // Mint the new half-cycle's label now, blank — the only label.new in the
    // script, so the tick-time draw below never creates or deletes a drawing
    // intrabar (same lifecycle as ma-waves): it only set_*s this object once
    // the turn gate passes, and a blank label renders as nothing.
    cycleExtremeLabel := label.new(x = bar_index, y = macd, text = "",
         style = cycleZone == 1 ? label.style_label_down : label.style_label_up,
         color = color.new(color = color.gray, transp = 100),
         textcolor = f_waveTrendColor(trendDirection = liveWaveTrend), size = waveLabelSize)
    liveShownNumber := na
    liveShownTrend := 0
    liveShownIsShift := false
// Pinned-label migration stays on closing ticks: intrabar the MACD's turn away
// from the old extreme is unconfirmed (the line can resume into a new extreme
// before the close), and a migration step is a commitment — the label only
// stops for good on a confirmed failure to extend.
// Runs on the pin bar too: the crossing bar already belongs to the new
// window, so it is the first candidate for a beyond-window extreme.
if barstate.isconfirmed and pinnedExtremeMigrating and not na(prevWaveLabel) and not na(pinnedExtremeValue)
    if pinnedExtremeSide == 1 ? macd > pinnedExtremeValue : macd < pinnedExtremeValue
        pinnedExtremeValue := macd
        label.set_xy(id = prevWaveLabel, x = bar_index, y = pinnedExtremeValue)
    else
        pinnedExtremeMigrating := false
// Live shift candidate (display only, 2026-08-07 — Henry: the shift's 2 was
// "taking too long to be plotted, it must behave like the normal realtime
// plot, all must use the same engine"): the OPEN half-cycle is a failed
// impulse, so it already IS the shift's provisional "2" and the previous
// retrace is its "1". Before this a failed impulse never qualified, so its
// label stayed blank for its entire half-cycle and the pair could not light
// up until the %D cross that ended it — a whole half-cycle later than any
// other wave, which plots at its own turn. DISPLAY qualification therefore
// admits the failed impulse, and the live label below draws it exactly like
// every other wave: same tick-time turn gate (MACD + %K against the cycle),
// same live extreme tracking, same MACD-direction visibility, same
// close-gated renumbering. The ENGINE is untouched — the wave still counts
// under the running trend, still pins BLANK when it never takes, and
// trend/count still move only on a strict take at a close.
bool liveShiftFailed = liveWaveFailed and not na(prevWaveLabel)
int liveShiftTrend = -waveTrend
float liveShiftLevel = waveTrend == 1 ? lastLowExtreme : lastHighExtreme

// Live label — first show is TICK-TIME: the moment a tick has the MACD line
// retracing against the half-cycle, %K retracing with it (the turn gate
// above), and the wave qualified, it plots — no bar-close confirmation.
// Then it tracks the provisional extreme every tick (renumbering stays
// close-gated through the shown-state snapshot above), morphing into the
// pin at the boundary. VISIBILITY rides the MACD line tick by tick
// (2026-08-01, replacing never-un-shows): a resume — the line turning back
// WITH the cycle, extending the extreme — hides the label (blank text, the
// object survives), and the next tick pointing against the cycle re-shows
// it on the (possibly migrated) extreme with the snapshot's number. While
// the pinned label is still migrating the old swing hasn't finished, so the
// new window's label would mark a wave that hasn't started — nothing is
// remembered through the hold; the label first shows on the first
// post-migration tick that passes the gates, evaluated fresh on that tick.
// liveShownNumber (varip — survives rollback) is the ARMED state: once set,
// the MACD direction alone decides visibility — %K is first-show only.
// A live shift candidate rides all of the above unchanged; only the number
// and color it says differ (the shift's "2" in the new trend's color).
bool liveShowQualifies = liveWaveQualifies or liveShiftFailed
bool liveLabelDrawn = not cycleStartedThisBar and cycleZone != 0 and
     not na(displayExtreme) and not pinnedExtremeMigrating and not na(cycleExtremeLabel) and
     (not na(liveShownNumber) or (liveTurnAgainstCycle and liveShowQualifies))
if liveLabelDrawn
    // First show snapshots the showing tick's read; after that the snapshot
    // only re-reads QUALIFIED classifications on confirmed ticks — on a
    // close where the live wave momentarily took nothing (an exact tie
    // mid-travel) the label keeps saying its last qualified state instead of
    // blanking. A failed impulse that finally TAKES its level mid-half-cycle
    // re-reads here too: the shift dies at that close and the label goes back
    // to the running trend's number (the "1" restores with it, below).
    if na(liveShownNumber) or (barstate.isconfirmed and liveShowQualifies)
        liveShownNumber := liveShiftFailed ? 2 : liveWaveNumber
        liveShownTrend := liveShiftFailed ? liveShiftTrend : liveWaveTrend
        liveShownIsShift := liveShiftFailed
    cycleExtremeLabel := f_upsertCycleLabel(existingLabel = cycleExtremeLabel,
         labelBarIndex = displayExtremeBar, labelPrice = displayExtreme,
         labelText = macdTurnAgainstCycle ? str.tostring(value = liveShownNumber) : "",
         labelTextColor = f_waveTrendColor(trendDirection = liveShownTrend), isHighCycle = cycleZone == 1)
// The pair moves in lockstep: the "1" applies on exactly the ticks the live
// "2" is visible — same snapshot, same MACD-direction visibility rule.
bool liveShiftShown = liveLabelDrawn and liveShownIsShift and macdTurnAgainstCycle

// Shift plot — ANGLE-GATED PROVISIONAL, tick-time. Three entry points feed
// one rule; the pair (old retrace → "1", failed impulse → "2") never splits:
// • LIVE (2026-08-07, supersedes the 2026-08-01 "never before the %D cross"
//   condition — that gate is what made the 2 a half-cycle late): the failed
//   impulse's own live label above IS the "2", so this block only writes the
//   "1", on exactly the ticks that label shows.
// • PRE-PIN: the %D crossing bar's intrabar ticks, before the pin arms the
//   pending (the confirmed tick of that bar arms it and takes the path
//   below — and it must, because the pin has already re-minted
//   cycleExtremeLabel for the NEW half-cycle by then).
// • PENDING: from the pin until the take commits or the shift dies. Shows
//   while the MACD line ANGLES in the shift direction (tick value vs last
//   committed close — same fade rule as the live label) or its VALUE is
//   already through the old retrace level (the real take).
// A tick angling back stops re-applying AND the else-branches actively
// restore the originals — a provisional can commit at a close, so rollback
// alone can't undo it. The pending only CLEARS on a confirmed close with the
// VALUE take standing: the 1/2 are permanent from that close on, and the
// engine's trend/count still move only on the strict take at the boundary.
bool shiftPlotPrePin = na(pendingShiftLabel) and cycleStartedThisBar and endedWaveFailed and
     not na(prevWaveLabel) and not barstate.isconfirmed
bool shiftPlotLive = na(pendingShiftLabel) and not shiftPlotPrePin and liveShiftShown
label shiftOneLabel = not na(pendingShiftLabel) ? pendingShiftLabel : (shiftPlotPrePin or shiftPlotLive) ? prevWaveLabel : na
label shiftTwoLabel = not na(pendingShiftLabel) ? provisionalShiftLabel : shiftPlotPrePin ? cycleExtremeLabel : na
int shiftPlotTrend = not na(pendingShiftLabel) ? pendingShiftTrend : shiftPlotPrePin ? shiftTrend : liveShiftTrend
float shiftPlotLevel = not na(pendingShiftLabel) ? pendingShiftLevel : shiftPlotPrePin ? shiftLevel : liveShiftLevel
bool macdAnglesWithShift = shiftPlotTrend == -1 ? macd < macd[1] : macd > macd[1]
bool shiftTakeStands = not na(shiftOneLabel) and (shiftPlotTrend == -1 ? macd < shiftPlotLevel : macd > shiftPlotLevel)
if not na(shiftOneLabel) and (macdAnglesWithShift or shiftTakeStands)
    color shiftPlotColor = f_waveTrendColor(trendDirection = shiftPlotTrend)
    label.set_text(id = shiftOneLabel, text = "1")
    label.set_textcolor(id = shiftOneLabel, textcolor = shiftPlotColor)
    if shiftPlotLive
        liveShiftOneLabel := shiftOneLabel
        liveShiftOneText := prevWaveText
        liveShiftOneTrend := prevWaveTrend
    if not na(shiftTwoLabel)
        label.set_text(id = shiftTwoLabel, text = "2")
        label.set_textcolor(id = shiftTwoLabel, textcolor = shiftPlotColor)
        if shiftPlotPrePin
            // Before its pin the failed impulse's label sits wherever the
            // live layer left it; anchor the 2 on its display extreme — the
            // pin re-lands it there at the close.
            label.set_xy(id = shiftTwoLabel,
                 x = na(endedDisplayExtremeBar) ? endedCycleExtremeBar : endedDisplayExtremeBar,
                 y = na(endedDisplayExtreme) ? endedCycleExtreme : endedDisplayExtreme)
    // Only the pending path can COMMIT: in the live phase the half-cycle
    // hasn't ended, so there is no take for the engine to confirm yet.
    if barstate.isconfirmed and shiftTakeStands and not na(pendingShiftLabel)
        pendingShiftLabel := na
        pendingShiftLevel := na
        pendingShiftTrend := 0
        provisionalShiftLabel := na
        pendingShiftOneText := na
else if not na(pendingShiftLabel)
    // Fade restore: a provisional 1/2 that COMMITTED at a close (MACD angled
    // with the shift at that close without the take) must be undone by hand
    // when the line angles back — the retrace label returns to its pinned
    // number under the old trend's color, the failed impulse to blank.
    label.set_text(id = pendingShiftLabel, text = pendingShiftOneText)
    label.set_textcolor(id = pendingShiftLabel, textcolor = f_waveTrendColor(trendDirection = -pendingShiftTrend))
    if not na(provisionalShiftLabel)
        label.set_text(id = provisionalShiftLabel, text = "")
else if not na(liveShiftOneLabel)
    // Same restore for the LIVE provisional "1" — the live "2" hides itself
    // through the label's own visibility rule, but the retrace label carries
    // a real number that has to be put back. Restores through the held
    // reference so it lands on the right label whatever the pin did this tick.
    label.set_text(id = liveShiftOneLabel, text = liveShiftOneText)
    label.set_textcolor(id = liveShiftOneLabel, textcolor = f_waveTrendColor(trendDirection = liveShiftOneTrend))
    liveShiftOneLabel := na

// ═════════════════════════════════════════════════════════════════════════════
// 🎨 PLOTS
// Final plot and hline statements only — all series and colors are computed
// in their owning sections above.
// ═════════════════════════════════════════════════════════════════════════════
hline(price = 0, title = "Zero Line", color = NORD3, linewidth = 1, linestyle = hline.style_dashed)
plot(series = macdRaw, title = "MACD", color = macdColor, linewidth = 2)
plot(series = signalRaw, title = "Signal", color = signalColor, linewidth = 4)
